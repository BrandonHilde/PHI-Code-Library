# What the parser knows about names, on the heap, built the first time a parser is made: the
# numbers on the atoms (WlAtom.tag), the flags of each code, and the adjusted names of foreign
# content. The tables themselves are text in tags.phi.

use memory.mem;
use core.text;
use core.atoms;
use dom.dom;
use html.tags;

phi.HtmlTags:Library
{
	ptr<u32> flags: 0;              # what the spec's lists say of a code (HtmlTag.F_...)
	ptr<ptr<WlAtom>> atoms: 0;      # by number: the element's name; for an adjusted name, the
	                                # mixed-case one; for a foreign attribute, its local name
	ptr<ptr<WlAtom>> prefixes: 0;   # for a foreign attribute: its prefix
	ptr<u8> adjust_kind: 0;         # for an adjusted name: 1 if on elements, 2 if on attributes
	ptr<WlAtom> A_SCRIPT: 0;
	ptr<WlAtom> A_EMPTY: 0;
	ptr<WlAtom> A_ENCODING: 0;
	ptr<WlAtom> A_TYPE: 0;
	ptr<WlAtom> A_COLOR: 0;
	ptr<WlAtom> A_FACE: 0;
	ptr<WlAtom> A_SIZE: 0;
	ptr<WlAtom> A_MATH: 0;
	ptr<WlAtom> A_SVG: 0;

	[Start]
		if flags is not 0 return;
		ptr<u32> table: new u32[HtmlTag.CODE_COUNT + 1];
		ptr<ptr<WlAtom>> names: new ptr<WlAtom>[HtmlTag.ATOM_COUNT + 1];
		ptr<ptr<WlAtom>> pre: new ptr<WlAtom>[HtmlTag.ATOM_COUNT + 1];
		ptr<u8> kinds: new u8[HtmlTag.ATOM_COUNT + 1];
		if table is 0 or names is 0 or pre is 0 or kinds is 0
			throw 'out of memory for the tag tables';
		;;
		atoms is names;
		prefixes is pre;
		adjust_kind is kinds;

		# div:3801 span:800 ...
		ptr<u8> p: HtmlTag.ELEMENT_TEXT;
		u32 number: 1;
		while p:0 is not 0
			u32 len: 0;
			while p:len is not ':'
				len++;
			;;
			ptr<WlAtom> a: (WlAtoms.Get: p len);
			a.tag is number;
			names:number is a;
			p is p + len + 1;
			table:number is (ReadHex: p);
			p is (SkipWord: p);
			number++;
		;;

		# clipPath:1: the lowercase name gets the number, and the mixed-case one is what it becomes
		p is HtmlTag.ADJUST_TEXT;
		number is HtmlTag.ADJUST_FIRST;
		while p:0 is not 0
			u32 len2: 0;
			while p:len2 is not ':'
				len2++;
			;;
			ptr<WlAtom> low: (WlAtoms.GetLower: p len2);
			low.tag is number;
			names:number is (WlAtoms.Get: p len2);
			kinds:number is p:(len2 + 1) - '0';
			p is (SkipWord: p + len2);
			number++;
		;;

		# xlink:href=xlink=href
		p is HtmlTag.FOREIGN_ATTR_TEXT;
		number is HtmlTag.FOREIGN_ATTR_FIRST;
		while p:0 is not 0
			u32 l1: 0;
			while p:l1 is not '='
				l1++;
			;;
			ptr<WlAtom> whole: (WlAtoms.Get: p l1);
			whole.tag is number;
			p is p + l1 + 1;
			u32 l2: 0;
			while p:l2 is not '='
				l2++;
			;;
			pre:number is (WlAtoms.Get: p l2);
			p is p + l2 + 1;
			u32 l3: 0;
			while p:l3 is not 0 and p:l3 is not ' '
				l3++;
			;;
			names:number is (WlAtoms.Get: p l3);
			p is (SkipWord: p);
			number++;
		;;

		ptr<WlAtom> durl: (WlAtoms.GetZ: 'definitionurl');
		durl.tag is HtmlTag.DEFINITIONURL;
		names:(HtmlTag.DEFINITIONURL) is (WlAtoms.GetZ: 'definitionURL');

		p is HtmlTag.FOREIGN_CODE_FLAGS;
		number is HtmlTag.K_SVG;
		while p:0 is not 0
			table:number is (ReadHex: p);
			p is (SkipWord: p);
			number++;
		;;

		A_SCRIPT is (WlAtoms.GetZ: 'script');
		A_EMPTY is (WlAtoms.Get: '' 0);
		A_ENCODING is (WlAtoms.GetZ: 'encoding');
		A_TYPE is (WlAtoms.GetZ: 'type');
		A_COLOR is (WlAtoms.GetZ: 'color');
		A_FACE is (WlAtoms.GetZ: 'face');
		A_SIZE is (WlAtoms.GetZ: 'size');
		A_MATH is names:(HtmlTag.MATH);
		A_SVG is names:(HtmlTag.SVG);
		flags is table;
	[end]

	# the code an element on the stack has: its name's number if it's HTML; for a foreign one, what
	# the spec cares about. low is its name in lowercase.
	[CodeOf: DomNs ns: DomNs.HTML; ptr<WlAtom> low: 0;]
		u32 t: low.tag;
		if ns is DomNs.HTML return t;
		if ns is DomNs.SVG
			if t is HtmlTag.FOREIGNOBJECT return HtmlTag.K_SVG_FOREIGNOBJECT;
			if t is HtmlTag.DESC return HtmlTag.K_SVG_DESC;
			if t is HtmlTag.TITLE return HtmlTag.K_SVG_TITLE;
			return HtmlTag.K_SVG;
		;;
		if t is HtmlTag.MI return HtmlTag.K_MATH_MI;
		if t is HtmlTag.MO return HtmlTag.K_MATH_MO;
		if t is HtmlTag.MN return HtmlTag.K_MATH_MN;
		if t is HtmlTag.MS return HtmlTag.K_MATH_MS;
		if t is HtmlTag.MTEXT return HtmlTag.K_MATH_MTEXT;
		if t is HtmlTag.ANNOTATION_XML return HtmlTag.K_MATH_ANNOTATION_XML;
	[end: HtmlTag.K_MATH]

	[ReadHex: ptr<u8> p: 0;]
		u32 v: 0;
		u32 i: 0;
		while (WlText.IsHex: p:i)
			v is v * 16 + (WlText.HexValue: p:i) as u32;
			i++;
		;;
	[end: v]

	# past this word and the space after it
	[SkipWord: ptr<u8> p: 0;]
		while p:0 is not 0 and p:0 is not ' '
			p is p + 1;
		;;
		if p:0 is ' '
			p is p + 1;
		;;
	[end: p]
}
