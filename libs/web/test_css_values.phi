	call V: 'cursor' 'pointer' 'pointer';
	call V: 'cursor' 'url(a.png), pointer' 'url("a.png"), pointer';
	call V: 'cursor' 'url(a.png) 1 2, auto' 'url("a.png") 1 2, auto';
	call V: 'cursor' 'url(a.png)' 0;
	call V: 'flex-grow' '-1' 0;
	call V: 'flex-basis' 'content' 'content';
	call V: 'justify-content' 'space-between' 'space-between';
	call V: 'justify-content' 'safe center' 'safe center';
	call V: 'align-items' 'first baseline' 'first baseline';
	call V: 'align-items' 'nonsense' 0;
	call V: 'box-shadow' 'none' 'none';
	call V: 'box-shadow' '1px 2px' '1px 2px';
	call V: 'box-shadow' '1px 2px 3px 4px red' '1px 2px 3px 4px rgb(255, 0, 0)';
	call V: 'box-shadow' 'inset 1px 2px red, 0 0 3px blue' 'inset 1px 2px rgb(255, 0, 0), 0px 0px 3px rgb(0, 0, 255)';
	call V: 'box-shadow' 'red 1px 2px inset' 'rgb(255, 0, 0) 1px 2px inset';
	call V: 'box-shadow' '1px' 0;
	call V: 'box-shadow' '1px 2px 3px 4px 5px' 0;
	call V: 'box-shadow' 'none, 1px 2px' 0;
	call V: 'text-shadow' '1px 1px 2px black' '1px 1px 2px rgb(0, 0, 0)';
	call V: 'text-shadow' '1px 1px 2px 3px' 0;
	call V: 'transform' 'none' 'none';
	call V: 'transform' 'translate(10px, 20%) rotate(45deg) scale(2)' 'translate(10px, 20%) rotate(45deg) scale(2)';
	call V: 'transform' 'matrix(1, 0, 0, 1, 0, 0)' 'matrix(1, 0, 0, 1, 0, 0)';
	call V: 'transform' 'matrix(1, 0, 0, 1, 0)' 0;
	call V: 'transform' 'rotate(0)' 'rotate(0deg)';
	call V: 'transform' 'rotate(10px)' 0;
	call V: 'transform' 'nonsense(1)' 0;
	call V: 'transform' 'translateX(1px) none' 0;
	call V: 'transform-origin' 'left top' 'left top';
	call V: 'transform-origin' '50% 50% 10px' '50% 50% 10px';
	call V: 'transition-property' 'opacity, width' 'opacity, width';
	call V: 'transition-duration' '1s, 200ms' '1s, 200ms';
	call V: 'transition-duration' '-1s' 0;
	call V: 'transition-delay' '-1s' '-1s';
	call V: 'transition-timing-function' 'cubic-bezier(0.1, 0.2, 0.3, 0.4)' 'cubic-bezier(0.1, 0.2, 0.3, 0.4)';
	call V: 'transition-timing-function' 'steps(4, end)' 'steps(4, end)';
	call V: 'transition-timing-function' 'steps(0)' 0;
	call V: 'animation-iteration-count' 'infinite, 3' 'infinite, 3';
