	call V: 'font-weight' '700' '700';
	call V: 'font-weight' 'bolder' 'bolder';
	call V: 'font-weight' '0' 0;
	call V: 'font-weight' '1001' 0;
	call V: 'font-family' 'Arial' 'Arial';
	call V: 'font-family' '"Times New Roman", serif' '"Times New Roman", serif';
	call V: 'font-family' 'Times New Roman, serif' 'Times New Roman, serif';
	call V: 'font-family' 'Arial,' 0;
	call V: 'font-family' '1' 0;
	call V: 'line-height' '1.5' '1.5';
	call V: 'line-height' '0' '0';
	call V: 'line-height' '-1' 0;
	call V: 'line-height' 'normal' 'normal';
	call V: 'text-align' 'justify' 'justify';
	call V: 'text-indent' '5px hanging' '5px hanging';
	call V: 'white-space' 'pre-wrap' 'pre-wrap';
	call V: 'vertical-align' '-2px' '-2px';
