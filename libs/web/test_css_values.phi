	call E: 'transition' 'opacity 1s' 'transition-timing-function' 'ease';
	call E: 'transition' '1s 2s ease-in opacity' 'transition-delay' '2s';
	call E: 'transition' '1s 2s ease-in opacity' 'transition-timing-function' 'ease-in';
	call E: 'transition' 'a 1s, b 2s linear' 'transition-property' 'a, b';
	call E: 'transition' 'a 1s, b 2s linear' 'transition-duration' '1s, 2s';
	call E: 'transition' 'a 1s, b 2s linear' 'transition-timing-function' 'ease, linear';
	call E: 'transition' 'none' 'transition-property' 'none';
	call E: 'transition' '1s 2s 3s' 'transition-duration' 0;
	call E: 'animation' 'spin 1s infinite' 'animation-name' 'spin';
	call E: 'animation' 'spin 1s infinite' 'animation-iteration-count' 'infinite';
	call E: 'animation' 'spin 1s infinite' 'animation-direction' 'normal';
	call E: 'animation' 'spin 1s 2s ease-out alternate both paused' 'animation-fill-mode' 'both';
	call E: 'animation' 'spin 1s 2s ease-out alternate both paused' 'animation-play-state' 'paused';
	call E: 'animation' 'spin 1s 2s ease-out alternate both paused' 'animation-delay' '2s';
	call E: 'animation' 'a 1s, b 2s' 'animation-name' 'a, b';
	call E: 'grid-row' '1 / 3' 'grid-row-end' '3';
	call E: 'grid-row' '1' 'grid-row-end' 'auto';
	call E: 'grid-row' 'a' 'grid-row-end' 'a';
	call E: 'grid-column' 'span 2 / 4' 'grid-column-start' 'span 2';
	call E: 'grid-area' 'a' 'grid-column-end' 'a';
	call E: 'grid-area' '1 / 2 / 3 / 4' 'grid-column-end' '4';
	call E: 'grid-area' '1 / 2' 'grid-row-end' 'auto';
	call E: 'grid-area' 'a / b' 'grid-row-end' 'a';
	call E: 'grid-area' 'a / b' 'grid-column-end' 'b';
	call E: 'grid-area' '1 / 2 / 3 / 4 / 5' 'grid-row-start' 0;
	call E: 'grid-template' '100px / 1fr 2fr' 'grid-template-columns' '1fr 2fr';
	call E: 'grid-template' 'none' 'grid-template-rows' 'none';
	call E: 'grid-template' '"a b" 10px "c d" / 1fr 2fr' 'grid-template-areas' '"a b" "c d"';
	call E: 'grid-template' '"a b" 10px "c d" / 1fr 2fr' 'grid-template-rows' '10px auto';
	call E: 'grid-template' '"a b" 10px "c d" / 1fr 2fr' 'grid-template-columns' '1fr 2fr';
	call E: 'grid' 'auto-flow / 1fr 1fr' 'grid-auto-flow' 'row';
	call E: 'grid' 'auto-flow / 1fr 1fr' 'grid-template-columns' '1fr 1fr';
	call E: 'grid' '100px / auto-flow 50px' 'grid-auto-flow' 'column';
	call E: 'grid' '100px / auto-flow 50px' 'grid-auto-columns' '50px';
	call E: 'grid' '100px / 200px' 'grid-template-columns' '200px';
	call E: 'columns' '3' 'column-count' '3';
	call E: 'columns' '10px' 'column-width' '10px';
	call E: 'column-rule' '1px solid red' 'column-rule-style' 'solid';
	call E: 'font-variant' 'small-caps' 'font-variant-caps' 'small-caps';
	call E: 'margin-inline' '1px 2px' 'margin-right' '2px';
	call E: 'padding-block' '3px' 'padding-bottom' '3px';
	call E: 'margin-inline-start' '4px' 'margin-left' '4px';
	call E: 'inset-inline' '5px' 'right' '5px';
	call E: 'border-inline' '1px solid' 'border-right-style' 'solid';
	call E: 'margin' 'inherit' 'margin-top' 'inherit';
	call E: 'all' 'initial' 'color' 'initial';
	call E: 'all' 'unset' 'width' 'unset';
	call E: 'margin' 'var(--x)' 'margin-top' '';

	# ---- reading a whole block, and setting and removing
	call Block;

	# ---- number text
	call Num: 0.1 '0.1';
	call Num: 1.0 '1';
	call Num: 100.0 '100';
	call Num: 33.3333 '33.3333';
	call Num: 1234567.0 '1234567';
	call Num: 0.5 '0.5';
	call Num: -2.25 '-2.25';
	call Num: 0.000012 '0.000012';
	call Num: 1.0e-7 '1e-7';
	call Num: 1.0e20 '1e+20';

	log 'values: ' passed ' passed, ' failed ' failed\n';
	exit 0;

	int passed: 0;
	int failed: 0;

	[Say: ptr<u8> what: 0; bln ok: false;]
		if ok
			passed++;
		;;
		else
			failed++;
			log 'FAIL ' what '\n';
		;;
	[end]

	# property: value reads back as want; or with want 0, it's refused
	[V: ptr<u8> prop: 0; ptr<u8> value: 0; ptr<u8> want: 0;]
		call E: prop value prop want;
	[end]

	[E: ptr<u8> prop: 0; ptr<u8> value: 0; ptr<u8> read_prop: 0; ptr<u8> want: 0;]
		CssDecls d;
		bln ok: (Css.DeclSet: addr d prop (WlText.LenZ: prop) value (WlText.LenZ: value) false);
		WlBuf text;
		if ok
			if (Css.DeclGet: addr d read_prop (WlText.LenZ: read_prop) addr text) is false
				call text.AddZ: '(not there)';
			;;
		;;
		if ok is (want is not 0) and (ok is false or (WlText.EqZ: text.data text.len want))
			passed++;
		;;
		else
			failed++;
			log 'FAIL ' prop ': ' value ' -> ' read_prop ' want ';
			if want is 0
				log '(refused)';
			;;
			else
				log want;
			;;
			log ' got ';
			if ok is false
				log '(refused)';
			;;
			elif text.data is not 0
				log text.data;
			;;
			log '\n';
		;;
		call text.Free;
		call d.FreeItems;
	[end]

	[Num: f64 v: 0.0; ptr<u8> want: 0;]
		WlBuf text;
		call CssNum.Add: addr text v 7;
		if (WlText.EqZ: text.data text.len want)
			passed++;
		;;
		else
			failed++;
			log 'FAIL number want ' want ' got ' text.data '\n';
		;;
		call text.Free;
	[end]

	[Block]
		ptr<u8> source: 'color: red; margin: 1px 2px; width: bogus; --x: 1 ; height: 5px !important; color: blue; nonsense: 1; ;; { a:b } top: 1px; @foo bar; left: 2px';
		ptr<CssDecls> d: (Css.ParseInline: source (WlText.LenZ: source) 0);
		WlBuf text;
		call Css.DeclText: d addr text;
		ptr<u8> want: 'margin-top: 1px; margin-right: 2px; margin-bottom: 1px; margin-left: 2px; --x: 1; height: 5px !important; color: rgb(0, 0, 255); left: 2px;';
		call Say: 'block text' (WlText.EqZ: text.data text.len want);
		if (WlText.EqZ: text.data text.len want) is false
			log '  got ' text.data '\n';
		;;
		call Say: 'count' (Css.DeclCount: d) is 8;
		call Say: 'priority' (Css.DeclPriority: d 'height' 6);
		call Say: 'priority no' (Css.DeclPriority: d 'color' 5) is false;
		call Say: 'name' (WlText.EqZ: (Css.DeclName: d 0) 10 'margin-top');
		call text.Clear;
		call Say: 'shorthand reads' (Css.DeclGet: d 'margin' 6 addr text);
		call Say: 'margin text' (WlText.EqZ: text.data text.len '1px 2px');
		call text.Clear;
		call Say: 'partial shorthand' (Css.DeclGet: d 'padding' 7 addr text) is false;
		call Say: 'remove shorthand' (Css.DeclRemove: d 'margin' 6);
		call Say: 'gone' (Css.DeclCount: d) is 4;
		call Say: 'remove custom' (Css.DeclRemove: d '--x' 3);
		call Say: 'remove absent' (Css.DeclRemove: d 'top' 3) is false;
		# a later set replaces, and an invalid one changes nothing
		call Say: 'set' (Css.DeclSet: d 'color' 5 'lime' 4 false);
		call Say: 'set invalid' (Css.DeclSet: d 'color' 5 'xx' 2 false) is false;
		call text.Clear;
		call Css.DeclGet: d 'color' 5 addr text;
		call Say: 'after set' (WlText.EqZ: text.data text.len 'rgb(0, 255, 0)');
		call Say: 'semicolon refused' (Css.DeclSet: d 'top' 3 '1px; left: 2px' 14 false) is false;
		call Say: 'important refused in a value' (Css.DeclSet: d 'top' 3 '1px !important' 14 false) is false;
		call Say: 'important said separately' (Css.DeclSet: d 'top' 3 '1px' 3 true);
		call Say: 'priority set' (Css.DeclPriority: d 'top' 3);
		call Css.FreeDecls: d;
		call text.Free;

		# the element's style object: writes go to the attribute, and back
		ptr<DomDocument> doc: (Dom.NewDocument);
		ptr<DomNode> el: (Dom.CreateElementZ: doc 'div');
		call Dom.Append: doc.root el;
		call Dom.SetAttrZ: el 'style' 'color: red; width: 1px';
		WlBuf got;
		call Say: 'style get' (Css.StyleGet: el 'color' 5 addr got);
		call Say: 'style get text' (WlText.EqZ: got.data got.len 'rgb(255, 0, 0)');
		el.flags is 0;
		call Say: 'style set' (Css.StyleSet: el 'height' 6 '2px' 3 false);
		call Say: 'style set dirties' (el.flags & Dom.DIRTY_STYLE) is not 0;
		ptr<u8> attr_text: (Dom.AttrValue: el 'style');
		call Say: 'attribute written' (WlText.EqZ: attr_text (WlText.LenZ: attr_text) 'color: rgb(255, 0, 0); width: 1px; height: 2px;');
		call Say: 'style invalid' (Css.StyleSet: el 'height' 6 'xx' 2 false) is false;
		call Say: 'style remove' (Css.StyleRemove: el 'width' 5);
		call got.Clear;
		call Css.StyleText: el addr got;
		call Say: 'style text' (WlText.EqZ: got.data got.len 'color: rgb(255, 0, 0); height: 2px;');
		call Css.StyleSetText: el 'margin: 3px' 11;
		call got.Clear;
		call Css.StyleGet: el 'margin-left' 11 addr got;
		call Say: 'cssText set' (WlText.EqZ: got.data got.len '3px');
		call got.Clear;
		call Say: 'cleared by it' (Css.StyleGet: el 'color' 5 addr got) is false;
		call got.Free;
		ptr<CssDecls> own: el.inline_style as ptr<CssDecls>;
		call Css.FreeDecls: own;
		call Dom.FreeDocument: doc;
	[end]
}
