# Parsing and validating values: what each property takes, what it refuses, how shorthands expand,
# and how declarations read back as text. Expected answers written by hand.
use weblib;
use css.css;

phi.TestCssValues:Program
{
	call Weblib.Start: 900000;
	call Css.Start;

	# ---- every property in the table: its initial value is valid, and nonsense isn't
	u32 nonsense_ok: 0;
	WlBuf any_word;
	while u32 p: 0; p < CssP.LONGHANDS; p++;
		ptr<u8> name: (Css.PropertyName: p);
		u32 n: (WlText.LenZ: name);
		ptr<CssPropInfo> info: addr CssProps.info:p;
		call Say: name (Css.SupportsProperty: name n info.initial info.initial_len);
		call Say: name (Css.SupportsProperty: name n '1px 2 #fff "s" 3deg url(a) / , %' 32) is false;
		# some properties do take any word: they're the ones that name things
		if (Css.SupportsProperty: name n 'qqq' 3)
			if nonsense_ok > 0
				call any_word.Add: 32;
			;;
			call any_word.AddZ: name;
			nonsense_ok++;
		;;
	;;
	log 'properties taking any word: ' any_word.data '\n';
	call any_word.Free;

	# ---- longhands
	call V: 'display' 'block' 'block';
	call V: 'display' 'BLOCK' 'block';
	call V: 'display' 'inline flex' 'inline-flex';
	call V: 'display' 'block flow' 'block';
	call V: 'display' 'block flow-root' 'flow-root';
	call V: 'display' 'flow-root inline' 'inline-block';
	call V: 'display' '-webkit-box' 'flex';
	call V: 'display' 'flex flex' 0;
	call V: 'display' 'none block' 0;
	call V: 'display' 'nonsense' 0;
	call V: 'display' '1' 0;
	call V: 'position' 'sticky' 'sticky';
	call V: 'float' 'inline-start' 'inline-start';
	call V: 'width' '0' '0px';
	call V: 'width' '10px' '10px';
	call V: 'width' '-10px' 0;
	call V: 'width' '10' 0;
	call V: 'width' '50%' '50%';
	call V: 'width' 'auto' 'auto';
	call V: 'width' 'min-content' 'min-content';
	call V: 'width' 'fit-content(10px)' 'fit-content(10px)';
	call V: 'width' 'fit-content(red)' 0;
	call V: 'width' '10px 20px' 0;
	call V: 'width' 'calc(10px + 5%)' 'calc(5% + 10px)';
	call V: 'width' 'calc(10px + 5)' 0;
	call V: 'width' 'calc(10px +5px)' 0;
	call V: 'width' 'calc(10px*2)' '20px';
	call V: 'width' 'calc(1em + 1em)' '2em';
	call V: 'width' 'calc()' 0;
	call V: 'width' 'calc(1px / 0px)' 0;
	call V: 'width' 'calc(1px * 2px)' 0;
	call V: 'width' 'min(1px)' '1px';
	call V: 'width' 'clamp(1px, 2px)' 0;
	call V: 'max-width' 'none' 'none';
	call V: 'min-width' 'none' 0;
	call V: 'margin-top' '-5px' '-5px';
	call V: 'margin-top' 'auto' 'auto';
	call V: 'padding-top' '-5px' 0;
	call V: 'padding-top' 'auto' 0;
	call V: 'z-index' '3' '3';
	call V: 'z-index' '-3' '-3';
	call V: 'z-index' '1.5' 0;
	call V: 'z-index' 'auto' 'auto';
	call V: 'order' '1e2' 0;
	call V: 'opacity' '0.5' '0.5';
	call V: 'opacity' '50%' '50%';
	call V: 'opacity' 'none' 0;
	call V: 'color' 'red' 'rgb(255, 0, 0)';
	call V: 'color' 'RED' 'rgb(255, 0, 0)';
	call V: 'color' '#abc' 'rgb(170, 187, 204)';
	call V: 'color' '#abcd' 'rgba(170, 187, 204, 0.867)';
	call V: 'color' '#aabbcc' 'rgb(170, 187, 204)';
	call V: 'color' '#aabbcc80' 'rgba(170, 187, 204, 0.5)';
	call V: 'color' '#ab' 0;
	call V: 'color' '#abcde' 0;
	call V: 'color' '#gggggg' 0;
	call V: 'color' 'transparent' 'rgba(0, 0, 0, 0)';
	call V: 'color' 'currentcolor' 'currentcolor';
	call V: 'color' 'currentColor' 'currentcolor';
	call V: 'color' 'rgb(1, 2, 3)' 'rgb(1, 2, 3)';
	call V: 'color' 'rgb(1 2 3)' 'rgb(1, 2, 3)';
	call V: 'color' 'rgb(1 2 3 / 50%)' 'rgba(1, 2, 3, 0.5)';
	call V: 'color' 'rgba(1, 2, 3, 0.5)' 'rgba(1, 2, 3, 0.5)';
	call V: 'color' 'rgb(100%, 0%, 50%)' 'rgb(255, 0, 128)';
	call V: 'color' 'rgb(1, 2%, 3)' 0;
	call V: 'color' 'rgb(1 2, 3)' 0;
	call V: 'color' 'rgb(1, 2)' 0;
	call V: 'color' 'rgb(300, -5, 3)' 'rgb(255, 0, 3)';
	call V: 'color' 'hsl(120, 100%, 50%)' 'rgb(0, 255, 0)';
	call V: 'color' 'hsl(120deg 100% 50%)' 'rgb(0, 255, 0)';
	call V: 'color' 'hsla(0.5turn, 100%, 50%, 0.25)' 'rgba(0, 255, 255, 0.25)';
	call V: 'color' 'hsl(120, 100, 50)' 0;
	call V: 'color' 'hwb(0 0% 0%)' 'rgb(255, 0, 0)';
	call V: 'color' 'canvastext' 'rgb(0, 0, 0)';
	call V: 'color' 'notacolor' 0;
	call V: 'color' 'rgb(calc(1 + 1), 2, 3)' 'rgb(2, 2, 3)';
	call V: 'background-color' 'color-mix(in srgb, red, blue)' 'rgb(128, 0, 128)';
	call V: 'border-top-style' 'dashed' 'dashed';
	call V: 'border-top-width' 'thin' 'thin';
	call V: 'border-top-width' '-1px' 0;
	call V: 'font-size' 'medium' 'medium';
