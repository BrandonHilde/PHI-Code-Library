# The engine's own tests: each tests/js/NAME.js runs and what it logs is compared with NAME.out, which
# holds what a person checked it should say. Every fixture runs twice: normally, and with the
# collector running at every safepoint, which must make no difference at all.
#
#   test_js                  runs them all; prints pass or fail for each
#   test_js NAME             runs one, and prints what it logs (non-ASCII as \u escapes)
#   test_js +NAME            the same with the collector at every safepoint
#
# takes up to 900 seconds

use js.js;
use fs.fileinfo;

phi.TestJs:Program
{
	call Js.Start: 900000;
	src is new u8[ROOM];
	expected is new u8[ROOM];
	if src is 0 or expected is 0
		log 'out of memory\n';
		exit 1;
	;;
	ptr<u8> arg: (OS.Arguments);
	if arg is not 0 and arg:0 is not 0
		bln one_stressed: arg:0 is '+';
		if one_stressed
			arg is arg + 1;
		;;
		bln ok: (Run: arg one_stressed);
		call Escape;
		log out_text.data;
		if not ok
			log 'FAILED: ' why.data '\n';
		;;
		exit 0;
	;;
	FileInfo entries[256];
	int count: (OS.ListFolder: 'tests/js' addr entries:0 256);
	# by name, so the order doesn't depend on the system
	while int i: 0; i < count; i++;
		while int j: i + 1; j < count; j++;
			if (Before: addr entries:j.name addr entries:i.name)
				FileInfo t;
				t is entries:i;
				entries:i is entries:j;
				entries:j is t;
			;;
		;;
	;;
	int passed: 0;
	int failed: 0;
	while int k: 0; k < count; k++;
		ptr<u8> name: addr entries:k.name;
		u32 n: (WlText.LenZ: name);
		if n < 4 or not (WlText.EqZ: name + n - 3 3 '.js') continue;
		if (WlText.EqZ: name n 'shim262.js') continue;
		name:(n - 3) is 0;
		if (Check: name)
			passed++;
		;;
		else
			failed++;
		;;
	;;
	log passed ' passed, ' failed ' failed\n';
	exit 0;

	const u32 ROOM: 4000000;

	ptr<u8> src: 0;
	ptr<u8> expected: 0;
	WlBuf out_text;
	WlBuf why;

	[Before: ptr<u8> a: 0; ptr<u8> b: 0;]
		u32 i: 0;
		while a:i is b:i and a:i is not 0
			i++;
		;;
	[end: a:i < b:i]

	[Hook: ptr<u8> t: 0; u32 n: 0;]
		call out_text.AddN: t n;
		call out_text.Add: 10;
	[end]

	# non-ASCII as \uXXXX, so what's compared and printed is ASCII whatever the console's code page
	[Escape]
		WlBuf b;
		u32 i: 0;
		while i < out_text.len
			u32 c: out_text.data:i;
			if c < 128
				if c >= 32 or c is 10
					call b.Add: c as u8;
				;;
				else
					call AddU: addr b c;
				;;
				i++;
				continue;
			;;
			u32 cp: (JsOps.DecodeWtf8: out_text.data + i out_text.len - i);
			i++ JsOps.decoded_width;
			if cp >= 0x10000
				cp is cp - 0x10000;
				call AddU: addr b 0xD800 + (cp >> 10);
				call AddU: addr b 0xDC00 + (cp & 1023);
			;;
			else
				call AddU: addr b cp;
			;;
		;;
		call out_text.Clear;
		if b.len > 0
			call out_text.AddN: b.data b.len;
		;;
		call out_text.Reserve: 0;
		call b.Free;
	[end]

	[AddU: ptr<WlBuf> b: 0; u32 u: 0;]
		call b.AddZ: '\\u';
		ptr<u8> hex: '0123456789abcdef';
		call b.Add: hex:((u >> 12) & 15);
		call b.Add: hex:((u >> 8) & 15);
		call b.Add: hex:((u >> 4) & 15);
		call b.Add: hex:(u & 15);
	[end]

	# Runs a fixture in a runtime of its own, its output in out_text. It may end in an exception,
	# which is reported in what it says, and it's up to the .out file whether that's right.
	[Run: ptr<u8> name: 0; bln stress: false;]
		WlBuf path;
		call path.AddZ: 'tests/js/';
		call path.AddZ: name;
		call path.AddZ: '.js';
		int n: (OS.ReadFile: path.data src ROOM - 1);
		call path.Free;
		call why.Clear;
		call out_text.Clear;
		if n < 0
			call why.AddZ: 'no such fixture';
			call why.Reserve: 0;
			return false;
		;;
		ptr<JsRuntime> rt: (Js.New);
		rt.console_hook is addr Hook;
		call JsTestHost.Install;
		if stress
			call Js.SetStress: true;
		;;
		u64 result: (Js.Eval: src n as u32 name);
		if Js.failed
			call Report: Js.exception;
		;;
		call Js.RunJobs;
		if Js.failed
			call Report: Js.exception;
		;;
		call Js.SetStress: false;
		call Js.Free: rt;
		call why.Reserve: 0;
		call out_text.Reserve: 0;
	[end: true]

	[Report: u64 ex: 0;]
		call out_text.AddZ: 'UNCAUGHT ';
		JsTryState t;
		call Js.TryBegin: addr t;
		if call Js.TextOf: ex addr out_text throws err
			call Js.TryCatchAll: addr t err;
			call out_text.AddZ: 'something unprintable';
		;;
		call out_text.Add: 10;
	[end]

	[Check: ptr<u8> name: 0;]
		call Run: name false;
		call Escape;
		WlBuf normal;
		call normal.AddN: out_text.data out_text.len;
		call normal.Reserve: 0;
		WlBuf path;
		call path.AddZ: 'tests/js/';
		call path.AddZ: name;
		call path.AddZ: '.out';
		int n: (OS.ReadFile: path.data expected ROOM - 1);
		call path.Free;
		bln ok: true;
		if n < 0
			log 'fail ' name ': no .out file\n';
			ok is false;
		;;
		elif not (Same: normal.data normal.len expected n as u32)
			log 'fail ' name ': the output differs\n';
			ok is false;
		;;
		else
			call Run: name true;
			call Escape;
			if not (Same: out_text.data out_text.len normal.data normal.len)
				log 'fail ' name ': it differs under GC stress\n';
				ok is false;
			;;
		;;
		call normal.Free;
		if ok
			log 'pass ' name '\n';
		;;
	[end: ok]

	# the same bytes, not counting a return before a line feed in the file
	[Same: ptr<u8> a: 0; u32 an: 0; ptr<u8> b: 0; u32 bn: 0;]
		u32 i: 0;
		u32 j: 0;
		while i < an and j < bn
			if b:j is 13
				j++;
				continue;
			;;
			if a:i is not b:j return false;
			i++;
			j++;
		;;
	[end: i is an and j is bn]
}

# things only the tests need: reaching the collector from JS
phi.JsTestHost:Library
{
	u64 rooted: 0;
	bln root_registered: false;

	[Install]
		ptr<JsObj> g: JsRt.r.global;
		call Js.DefineNativeSafe: g 'gc' addr Gc 0;
		call Js.DefineNative: g 'gcCount' addr GcCount 0;
		call Js.DefineNative: g 'repeat' addr Repeat 2;
		call Js.DefineNative: g 'keepRooted' addr KeepRooted 1;
		call Js.DefineNative: g 'readRooted' addr ReadRooted 0;
		call JsDocExample.Install;
		rooted is JsV.UNDEF;
		call Js.AddRoot: addr rooted;
	[end]

	[Gc: ptr<u64> args: 0; int argc: 0;]
		call Js.Collect;
	[end: JsV.UNDEF]

	# repeat(text, n), with no safepoints in it, for making huge sources even under GC stress
	[Repeat: ptr<u64> args: 0; int argc: 0;]
		WlBuf t;
		call Js.TextOf: (Js.Arg: args argc 0) addr t;
		int n: (JsOps.ToInt32: (Js.Arg: args argc 1));
		WlBuf b;
		call b.Reserve: t.len * (n as u32);
		while int i: 0; i < n; i++;
			call b.AddN: t.data t.len;
		;;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
		call t.Free;
	[end: r]

	[GcCount: ptr<u64> args: 0; int argc: 0;]
	[end: (JsV.Uint: JsRt.r.collections)]

	[KeepRooted: ptr<u64> args: 0; int argc: 0;]
		rooted is (Js.Arg: args argc 0);
	[end: JsV.UNDEF]

	[ReadRooted: ptr<u64> args: 0; int argc: 0;]
	[end: rooted]
}

# The worked example from docs/JS-INTERNALS.md. Keep the two the same: tests/js/api_example.js runs
# this, so what the document says stays true.
struct.JsCounterData
{
	u64 label;            # a JS value this host object holds: its trace hook marks it
	f64 count;
}

phi.JsDocExample:Library
{
	ptr<JsClass> counter_class: 0;
	ptr<JsClass> live_class: 0;
	ptr<JsClass> weak_class: 0;
	ptr<JsClass> ephemeron_class: 0;
	int finalized_count: 0;
	ptr<JsObj> counter_proto: 0;

	[Install]
		ptr<JsObj> g: JsRt.r.global;
		# plain natives
		call Js.DefineNative: g 'sum' addr Sum 2;
		call Js.DefineNative: g 'makeList' addr MakeList 1;
		call Js.DefineNative: g 'shapeOf' addr ShapeOf 1;
		call Js.DefineNativeSafe: g 'callTwice' addr CallTwice 2;
		call Js.DefineNativeSafe: g 'callCatching' addr CallCatching 1;
		call Js.DefineNative: g 'crash' addr Crash 0;
		call Js.DefineNative: g 'finalized' addr Finalized 0;
		# a class with a payload
		if counter_class is 0
			counter_class is (JsObjs.NewClass: 'Counter');
			counter_class.trace is addr TraceCounter;
			counter_class.finalize is addr FreeCounter;
		;;
		counter_proto is (Js.NewObject);
		call Js.DefineClass: 'Counter' addr CounterCtor 1 counter_proto;
		call Js.DefineNative: counter_proto 'add' addr CounterAdd 1;
		call Js.DefineNative: counter_proto 'held' addr CounterHeld 0;
		call Js.DefineNativeSafe: counter_proto 'each' addr CounterEach 1;
		call Js.DefineGetter: counter_proto 'value' addr CounterGet addr CounterSet;
		call Js.DefineGetter: counter_proto 'label' addr LabelGet addr LabelSet;
		call JsDefineRootProto: counter_proto;
		# a live collection: hooks answer for indexes and length
		if live_class is 0
			live_class is (JsObjs.NewClass: 'Live');
			live_class.get is addr LiveGet;
			live_class.set is addr LiveSet;
			live_class.has_key is addr LiveHas;
			live_class.del is addr LiveDelete;
			live_class.get_own is addr LiveGetOwn;
			live_class.keys is addr LiveKeys;
		;;
		call Js.DefineClass: 'Live' addr LiveCtor 0 (Js.NewObject);
		# weak references
		if weak_class is 0
			weak_class is (JsObjs.NewClass: 'Weak');
			weak_class.weak_clear is addr WeakClear;
			weak_class.finalize is addr WeakFinal;
		;;
		ptr<JsObj> wp: (Js.NewObject);
		call Js.DefineClass: 'Weak' addr WeakCtor 1 wp;
		call Js.DefineNative: wp 'get' addr WeakGet 0;
		call JsDefineRootProto: wp;
		if ephemeron_class is 0
			ephemeron_class is (JsObjs.NewClass: 'Ephemeron');
			ephemeron_class.ephemeron is addr EphemeronMark;
			ephemeron_class.weak_clear is addr EphemeronClear;
		;;
		ptr<JsObj> ep: (Js.NewObject);
		call Js.DefineClass: 'Ephemeron' addr EphemeronCtor 0 ep;
		call Js.DefineNative: ep 'set' addr EphemeronSet 2;
		call Js.DefineNative: ep 'get' addr EphemeronGet 1;
		call Js.DefineNative: ep 'count' addr EphemeronCount 0;
		call JsDefineRootProto: ep;
	[end]

	# (the example's prototypes are in the runtime through their constructors, on the global)
	[JsDefineRootProto: ptr<JsObj> proto: 0;]
	[end]

	# ---- plain natives ----

	# reads its arguments, gives back a number
	[Sum: ptr<u64> args: 0; int argc: 0;]
		f64 total: 0.0;
		while int i: 0; i < argc; i++;
			total is total + (JsOps.ToNumber: args:i);
		;;
	[end: (JsV.Num: total)]

	# makes an array
	[MakeList: ptr<u64> args: 0; int argc: 0;]
		int n: (JsOps.ToInt32: (Js.Arg: args argc 0));
		ptr<JsObj> list: (Js.NewArray: 0);
		while int i: 0; i < n; i++;
			call Js.ArrayPush: list (JsV.Int: i * i);
		;;
	[end: (JsV.Obj: list)]

	# reads properties, makes an object, sets one
	[ShapeOf: ptr<u64> args: 0; int argc: 0;]
		u64 o: (Js.Arg: args argc 0);
		f64 w: (JsOps.ToNumber: (Js.GetProp: o 'w'));
		f64 h: (JsOps.ToNumber: (Js.GetProp: o 'h'));
		ptr<JsObj> result: (Js.NewObject);
		call Js.SetProp: (JsV.Obj: result) 'area' (JsV.Num: w * h);
	[end: (JsV.Obj: result)]

	# Calls back into JS, for as long as it likes. It's gc_safe (see where it's defined), so all it
	# holds across the calls is on the value stack: its arguments already are, and so is what it pushes.
	[CallTwice: ptr<u64> args: 0; int argc: 0;]
		u64 f: (Js.Arg: args argc 0);
		if not (JsOps.IsCallable: f)
			call JsErr.Type: 'callTwice needs a function';
		;;
		call Js.Push: (Js.Arg: args argc 1);
		u64 once: (Js.CallThrowing: f JsV.UNDEF 1);
		# `once` is only in a local here, so it goes on the stack before anything can collect
		call Js.Push: once;
		ptr<u64> held: JsVm.sp - 8;
		call Js.Push: once;
		u64 twice: (Js.CallThrowing: f JsV.UNDEF 1);
		held:0 is twice;
	[end: held:0]

	# catches what a call throws
	[CallCatching: ptr<u64> args: 0; int argc: 0;]
		u64 f: (Js.Arg: args argc 0);
		JsTryState t;
		call Js.TryBegin: addr t;
		u64 r: 0;
		if call r is Js.CallThrowing: f JsV.UNDEF 0 throws err
			u64 thrown: (Js.TryCatch: addr t err);
			return thrown;
		;;
	[end: r]

	[Crash: ptr<u64> args: 0; int argc: 0;]
		ptr<u32> nothing: 0;
		nothing:0 is 1;
	[end: JsV.UNDEF]

	[Finalized: ptr<u64> args: 0; int argc: 0;]
	[end: (JsV.Int: finalized_count)]

	# ---- a class with a payload ----

	[CounterCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		if not (JsV.IsObj: nt)
			call JsErr.Type: 'Counter needs new';
		;;
		ptr<JsCounterData> d: new JsCounterData;
		if d is 0
			throw 'out of memory';
		;;
		d.label is JsV.UNDEF;
		d.count is (JsOps.ToNumber: (Js.Arg: args argc 0));
		# subclasses work if the prototype comes from new.target
		ptr<JsObj> proto: (JsOps.ProtoFromCtor: nt counter_proto);
		ptr<JsObj> o: (JsObjs.NewHost: counter_class proto d as ptr<u8>);
	[end: (JsV.Obj: o)]

	# `this`, checked to be a Counter
	[ThisCounter: ptr<u64> args: 0;]
		u64 t: (Js.This: args);
		if (JsV.IsObj: t)
			ptr<JsObj> o: (JsV.AsObj: t);
			if o.cls is counter_class
				return o.data as ptr<JsCounterData>;
			;;
		;;
		call JsErr.Type: 'not a Counter';
	[end: 0 as ptr<JsCounterData>]

	[TraceCounter: ptr<JsObj> o: 0;]
		ptr<JsCounterData> d: o.data as ptr<JsCounterData>;
		call Js.Mark: d.label;
	[end]

	[FreeCounter: ptr<JsObj> o: 0;]
		free o.data;
		finalized_count++;
	[end]

	[CounterAdd: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
		if argc > 0
			if not (JsV.IsNum: args:0)
				call JsErr.Type: 'add needs a number';
			;;
			d.count is d.count + (JsV.AsNum: args:0);
		;;
	[end: (JsV.Num: d.count)]

	[CounterGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
	[end: (JsV.Num: d.count)]

	[CounterSet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
		d.count is (JsOps.ToNumber: (Js.Arg: args argc 0));
	[end: JsV.UNDEF]

	[LabelGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
	[end: d.label]

	[LabelSet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
		d.label is (Js.Arg: args argc 0);
	[end: JsV.UNDEF]

	[CounterHeld: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
	[end: d.label]

	# gc_safe: calls f(count, i) three times; the array it builds stays reachable on the stack
	[CounterEach: ptr<u64> args: 0; int argc: 0;]
		ptr<JsCounterData> d: (ThisCounter: args);
		u64 f: (Js.Arg: args argc 0);
		ptr<JsObj> list: (Js.NewArray: 3);
		call Js.Push: (JsV.Obj: list);
		while int i: 0; i < 3; i++;
			call Js.Push: (JsV.Num: d.count);
			call Js.Push: (JsV.Int: i);
			call Js.ArrayPush: list (Js.CallThrowing: f JsV.UNDEF 2);
		;;
	[end: (JsV.Obj: list)]

	# ---- a live collection: three items a hook makes up, kept nowhere ----

	[LiveCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		ptr<JsObj> proto: (JsOps.ProtoFromCtor: nt JsRt.P.object);
		ptr<JsObj> o: (JsObjs.NewHost: live_class proto 0);
	[end: (JsV.Obj: o)]

	# 1 means the hook answered, in result; 0 means carry on as for any object
	[LiveGet: ptr<JsObj> o: 0; u64 key: 0; u64 recv: 0; ptr<u64> result: 0;]
		if (JsObjs.IsIndexKey: key)
			u32 i: key as u32;
			if i < 3
				WlBuf b;
				call b.AddZ: 'item ';
				call b.AddInt: i as int;
				result:0 is (Js.NewString: b.data b.len);
				call b.Free;
				return 1;
			;;
			# past the end: nothing there, and not on the prototype either
			result:0 is JsV.UNDEF;
			return 1;
		;;
		if (key & JsV.PTR_MASK) as ptr<JsStr> is JsRt.A.length
			result:0 is (JsV.Int: 3);
			return 1;
		;;
	[end: 0]

	# 1 done, -1 refused, 0 carry on as for any object
	[LiveSet: ptr<JsObj> o: 0; u64 key: 0; u64 v: 0; u64 recv: 0;]
		if (JsObjs.IsIndexKey: key) return -1;
	[end: 0]

	# 1 it's there, -1 it isn't, 0 carry on
	[LiveHas: ptr<JsObj> o: 0; u64 key: 0;]
		if (JsObjs.IsIndexKey: key)
			if (key as u32) < 3 return 1;
			return -1;
		;;
	[end: 0]

	[LiveDelete: ptr<JsObj> o: 0; u64 key: 0;]
		if (JsObjs.IsIndexKey: key) return -1;
	[end: 0]

	[LiveGetOwn: ptr<JsObj> o: 0; u64 key: 0; ptr<JsDesc> d: 0;]
		if (JsObjs.IsIndexKey: key)
			if (key as u32) < 3
				u64 v: 0;
				call LiveGet: o key JsV.UNDEF addr v;
				d.value is v;
				d.flags is JsObjs.E;
				return 1;
			;;
			return -1;
		;;
	[end: 0]

	[LiveKeys: ptr<JsObj> o: 0; ptr<JsObj> keys: 0;]
		call Js.ArrayPush: keys (JsV.Str: (JsStrs.InternZ: '0'));
		call Js.ArrayPush: keys (JsV.Str: (JsStrs.InternZ: '1'));
		call Js.ArrayPush: keys (JsV.Str: (JsStrs.InternZ: '2'));
		# ... and whatever's ordinarily on it
		ptr<JsProp> p: o.props;
		while u32 i: 0; i < o.count; i++;
			if p:i.key is not 0
				call Js.ArrayPush: keys (JsObjs.PtrToValue: p:i.key);
			;;
		;;
	[end]

	# ---- weak references ----

	# Weak(obj): o.slot would keep it alive, so it's kept in data instead, as a value on the heap
	[WeakCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		ptr<u64> cell: new u64;
		if cell is 0
			throw 'out of memory';
		;;
		cell:0 is (Js.Arg: args argc 0);
		ptr<JsObj> o: (JsObjs.NewHost: weak_class (JsOps.ProtoFromCtor: nt JsRt.P.object) cell as ptr<u8>);
	[end: (JsV.Obj: o)]

	[WeakClear: ptr<JsObj> o: 0;]
		ptr<u64> cell: o.data as ptr<u64>;
		if not (Js.IsMarked: cell:0)
			cell:0 is JsV.UNDEF;
		;;
	[end]

	[WeakFinal: ptr<JsObj> o: 0;]
		free o.data;
		finalized_count++;
	[end]

	[WeakGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (JsV.AsObj: (Js.This: args));
		ptr<u64> cell: o.data as ptr<u64>;
		if (JsV.IsObj: cell:0)
			return (Js.GetProp: cell:0 'v');
		;;
	[end: cell:0]

	# ---- an ephemeron table: a value's kept only while its key is alive ----

	# pairs in an ordinary heap block: [count, key, value, key, value ...]
	[EphemeronCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		ptr<u64> t: new u64[65];
		if t is 0
			throw 'out of memory';
		;;
		ptr<JsObj> o: (JsObjs.NewHost: ephemeron_class (JsOps.ProtoFromCtor: nt JsRt.P.object) t as ptr<u8>);
	[end: (JsV.Obj: o)]

	[EphemeronMark: ptr<JsObj> o: 0;]
		ptr<u64> t: o.data as ptr<u64>;
		int found: 0;
		u32 n: t:0 as u32;
		while u32 i: 0; i < n; i++;
			u64 key: t:(1 + i * 2);
			u64 value: t:(2 + i * 2);
			if (Js.IsMarked: key) and not (Js.IsMarked: value)
				call Js.Mark: value;
				found++;
			;;
		;;
	[end: found]

	[EphemeronClear: ptr<JsObj> o: 0;]
		ptr<u64> t: o.data as ptr<u64>;
		u32 n: t:0 as u32;
		u32 kept: 0;
		while u32 i: 0; i < n; i++;
			if (Js.IsMarked: t:(1 + i * 2))
				t:(1 + kept * 2) is t:(1 + i * 2);
				t:(2 + kept * 2) is t:(2 + i * 2);
				kept++;
			;;
		;;
		t:0 is kept;
	[end]

	[EphemeronSet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (JsV.AsObj: (Js.This: args));
		ptr<u64> t: o.data as ptr<u64>;
		u32 n: t:0 as u32;
		if n >= 32
			call JsErr.Range: 'the example only holds 32';
		;;
		t:(1 + n * 2) is (Js.Arg: args argc 0);
		t:(2 + n * 2) is (Js.Arg: args argc 1);
		t:0 is n + 1;
	[end: JsV.UNDEF]

	[EphemeronGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (JsV.AsObj: (Js.This: args));
		ptr<u64> t: o.data as ptr<u64>;
		u32 n: t:0 as u32;
		while u32 i: 0; i < n; i++;
			if t:(1 + i * 2) is (Js.Arg: args argc 0)
				return t:(2 + i * 2);
			;;
		;;
	[end: JsV.UNDEF]

	[EphemeronCount: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (JsV.AsObj: (Js.This: args));
		ptr<u64> t: o.data as ptr<u64>;
	[end: (JsV.Int: t:0 as int)]
}
