# <canvas>: a page that draws on one, and what its pixels became, through getImageData and the
# browser's own view of them. Text, pictures and PNG files come from a pretend browser here: each
# character is a box 0.6 of the font size wide and 0.7 tall, the <img> is 2 by 2, and a "PNG" is
# four bytes.
use vectorlib;
use weblib;

phi.TestCanvas:Program
{
	u32 picture[4];

	call Weblib.Start: 900000;
	picture:0 is 0xFFFF0000;
	picture:1 is 0xFF00FF00;
	picture:2 is 0xFF0000FF;
	picture:3 is 0xFFFFFFFF;
	PageHost host;
	host.load is addr Load;
	host.logger is addr Print;
	host.canvas_text is addr CanvasText;
	host.image_pixels is addr ImagePixels;
	host.encode_png is addr EncodePng;
	int size: (OS.FileSize: 'tests/page/canvas1.html');
	if size < 0
		log 'no test page\n';
		exit 1;
	;;
	ptr<u8> html: new u8[size + 1];
	int got: (OS.ReadFile: 'tests/page/canvas1.html' html size);
	ptr<Page> page: (Page.New: addr host 800.0 600.0);
	call Page.Load: page html got as u32 'http://test.example/canvas.html';
	call Page.Tick: page 5.0;
	# what a browser would paint: the second canvas's pixels
	ptr<DomNode> d: (Css.Query: page.doc.root '#d' 2);
	ptr<PageCanvasCtx> c: (PageCanvas.Of: d);
	if c is 0
		log 'the second canvas has no pixels\n';
	;;
	else
		u32 sum: 0;
		while int i: 0; i < c.w * c.h; i++;
			sum is sum * 31 + c.pixels:i;
		;;
		log 'second canvas: ' c.w 'x' c.h ', pixels sum to ' sum '\n';
	;;
	call Page.Free: page;
	log 'done\n';
	exit 0;

	[Print: ptr<Page> p: 0; ptr<u8> text: 0; u32 n: 0; int level: 0;]
		log text '\n';
	[end]

	[Load: ptr<Page> p: 0; ptr<u8> url: 0; PageLoad kind: PageLoad.DOCUMENT; u32 id: 0;]
		call Page.Delivered: p id 404 0 0;
	[end]

	[CanvasText: ptr<Page> p: 0; ptr<u8> font: 0; ptr<u8> text: 0; u32 n: 0; ptr<VgPath> outline: 0; ptr<f64> size: 0; : bln]
		f64 em: 10.0;
		size:0 is n * em * 0.6;
		size:1 is em * 0.8;
		size:2 is em * 0.2;
		if outline is not 0
			while u32 i: 0; i < n; i++;
				call outline.Rect: i * em * 0.6 + em * 0.05 0.0 - em * 0.7 em * 0.5 em * 0.7;
			;;
		;;
	[end: true]

	[ImagePixels: ptr<Page> p: 0; ptr<DomNode> n: 0; ptr<PageBitmap> into_: 0; : bln]
		into_.pixels is addr picture:0;
		into_.w is 2;
		into_.h is 2;
	[end: true]

	[EncodePng: ptr<Page> p: 0; ptr<u32> pixels: 0; int w: 0; int h: 0; ptr<WlBuf> b: 0; : bln]
		call b.Add: 0x89;
		call b.AddZ: 'PNG';
	[end: true]
}
