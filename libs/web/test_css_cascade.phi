	# ---- inheritance
	call Setup: 'html(body(div#o(div#m(div#i span#s))))'
		'#o { color: red; font-size: 20px; line-height: 1.5; margin-top: 7px; background-color: blue; visibility: hidden; text-align: right; } #m { font-size: 2em; border-top: 1px solid; } #i { margin-top: inherit; background-color: inherit; color: initial; visibility: unset; border-top-width: inherit; width: inherit; } #s { font-size: 50%; line-height: inherit; }';
	call C: 'm' 'color' 'rgb(255, 0, 0)';
	call C: 'm' 'font-size' '40px';
	call C: 'm' 'margin-top' '0px';
	call C: 'm' 'background-color' 'rgba(0, 0, 0, 0)';
	call C: 'm' 'text-align' 'right';
	call C: 'm' 'line-height' '1.5';
	call C: 'm' 'border-top-color' 'rgb(255, 0, 0)';
