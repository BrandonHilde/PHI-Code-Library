	call Setup: 'html(body(h1#a p#b.x div#c(p#d)))'
		'h1 { font-size: 50px; font-weight: 100; display: inline; } #a { font-size: revert; display: revert; font-weight: revert; } .x { margin-top: 100px; margin-top: revert; } #c { color: red; } #d { color: unset; margin-top: unset; }';
	call C: 'a' 'font-size' '32px';
	call C: 'a' 'display' 'block';
