	call C: 'a1' 'color' 'rgb(0, 0, 238)';
	call C: 'a2' 'color' 'rgb(0, 0, 0)';
	call C: 'h' 'font-family' 'serif';
	call C: 'hr' 'border-top-width' '1px';
	call Finish;

	# ---- order: specificity, source order, !important, inline
	call Setup: 'html(body(p#a.x.y p#b.x[style=color:blue;margin-left:1px] p#c[style=color:blue] p#d.x[style=color:blue!important] div#e.z))'
		'p { color: red; margin-top: 1px; } p { color: green; } .x { color: orange; } .x.y { color: purple; } #a { margin-top: 5px; } p.x { color: teal; } p#c { color: lime !important; } .x { color: navy !important; } .z { width: 10px; width: bogus; height: 1px; height: calc(1px + 2px); }';
	call C: 'a' 'color' 'rgb(0, 0, 128)';
	call C: 'a' 'margin-top' '5px';
	call C: 'b' 'color' 'rgb(0, 0, 128)';
	call C: 'b' 'margin-left' '1px';
	call C: 'c' 'color' 'rgb(0, 255, 0)';
	call C: 'd' 'color' 'rgb(0, 0, 255)';
	call C: 'e' 'width' '10px';
	call C: 'e' 'height' '3px';
	call Finish;

	# specificity decides before order, order only ties
	call Setup: 'html(body(p#a.x))' '#a { color: red } p.x { color: green } p { color: blue } .x { margin-top: 1px } p { margin-top: 2px } :where(#a) { margin-left: 1px } p { margin-left: 2px } :is(#a) { padding-left: 1px } .x.x.x.x { padding-left: 2px }';
	call C: 'a' 'color' 'rgb(255, 0, 0)';
