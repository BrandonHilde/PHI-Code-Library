	# a value that grows too big by substitution is invalid, not out of memory
	WlBuf many;
	call many.AddZ: '#a { --v0: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx; ';
	while int i: 1; i < 40; i++;
		call many.AddZ: '--v';
		call many.AddInt: i;
		call many.AddZ: ': var(--v';
		call many.AddInt: i - 1;
		call many.AddZ: ') var(--v';
		call many.AddInt: i - 1;
		call many.AddZ: '); ';
	;;
	call many.AddZ: 'width: var(--v39, 5px); height: var(--v2, 6px); }';
	call Setup: 'html(body(div#a))' many.data;
	call C: 'a' 'width' '5px';
	call C: 'a' 'height' 'auto';
	call Finish;
	call many.Free;

	# ---- @media, with the viewport changing
	call Setup: 'html(body(div#a))'
		'@media (min-width: 500px) { #a { width: 1px; } } @media (max-width: 499px) { #a { width: 2px; } } @media print { #a { height: 1px; } } @media screen { #a { height: 2px; } } @media not print { #a { margin-top: 3px; } } @media not screen { #a { margin-top: 4px; } } @media (orientation: landscape) { #a { margin-left: 1px; } } @media (orientation: portrait) { #a { margin-left: 2px; } } @media (prefers-color-scheme: dark) { #a { color: white; } } @media (400px <= width <= 700px) { #a { top: 1px; } } @media (width > 700px) { #a { top: 2px; } } @media screen and (min-width: 100px) and (max-width: 10000px) { #a { left: 1px; } } @media (nonsense) { #a { right: 1px; } } @media not (nonsense) { #a { bottom: 1px; } } @media (min-width: 1000px), print { #a { padding-top: 1px; } } @media ((min-width: 1px) or (nonsense)) and (not (max-width: 1px)) { #a { padding-left: 1px; } } @media all { @media (min-width: 1px) { #a { padding-right: 1px; } } } @media foo { #a { padding-bottom: 1px; } } @media { #a { z-index: 1; } } @media 1 + 1 { #a { order: 1; } } @media screen, 1 { #a { order: 2; } }';
	call e.SetViewport: 800.0 600.0;
