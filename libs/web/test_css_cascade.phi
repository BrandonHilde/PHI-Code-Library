	# ---- @supports
	call Setup: 'html(body(div#a))'
		'@supports (display: flex) { #a { top: 1px; } } @supports (display: nonsense) { #a { top: 2px; } } @supports (nonsense: 1) { #a { top: 3px; } } @supports not (display: nonsense) { #a { left: 1px; } } @supports (display: flex) and (color: red) { #a { right: 1px; } } @supports (display: nonsense) or (color: red) { #a { bottom: 1px; } } @supports selector(a > b) { #a { margin-top: 1px; } } @supports selector(a:nosuch) { #a { margin-top: 2px; } } @supports (--x: 1) { #a { margin-left: 1px; } } @supports (width: calc(1px + 1%)) { #a { margin-right: 1px; } } @supports (width: var(--x)) { #a { margin-bottom: 1px; } } @supports (display: flex) and (color: red) or (top: 0) { #a { padding-top: 1px; } } @supports display: flex { #a { padding-left: 1px; } } @supports ((display: flex)) { #a { padding-right: 1px; } } @supports (color: red !important) { #a { padding-bottom: 1px; } } @supports (color: rgb(1 2 3 / 50%)) { #a { z-index: 1; } }';
