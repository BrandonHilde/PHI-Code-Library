	call C: 'd' 'top' '80px';
	call C: 'd' 'right' '60px';
	call C: 'd' 'bottom' '60px';
	call C: 'd' 'left' '80px';
	call C: 'e' 'width' '50%';
	call C: 'e' 'height' 'auto';
	call C: 'e' 'min-width' '0px';
	call C: 'e' 'max-width' 'none';
	call C: 'e' 'margin-left' 'auto';
	call C: 'e' 'font-size' '30px';
	call C: 'e' 'letter-spacing' '3px';
	call C: 'e' 'text-indent' '5%';
	call C: 'e' 'line-height' '45px';
	call C: 's' 'line-height' '40px';
	call C: 's' 'word-spacing' 'normal';
	call C: 's' 'vertical-align' '10%';
	call C: 's' 'opacity' '0.5';
	call C: 's' 'z-index' '7';
	call C: 's' 'flex-grow' '2.5';
	call Typed;
	call Finish;

	# ---- calc
	call Setup: 'html(body(div#a))'
		'#a { font-size: 10px; width: calc(1in + 4px); height: calc(10% + 2em); margin-top: calc(2 * 3px); margin-right: calc(10px / 2); margin-bottom: calc((1px + 2px) * 2); margin-left: min(10px, 20px); padding-top: max(1px, 2px, 3px); padding-right: clamp(1px, 5px, 3px); padding-bottom: calc(-5px); padding-left: min(10px, 50%); top: calc(1em - 1em); right: calc(100% - 10px); opacity: calc(1 / 2); z-index: calc(1 + 2); line-height: calc(1 + 0.5); rotate: calc(45deg + 45deg); transition-duration: calc(1s + 500ms); bottom: calc(1px + calc(2px + 3px)); left: calc(1vw); } #a { flex-grow: calc(1px); flex-shrink: calc(1 + 1px); order: calc(1.5); column-width: calc(1% + 1px); }';
	call C: 'a' 'width' '100px';
	call C: 'a' 'height' 'calc(10% + 20px)';
	call C: 'a' 'margin-top' '6px';
	call C: 'a' 'margin-right' '5px';
	call C: 'a' 'margin-bottom' '6px';
	call C: 'a' 'margin-left' '10px';
	call C: 'a' 'padding-top' '3px';
	call C: 'a' 'padding-right' '3px';
	call C: 'a' 'padding-bottom' '0px';
	call C: 'a' 'padding-left' 'min(10px, 50%)';
	call C: 'a' 'top' '0px';
	call C: 'a' 'right' 'calc(100% - 10px)';
	call C: 'a' 'opacity' '0.5';
