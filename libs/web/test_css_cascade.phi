	call C: 'bs' 'border-top-width' '0px';
	call C: 'bs' 'border-left-width' '5px';
	call C: 'bs' 'border-right-width' '0px';
	call C: 'bs' 'outline-width' '7px';
	call C: 'fi' 'display' 'flex';
	call C: 'c1' 'display' 'contents';
	call Finish;

	# ---- pseudo-elements
	call Setup: 'html(body(div#a[data-t=hi] div#b p#c))'
		'#a::before { content: "<" attr(data-t) ">" attr(nope, "!"); color: red; font-size: 2em; display: block; } #a::after { content: none; } #a { font-size: 10px; } #b:before { width: 1px; } p::first-line { color: blue; } p::first-letter { color: green; } p::selection { color: pink; }';
	call Pseudos;
	call Finish;

	# ---- presentational attributes
	call Setup: 'html(body[bgcolor=red][text=blue](img#i[width=100][height=50%][hspace=3] table#t[border=2][width=80%][cellspacing=4][align=center](tbody(tr(td#d[bgcolor=#00ff00][align=right][valign=top]))) font#f[color=green][face=Arial] div#s[align=center][width=9] img#o[width=5][style=width:7px]))'
		'#o { height: 1px; }';
	ptr<DomNode> body: (Dom.Body: doc);
	call Node: body 'background-color' 'rgb(255, 0, 0)';
	call Node: body 'color' 'rgb(0, 0, 255)';
	call C: 'i' 'width' '100px';
	call C: 'i' 'height' '50%';
	call C: 'i' 'margin-left' '3px';
	call C: 't' 'border-top-width' '2px';
	call C: 't' 'width' '80%';
	call C: 't' 'border-spacing' '4px';
	call C: 't' 'margin-left' 'auto';
	call C: 'd' 'background-color' 'rgb(0, 255, 0)';
	call C: 'd' 'text-align' 'right';
	call C: 'd' 'vertical-align' 'top';
	call C: 'f' 'color' 'rgb(0, 128, 0)';
	call C: 'f' 'font-family' 'Arial';
	call C: 's' 'text-align' 'center';
	call C: 's' 'width' 'auto';
	call C: 'o' 'width' '7px';
	call Finish;

	# ---- dynamic: what's dirty is recomputed, what isn't keeps its very style
	call Setup: 'html(body(div#p.a(div#k span#ks) div#sib div#other))' '.a { color: red; } .b { color: blue; } .a #k { width: 1px; } .b #k { width: 2px; } #sib { height: 1px; } .a + #sib { height: 2px; } [data-on] { margin-top: 1px; } li:first-child { top: 1px; } li:last-child { left: 1px; }';
	ptr<DomNode> pn: (Id: 'p');
	ptr<DomNode> other: (Id: 'other');
	ptr<u8> other_style: other.style;
	call C: 'k' 'color' 'rgb(255, 0, 0)';
	call C: 'k' 'width' '1px';
	call C: 'sib' 'height' '2px';
	u32 v0: doc.version;
	call e.Update;
	call Say: 'no change, no version change' doc.version is v0;
	call Dom.SetAttrZ: pn 'class' 'b';
	call e.Update;
	call C: 'p' 'color' 'rgb(0, 0, 255)';
	call C: 'k' 'color' 'rgb(0, 0, 255)';
	call C: 'k' 'width' '2px';
	call C: 'sib' 'height' '1px';
	call Dom.SetAttrZ: other 'data-on' '';
	call e.Update;
	call C: 'other' 'margin-top' '1px';
	call Dom.RemoveAttr: other (WlAtoms.GetZ: 'data-on');
	call e.Update;
	call C: 'other' 'margin-top' '0px';
	# the style attribute, written by hand
	call Dom.SetAttrZ: other 'style' 'margin-top: 5px';
	call e.Update;
	call C: 'other' 'margin-top' '5px';
	call Dom.SetAttrZ: other 'style' 'margin-top: 6px';
	call e.Update;
	call C: 'other' 'margin-top' '6px';
	call Dom.RemoveAttr: other (WlAtoms.GetZ: 'style');
	call e.Update;
	call C: 'other' 'margin-top' '0px';
	# new elements, and positions that change as they come
	ptr<DomNode> list: (Dom.CreateElementZ: doc 'ul');
	call Dom.Append: (Dom.Body: doc) list;
	ptr<DomNode> li1: (Dom.CreateElementZ: doc 'li');
	call Dom.Append: list li1;
	call Dom.SetAttrZ: li1 'id' 'li1';
	call e.Update;
	call C: 'li1' 'top' '1px';
	call C: 'li1' 'left' '1px';
	ptr<DomNode> li2: (Dom.CreateElementZ: doc 'li');
	call Dom.Append: list li2;
	call Dom.SetAttrZ: li2 'id' 'li2';
	call e.Update;
	call C: 'li1' 'left' 'auto';
	call C: 'li2' 'top' 'auto';
	call C: 'li2' 'left' '1px';
	call Dom.Remove: li2;
	call e.Update;
	call C: 'li1' 'left' '1px';
	# moved under another parent, it inherits from there
	call Dom.SetAttrZ: li2 'style' 'width: 3px';
	call Dom.Append: pn li2;
	call e.Update;
	call C: 'li2' 'color' 'rgb(0, 0, 255)';
	call C: 'li2' 'width' '3px';
	# a sheet added and taken away
	ptr<CssSheet> extra: (Css.ParseSheet: '#k { color: lime; }' 19 0);
	call e.AddSheet: extra;
	call e.Update;
	call C: 'k' 'color' 'rgb(0, 255, 0)';
	call e.RemoveSheet: extra;
	call e.Update;
	call C: 'k' 'color' 'rgb(0, 0, 255)';
	call Css.FreeSheet: extra;
	# hover, through the host
	ptr<CssSheet> hv: (Css.ParseSheet: '#k:hover { color: pink; }' 25 0);
	call e.AddSheet: hv;
	call e.Update;
	CssSel.on_state is addr HoverK;
	call e.MarkDirty: (Id: 'k');
	call e.Update;
	call C: 'k' 'color' 'rgb(255, 192, 203)';
	CssSel.on_state is 0;
	call e.MarkDirty: (Id: 'k');
	call e.Update;
	call C: 'k' 'color' 'rgb(0, 0, 255)';
	call e.RemoveSheet: hv;
	call Css.FreeSheet: hv;
	call Finish;

	# ---- sharing: 1000 elements alike are one style
	WlBuf big;
	call big.AddZ: 'html(body(div#w(';
	while int i: 0; i < 1000; i++;
		call big.AddZ: 'p.x ';
	;;
	call big.AddZ: ')))';
	call Setup: big.data '.x { color: red; margin: 1px; }';
	call big.Free;
	ptr<DomNode> w: (Id: 'w');
	ptr<DomNode> p1: (Dom.FirstElementChild: w);
	ptr<DomNode> p2: (Dom.NextElement: p1);
	call Say: 'siblings share a style' p1.style is p2.style;
	ptr<CssComputed> ws: p1.style as ptr<CssComputed>;
	call Say: 'an untouched group is shared with the initial style' ws.g:(CssP.G_BG) is CssStyles.initial.g:(CssP.G_BG);
	call Finish;

	# ---- @import, sync and async, and cycles
	imports is 0;
	call Setup2: 'html(body(div#a))' '@import "one.css"; @import url(two.css) screen; @import "three.css" print; @import "four.css" layer(l); @import "late.css" supports(display: nope); #a { color: red; } @import "ignored.css"; ' 'https://x.test/dir/main.css';
	call C: 'a' 'width' '1px';
	call C: 'a' 'height' '2px';
	call C: 'a' 'color' 'rgb(255, 0, 0)';
	call C: 'a' 'margin-top' '0px';
	call C: 'a' 'margin-left' '9px';
	call Say: 'imports asked' imports is 4;
	call Finish;

	# ---- @font-face and @keyframes, for the browser to read
	call FontsAndFrames;

	# ---- URLs
	call Url: 'http://a.test/b/c.css' 'd.png' 'http://a.test/b/d.png';
	call Url: 'http://a.test/b/c.css' '../d.png' 'http://a.test/d.png';
	call Url: 'http://a.test/b/c.css' './e/../d.png' 'http://a.test/b/d.png';
	call Url: 'http://a.test/b/c.css' '/d.png' 'http://a.test/d.png';
	call Url: 'http://a.test/b/c.css' '//z.test/d.png' 'http://z.test/d.png';
	call Url: 'http://a.test/b/c.css' 'https://q.test/x' 'https://q.test/x';
	call Url: 'http://a.test/b/c.css' 'data:image/png;base64,AAAA' 'data:image/png;base64,AAAA';
	call Url: 'http://a.test/b/c.css?q=1#f' 'd.png?x=1#y' 'http://a.test/b/d.png?x=1#y';
	call Url: 'http://a.test/b/c.css' '#frag' 'http://a.test/b/c.css#frag';
	call Url: 'http://a.test/b/c.css' '?q' 'http://a.test/b/c.css?q';
	call Url: 'http://a.test' 'd.png' 'http://a.test/d.png';
	call Url: 'http://a.test/b/c.css' '../../../d.png' 'http://a.test/d.png';
	call Url: 'http://a.test/b/' 'd/' 'http://a.test/b/d/';
	call Url: 'http://a.test/b/' '  d  ' 'http://a.test/b/d';

	log 'cascade: ' passed ' passed, ' failed ' failed\n';
	exit 0;

	ptr<DomDocument> doc: 0;
	ptr<CssEngine> e: 0;
	ptr<CssSheet> sheet: 0;
	int passed: 0;
	int failed: 0;
	int imports: 0;

	[Setup: ptr<u8> tree: 0; ptr<u8> css: 0;]
		call Setup2: tree css 0;
	[end]

	[Setup2: ptr<u8> tree: 0; ptr<u8> css: 0; ptr<u8> base: 0;]
		doc is (CssTestDom.Build: tree);
		e is (Css.NewEngine: doc);
		if e is 0
			log 'no engine: ' Css.error '\n';
			exit 1;
		;;
		e.on_import is addr OnImport;
		sheet is (Css.ParseSheet: css (WlText.LenZ: css) base);
		call e.AddSheet: sheet;
		if (e.Update) is false
			failed++;
			log 'FAIL Update: ' Css.error '\n';
		;;
	[end]

	[Finish]
		call e.Free;
		call Css.FreeSheet: sheet;
		call Dom.FreeDocument: doc;
	[end]

	[OnImport: ptr<CssEngine> eng: 0; ptr<CssImport> im: 0;]
		imports++;
		ptr<u8> url: im.url;
		u32 n: (WlText.LenZ: url);
		if (WlText.EqZ: url n 'https://x.test/dir/one.css')
			call Css.ImportDone: eng im '#a { width: 1px; }' 18;
		;;
		elif (WlText.EqZ: url n 'https://x.test/dir/two.css')
			call Css.ImportDone: eng im '@import "one.css"; #a { height: 2px; margin-left: 9px; }' 56;
		;;
		elif (WlText.EqZ: url n 'https://x.test/dir/four.css')
			call Css.ImportDone: eng im '#a { margin-left: 1px; }' 24;
		;;
		else
			log 'FAIL asked to import ' url '\n';
			failed++;
		;;
	[end]

	[HoverK: ptr<DomNode> n: 0; u32 what: 0;]
		if what is CssSel.ST_HOVER and n.id_atom is (WlAtoms.GetZ: 'k') return 1;
	[end: 0]

	[Id: ptr<u8> id: 0;]
	[end: (Dom.FindById: doc.root (WlAtoms.GetZ: id))]

	[Say: ptr<u8> what: 0; bln ok: false;]
		if ok
			passed++;
		;;
		else
			failed++;
			log 'FAIL ' what '\n';
		;;
	[end]

	[C: ptr<u8> id: 0; ptr<u8> prop: 0; ptr<u8> want: 0;]
		ptr<DomNode> n: (Id: id);
		if n is 0
			failed++;
			log 'FAIL no element ' id '\n';
			return;
		;;
		call Node: n prop want;
	[end]

	[Node: ptr<DomNode> n: 0; ptr<u8> prop: 0; ptr<u8> want: 0;]
		WlBuf text;
		bln ok: (Css.ComputedText: n prop (WlText.LenZ: prop) addr text);
		if ok and (WlText.EqZ: text.data text.len want)
			passed++;
		;;
		else
			failed++;
			ptr<WlAtom> id: n.id_atom;
			log 'FAIL ';
			if id is not 0
				log '#' id.text ' ';
			;;
			log prop ' want ' want ' got ';
			if text.data is not 0
				log text.data;
			;;
			log '\n';
		;;
		call text.Free;
	[end]

	[Absent: ptr<u8> id: 0; ptr<u8> prop: 0;]
		WlBuf text;
		bln ok: (Css.ComputedText: (Id: id) prop (WlText.LenZ: prop) addr text);
		call Say: prop ok is false;
		call text.Free;
	[end]

	# the getters a layout engine uses
	[Typed]
		ptr<CssComputed> s: (Css.StyleOf: (Id: 'e'));
		call Say: 'Len percent' (s.Len: CssP.WIDTH 200.0 -1.0) is 100.0;
		call Say: 'Len auto' (s.Len: CssP.HEIGHT 200.0 -1.0) is -1.0;
		call Say: 'IsAuto' (s.IsAuto: CssP.HEIGHT);
		call Say: 'IsAuto no' (s.IsAuto: CssP.WIDTH) is false;
		call Say: 'IsPercent' (s.IsPercent: CssP.WIDTH);
		call Say: 'Display' (s.Display) is CssK.BLOCK;
		call Say: 'FontPx' (s.FontPx) is 30.0;
		call Say: 'LineHeightPx' (s.LineHeightPx) is 45.0;
		call Say: 'MarginLeft auto' (s.MarginLeft: 100.0) is 0.0;
		ptr<CssComputed> t: (Css.StyleOf: (Id: 's'));
		call Say: 'ZIndex' (t.ZIndex) is 7;
		call Say: 'ZIndexAuto' (t.ZIndexAuto) is false;
		call Say: 'Opacity' (t.Opacity) is 0.5;
		call Say: 'Num' (t.Num: CssP.FLEX_GROW 0.0) is 2.5;
		call Say: 'Kw' (t.Kw: CssP.DISPLAY) is CssK.INLINE;
		call Say: 'TextColor' (t.TextColor) is 0x000000FF;
		call Say: 'Color currentcolor' (t.Color: CssP.BORDER_TOP_COLOR) is 0x000000FF;
		call Say: 'BackgroundColor' (t.BackgroundColor) is 0;
		call Say: 'FontWeight' (t.FontWeight) is 400.0;
		# a text node's style is its parent's
		ptr<DomNode> sn: (Id: 's');
		ptr<DomNode> txt: (Dom.CreateTextZ: doc 'x');
		call Dom.Append: sn txt;
		call Say: 'StyleOf a text node' (Css.StyleOf: txt) is t;
		call Dom.Remove: txt;
		call Say: 'StyleOf nothing' (Css.StyleOf: 0) is CssStyles.initial;
	[end]

	[CalcTyped]
		ptr<CssComputed> s: (Css.StyleOf: (Id: 'a'));
		call Say: 'calc resolved' (s.Len: CssP.HEIGHT 200.0 -1.0) is 40.0;
		call Say: 'min resolved low' (s.Len: CssP.PADDING_LEFT 10.0 -1.0) is 5.0;
		call Say: 'min resolved high' (s.Len: CssP.PADDING_LEFT 100.0 -1.0) is 10.0;
		call Say: 'calc is a percent' (s.IsPercent: CssP.HEIGHT);
		call Say: 'calc not auto' (s.IsAuto: CssP.HEIGHT) is false;
	[end]

	[Pseudos]
		ptr<DomNode> a: (Id: 'a');
		ptr<CssComputed> before: (Css.PseudoOf: a Css.PE_BEFORE);
		call Say: 'before exists' before is not 0;
		if before is 0 return;
		call Say: 'before size' (before.FontPx) is 20.0;
		call Say: 'before color' (before.TextColor) is 0xFF0000FF;
		call Say: 'before display' (before.Display) is CssK.BLOCK;
		call Say: 'before has content' (Css.HasContent: before);
		WlBuf text;
		call Css.ContentText: a before addr text;
		call Say: 'content text' (WlText.EqZ: text.data text.len '<hi>!');
		call text.Free;
		WlBuf ser;
		call CssSer.Computed: before CssP.CONTENT addr ser;
		call Say: 'content serialized' (WlText.EqZ: ser.data ser.len '"<" attr(data-t) ">" attr(nope, "!")');
		call ser.Free;
		ptr<CssComputed> after: (Css.PseudoOf: a Css.PE_AFTER);
		call Say: 'after none' after is not 0 and (Css.HasContent: after) is false;
		ptr<CssComputed> own: (Css.StyleOf: a);
		call Say: 'the element itself unaffected' (own.FontPx) is 10.0;
	[end]

	[FontsAndFrames]
		call Setup: 'html(body(div#a))' '@font-face { font-family: "My Font"; src: local(Foo Bar), url(a.woff2) format("woff2"), url("b.ttf"); font-weight: 100 900; font-style: italic; font-display: swap; unicode-range: U+26, u+0-7f, U+590-5ff, u+4??; } @font-face { font-family: Plain Name; src: url(c.woff); } @font-face { font-family: nosource; } @keyframes spin { from { transform: rotate(0deg); } 50%, 75% { opacity: 0.5; bogus: 1; } to { transform: rotate(1turn); } } @-webkit-keyframes other { 10% { top: 1px; } 200% { top: 2px; } } @media print { @font-face { font-family: printed; src: url(p.woff); } } @page { margin: 1cm; } @namespace svg url(http://www.w3.org/2000/svg); @charset "utf-8"; #a { width: 1px; }';
		call C: 'a' 'width' '1px';
		call Say: 'font-face count' e.face_count is 2;
		ptr<CssFontFace> f: e.faces:0;
		call Say: 'family' (WlText.EqZ: f.family (WlText.LenZ: f.family) 'My Font');
		call Say: 'weight low' f.weight_low is 100.0;
		call Say: 'weight high' f.weight_high is 900.0;
		call Say: 'style' f.style is CssK.ITALIC as u16;
		call Say: 'display' f.display is CssK.SWAP as u16;
		call Say: 'ranges' f.range_count is 4;
		call Say: 'range 0' f.ranges:0 is 0x26 and f.ranges:1 is 0x26;
		call Say: 'range 1' f.ranges:2 is 0 and f.ranges:3 is 0x7F;
		call Say: 'range 3' f.ranges:6 is 0x400 and f.ranges:7 is 0x4FF;
		ptr<CssFontSrc> s: f.src;
		call Say: 'src 0' s.is_local and (WlText.EqZ: s.url (WlText.LenZ: s.url) 'Foo Bar');
		s is s.next;
		call Say: 'src 1' s.is_local is false and (WlText.EqZ: s.url (WlText.LenZ: s.url) 'a.woff2') and (WlText.EqZ: s.format (WlText.LenZ: s.format) 'woff2');
		s is s.next;
		call Say: 'src 2' s.format is 0 and s.next is 0;
		ptr<CssFontFace> g: e.faces:1;
		call Say: 'family words' (WlText.EqZ: g.family (WlText.LenZ: g.family) 'Plain Name');
		call Say: 'keyframes count' e.frame_count is 2;
		ptr<CssKeyframes> set: e.frames:0;
		call Say: 'keyframes name' set.name is (WlAtoms.GetZ: 'spin');
		call Say: 'keyframes frames' set.count is 3;
		ptr<CssKeyframe> k: set.first;
		call Say: 'from' k.offset_count is 1 and k.offsets:0 is 0.0;
		k is k.next;
		call Say: 'list' k.offset_count is 2 and k.offsets:0 is 0.5 and k.offsets:1 is 0.75;
		call Say: 'its declarations' k.decls.count is 1;
		ptr<CssKeyframes> other: e.frames:1;
		call Say: 'bad keyframe dropped' other.count is 1;
		call Finish;
	[end]

	[Url: ptr<u8> base: 0; ptr<u8> rel: 0; ptr<u8> want: 0;]
		WlBuf b;
		call CssUrl.Join: base rel (WlText.LenZ: rel) addr b;
		if (WlText.EqZ: b.data b.len want)
			passed++;
		;;
		else
			failed++;
			log 'FAIL url ' base ' + ' rel ' want ' want ' got ' b.data '\n';
		;;
		call b.Free;
	[end]
}
