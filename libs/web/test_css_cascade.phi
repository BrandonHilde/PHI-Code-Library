	call C: 'a' 'height' '1px';
	call C: 'a' 'margin-top' '4px';
	call C: 'a' 'padding-top' '1px';
	call Say: 'matchMedia yes' (Css.MatchMedia: e '(min-width: 1000px)' 19);
	call Say: 'matchMedia no' (Css.MatchMedia: e '(min-width: 2000px)' 19) is false;
	call Finish;

	# vw units follow the viewport; only the viewport's going to change them
	call Setup: 'html(body(div#a))' '#a { width: 10vw; height: 10vh; }';
	call e.SetViewport: 1000.0 500.0;
	call e.Update;
	call C: 'a' 'width' '100px';
	call C: 'a' 'height' '50px';
	call e.SetViewport: 2000.0 100.0;
	call e.Update;
	call C: 'a' 'width' '200px';
	call C: 'a' 'height' '10px';
