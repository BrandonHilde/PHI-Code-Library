	call Finish;

	# ---- var()
	call Setup: 'html#h(body#b(div#a(div#c) div#d div#e div#f div#g))'
		'html { --main: red; --size: 10px; --empty:; --Case: 1px; } #a { color: var(--main); width: var(--size); height: calc(var(--size) * 2); margin: var(--size) 2px; background-color: var(--nope, blue); padding-top: var(--nope, var(--size)); padding-left: var(--nope); border-top: var(--size) solid var(--main); --local: var(--size) var(--main); --main: green; outline-color: var(--main); } #c { color: var(--main); --size: 3px; width: var(--size); --a: var(--b); --b: var(--a); height: var(--a, 5px); margin-top: var(--a); --self: var(--self); padding-top: var(--self, 9px); padding-bottom: var(--case, 8px); padding-right: var(--Case, 8px); } #d { width: 1px var(--size); height: var(--size) !important; height: 7px; font-size: var(--nope, 20px); --w: 2; line-height: var(--w); z-index: var(--w)var(--w); } #e { --x: initial; color: var(--main, purple); --main: initial; background-color: var(--main, purple); width: var(--empty) 4px; } #f { --big: 1px; --v: var(--big) var(--big); --u: var(--v) var(--v); margin: var(--big); transition: var(--nope, opacity) 1s; } #g { --c1: var(--c2, 1px); --c2: var(--c3, 2px); --c3: var(--c1, 3px); width: var(--c1, 40px); height: var(--c3, 50px); --ok: var(--c1, 60px); left: var(--ok); }';
	call C: 'a' 'color' 'rgb(0, 128, 0)';
	call C: 'a' 'width' '10px';
	call C: 'a' 'height' '20px';
	call C: 'a' 'margin-top' '10px';
	call C: 'a' 'margin-right' '2px';
	call C: 'a' 'margin-bottom' '10px';
	call C: 'a' 'background-color' 'rgb(0, 0, 255)';
	call C: 'a' 'padding-top' '10px';
	call C: 'a' 'padding-left' '0px';
	call C: 'a' 'border-top-width' '10px';
	call C: 'a' 'border-top-style' 'solid';
	call C: 'a' 'border-top-color' 'rgb(0, 128, 0)';
	call C: 'a' 'outline-color' 'rgb(0, 128, 0)';
