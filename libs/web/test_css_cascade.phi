# The cascade and computed values, with answers worked out by hand. Prints what's wrong and a count.
use weblib;
use css.css;
use css.testdom;

phi.TestCssCascade:Program
{
	call Weblib.Start: 900000;
	call Css.Start;

	# ---- the UA sheet
	call Setup: 'html#h(head#hd(title#ti style#st) body#b(div#d(p#p span#s("x") a#a1[href=u] a#a2) h1#h1 h2#h2 ul#u(li#l ol#o(li#l2)) table#t(tbody#tb(tr#tr(td#td th#th))) pre#pr b#bo i#it em#em strong#str code#co small#sm sub#su input#inp button#bt center#ce blockquote#bq hr#hr div#hid[hidden]))' '';
