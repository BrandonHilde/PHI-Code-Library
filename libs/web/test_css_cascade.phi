	call C: 'd' 'width' '40px';
	call C: 'd' 'height' '30px';
	call C: 'd' 'margin-top' '96px';
	call C: 'd' 'margin-right' '37.79528px';
	call C: 'd' 'margin-bottom' '1.333333px';
	call C: 'd' 'margin-left' '16px';
	call C: 'd' 'padding-top' '37.79528px';
	call C: 'd' 'padding-right' '3.779528px';
	call C: 'd' 'padding-bottom' '10px';
