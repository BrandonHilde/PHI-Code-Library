		'#f { float: left; } #ab { position: absolute; float: right; } #flex { display: flex; } #gr { display: inline-grid; } #ov { overflow-x: hidden; overflow-y: visible; } #bs { border: 5px none red; outline: 7px solid; border-left-style: solid; border-right-style: hidden; } #fi { display: inline-flex; float: left; } #c1 { display: contents; position: fixed; }';
