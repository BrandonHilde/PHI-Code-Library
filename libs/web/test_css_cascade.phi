	# ---- layers
	call Setup: 'html(body(div#a div#b[style=top:9px!important;left:9px] div#c))'
		'@layer one, two; @layer two { #a { color: red; margin-top: 2px !important; } } @layer one { #a { color: blue; width: 1px; margin-top: 1px !important; } } #a { width: 3px; height: 1px !important; } @layer two { #a { height: 2px !important; } } @layer one { #b { top: 1px !important; left: 1px !important; } } @layer outer { #c { color: red; } @layer inner { #c { color: blue; width: 7px; } } } @layer outer.inner { #c { width: 8px; } } @layer { #c { height: 1px; } } @layer { #c { height: 2px; } }';
