# Streams (platform.js): ReadableStream, WritableStream, TransformStream, pipeTo, pipeThrough, tee, async
# iteration, ReadableStream.from, TextEncoderStream and TextDecoderStream (a character split across
# chunks), Blob.stream, a Response with a stream body and Response.body, CompressionStream and
# DecompressionStream (gzip, deflate, deflate-raw: corelib's, through page/packing.phi) both ways, and
# bad data and a bad format refused; crypto.subtle.digest's SHA-1, SHA-256, SHA-384 and SHA-512 (MD5
# refused).
use weblib;

phi.TestStreams:Program
{
	call Weblib.Start: 900000;
	PageHost host;
	host.logger is addr Print;
	str html: '<!doctype html><body><script>var log = function (s) { console.log(s); };\nvar steps = [];\nfunction step(name, f) { steps.push([name, f]); }\nstep("read and close", function () {\n  var rs = new ReadableStream({ start: function (c) { c.enqueue("a"); c.enqueue("b"); c.close(); } });\n  var r = rs.getReader(), got = [];\n  log("locked " + rs.locked);\n  return r.read().then(function (x) { got.push(JSON.stringify(x)); return r.read(); }).then(function (x) { got.push(JSON.stringify(x)); return r.read(); })\n    .then(function (x) { got.push(JSON.stringify(x)); log(got.join(" ")); });\n});\nstep("pull and backpressure", function () {\n  var n = 0, desired = [];\n  var rs = new ReadableStream({ pull: function (c) { n++; desired.push(c.desiredSize); c.enqueue(n); if (n === 3) c.close(); } }, { highWaterMark: 2 });\n  return new Promise(function (r) { setTimeout(r, 0); }).then(function () {\n    log("pulled before reading: " + n + " (desired " + desired.join(",") + ")");\n    var rd = rs.getReader(), all = [];\n    function go() { return rd.read().then(function (x) { if (x.done) return; all.push(x.value); return go(); }); }\n    return go().then(function () { log("read " + all.join(",")); });\n  });\n});\nstep("error", function () {\n  var rs = new ReadableStream({ start: function (c) { c.error(new Error("boom")); } });\n  return rs.getReader().read().then(function () { log("no error?"); }, function (e) { log("rejected: " + e.message); });\n});\nstep("writable", function () {\n  var written = [];\n  var ws = new WritableStream({ write: function (chunk) { return new Promise(function (r) { setTimeout(function () { written.push(chunk); r(); }, 0); }); }, close: function () { written.push("closed"); } });\n  var w = ws.getWriter();\n  w.write(1); w.write(2);\n  return w.close().then(function () { log("written in order: " + written.join(",")); });\n});\nstep("pipeThrough a TransformStream, async iteration", function () {\n  var upper = new TransformStream({ transform: function (chunk, c) { c.enqueue(String(chunk).toUpperCase()); }, flush: function (c) { c.enqueue("!"); } });\n  var rs = ReadableStream.from(["one", "two"]).pipeThrough(upper);\n  var out = [];\n  return (async function () { for await (var x of rs) out.push(x); log("through: " + out.join(" ")); })();\n});\nstep("tee", function () {\n  var pair = ReadableStream.from([1, 2, 3]).tee();\n  return Promise.all([new Response(pair[0].pipeThrough(new TransformStream({ transform: function (c, k) { k.enqueue(String(c)); } })).pipeThrough(new TextEncoderStream())).text(), (async function () { var s = 0; for await (var v of pair[1]) s += v; return s; })()])\n    .then(function (r) { log("tee: text \'" + r[0] + "\', sum " + r[1]); });\n});\nstep("text streams split a character across chunks", function () {\n  var bytes = new TextEncoder().encode("héllo €");\n  var rs = new ReadableStream({ start: function (c) { c.enqueue(bytes.slice(0, 2)); c.enqueue(bytes.slice(2, 8)); c.enqueue(bytes.slice(8)); c.close(); } });\n  var out = "";\n  return rs.pipeThrough(new TextDecoderStream()).pipeTo(new WritableStream({ write: function (s) { out += s; } })).then(function () { log("decoded: " + out); });\n});\nstep("Blob.stream and Response bodies", function () {\n  var b = new Blob(["from a blob"]);\n  return new Response(b.stream()).text().then(function (t) {\n    log("blob stream through a Response: " + t);\n    var r = new Response("body text");\n    log("body is a ReadableStream: " + (r.body instanceof ReadableStream) + ", used before: " + r.bodyUsed + ", null body: " + new Response(null).body);\n    return r.body.getReader().read();\n  }).then(function (x) { log("body chunk: " + new TextDecoder().decode(x.value)); });\n});\nstep("compression round trips", function () {\n  var text = "PHI PHI PHI ".repeat(200);\n  return Promise.all(["gzip", "deflate", "deflate-raw"].map(function (f) {\n    var packed = new Blob([text]).stream().pipeThrough(new CompressionStream(f));\n    return new Response(packed).arrayBuffer().then(function (buf) {\n      var size = buf.byteLength;\n      var back = new Blob([buf]).stream().pipeThrough(new DecompressionStream(f));\n      return new Response(back).text().then(function (t) { return f + " " + text.length + " -> " + (size < 200 ? "under 200" : size) + " bytes -> " + (t === text ? "the same" : "DIFFERENT"); });\n    });\n  })).then(function (r) { log(r.join("; ")); });\n});\nstep("bad compressed data, a bad format", function () {\n  var bad = new Blob([new Uint8Array([1, 2, 3, 4, 5])]).stream().pipeThrough(new DecompressionStream("gzip"));\n  try { new CompressionStream("zip"); } catch (e) { log("zip: " + e.name); }\n  return new Response(bad).arrayBuffer().then(function () { log("bad data read?"); }, function (e) { log("bad data: " + e.name); });\n});\nstep("crypto.subtle.digest", function () {\n  var hex = function (b) { return Array.from(new Uint8Array(b)).map(function (x) { return (x + 256).toString(16).slice(1); }).join(""); };\n  var abc = new TextEncoder().encode("abc");\n  return Promise.all(["SHA-1", "SHA-256", "SHA-384", "SHA-512"].map(function (a) { return crypto.subtle.digest(a, abc).then(function (d) { return a + " " + hex(d).slice(0, 16) + "... (" + d.byteLength + ")"; }); })).then(function (r) { log(r.join("; ")); return crypto.subtle.digest("MD5", abc).then(function () { log("MD5?"); }, function (e) { log("MD5: " + e.name); }); });\n});\n(function run(i) {\n  if (i >= steps.length) { log("done"); return; }\n  log("-- " + steps[i][0]);\n  Promise.resolve().then(steps[i][1]).then(function () { run(i + 1); }, function (e) { log("FAILED " + e); run(i + 1); });\n})(0);\n</script></body>';
	ptr<Page> page: (Page.New: addr host 800.0 600.0);
	call Page.Load: page html html.len as u32 'https://streams.example/';
	f64 now: 0.0;
	while int i: 0; i < 200; i++;
		now is now + 5.0;
		call Page.Tick: page now;
	;;
	call Page.Free: page;
	exit 0;

	[Print: ptr<Page> p: 0; ptr<u8> text: 0; u32 n: 0; int level: 0;]
		log text '\n';
	[end]
}
