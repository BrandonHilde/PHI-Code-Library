{
	fldcw [rel {js_m_ext}]
	fld qword [rel {js_m_x}]
	fptan
	fstp st0
	fstp qword [rel {js_m_r}]
	fldcw [rel {js_m_dbl}]
	ret
}

asm.JsX87Atan2
{
	fldcw [{js_m_ext}]
	fld qword [{js_m_y}]
	fld qword [{js_m_x}]
	fpatan
	fstp qword [{js_m_r}]
	fldcw [{js_m_dbl}]
	ret
}

