{
	fldcw [rel {js_m_ext}]
	fld qword [rel {js_m_y}]
	fld qword [rel {js_m_x}]
	fpatan
	fstp qword [rel {js_m_r}]
	fldcw [rel {js_m_dbl}]
	ret
}
