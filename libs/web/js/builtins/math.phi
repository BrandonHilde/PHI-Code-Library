	ret
}

asm.JsX87Tan
{
	fldcw [{js_m_ext}]
	fld qword [{js_m_x}]
	fptan
	fstp st0
	fstp qword [{js_m_r}]
	fldcw [{js_m_dbl}]
	ret
}

