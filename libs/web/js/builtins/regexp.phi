			;;
			call JsObjs.ArrayPush: a (JsV.Str: subject);
			return (JsV.Obj: a);
		;;
		f64 from: 0.0;
		f64 q: 0.0;
		while q < size
			call Js.Checkpoint;
			call SetLastIndex: splitter q;
			u64 z: (ExecOf: splitter subject);
			if z is JsV.NULL
				q is (Advance: subject q full);
			;;
			else
				f64 e: (GetLastIndex: splitter);
				if e > size
					e is size;
				;;
				if e is from
					q is (Advance: subject q full);
