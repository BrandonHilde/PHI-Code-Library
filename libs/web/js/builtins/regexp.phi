		call JsObjs.ArrayPush: a (JsV.Str: (JsStrs.Slice: subject from as u32 subject.len));
	[end: (JsV.Obj: a)]

	[SymMatchAll: ptr<u64> args: 0; int argc: 0;]
		u64 t: (ThisObject: args);
		ptr<JsStr> subject: (JsOps.ToStr: (Js.Arg: args argc 0));
		u64 fallback: (JsObjs.GetAtom: JsRt.P.regexp JsRt.A.constructor as ptr<u8> (JsV.Obj: JsRt.P.regexp));
		u64 c: (JsOps.Species: (JsV.AsObj: t) fallback);
		ptr<JsStr> flags: (FlagsText: t);
