		;;
		if next_pos < total
			call JsStringMore.AddUnits: addr output subject next_pos as u32 subject.len;
		;;
		u64 result: (JsV.Str: (JsStrs.FromBuf: addr output));
		call output.Free;
	[end: result]

	[SymSplit: ptr<u64> args: 0; int argc: 0;]
		u64 t: (ThisObject: args);
		ptr<JsStr> subject: (JsOps.ToStr: (Js.Arg: args argc 0));
		u64 limit_v: (Js.Arg: args argc 1);
		ptr<JsObj> holder: (JsV.AsObj: t);
