					if a.length is lim
						return (JsV.Obj: a);
					;;
					from is e;
					ptr<JsObj> zo: (JsV.AsObj: z);
					f64 ncap: (JsArrayBuiltins.LengthOf: zo);
					f64 i: 1.0;
					while i < ncap
						call JsObjs.ArrayPush: a (JsObjs.Get: zo (JsArrayBuiltins.IndexKey: i) z);
						if a.length is lim
