		call Js.Push: (JsV.Str: flags);
		u64 matcher: (Js.Construct: c 2);
		call SetLastIndex: matcher (GetLastIndex: t);
		ptr<JsReMatchIter> it: new JsReMatchIter;
		if it is 0
