		it.text is (JsV.Str: subject);
		it.global is (HasFlag: flags 'g');
		it.unicode is (HasFlag: flags 'u') or (HasFlag: flags 'v');
		ptr<JsObj> o: (JsObjs.NewHost: iter_class JsRt.P.regexp_string_iterator it as ptr<u8>);
