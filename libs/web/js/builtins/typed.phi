# ArrayBuffer, SharedArrayBuffer, the typed arrays and DataView.
#
# A buffer can be resizable (new ArrayBuffer(n, { maxByteLength })), or growable if it's shared, and an
# ArrayBuffer can be detached (transfer() does it, and a host can). A view on a buffer that can change
# size either has a fixed length, and is out of bounds while the buffer is too short for it, or tracks
# the buffer's length (a typed array made with no length, or a DataView with no byteLength). So nothing
# here keeps a buffer's address across anything a script could do: each look goes through At.
#
# A typed array is a host object whose hooks answer index keys from its buffer's bytes. Many of its
# methods are Array.prototype's own natives behind a check that this is a typed array in bounds (they go
# through the same hooks, and JsArrayBuiltins.LengthOf takes a typed array's length from here); those that
# must make a typed array, write by number or sort are here. BigInt64Array and BigUint64Array hold BigInts
# (js/bigint.phi), and a copy between them and the others is a TypeError. There's only one thread, so a
# SharedArrayBuffer is an ArrayBuffer that can't be detached or shrunk. Atomics and Uint8Array's base64
# and hex are in typedarray.js.

struct.JsBufferData
{
	ptr<u8> bytes;
	u32 len;
	u32 cap;               # bytes has room for this many
	f64 max_len;           # resizable or growable: the most it can be
	bln resizable;
	bln detached;
	bln shared;
	bln immutable;         # transferToImmutable or sliceToImmutable made it: nothing writes to it
}

struct.JsViewData
{
	u64 buffer;
	u32 offset;
	u32 length;            # elements, for a typed array; bytes, for a DataView. Not used if tracking.
	u32 kind;
	bln tracking;          # its length is what fits in the buffer after offset
}

phi.JsTyped:Library
{
	const u32 INT8: 0;
	const u32 UINT8: 1;
	const u32 UINT8C: 2;
	const u32 INT16: 3;
	const u32 UINT16: 4;
	const u32 INT32: 5;
	const u32 UINT32: 6;
	const u32 FLOAT32: 7;
	const u32 FLOAT64: 8;
	const u32 BIGINT64: 9;
	const u32 BIGUINT64: 10;
	const u32 FLOAT16: 11;
	const u32 KINDS: 12;

	const u32 MAX_BYTES: 1000000000;
	# a resizable buffer up to this big has its room from the start, so resizing never moves it
	const u32 RESERVE: 16777216;

	ptr<JsClass> buffer_class: 0;
	ptr<JsClass> shared_class: 0;
	ptr<JsClass> array_class: 0;
	ptr<JsClass> view_class: 0;

	[Init]
		if buffer_class is 0
			buffer_class is (JsObjs.NewClass: 'ArrayBuffer');
			buffer_class.finalize is addr FreeBuffer;
			shared_class is (JsObjs.NewClass: 'SharedArrayBuffer');
			shared_class.finalize is addr FreeBuffer;
			array_class is (JsObjs.NewClass: 'TypedArray');
			array_class.trace is addr TraceView;
			array_class.finalize is addr FreeView;
			array_class.get is addr HookGet;
			array_class.set is addr HookSet;
			array_class.has_key is addr HookHas;
			array_class.del is addr HookDelete;
			array_class.keys is addr HookKeys;
			array_class.get_own is addr HookGetOwn;
			array_class.define is addr HookDefine;
			view_class is (JsObjs.NewClass: 'DataView');
			view_class.trace is addr TraceView;
			view_class.finalize is addr FreeView;
		;;
		ptr<JsObj> bp: (JsObjs.NewObject);
		JsRt.P.arraybuffer is bp;
		ptr<JsNativeFn> bc: (Js.DefineClass: 'ArrayBuffer' addr BufferCtor 1 bp);
		call Js.DefineSymbolGetter: bc as ptr<JsObj> JsRt.S.species '[Symbol.species]' addr JsArrayBuiltins.Species 0;
		call Js.DefineNative: bc as ptr<JsObj> 'isView' addr IsView 1;
		call Js.DefineGetter: bp 'byteLength' addr BufferLength 0;
		call Js.DefineGetter: bp 'maxByteLength' addr BufferMaxLength 0;
		call Js.DefineGetter: bp 'resizable' addr BufferResizable 0;
		call Js.DefineGetter: bp 'detached' addr BufferDetached 0;
		call Js.DefineNative: bp 'slice' addr BufferSlice 2;
		call Js.DefineNative: bp 'resize' addr BufferResize 1;
		ptr<JsNativeFn> tr: (Js.DefineNative: bp 'transfer' addr Transfer 0);
		tr.magic is 1;
		call Js.DefineNative: bp 'transferToFixedLength' addr Transfer 0;
		ptr<JsNativeFn> ti: (Js.DefineNative: bp 'transferToImmutable' addr Transfer 0);
		ti.magic is 2;
		call Js.DefineNative: bp 'sliceToImmutable' addr SliceToImmutable 2;
		call Js.DefineGetter: bp 'immutable' addr BufferImmutable 0;
		call JsObjs.DefineValue: bp JsRt.S.toStringTag as ptr<u8> (Js.NewStringZ: 'ArrayBuffer') JsObjs.C;

		ptr<JsObj> sp: (JsObjs.NewObject);
		JsRt.P.shared_buffer is sp;
		ptr<JsNativeFn> sc: (Js.DefineClass: 'SharedArrayBuffer' addr SharedCtor 1 sp);
		call Js.DefineSymbolGetter: sc as ptr<JsObj> JsRt.S.species '[Symbol.species]' addr JsArrayBuiltins.Species 0;
		call Js.DefineGetter: sp 'byteLength' addr SharedLength 0;
		call Js.DefineGetter: sp 'growable' addr SharedGrowable 0;
		call Js.DefineGetter: sp 'maxByteLength' addr SharedMaxLength 0;
		call Js.DefineNative: sp 'grow' addr SharedGrow 1;
		call Js.DefineNative: sp 'slice' addr SharedSlice 2;
		call JsObjs.DefineValue: sp JsRt.S.toStringTag as ptr<u8> (Js.NewStringZ: 'SharedArrayBuffer') JsObjs.C;

		# %TypedArray%: not global, and it can't be called
		ptr<JsObj> tp: (JsObjs.NewObject);
		JsRt.P.typed_array is tp;
		ptr<JsNativeFn> tc: (JsObjs.NewNative: addr AbstractCtor 'TypedArray' 0 false);
		tc.o.flags is tc.o.flags | JsObjs.F_CTOR as u16;
		ptr<JsObj> tco: tc as ptr<JsObj>;
		call JsObjs.Materialize: tco;
		call JsObjs.AddProp: tco JsRt.A.prototype as ptr<u8> (JsV.Obj: tp) 0;
		call JsObjs.DefineValue: tp JsRt.A.constructor as ptr<u8> (JsV.Obj: tco) JsObjs.WC;
		call Js.DefineSymbolGetter: tco JsRt.S.species '[Symbol.species]' addr JsArrayBuiltins.Species 0;
		call Js.DefineNativeSafe: tco 'from' addr From 1;
		call Js.DefineNativeSafe: tco 'of' addr OfFn 0;
		call Js.DefineGetter: tp 'buffer' addr GetBuffer 0;
		call Js.DefineGetter: tp 'byteLength' addr GetByteLength 0;
		call Js.DefineGetter: tp 'byteOffset' addr GetByteOffset 0;
		call Js.DefineGetter: tp 'length' addr GetLength 0;
		call Js.DefineSymbolGetter: tp JsRt.S.toStringTag '[Symbol.toStringTag]' addr GetTag 0;
		call Js.DefineNativeSafe: tp 'set' addr SetFn 1;
		call Js.DefineNativeSafe: tp 'subarray' addr Subarray 2;
		call Js.DefineNativeSafe: tp 'slice' addr Slice 2;
		call Js.DefineNativeSafe: tp 'map' addr MapFn 1;
		call Js.DefineNativeSafe: tp 'filter' addr FilterFn 1;
		call Js.DefineNativeSafe: tp 'sort' addr Sort 1;
		call Js.DefineNativeSafe: tp 'toSorted' addr ToSorted 1;
		call Js.DefineNativeSafe: tp 'toReversed' addr ToReversed 0;
		call Js.DefineNativeSafe: tp 'with' addr WithFn 2;
		call Js.DefineNativeSafe: tp 'fill' addr Fill 1;
		call Js.DefineNative: tp 'copyWithin' addr CopyWithin 2;
		call Js.DefineNative: tp 'reverse' addr Reverse 0;
		# the rest work as they do on an array, once this is known to be a typed array in bounds: they
		# only look at indexes and the length
		ptr<u8> shared: 'at entries every find findIndex findLast findLastIndex forEach includes indexOf join keys lastIndexOf reduce reduceRight some toLocaleString values ';
		u32 i: 0;
		while shared:i is not 0
			u32 start: i;
			while shared:i is not 32
				i++;
			;;
			ptr<JsStr> name: (JsStrs.Intern: shared + start i - start);
			ptr<JsProp> m: (JsObjs.Find: JsRt.P.array name as ptr<u8>);
			if m is not 0
				ptr<JsNativeFn> orig: (JsV.AsObj: m.value) as ptr<JsNativeFn>;
				ptr<JsNativeFn> w: (JsObjs.NewNative: addr Checked orig.name orig.nargs orig.gc_safe);
				w.magic is orig.magic | JsArrayMore.TYPED_CALL;
				w.data is m.value;
				call JsObjs.DefineValue: tp name as ptr<u8> (JsV.Obj: w as ptr<JsObj>) JsObjs.WC;
			;;
			i++;
		;;
		# toString is Array.prototype.toString itself
		ptr<JsProp> ts: (JsObjs.Find: JsRt.P.array (JsStrs.InternZ: 'toString') as ptr<u8>);
		call JsObjs.DefineValue: tp (JsStrs.InternZ: 'toString') as ptr<u8> ts.value JsObjs.WC;
		ptr<JsProp> vals: (JsObjs.Find: tp (JsStrs.InternZ: 'values') as ptr<u8>);
		call JsObjs.DefineValue: tp JsRt.S.iterator as ptr<u8> vals.value JsObjs.WC;

		JsRt.P.typed_ctors is (JsObjs.NewArray: KINDS);
		while u32 k: 0; k < KINDS; k++;
			call OneKind: (KindName: k) k tco tp;
		;;

		ptr<JsObj> vp: (JsObjs.NewObject);
		JsRt.P.dataview is vp;
		call Js.DefineClass: 'DataView' addr ViewCtor 1 vp;
		call Js.DefineGetter: vp 'buffer' addr ViewBuffer 0;
		call Js.DefineGetter: vp 'byteLength' addr ViewByteLength 0;
		call Js.DefineGetter: vp 'byteOffset' addr ViewByteOffset 0;
		call JsObjs.DefineValue: vp JsRt.S.toStringTag as ptr<u8> (Js.NewStringZ: 'DataView') JsObjs.C;
		call ViewMethods: vp 'getInt8' 'setInt8' INT8;
		call ViewMethods: vp 'getUint8' 'setUint8' UINT8;
		call ViewMethods: vp 'getInt16' 'setInt16' INT16;
		call ViewMethods: vp 'getUint16' 'setUint16' UINT16;
		call ViewMethods: vp 'getInt32' 'setInt32' INT32;
		call ViewMethods: vp 'getUint32' 'setUint32' UINT32;
		call ViewMethods: vp 'getFloat16' 'setFloat16' FLOAT16;
		call ViewMethods: vp 'getFloat32' 'setFloat32' FLOAT32;
		call ViewMethods: vp 'getFloat64' 'setFloat64' FLOAT64;
		call ViewMethods: vp 'getBigInt64' 'setBigInt64' BIGINT64;
		call ViewMethods: vp 'getBigUint64' 'setBigUint64' BIGUINT64;
	[end]

	[OneKind: ptr<u8> name: 0; u32 kind: 0; ptr<JsObj> tco: 0; ptr<JsObj> tp: 0;]
		ptr<JsObj> p: (JsObjs.NewWithProto: tp);
		ptr<JsNativeFn> c: (Js.DefineClass: name addr ArrayCtor 3 p);
		c.magic is kind;
		ptr<JsObj> co: c as ptr<JsObj>;
		co.proto is tco;
		f64 size: (SizeOf: kind) as f64;
		call Js.Define: co 'BYTES_PER_ELEMENT' (JsV.Num: size) 0;
		call Js.Define: p 'BYTES_PER_ELEMENT' (JsV.Num: size) 0;
		# new Uint8Array(...) needs the prototype of its kind, so the constructor keeps it
		c.data is (JsV.Obj: p);
		call JsObjs.ArrayPush: JsRt.P.typed_ctors (JsV.Obj: co);
	[end]

	# (the names are literals: a native keeps the pointer until its name is made)
	[ViewMethods: ptr<JsObj> vp: 0; ptr<u8> getter: 0; ptr<u8> setter: 0; u32 kind: 0;]
		ptr<JsNativeFn> g: (Js.DefineNative: vp getter addr ViewGet 1);
		g.magic is kind;
		ptr<JsNativeFn> s: (Js.DefineNative: vp setter addr ViewSet 2);
		s.magic is kind;
	[end]

	[SizeOf: u32 kind: 0;]
		when kind
			is INT8 UINT8 UINT8C
				return 1;
			;;
			is INT16 UINT16 FLOAT16
				return 2;
			;;
			is INT32 UINT32 FLOAT32
				return 4;
			;;
		;;
	[end: 8 as u32]

	[FreeBuffer: ptr<JsObj> o: 0;]
		ptr<JsBufferData> d: o.data as ptr<JsBufferData>;
		if d.bytes is not 0
			free d.bytes;
		;;
		free d;
	[end]

	[TraceView: ptr<JsObj> o: 0;]
		ptr<JsViewData> d: o.data as ptr<JsViewData>;
		call Js.Mark: d.buffer;
	[end]

	[FreeView: ptr<JsObj> o: 0;]
		free o.data;
	[end]

	# ---- buffers ----

	# A buffer of this many zero bytes. So a browser can make one from bytes it has: (JsTyped.BytesOf: v).
	[NewBuffer: f64 n: 0.0; ptr<JsObj> proto: 0;]
	[end: (Allocate: buffer_class n -1.0 proto)]

	# max below 0: one of fixed length
	[Allocate: ptr<JsClass> cl: 0; f64 n: 0.0; f64 max: -1.0; ptr<JsObj> proto: 0;]
		if n > (MAX_BYTES as f64) or n < 0.0
			call JsErr.Range: 'Array buffer allocation failed';
		;;
		ptr<JsBufferData> d: new JsBufferData;
		if d is 0
			throw 'out of memory';
		;;
		u32 count: n as u32;
		u32 room: count;
		if max >= 0.0
			d.resizable is true;
			d.max_len is max;
			if max <= (RESERVE as f64)
				room is max as u32;
			;;
		;;
		d.bytes is new u8[room + 1];
		if d.bytes is 0
			free d;
			call JsErr.Range: 'Array buffer allocation failed';
		;;
		call Mem.Fill: d.bytes 0 room + 1;
		d.len is count;
		d.cap is room;
		d.shared is (cl is shared_class);
		call JsGc.Account: room;
		ptr<JsObj> o: (JsObjs.NewHost: cl proto d as ptr<u8>);
	[end: o]

	# options' maxByteLength, or -1 if there's none
	[MaxOption: u64 options: 0;]
		if not (JsV.IsObj: options) return -1.0;
		u64 m: (JsObjs.GetV: options (JsObjs.KeyZ: 'maxByteLength'));
		if m is JsV.UNDEF return -1.0;
	[end: (ToIndex: m)]

	[BufferCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		if not (JsV.IsObj: nt)
			call JsErr.Type: 'Constructor ArrayBuffer requires new';
		;;
		f64 n: (ToIndex: (Js.Arg: args argc 0));
		f64 max: (MaxOption: (Js.Arg: args argc 1));
		if max >= 0.0 and n > max
			call JsErr.Range: 'byteLength is more than maxByteLength';
		;;
		if max > (MAX_BYTES as f64)
			call JsErr.Range: 'maxByteLength is more than can be made';
		;;
	[end: (JsV.Obj: (Allocate: buffer_class n max (JsOps.ProtoFromCtor: nt JsRt.P.arraybuffer)))]

	[SharedCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		if not (JsV.IsObj: nt)
			call JsErr.Type: 'Constructor SharedArrayBuffer requires new';
		;;
		f64 n: (ToIndex: (Js.Arg: args argc 0));
		f64 max: (MaxOption: (Js.Arg: args argc 1));
		if max >= 0.0 and n > max
			call JsErr.Range: 'byteLength is more than maxByteLength';
		;;
		if max > (MAX_BYTES as f64)
			call JsErr.Range: 'maxByteLength is more than can be made';
		;;
	[end: (JsV.Obj: (Allocate: shared_class n max (JsOps.ProtoFromCtor: nt JsRt.P.shared_buffer)))]

	[ToIndex: u64 v: 0;]
		if v is JsV.UNDEF return 0.0;
		f64 n: (JsOps.ToInteger: v);
		if n < 0.0 or n > 9007199254740991.0
			call JsErr.Range: 'Invalid index';
		;;
	[end: n]

	[IsView: ptr<u64> args: 0; int argc: 0;]
		u64 v: (Js.Arg: args argc 0);
		if not (JsV.IsObj: v)
			return JsV.FALSE;
		;;
		ptr<JsObj> o: (JsV.AsObj: v);
	[end: (JsV.Bool: o.cls is array_class or o.cls is view_class)]

	# this, which must be an ArrayBuffer (not shared)
	[ThisBuffer: ptr<u64> args: 0;]
		u64 v: args:(-1);
		if (IsClass: v buffer_class)
			return (JsV.AsObj: v).data as ptr<JsBufferData>;
		;;
		call JsErr.Type: 'This method requires an ArrayBuffer';
	[end: 0 as ptr<JsBufferData>]

	[ThisShared: ptr<u64> args: 0;]
		u64 v: args:(-1);
		if (IsClass: v shared_class)
			return (JsV.AsObj: v).data as ptr<JsBufferData>;
		;;
		call JsErr.Type: 'This method requires a SharedArrayBuffer';
	[end: 0 as ptr<JsBufferData>]

	[BufferLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
	[end: (JsV.Uint: d.len)]

	[BufferMaxLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
		if d.detached return (JsV.Int: 0);
		if d.resizable return (JsV.Num: d.max_len);
	[end: (JsV.Uint: d.len)]

	[BufferResizable: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
	[end: (JsV.Bool: d.resizable)]

	[BufferImmutable: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
	[end: (JsV.Bool: d.immutable)]

	[BufferDetached: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
	[end: (JsV.Bool: d.detached)]

	[SharedLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisShared: args);
	[end: (JsV.Uint: d.len)]

	[SharedGrowable: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisShared: args);
	[end: (JsV.Bool: d.resizable)]

	[SharedMaxLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisShared: args);
		if d.resizable return (JsV.Num: d.max_len);
	[end: (JsV.Uint: d.len)]

	# a new length for a buffer, past what it was or not; what's new is zeros
	[SetLength: ptr<JsBufferData> d: 0; f64 n: 0.0;]
		if n > (MAX_BYTES as f64)
			call JsErr.Range: 'Array buffer allocation failed';
		;;
		u32 count: n as u32;
		if count > d.cap
			ptr<u8> grown: new u8[count + 1];
			if grown is 0
				call JsErr.Range: 'Array buffer allocation failed';
			;;
			call Mem.Fill: grown 0 count + 1;
			call Mem.Copy: grown d.bytes d.len;
			free d.bytes;
			call JsGc.Account: count - d.cap;
			d.bytes is grown;
			d.cap is count;
		;;
		elif count > d.len
			call Mem.Fill: d.bytes + d.len 0 count - d.len;
		;;
		elif count < d.len
			call Mem.Fill: d.bytes + count 0 d.len - count;
		;;
		d.len is count;
	[end]

	[BufferResize: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
		if not d.resizable or d.immutable
			call JsErr.Type: 'This ArrayBuffer is not resizable';
		;;
		f64 n: (ToIndex: (Js.Arg: args argc 0));
		if d.detached
			call JsErr.Type: 'This ArrayBuffer is detached';
		;;
		if n > d.max_len
			call JsErr.Range: 'The new length is more than maxByteLength';
		;;
		call SetLength: d n;
	[end: JsV.UNDEF]

	[SharedGrow: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisShared: args);
		if not d.resizable
			call JsErr.Type: 'This SharedArrayBuffer is not growable';
		;;
		f64 n: (ToIndex: (Js.Arg: args argc 0));
		if n > d.max_len
			call JsErr.Range: 'The new length is more than maxByteLength';
		;;
		if n < (d.len as f64)
			call JsErr.Range: 'A SharedArrayBuffer can only grow';
		;;
		call SetLength: d n;
	[end: JsV.UNDEF]

	# The buffer has no bytes from now on, and its views are out of bounds. A host can do it as well, as
	# when an ArrayBuffer is sent to a worker.
	[Detach: u64 bv: 0;]
		ptr<JsBufferData> d: (BytesData: bv);
		if d.immutable
			call JsErr.Type: 'An immutable ArrayBuffer can\'t be detached';
		;;
		if d.bytes is not 0
			free d.bytes;
		;;
		d.bytes is new u8[1];
		d.len is 0;
		d.cap is 0;
		d.detached is true;
	[end]

	# transfer (magic 1: keeps it resizable if it was), transferToFixedLength, and transferToImmutable (2)
	[Transfer: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<JsBufferData> d: (ThisBuffer: args);
		f64 n: d.len as f64;
		if (Js.Arg: args argc 0) is not JsV.UNDEF
			n is (ToIndex: args:0);
		;;
		if d.detached
			call JsErr.Type: 'This ArrayBuffer is detached';
		;;
		if d.immutable
			call JsErr.Type: 'An immutable ArrayBuffer can\'t be transferred';
		;;
		f64 max: -1.0;
		if self.magic is 1 and d.resizable
			max is d.max_len;
			if n > max
				call JsErr.Range: 'The new length is more than maxByteLength';
			;;
		;;
		ptr<JsObj> made: (Allocate: buffer_class n max JsRt.P.arraybuffer);
		ptr<JsBufferData> md: made.data as ptr<JsBufferData>;
		u32 count: md.len;
		if d.len < count
			count is d.len;
		;;
		call Mem.Copy: md.bytes d.bytes count;
		call Detach: args:(-1);
		md.immutable is (self.magic is 2);
	[end: (JsV.Obj: made)]

	[SliceToImmutable: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
		if d.detached
			call JsErr.Type: 'This ArrayBuffer is detached';
		;;
		f64 len: d.len as f64;
		f64 first: (JsOps.RelativeIndex: (Js.Arg: args argc 0) len 0.0);
		f64 last: (JsOps.RelativeIndex: (Js.Arg: args argc 1) len len);
		if d.detached
			call JsErr.Type: 'This ArrayBuffer was detached';
		;;
		f64 count: last - first;
		if count < 0.0
			count is 0.0;
		;;
		# it may have been resized meanwhile
		if count > 0.0 and last > (d.len as f64)
			call JsErr.Range: 'This ArrayBuffer is shorter than the slice now';
		;;
		ptr<JsObj> made: (Allocate: buffer_class count -1.0 JsRt.P.arraybuffer);
		ptr<JsBufferData> md: made.data as ptr<JsBufferData>;
		if count > 0.0
			call Mem.Copy: md.bytes d.bytes + first as u32 count as u32;
		;;
		md.immutable is true;
	[end: (JsV.Obj: made)]

	# whether a view's buffer is immutable
	[ReadOnly: ptr<JsViewData> v: 0;]
		ptr<JsBufferData> d: (BufferOf: v);
	[end: d.immutable]

	# a typed array that will be written to (ValidateTypedArray with write)
	[ThisWritable: ptr<u64> args: 0;]
		ptr<JsObj> o: (ThisArray: args);
		if (ReadOnly: (ViewOf: o))
			call JsErr.Type: 'The typed array\'s buffer is immutable';
		;;
	[end: o]

	[BufferSlice: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisBuffer: args);
		if d.detached
			call JsErr.Type: 'This ArrayBuffer is detached';
		;;
	[end: (SliceOf: args argc d buffer_class JsRt.P.arraybuffer 'ArrayBuffer')]

	[SharedSlice: ptr<u64> args: 0; int argc: 0;]
		ptr<JsBufferData> d: (ThisShared: args);
	[end: (SliceOf: args argc d shared_class JsRt.P.shared_buffer 'SharedArrayBuffer')]

	[SliceOf: ptr<u64> args: 0; int argc: 0; ptr<JsBufferData> d: 0; ptr<JsClass> cl: 0; ptr<JsObj> proto: 0; ptr<u8> what: 0;]
		f64 len: d.len as f64;
		f64 first: (JsOps.RelativeIndex: (Js.Arg: args argc 0) len 0.0);
		f64 last: (JsOps.RelativeIndex: (Js.Arg: args argc 1) len len);
		f64 count: last - first;
		if count < 0.0
			count is 0.0;
		;;
		ptr<JsObj> self: (JsV.AsObj: args:(-1));
		ptr<JsProp> cp: (JsObjs.Find: proto JsRt.A.constructor as ptr<u8>);
		u64 ctor: (JsOps.Species: args:(-1) cp.value);
		call Js.Push: (JsV.Num: count);
		u64 made: (Js.Construct: ctor 1);
		if not (IsClass: made cl)
			call JsErr.Type: ('The species constructor did not make an ' what);
		;;
		ptr<JsObj> mo: (JsV.AsObj: made);
		ptr<JsBufferData> md: mo.data as ptr<JsBufferData>;
		if md.detached
			call JsErr.Type: 'The species constructor made a detached ArrayBuffer';
		;;
		if mo is self
			call JsErr.Type: ('The species constructor did not make a new ' what);
		;;
		if (md.len as f64) < count
			call JsErr.Type: ('The species constructor made an ' what ' too short');
		;;
		if d.detached
			call JsErr.Type: 'This ArrayBuffer was detached';
		;;
		# it may have been resized meanwhile
		if first < (d.len as f64)
			f64 can: (d.len as f64) - first;
			if can < count
				count is can;
			;;
			if count > 0.0
				call Mem.Copy: md.bytes d.bytes + first as u32 count as u32;
			;;
		;;
	[end: made]

	# for a host: where a buffer's bytes are, and how many (BytesLen). Good until a script runs.
	[BytesOf: u64 v: 0;]
		ptr<JsObj> o: (JsV.AsObj: v);
		ptr<JsBufferData> d: o.data as ptr<JsBufferData>;
	[end: d.bytes]

	[BytesLen: u64 v: 0;]
		ptr<JsObj> o: (JsV.AsObj: v);
		ptr<JsBufferData> d: o.data as ptr<JsBufferData>;
	[end: d.len]

	[BytesData: u64 bv: 0;]
		ptr<JsObj> b: (JsV.AsObj: bv);
	[end: b.data as ptr<JsBufferData>]

	[IsBuffer: u64 v: 0;]
	[end: (IsClass: v buffer_class) or (IsClass: v shared_class)]

	# ---- reading and writing elements ----

	[Load: ptr<u8> p: 0; u32 kind: 0;]
		when kind
			is INT8
				ptr<i8> a: p as ptr<i8>;
				return (JsV.Int: a:0 as int);
			;;
			is UINT8 UINT8C
				return (JsV.Int: p:0 as int);
			;;
			is INT16
				ptr<i16> b: p as ptr<i16>;
				return (JsV.Int: b:0 as int);
			;;
			is UINT16
				ptr<u16> c: p as ptr<u16>;
				return (JsV.Int: c:0 as int);
			;;
			is INT32
				ptr<i32> d: p as ptr<i32>;
				return (JsV.Int: d:0);
			;;
			is UINT32
				ptr<u32> e: p as ptr<u32>;
				return (JsV.Uint: e:0);
			;;
			is FLOAT16
				ptr<u16> hf: p as ptr<u16>;
				return (JsV.Num: (FromHalf: hf:0));
			;;
			is FLOAT32
				ptr<f32> f: p as ptr<f32>;
				f64 wide: f:0 as f64;
				return (JsV.Num: wide);
			;;
			is BIGINT64
				ptr<i64> h: p as ptr<i64>;
				return (JsBig.FromI64: h:0);
			;;
			is BIGUINT64
				ptr<u64> k: p as ptr<u64>;
				return (JsBig.FromU64: k:0);
			;;
		;;
		ptr<f64> g: p as ptr<f64>;
	[end: (JsV.Num: g:0)]

	# whether the kind holds BigInts
	[IsBigKind: u32 kind: 0;]
	[end: kind is BIGINT64 or kind is BIGUINT64]

	# a value made what an element of the kind takes: a BigInt (ToBigInt) or a number (ToNumber)
	[Convert: u32 kind: 0; u64 val: 0;]
		if (IsBigKind: kind) return (JsOps.ToBigInt: val);
		if (JsV.IsNum: val) return val;
	[end: (JsV.Num: (JsOps.ToNumber: val))]

	# store a value Convert made
	[Put: ptr<u8> p: 0; u32 kind: 0; u64 val: 0;]
		if (IsBigKind: kind)
			ptr<u64> q: p as ptr<u64>;
			q:0 is (JsBig.ToU64: val);
			return;
		;;
		call Store: p kind (JsV.AsNum: val);
	[end]

	# an element from one kind of array into another: they must both hold BigInts, or neither
	[SameContent: u32 a: 0; u32 b: 0;]
		if (IsBigKind: a) is not (IsBigKind: b)
			call JsErr.Type: 'Content types differ: a BigInt array and another can\'t be copied between';
		;;
	[end]

	[Store: ptr<u8> p: 0; u32 kind: 0; f64 x: 0.0;]
		when kind
			is INT8 UINT8
				p:0 is (JsOps.ToUint32Num: x) as u8;
			;;
			is UINT8C
				f64 c: x;
				if c is not c or c <= 0.0
					p:0 is 0;
				;;
				elif c >= 255.0
					p:0 is 255;
				;;
				else
					# to the nearest, halves to even
					p:0 is (Float.Round: c) as u8;
				;;
			;;
			is INT16 UINT16
				ptr<u16> a: p as ptr<u16>;
				a:0 is (JsOps.ToUint32Num: x) as u16;
			;;
			is INT32 UINT32
				ptr<u32> b: p as ptr<u32>;
				b:0 is (JsOps.ToUint32Num: x);
			;;
			is FLOAT16
				ptr<u16> h: p as ptr<u16>;
				h:0 is (ToHalf: x);
			;;
			is FLOAT32
				ptr<f32> f: p as ptr<f32>;
				f:0 is x as f32;
			;;
			else
				ptr<f64> g: p as ptr<f64>;
				g:0 is x;
			;;
		;;
	[end]

	# IEEE 754 binary16, the nearest to x (halves to even), as its bits
	[ToHalf: f64 x: 0.0;]
		ptr<u64> q: (addr x) as ptr<u64>;
		u64 bits: q:0;
		u32 sign: ((bits >> 63) as u32) << 15;
		u32 e2: ((bits >> 52) as u32) & 0x7FF;
		u64 mant: bits & 0xFFFFFFFFFFFFF;
		if e2 is 0x7FF
			if mant is not 0
				return (sign | 0x7E00) as u16;
			;;
			return (sign | 0x7C00) as u16;
		;;
		int e: (e2 as int) - 1008;
		if e >= 31
			return (sign | 0x7C00) as u16;
		;;
		u64 m: 0;
		u32 shift: 0;
		u64 result: 0;
		if e <= 0
			if e < -10
				return sign as u16;
			;;
			m is mant | 0x10000000000000;
			shift is (43 - e) as u32;
			result is m >> shift;
		;;
		else
			m is mant;
			shift is 42;
			result is ((e as u64) << 10) | (m >> 42);
		;;
		u64 one: 1;
		u64 rest: m & ((one << shift) - 1);
		u64 half: one << (shift - 1);
		if rest > half or (rest is half and (result & 1) is 1)
			result++;
		;;
	[end: (sign | result as u32) as u16]

	[FromHalf: u16 h: 0;]
		u32 e: (h >> 10) & 31;
		u32 m: h & 1023;
		f64 v: 0.0;
		if e is 0
			v is (m as f64) * 0.000000059604644775390625;
		;;
		elif e is 31
			if m is not 0
				v is 0.0 / 0.0;
			;;
			else
				v is 1.0 / 0.0;
			;;
		;;
		else
			v is ((1024 + m) as f64) * 0.000000059604644775390625;
			u32 k: 1;
			while k < e
				v is v * 2.0;
				k++;
			;;
		;;
		if (h & 0x8000) is not 0
			v is v * -1.0;
		;;
	[end: v]

	[IsClass: u64 v: 0; ptr<JsClass> cl: 0;]
		if not (JsV.IsObj: v) return false;
		ptr<JsObj> o: (JsV.AsObj: v);
	[end: o.cls is cl]

	[ViewOf: ptr<JsObj> o: 0;]
	[end: o.data as ptr<JsViewData>]

	[BufferOf: ptr<JsViewData> v: 0;]
		ptr<JsObj> b: (JsV.AsObj: v.buffer);
	[end: b.data as ptr<JsBufferData>]

	# the address of element i
	[At: ptr<JsViewData> v: 0; u32 i: 0;]
		ptr<JsBufferData> d: (BufferOf: v);
	[end: d.bytes + v.offset + i * (SizeOf: v.kind)]

	# whether a typed array (or with dv, a DataView) is past its buffer's end, or its buffer is detached
	[OutOfBounds: ptr<JsViewData> v: 0; bln dv: false;]
		ptr<JsBufferData> d: (BufferOf: v);
		if d.detached return true;
		if v.offset > d.len return true;
		if v.tracking return false;
		u64 bytes: v.length as u64;
		if not dv
			bytes is bytes * (SizeOf: v.kind) as u64;
		;;
	[end: (v.offset as u64) + bytes > (d.len as u64)]

	# its length now: 0 if it's out of bounds
	[LenNow: ptr<JsViewData> v: 0;]
		if (OutOfBounds: v false) return 0;
		if v.tracking
			ptr<JsBufferData> d: (BufferOf: v);
			return (d.len - v.offset) / (SizeOf: v.kind);
		;;
	[end: v.length]

	[ViewBytesNow: ptr<JsViewData> v: 0;]
		if v.tracking
			ptr<JsBufferData> d: (BufferOf: v);
			return d.len - v.offset;
		;;
	[end: v.length]

	# for JsArrayBuiltins.LengthOf
	[LengthOf: ptr<JsObj> o: 0;]
	[end: (LenNow: (ViewOf: o))]

	# ---- the hooks: index keys are the array's; a key that's another number has no element ----

	# A string key that's a number as JavaScript writes one ("1.5", "-1", "-0", "Infinity") but isn't an
	# index: a typed array has no property by that name, and its prototypes aren't asked.
	[NumericKey: u64 key: 0;]
		if not (JsV.IsStr: key) return false;
		ptr<JsStr> s: (JsStrs.Flat: (JsV.AsStr: key));
		if s.bytes is 0 return false;
		u8 c: s.data:0;
		if not ((c >= '0' and c <= '9') or c is '-' or c is 'I' or c is 'N') return false;
		if s.bytes is 2 and c is '-' and s.data:1 is '0' return true;
		ptr<JsStr> back: (JsOps.NumToStr: (JsOps.StrToNum: s));
	[end: back.bytes is s.bytes and (Mem.Equal: back.data s.data s.bytes)]

	[IsIndex: ptr<JsViewData> v: 0; u64 key: 0;]
		if not (JsObjs.IsIndexKey: key) return false;
	[end: (key as u32) < (LenNow: v)]

	[HookGet: ptr<JsObj> o: 0; u64 key: 0; u64 recv: 0; ptr<u64> output: 0;]
		if not (JsObjs.IsIndexKey: key)
			if (NumericKey: key)
				output:0 is JsV.UNDEF;
				return 1;
			;;
			return 0;
		;;
		ptr<JsViewData> v: (ViewOf: o);
		if (key as u32) >= (LenNow: v)
			output:0 is JsV.UNDEF;
			return 1;
		;;
		output:0 is (Load: (At: v key as u32) v.kind);
	[end: 1]

	[HookSet: ptr<JsObj> o: 0; u64 key: 0; u64 val: 0; u64 recv: 0;]
		bln numeric: (NumericKey: key);
		if not (JsObjs.IsIndexKey: key) and not numeric return 0;
		ptr<JsViewData> v: (ViewOf: o);
		bln valid: not numeric and (key as u32) < (LenNow: v);
		# a receiver that's another object sets its own property, unless this has no such element
		if recv is not (JsV.Obj: o)
			if valid return 0;
			return 1;
		;;
		if numeric
			if (ReadOnly: v) return -1;
			call Convert: v.kind val;
			return 1;
		;;
		if (ReadOnly: v) return -1;
		u64 x: (Convert: v.kind val);
		if (key as u32) < (LenNow: v)
			call Put: (At: v key as u32) v.kind x;
		;;
	[end: 1]

	[HookHas: ptr<JsObj> o: 0; u64 key: 0;]
		if not (JsObjs.IsIndexKey: key)
			if (NumericKey: key) return -1;
			return 0;
		;;
		if (IsIndex: (ViewOf: o) key) return 1;
	[end: -1]

	[HookDelete: ptr<JsObj> o: 0; u64 key: 0;]
		if not (JsObjs.IsIndexKey: key)
			if (NumericKey: key) return 1;
			return 0;
		;;
		if (IsIndex: (ViewOf: o) key) return -1;
	[end: 1]

	[HookKeys: ptr<JsObj> o: 0; ptr<JsObj> list: 0;]
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		while u32 i: 0; i < n; i++;
			call JsObjs.ArrayPush: list (JsV.Str: (JsStrs.InternIndex: i));
		;;
		# then its ordinary ones, as any object's
		ptr<JsObj> rest: (JsObjs.OrdinaryKeys: o);
		while u32 j: 0; j < rest.length; j++;
			call JsObjs.ArrayPush: list rest.elems:j;
		;;
	[end]

	[HookGetOwn: ptr<JsObj> o: 0; u64 key: 0; ptr<JsDesc> d: 0;]
		if not (JsObjs.IsIndexKey: key)
			if (NumericKey: key) return -1;
			return 0;
		;;
		ptr<JsViewData> v: (ViewOf: o);
		if (key as u32) >= (LenNow: v) return -1;
		d.value is (Load: (At: v key as u32) v.kind);
		d.getter is JsV.UNDEF;
		d.setter is JsV.UNDEF;
		d.flags is JsObjs.WEC;
		if (ReadOnly: v)
			d.flags is JsObjs.E;
		;;
	[end: 1]

	[HookDefine: ptr<JsObj> o: 0; u64 key: 0; ptr<JsDesc> d: 0;]
		if not (JsObjs.IsIndexKey: key)
			if (NumericKey: key) return -1;
			return 0;
		;;
		ptr<JsViewData> v: (ViewOf: o);
		if (key as u32) >= (LenNow: v) return -1;
		if (d.flags & (JsObjs.H_GET | JsObjs.H_SET)) is not 0 return -1;
		if (ReadOnly: v) and (d.flags & JsObjs.H_VALUE) is not 0
			# the same value is no change
			if not (JsOps.SameValue: d.value (Load: (At: v key as u32) v.kind)) return -1;
		;;
		if (d.flags & JsObjs.H_C) is not 0 and (d.flags & JsObjs.C) is 0 return -1;
		if (d.flags & JsObjs.H_E) is not 0 and (d.flags & JsObjs.E) is 0 return -1;
		if (d.flags & JsObjs.H_W) is not 0 and (d.flags & JsObjs.W) is 0 return -1;
		if (d.flags & JsObjs.H_VALUE) is not 0
			u64 x: (Convert: v.kind d.value);
			if (key as u32) < (LenNow: v)
				call Put: (At: v key as u32) v.kind x;
			;;
		;;
	[end: 1]

	# element i set as by a script, through [[Set]]: converted first, written if it's still in bounds
	[SetElement: ptr<JsObj> o: 0; f64 i: 0.0; u64 val: 0;]
		ptr<JsViewData> v: (ViewOf: o);
		u64 x: (Convert: v.kind val);
		if i >= 0.0 and i < ((LenNow: v) as f64)
			call Put: (At: v i as u32) v.kind x;
		;;
	[end]

	[GetElement: ptr<JsObj> o: 0; u32 i: 0;]
		ptr<JsViewData> v: (ViewOf: o);
		if i >= (LenNow: v) return JsV.UNDEF;
	[end: (Load: (At: v i) v.kind)]

	# ---- making them ----

	[AbstractCtor: ptr<u64> args: 0; int argc: 0;]
		call JsErr.Type: 'Abstract class TypedArray not directly constructable';
	[end: JsV.UNDEF]

	[Make: u32 kind: 0; u64 buffer: 0; u32 offset: 0; u32 length: 0; ptr<JsObj> proto: 0;]
		ptr<JsViewData> v: new JsViewData;
		if v is 0
			throw 'out of memory';
		;;
		v.kind is kind;
		v.buffer is buffer;
		v.offset is offset;
		v.length is length;
		v.tracking is false;
		ptr<JsObj> o: (JsObjs.NewHost: array_class proto v as ptr<u8>);
	[end: o]

	[MakeSized: u32 kind: 0; f64 n: 0.0; ptr<JsObj> proto: 0;]
		f64 bytes: n * ((SizeOf: kind) as f64);
		if bytes > (MAX_BYTES as f64)
			call JsErr.Range: 'Invalid typed array length';
		;;
		ptr<JsObj> b: (NewBuffer: bytes JsRt.P.arraybuffer);
	[end: (Make: kind (JsV.Obj: b) 0 n as u32 proto)]

	[ArrayCtor: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		u32 kind: self.magic;
		u64 nt: (Js.NewTarget);
		if not (JsV.IsObj: nt)
			call JsErr.Type: 'Constructor of a typed array requires new';
		;;
		u64 first: (Js.Arg: args argc 0);
		if not (JsV.IsObj: first)
			f64 n: (ToIndex: first);
			return (JsV.Obj: (MakeSized: kind n (JsOps.ProtoFromCtor: nt (JsV.AsObj: self.data))));
		;;
		ptr<JsObj> proto: (JsOps.ProtoFromCtor: nt (JsV.AsObj: self.data));
		ptr<JsObj> fo: (JsV.AsObj: first);
		u32 size: (SizeOf: kind);
		if fo.cls is buffer_class or fo.cls is shared_class
			f64 off: (ToIndex: (Js.Arg: args argc 1));
			if (off % (size as f64)) is not 0.0
				call JsErr.Range: 'Start offset of a typed array must be a multiple of its element size';
			;;
			bln given: (Js.Arg: args argc 2) is not JsV.UNDEF;
			f64 count: 0.0;
			if given
				count is (ToIndex: args:2);
			;;
			ptr<JsBufferData> bd: fo.data as ptr<JsBufferData>;
			if bd.detached
				call JsErr.Type: 'The buffer is detached';
			;;
			f64 blen: bd.len as f64;
			if not given and bd.resizable
				if off > blen
					call JsErr.Range: 'Start offset is outside the bounds of the buffer';
				;;
				ptr<JsObj> tracked: (Make: kind first off as u32 0 proto);
				ptr<JsViewData> tv: (ViewOf: tracked);
				tv.tracking is true;
				return (JsV.Obj: tracked);
			;;
			if not given
				if (bd.len % size) is not 0
					call JsErr.Range: 'Byte length of a buffer must be a multiple of the element size';
				;;
				if off > blen
					call JsErr.Range: 'Start offset is outside the bounds of the buffer';
				;;
				count is (blen - off) / (size as f64);
			;;
			elif off + count * (size as f64) > blen
				call JsErr.Range: 'Invalid typed array length';
			;;
			return (JsV.Obj: (Make: kind first off as u32 count as u32 proto));
		;;
		if fo.cls is array_class
			ptr<JsViewData> src: (ViewOf: fo);
			if (OutOfBounds: src false)
				call JsErr.Type: 'The source typed array is detached or out of bounds';
			;;
			u32 sn: (LenNow: src);
			call SameContent: kind src.kind;
			ptr<JsObj> made: (MakeSized: kind sn as f64 proto);
			ptr<JsViewData> mv: (ViewOf: made);
			while u32 i: 0; i < sn; i++;
				call Put: (At: mv i) kind (Load: (At: src i) src.kind);
			;;
			return (JsV.Obj: made);
		;;
		# from an iterable if it is one, or else array-like
		u64 m: (JsOps.GetMethod: first JsRt.S.iterator as ptr<u8>);
		if m is not JsV.UNDEF
			ptr<JsObj> list: (JsObjs.NewArray: 0);
			call Js.Push: (JsV.Obj: list);
			call JsIter.Each: first addr ListItem list as ptr<u8>;
			ptr<JsObj> filled: (MakeSized: kind list.length as f64 proto);
			call Js.Push: (JsV.Obj: filled);
			while u32 j: 0; j < list.length; j++;
				call SetElement: filled j as f64 list.elems:j;
			;;
			return (JsV.Obj: filled);
		;;
		f64 len: (JsArrayBuiltins.LengthOf: fo);
		ptr<JsObj> made2: (MakeSized: kind len proto);
		call Js.Push: (JsV.Obj: made2);
		f64 k: 0.0;
		while k < len
			call SetElement: made2 k (JsObjs.Get: fo (JsArrayBuiltins.IndexKey: k) first);
			k is k + 1.0;
		;;
	[end: (JsV.Obj: made2)]

	[ListItem: u64 item: 0; ptr<u8> state: 0;]
		call JsObjs.ArrayPush: state as ptr<JsObj> item;
	[end]

	# this, a typed array, which mustn't be out of bounds (ValidateTypedArray)
	[ThisArray: ptr<u64> args: 0;]
		u64 t: args:(-1);
		if (IsClass: t array_class)
			ptr<JsObj> o: (JsV.AsObj: t);
			if (OutOfBounds: (ViewOf: o) false)
				call JsErr.Type: 'The typed array is detached or out of bounds';
			;;
			return o;
		;;
		call JsErr.Type: 'this is not a typed array';
	[end: 0 as ptr<JsObj>]

	# what's made by a constructor for a typed array, which must be one, in bounds, and if n is 0 or more,
	# at least that long (TypedArrayCreateFromConstructor)
	[Created: u64 made: 0; f64 n: -1.0;]
		if not (IsClass: made array_class)
			call JsErr.Type: 'The constructor did not make a typed array';
		;;
		ptr<JsObj> mo: (JsV.AsObj: made);
		ptr<JsViewData> mv: (ViewOf: mo);
		if (OutOfBounds: mv false)
			call JsErr.Type: 'The constructor made a typed array that is detached or out of bounds';
		;;
		if n >= 0.0 and ((LenNow: mv) as f64) < n
			call JsErr.Type: 'The constructor made a typed array too short';
		;;
	[end: mo]

	[IntrinsicCtor: u32 kind: 0;]
	[end: JsRt.P.typed_ctors.elems:kind]

	# a new typed array, by the species of an existing one, of length n (TypedArraySpeciesCreate)
	[SpeciesMake: ptr<JsObj> o: 0; f64 n: 0.0;]
		ptr<JsViewData> v: (ViewOf: o);
		u64 c: (JsOps.Species: (JsV.Obj: o) (IntrinsicCtor: v.kind));
		call Js.Push: (JsV.Num: n);
		ptr<JsObj> mo: (Created: (Js.Construct: c 1) n);
		ptr<JsViewData> mv: (ViewOf: mo);
		call SameContent: mv.kind v.kind;
		if (ReadOnly: mv)
			call JsErr.Type: 'The species constructor made a typed array on an immutable buffer';
		;;
	[end: mo]

	[KindName: u32 kind: 0;]
		when kind
			is INT8
				return 'Int8Array';
			;;
			is UINT8
				return 'Uint8Array';
			;;
			is UINT8C
				return 'Uint8ClampedArray';
			;;
			is INT16
				return 'Int16Array';
			;;
			is UINT16
				return 'Uint16Array';
			;;
			is INT32
				return 'Int32Array';
			;;
			is UINT32
				return 'Uint32Array';
			;;
			is FLOAT16
				return 'Float16Array';
			;;
			is FLOAT32
				return 'Float32Array';
			;;
			is BIGINT64
				return 'BigInt64Array';
			;;
			is BIGUINT64
				return 'BigUint64Array';
			;;
		;;
		ptr<u8> last: 'Float64Array';
	[end: last]

	[From: ptr<u64> args: 0; int argc: 0;]
		u64 c: args:(-1);
		if not (JsOps.IsConstructor: c)
			call JsErr.Type: 'TypedArray.from: this is not a constructor';
		;;
		u64 mapf: (Js.Arg: args argc 1);
		u64 this_arg: (Js.Arg: args argc 2);
		if mapf is not JsV.UNDEF and not (JsOps.IsCallable: mapf)
			call JsErr.Type: 'TypedArray.from: the mapper is not a function';
		;;
		u64 source: (Js.Arg: args argc 0);
		u64 m: (JsOps.GetMethod: source JsRt.S.iterator as ptr<u8>);
		if m is not JsV.UNDEF
			ptr<JsObj> list: (JsObjs.NewArray: 0);
			call Js.Push: (JsV.Obj: list);
			call JsIter.Each: source addr ListItem list as ptr<u8>;
			call Js.Push: (JsV.Uint: list.length);
			u64 made: (Js.Construct: c 1);
			ptr<JsObj> mo: (Created: made list.length as f64);
			call Js.Push: made;
			while u32 i: 0; i < list.length; i++;
				u64 v: list.elems:i;
				if mapf is not JsV.UNDEF
					v is (JsVm.Call2: mapf this_arg v (JsV.Uint: i));
				;;
				if not (JsObjs.Set: mo JsV.INT_BASE | i v made)
					call JsErr.Type: 'TypedArray.from: could not set an element';
				;;
			;;
			return made;
		;;
		ptr<JsObj> so: (JsOps.ToObject: source);
		call Js.Push: (JsV.Obj: so);
		f64 len: (JsArrayBuiltins.LengthOf: so);
		call Js.Push: (JsV.Num: len);
		u64 made2: (Js.Construct: c 1);
		ptr<JsObj> mo2: (Created: made2 len);
		call Js.Push: made2;
		f64 k: 0.0;
		while k < len
			u64 kv: (JsObjs.Get: so (JsArrayBuiltins.IndexKey: k) (JsV.Obj: so));
			if mapf is not JsV.UNDEF
				kv is (JsVm.Call2: mapf this_arg kv (JsV.Num: k));
			;;
			if not (JsObjs.Set: mo2 (JsArrayBuiltins.IndexKey: k) kv made2)
				call JsErr.Type: 'TypedArray.from: could not set an element';
			;;
			k is k + 1.0;
		;;
	[end: made2]

	[OfFn: ptr<u64> args: 0; int argc: 0;]
		u64 c: args:(-1);
		if not (JsOps.IsConstructor: c)
			call JsErr.Type: 'TypedArray.of: this is not a constructor';
		;;
		call Js.Push: (JsV.Int: argc);
		u64 made: (Js.Construct: c 1);
		ptr<JsObj> mo: (Created: made argc as f64);
		call Js.Push: made;
		while int i: 0; i < argc; i++;
			if not (JsObjs.Set: mo JsV.INT_BASE | i as u32 args:i made)
				call JsErr.Type: 'TypedArray.of: could not set an element';
			;;
		;;
	[end: made]

	# ---- its properties ----

	[GetBuffer: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisTyped: args);
	[end: v.buffer]

	[ViewBuffer: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisDataView: args);
	[end: v.buffer]

	[ThisTyped: ptr<u64> args: 0;]
		u64 t: args:(-1);
		if not (IsClass: t array_class)
			call JsErr.Type: 'this is not a typed array';
		;;
	[end: (ViewOf: (JsV.AsObj: t))]

	[GetByteLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisTyped: args);
	[end: (JsV.Uint: (LenNow: v) * (SizeOf: v.kind))]

	[GetByteOffset: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisTyped: args);
		if (OutOfBounds: v false) return (JsV.Int: 0);
	[end: (JsV.Uint: v.offset)]

	[GetLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisTyped: args);
	[end: (JsV.Uint: (LenNow: v))]

	[GetTag: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		if not (IsClass: t array_class)
			return JsV.UNDEF;
		;;
	[end: (Js.NewStringZ: (KindName: (ViewOf: (JsV.AsObj: t)).kind))]

	# One of Array.prototype's natives, once this is known to be a typed array in bounds. Its magic has
	# JsArrayMore.TYPED_CALL added, so the native can tell it's a typed array's method.
	[Checked: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		call ThisArray: args;
		ptr<JsNativeFn> orig: (JsV.AsObj: self.data) as ptr<JsNativeFn>;
	[end: (orig.fn: args argc)]

	# ---- its methods ----

	[SetFn: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		if not (IsClass: t array_class)
			call JsErr.Type: 'this is not a typed array';
		;;
		ptr<JsObj> o: (JsV.AsObj: t);
		ptr<JsViewData> v: (ViewOf: o);
		f64 off: (JsOps.ToInteger: (Js.Arg: args argc 1));
		if (ReadOnly: v)
			call JsErr.Type: 'The typed array\'s buffer is immutable';
		;;
		if off < 0.0
			call JsErr.Range: 'offset is out of bounds';
		;;
		u64 src: (Js.Arg: args argc 0);
		if (IsClass: src array_class)
			if (OutOfBounds: v false)
				call JsErr.Type: 'The typed array is detached or out of bounds';
			;;
			ptr<JsViewData> sv: (ViewOf: (JsV.AsObj: src));
			if (OutOfBounds: sv false)
				call JsErr.Type: 'The source typed array is detached or out of bounds';
			;;
			call SameContent: v.kind sv.kind;
			u32 n: (LenNow: sv);
			if off + (n as f64) > ((LenNow: v) as f64)
				call JsErr.Range: 'offset is out of bounds';
			;;
			if sv.kind is v.kind
				u32 size: (SizeOf: v.kind);
				call Mem.Move: (At: v off as u32) (At: sv 0) n * size;
				return JsV.UNDEF;
			;;
			# they may share a buffer, so what's read goes somewhere safe first
			ptr<u64> copy: new u64[n + 1];
			if copy is 0
				throw 'out of memory';
			;;
			while u32 i: 0; i < n; i++;
				copy:i is (Load: (At: sv i) sv.kind);
			;;
			while u32 j: 0; j < n; j++;
				call Put: (At: v (off as u32) + j) v.kind copy:j;
			;;
			free copy;
			return JsV.UNDEF;
		;;
		if (OutOfBounds: v false)
			call JsErr.Type: 'The typed array is detached or out of bounds';
		;;
		f64 tlen: (LenNow: v) as f64;
		ptr<JsObj> so: (JsOps.ToObject: src);
		call Js.Push: (JsV.Obj: so);
		f64 len: (JsArrayBuiltins.LengthOf: so);
		if off + len > tlen
			call JsErr.Range: 'offset is out of bounds';
		;;
		f64 k: 0.0;
		while k < len
			u64 e: (JsObjs.Get: so (JsArrayBuiltins.IndexKey: k) (JsV.Obj: so));
			call SetElement: o off + k e;
			k is k + 1.0;
		;;
	[end: JsV.UNDEF]

	[Subarray: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		if not (IsClass: t array_class)
			call JsErr.Type: 'this is not a typed array';
		;;
		ptr<JsObj> o: (JsV.AsObj: t);
		ptr<JsViewData> v: (ViewOf: o);
		f64 len: (LenNow: v) as f64;
		f64 first: (JsOps.RelativeIndex: (Js.Arg: args argc 0) len 0.0);
		u64 end_arg: (Js.Arg: args argc 1);
		u64 c: (JsOps.Species: t (IntrinsicCtor: v.kind));
		f64 begin_at: (v.offset as f64) + first * ((SizeOf: v.kind) as f64);
		call Js.Push: v.buffer;
		call Js.Push: (JsV.Num: begin_at);
		if v.tracking and end_arg is JsV.UNDEF
			ptr<JsObj> m2: (Created: (Js.Construct: c 2) -1.0);
			call SameContent: (ViewOf: m2).kind v.kind;
			return (JsV.Obj: m2);
		;;
		f64 last: (JsOps.RelativeIndex: end_arg len len);
		f64 count: last - first;
		if count < 0.0
			count is 0.0;
		;;
		call Js.Push: (JsV.Num: count);
		ptr<JsObj> m3: (Created: (Js.Construct: c 3) -1.0);
		call SameContent: (ViewOf: m3).kind v.kind;
	[end: (JsV.Obj: m3)]

	[Slice: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisArray: args);
		ptr<JsViewData> v: (ViewOf: o);
		f64 len: (LenNow: v) as f64;
		f64 first: (JsOps.RelativeIndex: (Js.Arg: args argc 0) len 0.0);
		f64 last: (JsOps.RelativeIndex: (Js.Arg: args argc 1) len len);
		f64 count: last - first;
		if count < 0.0
			count is 0.0;
		;;
		ptr<JsObj> made: (SpeciesMake: o count);
		if count > 0.0
			if (OutOfBounds: v false)
				call JsErr.Type: 'The typed array is detached or out of bounds';
			;;
			f64 now: (LenNow: v) as f64;
			if last > now
				last is now;
			;;
			ptr<JsViewData> mv: (ViewOf: made);
			if mv.kind is v.kind and last > first
				call Mem.Move: (At: mv 0) (At: v first as u32) ((last - first) as u32) * (SizeOf: v.kind);
				return (JsV.Obj: made);
			;;
			f64 k: first;
			u32 n: 0;
			while k < last
				call Put: (At: mv n) mv.kind (Load: (At: v k as u32) v.kind);
				n++;
				k is k + 1.0;
			;;
		;;
	[end: (JsV.Obj: made)]

	[MapFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisArray: args);
		u64 ov: args:(-1);
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		u64 f: (Js.Arg: args argc 0);
		if not (JsOps.IsCallable: f)
			call JsErr.Type: 'callback is not a function';
		;;
		u64 this_arg: (Js.Arg: args argc 1);
		ptr<JsObj> made: (SpeciesMake: o n as f64);
		call Js.Push: (JsV.Obj: made);
		while u32 i: 0; i < n; i++;
			call Js.Checkpoint;
			u64 r: (JsVm.Call3: f this_arg (GetElement: o i) (JsV.Uint: i) ov);
			if not (JsObjs.Set: made JsV.INT_BASE | i r (JsV.Obj: made))
				call JsErr.Type: 'could not set an element';
			;;
		;;
	[end: (JsV.Obj: made)]

	[FilterFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisArray: args);
		u64 ov: args:(-1);
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		u64 f: (Js.Arg: args argc 0);
		if not (JsOps.IsCallable: f)
			call JsErr.Type: 'callback is not a function';
		;;
		u64 this_arg: (Js.Arg: args argc 1);
		ptr<JsObj> kept: (JsObjs.NewArray: 0);
		call Js.Push: (JsV.Obj: kept);
		while u32 i: 0; i < n; i++;
			call Js.Checkpoint;
			u64 e: (GetElement: o i);
			if (JsOps.ToBool: (JsVm.Call3: f this_arg e (JsV.Uint: i) ov))
				call JsObjs.ArrayPush: kept e;
			;;
		;;
		ptr<JsObj> made: (SpeciesMake: o kept.length as f64);
		call Js.Push: (JsV.Obj: made);
		while u32 j: 0; j < kept.length; j++;
			call SetElement: made j as f64 kept.elems:j;
		;;
	[end: (JsV.Obj: made)]

	# the elements of o, sorted by cmp, in a new array on the value stack
	[Sorted: ptr<JsObj> o: 0; u64 cmp: 0;]
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		ptr<JsObj> a: (JsObjs.NewArray: n);
		call Js.Push: (JsV.Obj: a);
		ptr<JsObj> b: (JsObjs.NewArray: n);
		call Js.Push: (JsV.Obj: b);
		while u32 i: 0; i < n; i++;
			call JsObjs.ArrayPush: a (Load: (At: v i) v.kind);
			call JsObjs.ArrayPush: b JsV.UNDEF;
		;;
		call SortRuns: a.elems b.elems n cmp;
	[end: a]

	# by number, with -0 before 0 and NaN last, unless a function says otherwise
	[Sort: ptr<u64> args: 0; int argc: 0;]
		u64 cmp: (Js.Arg: args argc 0);
		if cmp is not JsV.UNDEF and not (JsOps.IsCallable: cmp)
			call JsErr.Type: 'The comparison function must be either a function or undefined';
		;;
		ptr<JsObj> o: (ThisWritable: args);
		ptr<JsObj> a: (Sorted: o cmp);
		while u32 j: 0; j < a.length; j++;
			call SetElement: o j as f64 a.elems:j;
		;;
	[end: args:(-1)]

	[ToSorted: ptr<u64> args: 0; int argc: 0;]
		u64 cmp: (Js.Arg: args argc 0);
		if cmp is not JsV.UNDEF and not (JsOps.IsCallable: cmp)
			call JsErr.Type: 'The comparison function must be either a function or undefined';
		;;
		ptr<JsObj> o: (ThisArray: args);
		ptr<JsViewData> v: (ViewOf: o);
		ptr<JsObj> made: (SameType: v (LenNow: v));
		call Js.Push: (JsV.Obj: made);
		ptr<JsObj> a: (Sorted: o cmp);
		while u32 j: 0; j < a.length; j++;
			call SetElement: made j as f64 a.elems:j;
		;;
	[end: (JsV.Obj: made)]

	# a typed array of the same kind, of the kind's own prototype (TypedArrayCreateSameType)
	[SameType: ptr<JsViewData> v: 0; u32 n: 0;]
		ptr<JsNativeFn> c: (JsV.AsObj: (IntrinsicCtor: v.kind)) as ptr<JsNativeFn>;
	[end: (MakeSized: v.kind n as f64 (JsV.AsObj: c.data))]

	[ToReversed: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisArray: args);
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		ptr<JsObj> made: (SameType: v n);
		ptr<JsViewData> mv: (ViewOf: made);
		while u32 k: 0; k < n; k++;
			call Put: (At: mv k) v.kind (Load: (At: v n - 1 - k) v.kind);
		;;
	[end: (JsV.Obj: made)]

	[WithFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisArray: args);
		ptr<JsViewData> v: (ViewOf: o);
		f64 len: (LenNow: v) as f64;
		f64 rel: (JsOps.ToInteger: (Js.Arg: args argc 0));
		f64 index: rel;
		if rel < 0.0
			index is len + rel;
		;;
		u64 x: (Convert: v.kind (Js.Arg: args argc 1));
		call Js.Push: x;
		if not (index >= 0.0 and index < ((LenNow: v) as f64))
			call JsErr.Range: 'Invalid typed array index';
		;;
		ptr<JsObj> made: (SameType: v len as u32);
		ptr<JsViewData> mv: (ViewOf: made);
		while u32 k: 0; k < len as u32; k++;
			if (k as f64) is index
				call Put: (At: mv k) v.kind x;
			;;
			else
				call Put: (At: mv k) v.kind (Convert: v.kind (GetElement: o k));
			;;
		;;
	[end: (JsV.Obj: made)]

	[Fill: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisWritable: args);
		ptr<JsViewData> v: (ViewOf: o);
		f64 len: (LenNow: v) as f64;
		u64 x: (Convert: v.kind (Js.Arg: args argc 0));
		call Js.Push: x;
		f64 first: (JsOps.RelativeIndex: (Js.Arg: args argc 1) len 0.0);
		f64 last: (JsOps.RelativeIndex: (Js.Arg: args argc 2) len len);
		if (OutOfBounds: v false)
			call JsErr.Type: 'The typed array is detached or out of bounds';
		;;
		f64 now: (LenNow: v) as f64;
		if last > now
			last is now;
		;;
		f64 k: first;
		while k < last
			call Put: (At: v k as u32) v.kind x;
			k is k + 1.0;
		;;
	[end: args:(-1)]

	[CopyWithin: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisWritable: args);
		ptr<JsViewData> v: (ViewOf: o);
		f64 len: (LenNow: v) as f64;
		f64 to: (JsOps.RelativeIndex: (Js.Arg: args argc 0) len 0.0);
		f64 from: (JsOps.RelativeIndex: (Js.Arg: args argc 1) len 0.0);
		f64 final: (JsOps.RelativeIndex: (Js.Arg: args argc 2) len len);
		f64 count: final - from;
		if len - to < count
			count is len - to;
		;;
		if count <= 0.0
			return args:(-1);
		;;
		if (OutOfBounds: v false)
			call JsErr.Type: 'The typed array is detached or out of bounds';
		;;
		u32 size: (SizeOf: v.kind);
		u64 limit: ((LenNow: v) as u64) * size as u64 + v.offset as u64;
		u64 to_byte: (to as u64) * size as u64 + v.offset as u64;
		u64 from_byte: (from as u64) * size as u64 + v.offset as u64;
		u64 bytes: (count as u64) * size as u64;
		ptr<u8> p: (BufferOf: v).bytes;
		if from_byte < to_byte and to_byte < from_byte + bytes
			from_byte is from_byte + bytes - 1;
			to_byte is to_byte + bytes - 1;
			while bytes > 0
				if from_byte < limit and to_byte < limit
					p:(to_byte as u32) is p:(from_byte as u32);
				;;
				from_byte--;
				to_byte--;
				bytes--;
			;;
		;;
		else
			while bytes > 0
				if from_byte < limit and to_byte < limit
					p:(to_byte as u32) is p:(from_byte as u32);
				;;
				from_byte++;
				to_byte++;
				bytes--;
			;;
		;;
	[end: args:(-1)]

	[Reverse: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisWritable: args);
		ptr<JsViewData> v: (ViewOf: o);
		u32 n: (LenNow: v);
		u32 size: (SizeOf: v.kind);
		u8 swap[8];
		u32 lo: 0;
		while lo + 1 < n - lo
			ptr<u8> a: (At: v lo);
			ptr<u8> b: (At: v n - 1 - lo);
			call Mem.Copy: addr swap:0 a size;
			call Mem.Copy: a b size;
			call Mem.Copy: b addr swap:0 size;
			lo++;
		;;
	[end: args:(-1)]

	[SortRuns: ptr<u64> items: 0; ptr<u64> other: 0; u32 n: 0; u64 cmp: 0;]
		ptr<u64> from: items;
		ptr<u64> to: other;
		u32 width: 1;
		while width < n
			u32 lo: 0;
			while lo < n
				u32 mid: lo + width;
				if mid > n
					mid is n;
				;;
				u32 hi: mid + width;
				if hi > n
					hi is n;
				;;
				u32 l: lo;
				u32 r: mid;
				u32 place: lo;
				while l < mid or r < hi
					if r >= hi or (l < mid and (Less: from:l from:r cmp))
						to:place is from:l;
						l++;
					;;
					else
						to:place is from:r;
						r++;
					;;
					place++;
				;;
				lo is hi;
			;;
			ptr<u64> swap: from;
			from is to;
			to is swap;
			width is width * 2;
		;;
		if from is not items
			call Mem.Copy: items as ptr<u8> from as ptr<u8> n * 8;
		;;
	[end]

	# whether a stays in front of b
	[Less: u64 a: 0; u64 b: 0; u64 cmp: 0;]
		call Js.Checkpoint;
		if cmp is not JsV.UNDEF
			f64 r: (JsOps.ToNumber: (JsVm.Call2: cmp JsV.UNDEF a b));
			return not (r > 0.0);
		;;
		if (JsV.IsBig: a)
			return (JsBig.Compare: a b) <= 0;
		;;
		f64 x: (JsV.AsNum: a);
		f64 y: (JsV.AsNum: b);
		if x is not x return y is not y;
		if y is not y return true;
		if x < y return true;
		if x > y return false;
		if x is 0.0 and y is 0.0
			return (WlNum.IsNegative: x) or not (WlNum.IsNegative: y);
		;;
	[end: true]

	# ---- DataView ----

	[ViewCtor: ptr<u64> args: 0; int argc: 0;]
		u64 nt: (Js.NewTarget);
		if not (JsV.IsObj: nt)
			call JsErr.Type: 'Constructor DataView requires new';
		;;
		u64 bv: (Js.Arg: args argc 0);
		if not (IsBuffer: bv)
			call JsErr.Type: 'First argument to DataView constructor must be an ArrayBuffer';
		;;
		f64 off: (ToIndex: (Js.Arg: args argc 1));
		ptr<JsBufferData> bd: (BytesData: bv);
		if bd.detached
			call JsErr.Type: 'The buffer is detached';
		;;
		if off > (bd.len as f64)
			call JsErr.Range: 'Start offset is outside the bounds of the buffer';
		;;
		bln given: (Js.Arg: args argc 2) is not JsV.UNDEF;
		bln tracking: not given and bd.resizable;
		f64 count: (bd.len as f64) - off;
		if given
			count is (ToIndex: args:2);
			if off + count > (bd.len as f64)
				call JsErr.Range: 'Invalid DataView length';
			;;
		;;
		ptr<JsObj> proto: (JsOps.ProtoFromCtor: nt JsRt.P.dataview);
		# that could have run a script, which could have changed the buffer
		if bd.detached
			call JsErr.Type: 'The buffer is detached';
		;;
		if off > (bd.len as f64)
			call JsErr.Range: 'Start offset is outside the bounds of the buffer';
		;;
		if given and off + count > (bd.len as f64)
			call JsErr.Range: 'Invalid DataView length';
		;;
		if not given and not tracking
			count is (bd.len as f64) - off;
		;;
		ptr<JsViewData> v: new JsViewData;
		if v is 0
			throw 'out of memory';
		;;
		v.buffer is bv;
		v.offset is off as u32;
		v.length is count as u32;
		v.tracking is tracking;
		v.kind is UINT8;
		ptr<JsObj> o: (JsObjs.NewHost: view_class proto v as ptr<u8>);
	[end: (JsV.Obj: o)]

	[ThisDataView: ptr<u64> args: 0;]
		u64 t: args:(-1);
		if (IsClass: t view_class)
			return (ViewOf: (JsV.AsObj: t));
		;;
		call JsErr.Type: 'this is not a DataView';
	[end: 0 as ptr<JsViewData>]

	[ViewByteLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisDataView: args);
		ptr<JsBufferData> vd: (BufferOf: v);
		if vd.detached return (JsV.Int: 0);
		if (OutOfBounds: v true) return (JsV.Int: 0);
	[end: (JsV.Uint: (ViewBytesNow: v))]

	[ViewByteOffset: ptr<u64> args: 0; int argc: 0;]
		ptr<JsViewData> v: (ThisDataView: args);
		ptr<JsBufferData> vd: (BufferOf: v);
		if vd.detached return (JsV.Int: 0);
		if (OutOfBounds: v true) return (JsV.Int: 0);
	[end: (JsV.Uint: v.offset)]

	# the element's bytes, in the machine's order, in tmp
	u8 tmp[8];

	[ViewGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		u32 kind: self.magic;
		ptr<JsViewData> v: (ThisDataView: args);
		f64 at_: (ToIndex: (Js.Arg: args argc 0));
		bln little: (JsOps.ToBool: (Js.Arg: args argc 1));
		if (OutOfBounds: v true)
			call JsErr.Type: 'The DataView is detached or out of bounds';
		;;
		u32 size: (SizeOf: kind);
		if at_ + (size as f64) > ((ViewBytesNow: v) as f64)
			call JsErr.Range: 'Offset is outside the bounds of the DataView';
		;;
		ptr<JsBufferData> bd: (BufferOf: v);
		ptr<u8> p: bd.bytes + v.offset + at_ as u32;
		while u32 i: 0; i < size; i++;
			if little
				tmp:i is p:i;
			;;
			else
				tmp:i is p:(size - 1 - i);
			;;
		;;
	[end: (Load: addr tmp:0 kind)]

	[ViewSet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		u32 kind: self.magic;
		ptr<JsViewData> v: (ThisDataView: args);
		if (ReadOnly: v)
			call JsErr.Type: 'The DataView\'s buffer is immutable';
		;;
		f64 at_: (ToIndex: (Js.Arg: args argc 0));
		u64 x: (Convert: kind (Js.Arg: args argc 1));
		bln little: (JsOps.ToBool: (Js.Arg: args argc 2));
		if (OutOfBounds: v true)
			call JsErr.Type: 'The DataView is detached or out of bounds';
		;;
		u32 size: (SizeOf: kind);
		if at_ + (size as f64) > ((ViewBytesNow: v) as f64)
			call JsErr.Range: 'Offset is outside the bounds of the DataView';
		;;
		call Put: addr tmp:0 kind x;
		ptr<JsBufferData> bd: (BufferOf: v);
		ptr<u8> p: bd.bytes + v.offset + at_ as u32;
		while u32 i: 0; i < size; i++;
			if little
				p:i is tmp:i;
			;;
			else
				p:i is tmp:(size - 1 - i);
			;;
		;;
	[end: JsV.UNDEF]
}
