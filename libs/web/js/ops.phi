# The language's abstract operations: conversions, equality, comparison, addition, typeof,
# instanceof; and errors. A native calls JsErr.Type: 'message' and that's the end of it: the error
# is recorded and a PHI throw takes it to the nearest handler, wherever that is.

phi.JsErr:Library
{
	# the value goes up as a JS exception
	[Throw: u64 v: 0;]
		ptr<JsRuntime> r: JsRt.r;
		r.exception is v;
		r.has_exception is true;
		throw 'js';
	[end]

	[Type: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.type_error msg));
	[end]

	[Range: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.range_error msg));
	[end]

	[Reference: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.reference_error msg));
	[end]

	[Syntax: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.syntax_error msg));
	[end]

	[Eval: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.eval_error msg));
	[end]

	[Uri: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.uri_error msg));
	[end]

	[Internal: ptr<u8> msg: 0;]
		call Throw: (JsV.Obj: (Make: JsRt.P.internal_error msg));
	[end]

	# an Error object, with the given prototype, message and a stack
	[Make: ptr<JsObj> proto: 0; ptr<u8> msg: 0;]
		ptr<JsObj> e: (JsObjs.Alloc: sizeof JsObj JsGc.K_ERROR proto);
		ptr<JsStr> text: (JsStrs.FromUtf8: msg (WlText.LenZ: msg));
		call JsObjs.AddProp: e JsRt.A.message as ptr<u8> (JsV.Str: text) JsObjs.WC;
		call AddStack: e;
	[end: e]

	# the same with a message that's already a string
	[MakeStr: ptr<JsObj> proto: 0; ptr<JsStr> text: 0;]
		ptr<JsObj> e: (JsObjs.Alloc: sizeof JsObj JsGc.K_ERROR proto);
		call JsObjs.AddProp: e JsRt.A.message as ptr<u8> (JsV.Str: text) JsObjs.WC;
		call AddStack: e;
	[end: e]

	# `stack` on an error: its name and message, then the JS frames, at most 16 of them
	[AddStack: ptr<JsObj> e: 0;]
		WlBuf b;
		ptr<JsObj> walk: e;
		u64 nm: JsV.UNDEF;
		u64 ms: JsV.UNDEF;
		ptr<JsProp> p: 0;
		while walk is not 0 and p is 0
			p is (JsObjs.Find: walk JsRt.A.name as ptr<u8>);
			walk is walk.proto;
		;;
		if p is not 0 and (p.flags & JsObjs.ACC) is 0
			nm is p.value;
		;;
		walk is e;
		p is 0;
		while walk is not 0 and p is 0
			p is (JsObjs.Find: walk JsRt.A.message as ptr<u8>);
			walk is walk.proto;
		;;
		if p is not 0 and (p.flags & JsObjs.ACC) is 0
			ms is p.value;
		;;
		if (JsV.IsStr: nm)
			ptr<JsStr> ns: (JsStrs.Flat: (JsV.AsStr: nm));
			call b.AddN: ns.data ns.bytes;
		;;
		else
			call b.AddZ: 'Error';
		;;
		if (JsV.IsStr: ms)
			ptr<JsStr> mz: (JsStrs.Flat: (JsV.AsStr: ms));
			if mz.bytes > 0
				call b.AddZ: ': ';
				call b.AddN: mz.data mz.bytes;
			;;
		;;
		call AddFrames: addr b;
		ptr<JsStr> text: (JsStrs.New: b.data b.len);
		call b.Free;
		call JsObjs.DefineValue: e JsRt.A.stack as ptr<u8> (JsV.Str: text) JsObjs.WC;
	[end]

	[AddFrames: ptr<WlBuf> b: 0;]
		ptr<JsRuntime> r: JsRt.r;
		ptr<JsFrame> f: JsVm.fr;
		int shown: 0;
		bln top: true;
		while f > r.frames and shown < 16
			ptr<JsCode> co: f.code;
			if co is not 0
				call b.AddZ: '\n    at ';
				ptr<u32> at_pc: f.pc;
				if top
					at_pc is JsVm.pc;
				;;
				u32 line: (JsCodes.LineAt: co at_pc);
				bln named: co.name is not 0 and co.name.bytes > 0;
				if named
					ptr<JsStr> fnm: (JsStrs.Flat: co.name);
					call b.AddN: fnm.data fnm.bytes;
					call b.AddZ: ' (';
				;;
				if co.src is not 0 and co.src.name is not 0
					ptr<JsStr> sn: (JsStrs.Flat: co.src.name);
					call b.AddN: sn.data sn.bytes;
				;;
				else
					call b.AddZ: '<anonymous>';
				;;
				call b.Add: ':';
				call b.AddInt: line as int;
				if named
					call b.Add: ')';
				;;
				shown++;
			;;
			top is false;
			f is f - sizeof JsFrame;
		;;
	[end]
}

phi.JsOps:Library
{
	const int HINT_DEFAULT: 0;
	const int HINT_NUMBER: 1;
	const int HINT_STRING: 2;

	# ---- to primitive ----

	[ToPrimitive: u64 v: 0; int hint: 0;]
		if (v >> 48) as u32 is not JsV.TAG_OBJ return v;
		ptr<JsObj> o: (JsV.AsObj: v);
		u64 ex: (JsObjs.GetAtom: o JsRt.S.toPrimitive as ptr<u8> v);
		if ex is not JsV.UNDEF and ex is not JsV.NULL
			if not (IsCallable: ex)
				call JsErr.Type: 'Symbol.toPrimitive is not a function';
			;;
			ptr<JsStr> h: JsRt.A.default_;
			if hint is HINT_NUMBER
				h is JsRt.A.number;
			;;
			elif hint is HINT_STRING
				h is JsRt.A.string;
			;;
			u64 got: (JsVm.Call1: ex v (JsV.Str: h));
			if (JsV.IsObj: got)
				call JsErr.Type: 'Cannot convert object to primitive value';
			;;
			return got;
		;;
		ptr<JsStr> first: JsRt.A.valueOf;
		ptr<JsStr> second: JsRt.A.toString;
		if hint is HINT_STRING
			first is JsRt.A.toString;
			second is JsRt.A.valueOf;
		;;
		u64 m: (JsObjs.GetAtom: o first as ptr<u8> v);
		if (IsCallable: m)
			u64 r1: (JsVm.Call0: m v);
			if not (JsV.IsObj: r1) return r1;
		;;
		m is (JsObjs.GetAtom: o second as ptr<u8> v);
		if (IsCallable: m)
			u64 r2: (JsVm.Call0: m v);
			if not (JsV.IsObj: r2) return r2;
		;;
		call JsErr.Type: 'Cannot convert object to primitive value';
	[end: 0 as u64]

	# ---- to number ----

	[ToNumber: u64 v: 0;]
		u32 tag: (v >> 48) as u32;
		if tag is JsV.TAG_INT
			return (v as int) as f64;
		;;
		if tag < JsV.TAG_SPECIAL
			return (JsV.AsNum: v);
		;;
		if tag is JsV.TAG_STR
			return (StrToNum: (JsV.AsStr: v));
		;;
		if tag is JsV.TAG_SPECIAL
			if v is JsV.TRUE return 1.0;
			if v is JsV.FALSE or v is JsV.NULL return 0.0;
			return (WlNum.FromBits: JsV.NAN);
		;;
		if tag is JsV.TAG_SYM
			call JsErr.Type: 'Cannot convert a Symbol value to a number';
		;;
		f64 from_prim: (ToNumber: (ToPrimitive: v HINT_NUMBER));
	[end: from_prim]

	[IsSpace: u32 c: 0;]
		if c < 128
			return c is 32 or (c >= 9 and c <= 13);
		;;
		if c is 0xA0 or c is 0x1680 or c is 0x2028 or c is 0x2029 or c is 0x202F or c is 0x205F or c is 0x3000 or c is 0xFEFF
			return true;
		;;
	[end: c >= 0x2000 and c <= 0x200A]

	# the bytes of s without JS whitespace at either end: JsOps.trim_start, JsOps.trim_len
	u32 trim_start: 0;
	u32 trim_len: 0;

	[Trim: ptr<JsStr> s: 0; bln at_start: true; bln at_stop: true;]
		call JsStrs.Flat: s;
		ptr<u8> p: s.data;
		u32 a: 0;
		u32 z: s.bytes;
		while at_start and a < z
			u32 c: (DecodeWtf8: p + a z - a);
			if not (IsSpace: c) break;
			a++ decoded_width;
		;;
		while at_stop and z > a
			# back to where the last character starts
			u32 at_char: z - 1;
			while at_char > a and (p:at_char & 0xC0) is 0x80
				at_char--;
			;;
			u32 l: (DecodeWtf8: p + at_char z - at_char);
			if not (IsSpace: l) break;
			z is at_char;
		;;
		trim_start is a;
		trim_len is z - a;
	[end]

	u32 decoded_width: 1;

	# a code point of WTF-8: surrogates come through as themselves
	[DecodeWtf8: ptr<u8> p: 0; u32 n: 0;]
		u32 c: p:0;
		decoded_width is 1;
		if c < 0x80 or n < 2 return c;
		if c < 0xE0
			decoded_width is 2;
			return ((c & 31) << 6) | (p:1 & 63);
		;;
		if n < 3 return c;
		if c < 0xF0
			decoded_width is 3;
			return ((c & 15) << 12) | ((p:1 & 63) << 6) | (p:2 & 63);
		;;
		if n < 4 return c;
		decoded_width is 4;
	[end: ((c & 7) << 18) | ((p:1 & 63) << 12) | ((p:2 & 63) << 6) | (p:3 & 63)]

	[StrToNum: ptr<JsStr> s: 0;]
		call Trim: s;
		u32 n: trim_len;
		if n is 0 return 0.0;
		ptr<u8> p: s.data + trim_start;
		if n > 2 and p:0 is '0'
			u32 x: p:1 | 32;
			int radix: 0;
			if x is 'x'
				radix is 16;
			;;
			elif x is 'o'
				radix is 8;
			;;
			elif x is 'b'
				radix is 2;
			;;
			if radix is not 0
				return (WlNum.ParseRadix: p + 2 n - 2 radix);
			;;
		;;
		bln neg: false;
		if p:0 is '+' or p:0 is '-'
			neg is (p:0 is '-');
			p is p + 1;
			n--;
		;;
		f64 result: 0.0;
		if (WlText.EqZ: p n 'Infinity')
			result is (WlNum.FromBits: 0x7FF0000000000000);
		;;
		else
			result is (WlNum.Parse: p n);
		;;
		if neg
			return result * -1.0;
		;;
	[end: result]

	[ToInt32Num: f64 x: 0.0;]
		if x > -2147483649.0 and x < 2147483648.0
			return x as int;
		;;
		if x is not x or not (WlNum.IsFinite: x) return 0;
		f64 t: (Float.Trunc: x) % 4294967296.0;
		if t < 0.0
			t is t + 4294967296.0;
		;;
		if t >= 2147483648.0
			t is t - 4294967296.0;
		;;
	[end: t as int]

	[ToUint32Num: f64 x: 0.0;]
	[end: (ToInt32Num: x) as u32]

	[ToInt32: u64 v: 0;]
		if (v >> 48) as u32 is JsV.TAG_INT return v as int;
	[end: (ToInt32Num: (ToNumber: v))]

	[ToUint32: u64 v: 0;]
		if (v >> 48) as u32 is JsV.TAG_INT return v as u32;
	[end: (ToInt32Num: (ToNumber: v)) as u32]

	# ToIntegerOrInfinity
	[ToInteger: u64 v: 0;]
		if (v >> 48) as u32 is JsV.TAG_INT
			return (v as int) as f64;
		;;
		f64 x: (ToNumber: v);
		if x is not x return 0.0;
		if not (WlNum.IsFinite: x) return x;
		f64 t: (Float.Trunc: x);
		# (-0 becomes 0)
		if t is 0.0 return 0.0;
	[end: t]

	# ToLength, kept to 2^53 - 1
	[ToLength: u64 v: 0;]
		f64 x: (ToInteger: v);
		if x <= 0.0 return 0.0;
		if x > 9007199254740991.0 return 9007199254740991.0;
	[end: x]

	# a relative index argument, as slice and friends take them, clamped to 0..len
	[RelativeIndex: u64 v: 0; f64 len: 0.0; f64 otherwise: 0.0;]
		if v is JsV.UNDEF return otherwise;
		f64 x: (ToInteger: v);
		if x < 0.0
			x is x + len;
			if x < 0.0 return 0.0;
			return x;
		;;
		if x > len return len;
	[end: x]

	# ---- to boolean ----

	[ToBool: u64 v: 0;]
		u32 tag: (v >> 48) as u32;
		if tag is JsV.TAG_SPECIAL return v is JsV.TRUE;
		if tag is JsV.TAG_INT return (v as u32) is not 0;
		if tag is JsV.TAG_OBJ or tag is JsV.TAG_SYM return true;
		if tag is JsV.TAG_STR
			ptr<JsStr> s: (JsV.AsStr: v);
			return s.bytes is not 0;
		;;
		f64 d: (JsV.AsNum: v);
	[end: d is d and d is not 0.0]

	# ---- to string ----

	[IntToStr: int i: 0;]
		if i >= 0 and i < 10
			return (JsStrs.FromUnit: ('0' + i) as u32);
		;;
		u8 tmp[12];
		int n: 12;
		u32 m: i as u32;
		if i < 0
			m is (0 - i) as u32;
		;;
		while m is not 0
			n--;
			tmp:n is ('0' + m % 10) as u8;
			m is m / 10;
		;;
		if i < 0
			n--;
			tmp:n is '-';
		;;
	[end: (JsStrs.New: (addr tmp) + n (12 - n) as u32)]

	[NumToStr: f64 x: 0.0;]
		WlBuf b;
		call WlNum.ToText: x addr b;
		ptr<JsStr> s: (JsStrs.New: b.data b.len);
		call b.Free;
	[end: s]

	[ToStr: u64 v: 0;]
		u32 tag: (v >> 48) as u32;
		if tag is JsV.TAG_STR return (JsV.AsStr: v);
		if tag is JsV.TAG_INT return (IntToStr: v as int);
		if tag is JsV.TAG_SPECIAL
			if v is JsV.UNDEF return JsRt.A.undefined;
			if v is JsV.NULL return JsRt.A.null;
			if v is JsV.TRUE return JsRt.A.true_;
			return JsRt.A.false_;
		;;
		if tag < JsV.TAG_SPECIAL return (NumToStr: (JsV.AsNum: v));
		if tag is JsV.TAG_SYM
			call JsErr.Type: 'Cannot convert a Symbol value to a string';
		;;
		ptr<JsStr> from_prim: (ToStr: (ToPrimitive: v HINT_STRING));
	[end: from_prim]

	# ---- to object ----

	[ToObject: u64 v: 0;]
		u32 tag: (v >> 48) as u32;
		if tag is JsV.TAG_OBJ return (JsV.AsObj: v);
		if v is JsV.UNDEF or v is JsV.NULL
			call JsErr.Type: 'Cannot convert undefined or null to object';
		;;
		ptr<JsObj> box: (JsObjs.Alloc: sizeof JsObj JsGc.K_BOXED (JsObjs.PrimProto: v));
		box.slot is v;
		if tag is JsV.TAG_STR
			box.flags is JsObjs.F_SPECIAL as u16;
		;;
	[end: box]

	# ---- equality ----

	[StrictEq: u64 a: 0; u64 b: 0;]
		u32 ta: (a >> 48) as u32;
		u32 tb: (b >> 48) as u32;
		if ta is JsV.TAG_STR
			if tb is not JsV.TAG_STR return false;
			return (JsStrs.Eq: (JsV.AsStr: a) (JsV.AsStr: b));
		;;
		bln na: ta < JsV.TAG_SPECIAL or ta is JsV.TAG_INT;
		bln nb: tb < JsV.TAG_SPECIAL or tb is JsV.TAG_INT;
		if na and nb
			if ta is JsV.TAG_INT and tb is JsV.TAG_INT
				return (a as u32) is (b as u32);
			;;
			return (JsV.AsNum: a) is (JsV.AsNum: b);
		;;
	[end: a is b]

	[LooseEq: u64 a: 0; u64 b: 0;]
		while true
			u32 ta: (a >> 48) as u32;
			u32 tb: (b >> 48) as u32;
			bln na: ta < JsV.TAG_SPECIAL or ta is JsV.TAG_INT;
			bln nb: tb < JsV.TAG_SPECIAL or tb is JsV.TAG_INT;
			if na and nb return (StrictEq: a b);
			if ta is JsV.TAG_STR and tb is JsV.TAG_STR return (StrictEq: a b);
			if ta is JsV.TAG_SPECIAL and tb is JsV.TAG_SPECIAL
				if (JsV.IsNil: a) and (JsV.IsNil: b) return true;
				if (JsV.IsNil: a) or (JsV.IsNil: b) return false;
				return a is b;
			;;
			if (JsV.IsNil: a) or (JsV.IsNil: b) return false;
			if ta is JsV.TAG_OBJ and tb is JsV.TAG_OBJ return a is b;
			if ta is JsV.TAG_SYM and tb is JsV.TAG_SYM return a is b;
			if (JsV.IsBool: a)
				a is (JsV.Int: (a is JsV.TRUE) as int);
				continue;
			;;
			if (JsV.IsBool: b)
				b is (JsV.Int: (b is JsV.TRUE) as int);
				continue;
			;;
			if ta is JsV.TAG_OBJ
				a is (ToPrimitive: a HINT_DEFAULT);
				continue;
			;;
			if tb is JsV.TAG_OBJ
				b is (ToPrimitive: b HINT_DEFAULT);
				continue;
			;;
			if ta is JsV.TAG_SYM or tb is JsV.TAG_SYM return false;
			# a string and a number
			return (ToNumber: a) is (ToNumber: b);
		;;
	[end: false]

	[SameValue: u64 a: 0; u64 b: 0;]
		if (JsV.IsNum: a) and (JsV.IsNum: b)
			f64 x: (JsV.AsNum: a);
			f64 y: (JsV.AsNum: b);
			if x is not x return y is not y;
			if x is 0.0 and y is 0.0
				return (WlNum.IsNegative: x) is (WlNum.IsNegative: y);
			;;
			return x is y;
		;;
	[end: (StrictEq: a b)]

	[SameValueZero: u64 a: 0; u64 b: 0;]
		if (JsV.IsNum: a) and (JsV.IsNum: b)
			f64 x: (JsV.AsNum: a);
			f64 y: (JsV.AsNum: b);
			if x is not x return y is not y;
			return x is y;
		;;
	[end: (StrictEq: a b)]

	# ---- comparing ----

	# a < b: 1 true, 0 false, -1 undefined (a NaN). Primitives only.
	[LessPrim: u64 a: 0; u64 b: 0;]
		if (JsV.IsStr: a) and (JsV.IsStr: b)
			if (JsStrs.Compare: (JsV.AsStr: a) (JsV.AsStr: b)) < 0 return 1;
			return 0;
		;;
		f64 x: (ToNumber: a);
		f64 y: (ToNumber: b);
		if x is not x or y is not y return -1;
		if x < y return 1;
	[end: 0]

	# the operator's own add, for anything: a and b are on the VM's stack while this runs
	[Add: u64 a: 0; u64 b: 0;]
		JsGc.no_gc++;
		a is (ToPrimitive: a HINT_DEFAULT);
		b is (ToPrimitive: b HINT_DEFAULT);
		u64 result: 0;
		if (JsV.IsStr: a) or (JsV.IsStr: b)
			ptr<JsStr> sa: (ToStr: a);
			ptr<JsStr> sb: (ToStr: b);
			result is (JsV.Str: (JsStrs.Concat: sa sb));
		;;
		else
			result is (JsV.Num: (ToNumber: a) + (ToNumber: b));
		;;
		JsGc.no_gc--;
	[end: result]

	# ---- typeof, callable, instanceof ----

	[TypeOf: u64 v: 0;]
		u32 tag: (v >> 48) as u32;
		if tag < JsV.TAG_SPECIAL or tag is JsV.TAG_INT return JsRt.A.number;
		if tag is JsV.TAG_STR return JsRt.A.string;
		if tag is JsV.TAG_SYM return JsRt.A.symbol;
		if tag is JsV.TAG_OBJ
			ptr<JsObj> o: (JsV.AsObj: v);
			if (o.flags & JsObjs.F_CALLABLE) is not 0 return JsRt.A.function;
			return JsRt.A.object;
		;;
		if v is JsV.UNDEF return JsRt.A.undefined;
		if v is JsV.NULL return JsRt.A.object;
	[end: JsRt.A.boolean]

	[IsCallable: u64 v: 0;]
		if (v >> 48) as u32 is not JsV.TAG_OBJ return false;
		ptr<JsObj> o: (JsV.AsObj: v);
	[end: (o.flags & JsObjs.F_CALLABLE) is not 0]

	[IsConstructor: u64 v: 0;]
		if (v >> 48) as u32 is not JsV.TAG_OBJ return false;
		ptr<JsObj> o: (JsV.AsObj: v);
		if (o.flags & JsObjs.F_CTOR) is not 0 return true;
		if o.kind is JsGc.K_FUNCTION
			ptr<JsFn> f: o as ptr<JsFn>;
			return (f.code.flags & JsCodes.F_CONSTRUCTOR) is not 0;
		;;
		if o.kind is JsGc.K_BOUND
			ptr<JsBoundFn> b: o as ptr<JsBoundFn>;
			return (IsConstructor: b.target);
		;;
	[end: false]

	[InstanceOf: u64 v: 0; u64 target: 0;]
		if not (JsV.IsObj: target)
			call JsErr.Type: 'Right-hand side of instanceof is not an object';
		;;
		u64 h: (JsObjs.GetAtom: (JsV.AsObj: target) JsRt.S.hasInstance as ptr<u8> target);
		if h is not JsV.UNDEF and h is not JsV.NULL
			if not (IsCallable: h)
				call JsErr.Type: 'Symbol.hasInstance is not a function';
			;;
			return (ToBool: (JsVm.Call1: h target v));
		;;
		if not (IsCallable: target)
			call JsErr.Type: 'Right-hand side of instanceof is not callable';
		;;
	[end: (OrdinaryHasInstance: target v)]

	[OrdinaryHasInstance: u64 c: 0; u64 v: 0;]
		if not (IsCallable: c) return false;
		ptr<JsObj> co: (JsV.AsObj: c);
		if co.kind is JsGc.K_BOUND
			ptr<JsBoundFn> b: co as ptr<JsBoundFn>;
			return (InstanceOf: v b.target);
		;;
		if not (JsV.IsObj: v) return false;
		u64 pv: (JsObjs.GetAtom: co JsRt.A.prototype as ptr<u8> c);
		if not (JsV.IsObj: pv)
			call JsErr.Type: 'Function has non-object prototype in instanceof check';
		;;
		ptr<JsObj> proto: (JsV.AsObj: pv);
		ptr<JsObj> o: (JsV.AsObj: v);
		while true
			o is (JsObjs.ProtoOf: o);
			if o is 0 return false;
			if o is proto return true;
		;;
	[end: false]

	# the prototype a constructor's new object should have: new_target's, or a default
	[ProtoFromCtor: u64 new_target: 0; ptr<JsObj> fallback: 0;]
		if not (JsV.IsObj: new_target) return fallback;
		u64 pv: (JsObjs.GetAtom: (JsV.AsObj: new_target) JsRt.A.prototype as ptr<u8> new_target);
		if (JsV.IsObj: pv)
			return (JsV.AsObj: pv);
		;;
	[end: fallback]

	# ---- methods and iterators, for natives and the VM ----

	# undefined if it's undefined or null; a TypeError if it's something not callable
	[GetMethod: u64 v: 0; ptr<u8> key: 0;]
		u64 m: (JsObjs.GetV: v (JsObjs.PtrToValue: key));
		if m is JsV.UNDEF or m is JsV.NULL return JsV.UNDEF;
		if not (IsCallable: m)
			call JsErr.Type: 'property is not a function';
		;;
	[end: m]

	[IsArray: u64 v: 0;]
		if not (JsV.IsObj: v) return false;
		ptr<JsObj> o: (JsV.AsObj: v);
		while o.kind is JsGc.K_HOST and (JsProxy.Is: o)
			call WlStack.Check;
			o is (JsV.AsObj: (JsProxy.TargetOf: o));
		;;
	[end: o.kind is JsGc.K_ARRAY]

	# an array-like's elements pushed on the VM's stack; how many
	[PushArrayLike: u64 v: 0;]
		if not (JsV.IsObj: v)
			call JsErr.Type: 'CreateListFromArrayLike called on non-object';
		;;
		ptr<JsObj> o: (JsV.AsObj: v);
		f64 flen: (ToLength: (JsObjs.GetAtom: o JsRt.A.length as ptr<u8> v));
		if flen > 200000.0
			call JsErr.Range: 'Too many arguments';
		;;
		u32 n: flen as u32;
		call JsVm.CheckStack: n;
		while u32 i: 0; i < n; i++;
			u64 e: (JsObjs.GetIndex: o i v);
			JsVm.sp:0 is e;
			JsVm.sp++ 8;
		;;
	[end: n]

	# SpeciesConstructor
	[Species: u64 o: 0; u64 fallback: 0;]
		u64 c: (JsObjs.GetAtom: (JsV.AsObj: o) JsRt.A.constructor as ptr<u8> o);
		if c is JsV.UNDEF return fallback;
		if not (JsV.IsObj: c)
			call JsErr.Type: 'constructor is not an object';
		;;
		u64 s: (JsObjs.GetAtom: (JsV.AsObj: c) JsRt.S.species as ptr<u8> c);
		if s is JsV.UNDEF or s is JsV.NULL return fallback;
		if (IsConstructor: s) return s;
		call JsErr.Type: 'Symbol.species is not a constructor';
	[end: 0 as u64]
}
