# WebSocket's native side: the page asks the host (PageHost ws_open, ws_send, ws_close) through
# %wsOpen, %wsSend and %wsClose (platform.js's WebSocket), and the host tells it what happened with
# Page.SocketEvent, which platform.js's %wsEvent turns into the socket's events. A page without
# the hooks gets sockets that fail at once (an error, then a close), as one that can't connect does.

use page.page;

phi.PageSocket:Library
{
	[Install]
		call Js.DefineNative: JsRt.r.global '%wsOpen' addr Open 2;
		call Js.DefineNative: JsRt.r.global '%wsSend' addr Send 4;
		call Js.DefineNative: JsRt.r.global '%wsClose' addr Close 3;
	[end]

	# %wsOpen(url, protocols): the host's id for the connection, or 0 if it has none to give
	[Open: ptr<u64> args: 0; int argc: 0;]
		ptr<Page> p: Page.current;
		if p is 0 or p.host.ws_open is 0 return (JsV.Int: 0);
		WlBuf url;
		call Js.TextOf: (Js.Arg: args argc 0) addr url;
		WlBuf protocols;
		call Js.TextOf: (Js.Arg: args argc 1) addr protocols;
		call protocols.Add: 0;
		int id: (p.host.ws_open: p url.data protocols.data);
		call url.Free;
		call protocols.Free;
	[end: (JsV.Int: id)]

	# %wsSend(id, data, binary, length): text (a string) or bytes (an ArrayBuffer, length of them)
	[Send: ptr<u64> args: 0; int argc: 0;]
		ptr<Page> p: Page.current;
		if p is 0 or p.host.ws_send is 0 return (JsV.Bool: false);
		int id: (JsOps.ToInteger: (Js.Arg: args argc 0)) as int;
		bln binary: (JsOps.ToBool: (Js.Arg: args argc 2));
		bln ok: false;
		if binary
			u64 buf: (Js.Arg: args argc 1);
			u32 n: (JsOps.ToInteger: (Js.Arg: args argc 3)) as u32;
			ok is (p.host.ws_send: p id (JsTyped.BytesOf: buf) n true);
		;;
		else
			WlBuf text;
			call Js.TextOf: (Js.Arg: args argc 1) addr text;
			ok is (p.host.ws_send: p id text.data text.len false);
			call text.Free;
		;;
	[end: (JsV.Bool: ok)]

	# %wsClose(id, code, reason)
	[Close: ptr<u64> args: 0; int argc: 0;]
		ptr<Page> p: Page.current;
		if p is 0 or p.host.ws_close is 0 return JsV.UNDEF;
		int id: (JsOps.ToInteger: (Js.Arg: args argc 0)) as int;
		int code: (JsOps.ToInteger: (Js.Arg: args argc 1)) as int;
		WlBuf reason;
		call Js.TextOf: (Js.Arg: args argc 2) addr reason;
		call reason.Add: 0;
		call p.host.ws_close: p id code reason.data;
		call reason.Free;
	[end: JsV.UNDEF]

	# what the host says happened (Page.SocketEvent): to platform.js's %wsEvent(id, kind, data, code)
	[Event: ptr<Page> p: 0; int id: 0; int kind: 0; ptr<u8> data: 0; u32 n: 0; int code: 0;]
		call Page.Use: p;
		u64 fn: (Js.GetProp: (JsV.Obj: JsRt.r.global) '%wsEvent');
		if not (JsV.IsObj: fn) return;
		u64 value: JsV.UNDEF;
		if kind is Page.WS_BINARY
			ptr<JsObj> b: (JsTyped.NewBuffer: n as f64 JsRt.P.arraybuffer);
			value is (JsV.Obj: b);
			if n > 0
				call Mem.Copy: (JsTyped.BytesOf: value) data n;
			;;
		;;
		elif data is not 0
			value is (Js.NewString: data n);
		;;
		else
			value is (Js.NewStringZ: '');
		;;
		call Js.Push: (JsV.Int: id);
		call Js.Push: (JsV.Int: kind);
		call Js.Push: value;
		call Js.Push: (JsV.Int: code);
		p.nest++;
		u64 ignored: (Js.Call: fn JsV.UNDEF 4);
		p.nest--;
		if Js.failed
			call Page.ReportException: p;
		;;
		call Page.RunJobs: p;
		call Page.Invalidate: p;
	[end]
}
