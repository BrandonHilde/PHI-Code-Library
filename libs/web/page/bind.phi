		if (WlText.EqZ: text n 'cssFloat')
			call b.AddZ: 'float';
			return;
		;;
		while u32 i: 0; i < n; i++;
			u32 c: text:i;
			if c >= 'A' and c <= 'Z'
				call b.Add: '-';
				call b.Add: (c + 32) as u8;
			;;
			else
				call b.Add: c as u8;
			;;
