	# ---- el.style and getComputedStyle ----

	[InstallStyle: ptr<JsObj> keep: 0;]
		style_proto is (Class: 'CSSStyleDeclaration' JsRt.P.object keep);
		ptr<JsObj> p: style_proto;
		call Getter: p 'cssText' addr StyleTextGet addr StyleTextSet 0;
		call Getter: p 'length' addr StyleLength 0 0;
		call Method: p 'getPropertyValue' addr StyleGetFn 1 0;
		call Method: p 'setProperty' addr StyleSetFn 2 0;
		call Method: p 'removeProperty' addr StyleRemoveFn 1 0;
		call Method: p 'getPropertyPriority' addr StylePriorityFn 1 0;
		call Method: p 'item' addr StyleItem 1 0;
