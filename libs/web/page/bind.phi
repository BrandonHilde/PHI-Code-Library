		ptr<DomAttr> a: (Dom.AttrZ: n 'value');
		if a is 0
			return (JsV.Str: JsRt.blank);
		;;
	[end: (Js.NewString: a.value a.value_len)]

	[ValuePropSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<JsObj> w: (JsV.AsObj: (Wrap: n));
		WlBuf b;
		call StringArg: (Js.Arg: args argc 0) addr b;
		u64 v: (Js.NewString: b.data b.len);
		call b.Free;
		call JsObjs.DefineValue: w (JsStrs.InternZ: '%value') as ptr<u8> v JsObjs.W;
