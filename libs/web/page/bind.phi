		;;
		else
			call Css.StyleSet: n name.data name.len text.data text.len important;
		;;
		call text.Free;
	[end]

	[ThisStyle: ptr<u64> args: 0;]
		u64 t: args:(-1);
		if (JsV.IsObj: t)
			ptr<JsObj> o: (JsV.AsObj: t);
			if o.cls is style_class or o.cls is computed_class
				return o;
			;;
		;;
		call JsErr.Type: 'Illegal invocation: this is not a CSSStyleDeclaration';
	[end: 0 as ptr<JsObj>]

	[StyleTextGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		WlBuf b;
		if o.cls is style_class
			call Css.StyleText: o.data as ptr<DomNode> addr b;
		;;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
	[end: r]

	[StyleTextSet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		WlBuf b;
		call StringArg: (Js.Arg: args argc 0) addr b;
		if o.cls is style_class
			call Css.StyleSetText: o.data as ptr<DomNode> b.data b.len;
		;;
		call b.Free;
	[end: JsV.UNDEF]

	[StyleLength: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		if o.cls is computed_class
			return (JsV.Uint: (Css.LonghandCount));
		;;
		ptr<CssDecls> d: (Css.StyleDecls: o.data as ptr<DomNode>);
		if d is 0
			return JsV.INT_BASE;
		;;
	[end: (JsV.Uint: (Css.DeclCount: d))]

	[StyleItem: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		f64 i: (JsOps.ToInteger: (Js.Arg: args argc 0));
		if i < 0.0
			return (JsV.Str: JsRt.blank);
		;;
		if o.cls is computed_class
			if i >= ((Css.LonghandCount) as f64)
				return (JsV.Str: JsRt.blank);
			;;
			return (Js.NewStringZ: (Css.PropertyName: i as u32));
		;;
		ptr<CssDecls> d: (Css.StyleDecls: o.data as ptr<DomNode>);
		if d is 0 or i >= ((Css.DeclCount: d) as f64)
			return (JsV.Str: JsRt.blank);
		;;
	[end: (Js.NewStringZ: (Css.DeclName: d i as u32))]

	[StyleGetFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		WlBuf name;
		call Js.TextOf: (Js.Arg: args argc 0) addr name;
		WlBuf text;
		if o.cls is style_class
			call Css.StyleGet: o.data as ptr<DomNode> name.data name.len addr text;
		;;
		else
			call Css.ComputedText: o.data as ptr<DomNode> name.data name.len addr text;
		;;
		u64 r: (Js.NewString: text.data text.len);
		call name.Free;
		call text.Free;
	[end: r]

	[StyleSetFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		if o.cls is computed_class
			call DomError: 'NoModificationAllowedError' 'A computed style cannot be changed';
		;;
		WlBuf name;
		call Js.TextOf: (Js.Arg: args argc 0) addr name;
		bln important: false;
		if argc > 2
			ptr<JsStr> pr: (JsOps.ToStr: args:2);
			important is (JsStrs.EqZ: pr 'important');
		;;
		call SetStyleValue: o.data as ptr<DomNode> addr name (Js.Arg: args argc 1) important;
		call name.Free;
	[end: JsV.UNDEF]

	[StyleRemoveFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		WlBuf name;
		call Js.TextOf: (Js.Arg: args argc 0) addr name;
		WlBuf text;
		u64 r: (JsV.Str: JsRt.blank);
		if o.cls is style_class
			call Css.StyleGet: o.data as ptr<DomNode> name.data name.len addr text;
			r is (Js.NewString: text.data text.len);
			call Css.StyleRemove: o.data as ptr<DomNode> name.data name.len;
		;;
		call name.Free;
		call text.Free;
	[end: r]

	[StylePriorityFn: ptr<u64> args: 0; int argc: 0;]
		ptr<JsObj> o: (ThisStyle: args);
		if o.cls is style_class
			ptr<CssDecls> d: (Css.StyleDecls: o.data as ptr<DomNode>);
			if d is not 0
				WlBuf name;
				call Js.TextOf: (Js.Arg: args argc 0) addr name;
				bln yes: (Css.DeclPriority: d name.data name.len);
				call name.Free;
				if yes
					return (Js.NewStringZ: 'important');
				;;
			;;
		;;
	[end: (JsV.Str: JsRt.blank)]

	[ComputedHookGet: ptr<JsObj> o: 0; u64 key: 0; u64 recv: 0; ptr<u64> output: 0;]
		WlBuf name;
		if not (IsPropertyKey: key addr name)
			call name.Free;
			return 0;
		;;
		call Page.UpdateStyle: Page.current;
		WlBuf text;
		call Css.ComputedText: o.data as ptr<DomNode> name.data name.len addr text;
		output:0 is (Js.NewString: text.data text.len);
		call name.Free;
		call text.Free;
	[end: 1]

	[NewComputed: ptr<DomNode> n: 0;]
	[end: (JsV.Obj: (JsObjs.NewHost: computed_class style_proto n as ptr<u8>))]

	# ---- el.dataset ----

	# fooBar is data-foo-bar
	[DataName: u64 key: 0; ptr<WlBuf> name: 0;]
		if not (JsV.IsStr: key) return false;
		ptr<JsStr> s: (JsStrs.Flat: (JsV.AsStr: key));
		call name.AddZ: 'data-';
		while u32 i: 0; i < s.bytes; i++;
			u32 c: s.data:i;
			if c >= 'A' and c <= 'Z'
				call name.Add: '-';
				call name.Add: (c + 32) as u8;
			;;
			else
				call name.Add: c as u8;
			;;
		;;
	[end: true]

	[DataGet: ptr<JsObj> o: 0; u64 key: 0; u64 recv: 0; ptr<u64> output: 0;]
		WlBuf name;
		if not (DataName: key addr name)
			call name.Free;
			return 0;
		;;
		ptr<DomAttr> a: (Dom.Attr: o.data as ptr<DomNode> (WlAtoms.Get: name.data name.len));
		call name.Free;
		if a is 0 return 0;
		output:0 is (Js.NewString: a.value a.value_len);
	[end: 1]

	[DataSet: ptr<JsObj> o: 0; u64 key: 0; u64 v: 0; u64 recv: 0;]
		WlBuf name;
		if not (DataName: key addr name)
			call name.Free;
			return 0;
		;;
		call SetAttrFrom: o.data as ptr<DomNode> (WlAtoms.Get: name.data name.len) v;
		call name.Free;
	[end: 1]

	[DataDelete: ptr<JsObj> o: 0; u64 key: 0;]
		WlBuf name;
		if not (DataName: key addr name)
			call name.Free;
			return 0;
		;;
		call Dom.RemoveAttr: o.data as ptr<DomNode> (WlAtoms.Get: name.data name.len);
		call name.Free;
	[end: 1]

	[DataHas: ptr<JsObj> o: 0; u64 key: 0;]
		WlBuf name;
		if not (DataName: key addr name)
			call name.Free;
			return 0;
		;;
		ptr<DomAttr> a: (Dom.Attr: o.data as ptr<DomNode> (WlAtoms.Get: name.data name.len));
		call name.Free;
		if a is 0 return 0;
	[end: 1]

	[DataKeys: ptr<JsObj> o: 0; ptr<JsObj> list: 0;]
		ptr<DomNode> n: o.data as ptr<DomNode>;
		ptr<DomAttr> a: n.attrs;
		while a is not 0
			if a.name.len > 5 and (WlText.Eq: a.name.text 5 'data-' 5)
				WlBuf b;
				u32 i: 5;
				while i < a.name.len
					u32 c: a.name.text:i;
					if c is '-' and i + 1 < a.name.len
						i++;
						call b.Add: (WlText.Upper: a.name.text:i) as u8;
					;;
					else
						call b.Add: c as u8;
					;;
					i++;
				;;
				call JsObjs.ArrayPush: list (Js.NewString: b.data b.len);
				call b.Free;
			;;
			a is a.next;
		;;
	[end]

	[DataGetOwn: ptr<JsObj> o: 0; u64 key: 0; ptr<JsDesc> d: 0;]
		WlBuf name;
		if not (DataName: key addr name)
			call name.Free;
			return 0;
		;;
		ptr<DomAttr> a: (Dom.Attr: o.data as ptr<DomNode> (WlAtoms.Get: name.data name.len));
		call name.Free;
		if a is 0 return 0;
		d.value is (Js.NewString: a.value a.value_len);
		d.getter is JsV.UNDEF;
		d.setter is JsV.UNDEF;
		d.flags is JsObjs.WEC;
	[end: 1]

	# ---- things the window keeps in step ----

	[SyncWindow: ptr<Page> p: 0;]
		call PageWindow.Sync: p;
	[end]
}
