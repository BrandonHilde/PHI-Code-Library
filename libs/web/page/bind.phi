	# ---- ParentNode and ChildNode ----

	[ParentNodeMethods: ptr<JsObj> p: 0;]
		call Getter: p 'children' addr ChildrenProp 0 E_CHILDREN;
		call Getter: p 'firstElementChild' addr ChildrenProp 0 E_FIRST_EL;
		call Getter: p 'lastElementChild' addr ChildrenProp 0 E_LAST_EL;
		call Getter: p 'childElementCount' addr ChildrenProp 0 E_COUNT;
		call Method: p 'querySelector' addr QueryFn 1 0;
		call Method: p 'querySelectorAll' addr QueryAllFn 1 0;
		call Method: p 'append' addr AppendMany 0 0;
		call Method: p 'prepend' addr AppendMany 0 1;
		call Method: p 'replaceChildren' addr AppendMany 0 2;
	[end]

	[ChildNodeMethods: ptr<JsObj> p: 0;]
		call Getter: p 'nextElementSibling' addr ChildrenProp 0 E_NEXT_EL;
		call Getter: p 'previousElementSibling' addr ChildrenProp 0 E_PREV_EL;
		call Method: p 'before' addr InsertBeside 0 0;
		call Method: p 'after' addr InsertBeside 0 1;
		call Method: p 'replaceWith' addr InsertBeside 0 2;
	[end]

	[ChildrenProp: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisNode: args);
		when self.magic
			is E_CHILDREN
				return (NewCollection: n C_CHILDREN 0 collection_proto);
			;;
			is E_FIRST_EL
				return (Wrap: (Dom.FirstElementChild: n));
			;;
			is E_LAST_EL
				ptr<DomNode> c: n.last_child;
				while c is not 0 and c.type is not DomType.ELEMENT
					c is c.prev;
				;;
				return (Wrap: c);
			;;
			is E_NEXT_EL
				return (Wrap: (Dom.NextElement: n));
			;;
			is E_PREV_EL
				return (Wrap: (Dom.PrevElement: n));
			;;
			is E_COUNT
				int count: 0;
				ptr<DomNode> k: n.first_child;
				while k is not 0
					if k.type is DomType.ELEMENT
						count++;
					;;
					k is k.next;
				;;
				return (JsV.Int: count);
			;;
		;;
	[end: JsV.NULL]

	# nodes and strings, as append() and the like take them, gathered in a new fragment
	[Gather: ptr<DomDocument> doc: 0; ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> f: (Dom.CreateFragment: doc);
		while int i: 0; i < argc; i++;
			ptr<DomNode> n: (NodeOf: args:i);
			if n is not 0
				call CheckInsert: f n;
				if n.type is DomType.FRAGMENT
					while n.first_child is not 0
						call Dom.Append: f n.first_child;
					;;
				;;
				else
					call Dom.Append: f n;
				;;
			;;
			else
				WlBuf b;
				call Js.TextOf: args:i addr b;
				call Dom.Append: f (Dom.CreateText: doc b.data b.len);
				call b.Free;
			;;
		;;
	[end: f]

	[AppendMany: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> f: (Gather: n.doc args argc);
		when self.magic
			is 0
				call InsertNode: n f 0;
			;;
			is 1
				call InsertNode: n f n.first_child;
			;;
			is 2
				call RemoveAllChildren: n;
				call InsertNode: n f 0;
			;;
		;;
	[end: JsV.UNDEF]

	[InsertBeside: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> parent: n.parent;
		if parent is 0
			return JsV.UNDEF;
		;;
		ptr<DomNode> f: (Gather: n.doc args argc);
		when self.magic
			is 0
				call InsertNode: parent f n;
			;;
			is 1
				call InsertNode: parent f n.next;
			;;
			is 2
				ptr<DomNode> following: n.next;
				call Dom.Remove: n;
				call InsertNode: parent f following;
			;;
		;;
	[end: JsV.UNDEF]

	# ---- selectors ----

	[QueryFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		ptr<DomNode> found: (Css.Query: n b.data b.len);
		bln invalid: Css.invalid;
		call b.Free;
		if invalid
			call DomError: 'SyntaxError' 'The selector is not valid';
		;;
	[end: (Wrap: found)]

	[QueryAllFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		CssNodeList list;
		int count: (Css.QueryAll: n b.data b.len addr list);
		call b.Free;
		if count < 0
			call list.Free;
			call DomError: 'SyntaxError' 'The selector is not valid';
		;;
		u64 r: (StaticList: addr list);
		call list.Free;
	[end: r]

	# what querySelectorAll gives: its nodes in a list that doesn't change
	[StaticList: ptr<CssNodeList> list: 0;]
		ptr<JsObj> a: (JsObjs.NewArray: list.count);
		a.proto is nodelist_proto;
		while u32 i: 0; i < list.count; i++;
			call JsObjs.ArrayPush: a (Wrap: list.items:i);
		;;
	[end: (JsV.Obj: a)]

	[MatchesFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		bln yes: (Css.Matches: n b.data b.len);
		bln invalid: Css.invalid;
		call b.Free;
		if invalid
			call DomError: 'SyntaxError' 'The selector is not valid';
		;;
	[end: (JsV.Bool: yes)]

	[ClosestFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		ptr<DomNode> found: (Css.Closest: n b.data b.len);
		bln invalid: Css.invalid;
		call b.Free;
		if invalid
			call DomError: 'SyntaxError' 'The selector is not valid';
		;;
	[end: (Wrap: found)]

	# ---- collections that stay up to date ----

	[FreeData: ptr<JsObj> o: 0;]
		free o.data;
	[end]

	[NewCollection: ptr<DomNode> root: 0; u32 kind: 0; ptr<WlAtom> atom: 0; ptr<JsObj> proto: 0;]
		ptr<PageCollection> c: new PageCollection;
		if c is 0
			throw 'out of memory';
		;;
		c.root is root;
		c.kind is kind;
		c.atom is atom;
		c.cached_len is NONE;
		c.version is root.doc.version;
		ptr<JsObj> o: (JsObjs.NewHost: collection_class proto c as ptr<u8>);
	[end: (JsV.Obj: o)]

	[Stale: ptr<PageCollection> c: 0;]
		if c.version is not c.root.doc.version
			c.version is c.root.doc.version;
			c.cached_len is NONE;
			c.cached_node is 0;
		;;
	[end]

	# the first node this collection holds at or after n, walking in document order
	[Accepts: ptr<PageCollection> c: 0; ptr<DomNode> n: 0;]
		when c.kind
			is C_CHILD_NODES
				return true;
			;;
			is C_CHILDREN
				return n.type is DomType.ELEMENT;
			;;
			is C_BY_TAG
				return n.type is DomType.ELEMENT and (c.atom is 0 or n.tag is c.atom);
			;;
		;;
	[end: n.type is DomType.ELEMENT and (Dom.HasClass: n c.atom)]

	[Following: ptr<PageCollection> c: 0; ptr<DomNode> n: 0;]
		if c.kind is C_CHILD_NODES or c.kind is C_CHILDREN
			return n.next;
		;;
	[end: (Dom.Next: n c.root)]

	[First: ptr<PageCollection> c: 0;]
		if c.kind is C_CHILD_NODES or c.kind is C_CHILDREN
			return c.root.first_child;
		;;
	[end: (Dom.Next: c.root c.root)]

	[CollLen: ptr<PageCollection> c: 0;]
		call Stale: c;
		if c.cached_len is not NONE return c.cached_len;
		u32 count: 0;
		ptr<DomNode> n: (First: c);
		while n is not 0
			if (Accepts: c n)
				count++;
			;;
			n is (Following: c n);
		;;
		c.cached_len is count;
	[end: count]

	# item i, remembering the last place, so walking a collection by index isn't quadratic
	[CollAt: ptr<PageCollection> c: 0; u32 i: 0;]
		call Stale: c;
		ptr<DomNode> n: 0;
		u32 at_: 0;
		if c.cached_node is not 0 and c.cached_index <= i
			n is c.cached_node;
			at_ is c.cached_index;
		;;
		else
			n is (First: c);
			while n is not 0 and not (Accepts: c n)
				n is (Following: c n);
			;;
		;;
		while n is not 0 and at_ < i
			n is (Following: c n);
			if n is not 0 and (Accepts: c n)
				at_++;
			;;
		;;
		if n is not 0
			c.cached_node is n;
			c.cached_index is at_;
		;;
	[end: n]

	[ListLength: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		if (JsV.IsObj: t)
			ptr<JsObj> o: (JsV.AsObj: t);
			if o.cls is collection_class
				return (JsV.Uint: (CollLen: o.data as ptr<PageCollection>));
			;;
			if o.kind is JsGc.K_ARRAY
				return (JsV.Uint: o.length);
			;;
		;;
	[end: JsV.INT_BASE]

	[ListItem: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		f64 i: (JsOps.ToInteger: (Js.Arg: args argc 0));
		if not (JsV.IsObj: t) or i < 0.0 or i > 4000000000.0
			return JsV.NULL;
		;;
		ptr<JsObj> o: (JsV.AsObj: t);
		if o.cls is collection_class
			return (Wrap: (CollAt: o.data as ptr<PageCollection> i as u32));
		;;
		if o.kind is JsGc.K_ARRAY and (i as u32) < o.length
			return o.elems:(i as u32);
		;;
	[end: JsV.NULL]

	[NamedItem: ptr<u64> args: 0; int argc: 0;]
		u64 t: args:(-1);
		if not (JsV.IsObj: t)
			return JsV.NULL;
		;;
		ptr<JsObj> o: (JsV.AsObj: t);
		if o.cls is not collection_class
			return JsV.NULL;
		;;
		ptr<PageCollection> c: o.data as ptr<PageCollection>;
		ptr<WlAtom> want: (AtomOf: (Js.Arg: args argc 0));
		ptr<DomNode> n: (First: c);
		while n is not 0
			if n.type is DomType.ELEMENT and (Accepts: c n)
				if n.id_atom is want
					return (Wrap: n);
				;;
				ptr<DomAttr> a: (Dom.AttrZ: n 'name');
				if a is not 0 and (WlAtoms.Get: a.value a.value_len) is want
					return (Wrap: n);
				;;
			;;
			n is (Following: c n);
		;;
	[end: JsV.NULL]

	[CollGet: ptr<JsObj> o: 0; u64 key: 0; u64 recv: 0; ptr<u64> output: 0;]
		if not (JsObjs.IsIndexKey: key) return 0;
		ptr<DomNode> n: (CollAt: o.data as ptr<PageCollection> key as u32);
		if n is 0
			output:0 is JsV.UNDEF;
		;;
		else
			output:0 is (Wrap: n);
		;;
	[end: 1]

	[CollGetOwn: ptr<JsObj> o: 0; u64 key: 0; ptr<JsDesc> d: 0;]
		if not (JsObjs.IsIndexKey: key) return 0;
		ptr<DomNode> n: (CollAt: o.data as ptr<PageCollection> key as u32);
		if n is 0 return -1;
		d.value is (Wrap: n);
		d.getter is JsV.UNDEF;
		d.setter is JsV.UNDEF;
		d.flags is JsObjs.E | JsObjs.C;
	[end: 1]

	[CollHas: ptr<JsObj> o: 0; u64 key: 0;]
		if not (JsObjs.IsIndexKey: key) return 0;
		if (CollAt: o.data as ptr<PageCollection> key as u32) is not 0 return 1;
	[end: -1]

	[CollKeys: ptr<JsObj> o: 0; ptr<JsObj> list: 0;]
		u32 n: (CollLen: o.data as ptr<PageCollection>);
		while u32 i: 0; i < n; i++;
			call JsObjs.ArrayPush: list (JsV.Str: (JsStrs.InternIndex: i));
		;;
		ptr<JsObj> rest: (JsObjs.OrdinaryKeys: o);
		while u32 j: 0; j < rest.length; j++;
			call JsObjs.ArrayPush: list rest.elems:j;
		;;
	[end]

	[ByTag: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		ptr<WlAtom> atom: 0;
		if not (b.len is 1 and b.data:0 is '*')
			atom is (WlAtoms.GetLower: b.data b.len);
		;;
		call b.Free;
	[end: (NewCollection: n C_BY_TAG atom collection_proto)]

	[ByClass: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		# one class name; two or more with a space between read as the first, here
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		u32 end_at: 0;
		while end_at < b.len and not (WlText.IsSpace: b.data:end_at)
			end_at++;
		;;
		ptr<WlAtom> atom: (WlAtoms.Get: b.data end_at);
		call b.Free;
	[end: (NewCollection: n C_BY_CLASS atom collection_proto)]

	# ---- HTML as text ----

	[InnerHtmlGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		WlBuf b;
		call Html.Serialize: n b true;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
	[end: r]

	[InnerHtmlSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		WlBuf b;
		call StringArg: (Js.Arg: args argc 0) addr b;
		ptr<DomNode> f: (Html.ParseFragment: n b.data b.len true);
		call b.Free;
		ptr<DomNode> dest: n;
		if n.content is not 0
			dest is n.content;
		;;
		call RemoveAllChildren: dest;
		if f is not 0
			while f.first_child is not 0
				call Dom.Append: dest f.first_child;
			;;
		;;
	[end: JsV.UNDEF]

	[OuterHtmlGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		WlBuf b;
		call Html.SerializeOuter: n b true;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
	[end: r]

	[OuterHtmlSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomNode> parent: n.parent;
		if parent is 0
			return JsV.UNDEF;
		;;
		WlBuf b;
		call StringArg: (Js.Arg: args argc 0) addr b;
		ptr<DomNode> context: parent;
		if parent.type is not DomType.ELEMENT
			context is (Dom.CreateElementZ: n.doc 'body');
		;;
		ptr<DomNode> f: (Html.ParseFragment: context b.data b.len true);
		call b.Free;
		ptr<DomNode> following: n.next;
		call Dom.Remove: n;
		if f is not 0
			call InsertNode: parent f following;
		;;
	[end: JsV.UNDEF]

	# beforebegin, afterbegin, beforeend, afterend: where to put something, as a parent and what it goes before
	[Adjacent: ptr<DomNode> n: 0; u64 where_v: 0; ptr<ptr<DomNode>> parent_out: 0; ptr<ptr<DomNode>> ref_out: 0;]
		WlBuf b;
		call Js.TextOf: where_v addr b;
		bln bad: false;
		if (WlText.EqNoCaseZ: b.data b.len 'beforebegin')
			parent_out:0 is n.parent;
			ref_out:0 is n;
		;;
		elif (WlText.EqNoCaseZ: b.data b.len 'afterbegin')
			parent_out:0 is n;
			ref_out:0 is n.first_child;
		;;
		elif (WlText.EqNoCaseZ: b.data b.len 'beforeend')
			parent_out:0 is n;
			ref_out:0 is 0;
		;;
		elif (WlText.EqNoCaseZ: b.data b.len 'afterend')
			parent_out:0 is n.parent;
			ref_out:0 is n.next;
		;;
		else
			bad is true;
		;;
		call b.Free;
		if bad
			call DomError: 'SyntaxError' 'The position must be beforebegin, afterbegin, beforeend or afterend';
		;;
	[end]

	[InsertAdjacentHtml: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomNode> parent: 0;
		ptr<DomNode> ref: 0;
		call Adjacent: n (Js.Arg: args argc 0) addr parent addr ref;
		if parent is 0
			call DomError: 'NoModificationAllowedError' 'The element has no parent';
		;;
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 1) addr b;
		ptr<DomNode> context: parent;
		if parent.type is not DomType.ELEMENT
			context is (Dom.CreateElementZ: n.doc 'body');
		;;
		ptr<DomNode> f: (Html.ParseFragment: context b.data b.len true);
		call b.Free;
		if f is not 0
			call InsertNode: parent f ref;
		;;
	[end: JsV.UNDEF]

	[InsertAdjacentNode: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomNode> parent: 0;
		ptr<DomNode> ref: 0;
		call Adjacent: n (Js.Arg: args argc 0) addr parent addr ref;
		if parent is 0
			return JsV.NULL;
		;;
		call InsertNode: parent (ArgNode: (Js.Arg: args argc 1)) ref;
	[end: args:1]

	[InsertAdjacentText: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomNode> parent: 0;
		ptr<DomNode> ref: 0;
		call Adjacent: n (Js.Arg: args argc 0) addr parent addr ref;
		if parent is 0
			return JsV.UNDEF;
		;;
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 1) addr b;
		call InsertNode: parent (Dom.CreateText: n.doc b.data b.len) ref;
		call b.Free;
	[end: JsV.UNDEF]

	# ---- where layout put it ----

	[BoxOf: ptr<DomNode> n: 0; ptr<f64> box: 0;]
		box:0 is 0.0;
		box:1 is 0.0;
		box:2 is 0.0;
		box:3 is 0.0;
		ptr<Page> p: Page.current;
		if p.host.box is not 0
			call p.host.box: p n box;
		;;
	[end]

	[BoxGet: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisElement: args);
		f64 box[4];
		call BoxOf: n addr box:0;
	[end: (JsV.Num: box:(self.magic))]

	[RectObject: ptr<f64> box: 0;]
		ptr<JsObj> r: (JsObjs.NewObject);
		call Js.Define: r 'x' (JsV.Num: box:0) JsObjs.WEC;
		call Js.Define: r 'y' (JsV.Num: box:1) JsObjs.WEC;
		call Js.Define: r 'width' (JsV.Num: box:2) JsObjs.WEC;
		call Js.Define: r 'height' (JsV.Num: box:3) JsObjs.WEC;
		call Js.Define: r 'left' (JsV.Num: box:0) JsObjs.WEC;
		call Js.Define: r 'top' (JsV.Num: box:1) JsObjs.WEC;
		call Js.Define: r 'right' (JsV.Num: box:0 + box:2) JsObjs.WEC;
		call Js.Define: r 'bottom' (JsV.Num: box:1 + box:3) JsObjs.WEC;
	[end: (JsV.Obj: r)]

	[BoundingRect: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		f64 box[4];
		call BoxOf: n addr box:0;
	[end: (RectObject: addr box:0)]

	[ClientRects: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		f64 box[4];
		call BoxOf: n addr box:0;
		ptr<JsObj> list: (JsObjs.NewArray: 1);
		call JsObjs.ArrayPush: list (RectObject: addr box:0);
	[end: (JsV.Obj: list)]

	[OffsetParent: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
	[end: (Wrap: n.parent)]

	[Focus: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisElement: args);
		ptr<Page> p: Page.current;
		ptr<DomNode> old: p.focused;
		if self.magic is 1
			if old is n
				return JsV.UNDEF;
			;;
			p.focused is n;
			if old is not 0
				call PageEvents.FireSimple: old 'blur';
			;;
			call PageEvents.FireSimple: n 'focus';
		;;
		elif old is n
			p.focused is 0;
			call PageEvents.FireSimple: n 'blur';
		;;
	[end: JsV.UNDEF]

	[ClickFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		u64 ev: (PageEvents.NewMouse: 'click' 0.0 0.0 0 1);
		call Js.Define: (JsV.AsObj: ev) 'isTrusted' JsV.FALSE JsObjs.W | JsObjs.E;
		bln allowed: (PageEvents.Dispatch: args:(-1) ev);
		if allowed
			call Page.DefaultClick: Page.current n;
		;;
	[end: JsV.UNDEF]

	# ---- Document ----

	const u32 D_ELEMENT: 0;
	const u32 D_HEAD: 1;
	const u32 D_BODY: 2;
	const u32 D_URL: 3;
	const u32 D_READY: 4;
	const u32 D_ACTIVE: 5;
	const u32 D_CURRENT_SCRIPT: 6;
	const u32 D_DOCTYPE: 7;
	const u32 D_VIEW: 8;
	const u32 D_COMPAT: 9;
	const u32 D_CHARSET: 10;
	const u32 D_HIDDEN: 11;
	const u32 D_VISIBILITY: 12;
	const u32 D_FORMS: 13;
	const u32 D_IMAGES: 14;
	const u32 D_LINKS: 15;
	const u32 D_SCRIPTS: 16;

	[InstallDocument]
		ptr<JsObj> p: document_proto;
