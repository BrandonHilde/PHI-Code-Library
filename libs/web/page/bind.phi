		ptr<WlAtom> name: (AttrAtom: n (Js.Arg: args argc 0));
		call SetAttrFrom: n name (Js.Arg: args argc 1);
	[end: JsV.UNDEF]

	[RemoveAttribute: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		call Dom.RemoveAttr: n (AttrAtom: n (Js.Arg: args argc 0));
	[end: JsV.UNDEF]

	[HasAttribute: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
	[end: (JsV.Bool: (Dom.Attr: n (AttrAtom: n (Js.Arg: args argc 0))) is not 0)]

	[HasAttributes: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
	[end: (JsV.Bool: n.attrs is not 0)]

	[ToggleAttribute: ptr<u64> args: 0; int argc: 0;]
