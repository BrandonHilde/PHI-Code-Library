# The DOM as JS sees it. A node's JS object is a host object whose payload is the node, made the first time JS asks
# and kept on node.js_wrapper for as long as the document lasts (Page.MarkAll keeps them alive). A page can call
# any method on anything, so each native checks what `this` is before trusting it.
#
# Natives come in families, one PHI method and a `magic` number per name, which keeps this a table of names rather
# than thousands of lines of nearly the same thing.


struct.PageCollection
{
	ptr<DomNode> root;
	u32 kind;              # PageBind.C_...
	ptr<WlAtom> atom;      # the tag or class looked for; 0 for '*'
	u32 version;           # the document's version the cache is good for
	u32 cached_len;        # how many, or NONE
	u32 cached_index;      # where cached_node is
	ptr<DomNode> cached_node;
}

phi.PageBind:Library
{
	ptr<JsClass> node_class: 0;
	ptr<JsClass> collection_class: 0;
	ptr<JsClass> static_list_class: 0;
	ptr<JsClass> token_class: 0;
	ptr<JsClass> style_class: 0;
	ptr<JsClass> computed_class: 0;
	ptr<JsClass> dataset_class: 0;

	ptr<JsObj> node_proto: 0;
	ptr<JsObj> element_proto: 0;
	ptr<JsObj> html_proto: 0;
	ptr<JsObj> svg_proto: 0;
	ptr<JsObj> character_proto: 0;
	ptr<JsObj> text_proto: 0;
	ptr<JsObj> comment_proto: 0;
	ptr<JsObj> document_proto: 0;
	ptr<JsObj> fragment_proto: 0;
	ptr<JsObj> doctype_proto: 0;
	ptr<JsObj> collection_proto: 0;
	ptr<JsObj> nodelist_proto: 0;
	ptr<JsObj> token_proto: 0;
	ptr<JsObj> style_proto: 0;
	ptr<JsObj> dataset_proto: 0;

	ptr<WlAtom> keep_style_key: 0;

	const u32 C_CHILD_NODES: 0;
	const u32 C_CHILDREN: 1;
	const u32 C_BY_TAG: 2;
	const u32 C_BY_CLASS: 3;
	const u32 NONE: 0xFFFFFFFF;

	# ---- setting it all up ----

	[Install: ptr<Page> p: 0;]
		if node_class is 0
			node_class is (JsObjs.NewClass: 'Node');
			collection_class is (JsObjs.NewClass: 'HTMLCollection');
			collection_class.get is addr CollGet;
			collection_class.get_own is addr CollGetOwn;
			collection_class.has_key is addr CollHas;
			collection_class.keys is addr CollKeys;
			collection_class.finalize is addr FreeData;
			token_class is (JsObjs.NewClass: 'DOMTokenList');
			token_class.get is addr TokenIndexGet;
			style_class is (JsObjs.NewClass: 'CSSStyleDeclaration');
			style_class.get is addr StyleHookGet;
			style_class.set is addr StyleHookSet;
			computed_class is (JsObjs.NewClass: 'CSSStyleDeclaration');
			computed_class.get is addr ComputedHookGet;
			dataset_class is (JsObjs.NewClass: 'DOMStringMap');
			dataset_class.get is addr DataGet;
			dataset_class.set is addr DataSet;
			dataset_class.del is addr DataDelete;
			dataset_class.has_key is addr DataHas;
			dataset_class.keys is addr DataKeys;
			dataset_class.get_own is addr DataGetOwn;
		;;
		ptr<JsObj> keep: (JsObjs.NewArray: 32);
		p.keep is (JsV.Obj: keep);
		call PageEvents.Init: keep;
		node_proto is (Class: 'Node' PageEvents.target_proto keep);
		character_proto is (Class: 'CharacterData' node_proto keep);
		text_proto is (Class: 'Text' character_proto keep);
		comment_proto is (Class: 'Comment' character_proto keep);
		document_proto is (Class: 'Document' node_proto keep);
		fragment_proto is (Class: 'DocumentFragment' node_proto keep);
		doctype_proto is (Class: 'DocumentType' node_proto keep);
		element_proto is (Class: 'Element' node_proto keep);
		html_proto is (Class: 'HTMLElement' element_proto keep);
		svg_proto is (Class: 'SVGElement' element_proto keep);
		# names a page may test with instanceof; all behave as HTMLElement
		ptr<u8> kinds: 'HTMLDivElement HTMLSpanElement HTMLAnchorElement HTMLImageElement HTMLInputElement HTMLButtonElement HTMLFormElement HTMLScriptElement HTMLStyleElement HTMLLinkElement HTMLBodyElement HTMLHeadElement HTMLHtmlElement HTMLParagraphElement HTMLSelectElement HTMLOptionElement HTMLTextAreaElement HTMLTableElement HTMLCanvasElement HTMLIFrameElement HTMLVideoElement HTMLAudioElement HTMLUListElement HTMLOListElement HTMLLIElement HTMLLabelElement HTMLMetaElement HTMLTitleElement ';
		u32 i: 0;
		while kinds:i is not 0
			u32 start: i;
			while kinds:i is not 32
				i++;
			;;
			ptr<JsStr> kind_str: (JsStrs.Intern: kinds + start i - start);
			call Class: kind_str.data html_proto keep;
			i++;
		;;
		collection_proto is (ListClass: 'HTMLCollection' keep);
		call Js.DefineNative: collection_proto 'namedItem' addr NamedItem 1;
		nodelist_proto is (ListClass: 'NodeList' keep);
		call InstallNode;
		call InstallElement;
		call InstallDocument;
		call InstallTokens: keep;
		call InstallStyle: keep;
		call PageWindow.Install: p keep;
	[end]

	# a constructor that can't be called, as the DOM's are, with a prototype under `parent`
	[Class: ptr<u8> name: 0; ptr<JsObj> parent: 0; ptr<JsObj> keep: 0;]
		ptr<JsObj> proto: (JsObjs.NewWithProto: parent);
		call JsObjs.ArrayPush: keep (JsV.Obj: proto);
		call Js.DefineClass: name addr IllegalCtor 0 proto;
	[end: proto]

	[IllegalCtor: ptr<u64> args: 0; int argc: 0;]
		call JsErr.Type: 'Illegal constructor';
	[end: JsV.UNDEF]

	[ListClass: ptr<u8> name: 0; ptr<JsObj> keep: 0;]
		ptr<JsObj> proto: (Class: name JsRt.P.object keep);
		call Js.DefineGetter: proto 'length' addr ListLength 0;
		call Js.DefineNative: proto 'item' addr ListItem 1;
		# an array's own forEach, keys, values and entries do the right thing with length and indexes
		ptr<u8> shared: 'forEach keys values entries ';
		u32 i: 0;
		while shared:i is not 0
			u32 start: i;
			while shared:i is not 32
				i++;
			;;
			ptr<JsStr> m: (JsStrs.Intern: shared + start i - start);
			ptr<JsProp> found: (JsObjs.Find: JsRt.P.array m as ptr<u8>);
			call JsObjs.DefineValue: proto m as ptr<u8> found.value JsObjs.WC;
			i++;
		;;
		ptr<JsProp> vals: (JsObjs.Find: JsRt.P.array JsRt.S.iterator as ptr<u8>);
		call JsObjs.DefineValue: proto JsRt.S.iterator as ptr<u8> vals.value JsObjs.WC;
	[end: proto]

	[Getter: ptr<JsObj> proto: 0; ptr<u8> name: 0; method<ptr<u64> int: u64> getter: 0; method<ptr<u64> int: u64> setter: 0; u32 magic: 0;]
		call Js.DefineGetter: proto name getter setter;
		JsDesc d;
		if (JsObjs.GetOwn: proto (JsObjs.KeyZ: name) addr d)
			ptr<JsNativeFn> g: (JsV.AsObj: d.getter) as ptr<JsNativeFn>;
			g.magic is magic;
			if setter is not 0
				ptr<JsNativeFn> s: (JsV.AsObj: d.setter) as ptr<JsNativeFn>;
				s.magic is magic;
			;;
		;;
	[end]

	[Method: ptr<JsObj> proto: 0; ptr<u8> name: 0; method<ptr<u64> int: u64> fn: 0; int nargs: 0; u32 magic: 0;]
		ptr<JsNativeFn> f: (Js.DefineNative: proto name fn nargs);
		f.magic is magic;
	[end]

	# ---- wrappers ----

	[Wrap: ptr<DomNode> n: 0;]
		if n is 0 return JsV.NULL;
		if n.js_wrapper is not 0 return n.js_wrapper;
		ptr<JsObj> proto: element_proto;
		when n.type
			is DomType.ELEMENT
				proto is html_proto;
				if n.ns is DomNs.SVG
					proto is svg_proto;
				;;
				elif n.ns is DomNs.MATHML
					proto is element_proto;
				;;
			;;
			is DomType.TEXT DomType.CDATA
				proto is text_proto;
			;;
			is DomType.COMMENT DomType.PI
				proto is comment_proto;
			;;
			is DomType.DOCUMENT
				proto is document_proto;
			;;
			is DomType.FRAGMENT
				proto is fragment_proto;
			;;
			is DomType.DOCTYPE
				proto is doctype_proto;
			;;
		;;
		ptr<JsObj> o: (JsObjs.NewHost: node_class proto n as ptr<u8>);
		n.js_wrapper is (JsV.Obj: o);
	[end: n.js_wrapper]

	[NodeOf: u64 v: 0;]
		if (JsV.IsObj: v)
			ptr<JsObj> o: (JsV.AsObj: v);
			if o.cls is node_class
				return o.data as ptr<DomNode>;
			;;
		;;
	[end: 0 as ptr<DomNode>]

	[ThisNode: ptr<u64> args: 0;]
		ptr<DomNode> n: (NodeOf: args:(-1));
		if n is 0
			call JsErr.Type: 'Illegal invocation: this is not a Node';
		;;
	[end: n]

	[ThisElement: ptr<u64> args: 0;]
		ptr<DomNode> n: (ThisNode: args);
		if n.type is not DomType.ELEMENT
			call JsErr.Type: 'Illegal invocation: this is not an Element';
		;;
	[end: n]

	[ArgNode: u64 v: 0;]
		ptr<DomNode> n: (NodeOf: v);
		if n is 0
			call JsErr.Type: 'The argument is not a Node';
		;;
	[end: n]

	# a DOM exception: an Error with a name
	[DomError: ptr<u8> name: 0; ptr<u8> message: 0;]
		ptr<JsObj> e: (JsErr.Make: JsRt.P.error message);
		call Js.Define: e 'name' (Js.NewStringZ: name) JsObjs.WC;
		call JsErr.Throw: (JsV.Obj: e);
	[end]

	[TextValue: ptr<WlBuf> b: 0;]
	[end: (Js.NewString: b.data b.len)]

	# text of any value, as a buffer; null as nothing (a lot of the DOM's setters want that)
	[StringArg: u64 v: 0; ptr<WlBuf> b: 0;]
		if v is JsV.NULL return;
		call Js.TextOf: v b;
	[end]

	[AtomOf: u64 v: 0;]
		WlBuf b;
		call Js.TextOf: v addr b;
		ptr<WlAtom> a: (WlAtoms.Get: b.data b.len);
		call b.Free;
	[end: a]

	# ---- Node ----

	const u32 N_TYPE: 0;
	const u32 N_NAME: 1;
	const u32 N_PARENT: 2;
	const u32 N_PARENT_EL: 3;
	const u32 N_CHILD_NODES: 4;
	const u32 N_FIRST: 5;
	const u32 N_LAST: 6;
	const u32 N_PREV: 7;
	const u32 N_NEXT: 8;
	const u32 N_DOC: 9;
	const u32 N_CONNECTED: 10;
	const u32 N_BASE_URI: 11;

	[InstallNode]
		ptr<JsObj> p: node_proto;
		call Getter: p 'nodeType' addr NodeProp 0 N_TYPE;
		call Getter: p 'nodeName' addr NodeProp 0 N_NAME;
		call Getter: p 'parentNode' addr NodeProp 0 N_PARENT;
		call Getter: p 'parentElement' addr NodeProp 0 N_PARENT_EL;
		call Getter: p 'childNodes' addr NodeProp 0 N_CHILD_NODES;
		call Getter: p 'firstChild' addr NodeProp 0 N_FIRST;
		call Getter: p 'lastChild' addr NodeProp 0 N_LAST;
		call Getter: p 'previousSibling' addr NodeProp 0 N_PREV;
		call Getter: p 'nextSibling' addr NodeProp 0 N_NEXT;
		call Getter: p 'ownerDocument' addr NodeProp 0 N_DOC;
		call Getter: p 'isConnected' addr NodeProp 0 N_CONNECTED;
		call Getter: p 'baseURI' addr NodeProp 0 N_BASE_URI;
		call Getter: p 'nodeValue' addr ValueGet addr ValueSet 0;
		call Getter: p 'textContent' addr TextContentGet addr TextContentSet 0;
		call Method: p 'appendChild' addr AppendChild 1 0;
		call Method: p 'insertBefore' addr InsertBefore 2 0;
		call Method: p 'removeChild' addr RemoveChild 1 0;
		call Method: p 'replaceChild' addr ReplaceChild 2 0;
		call Method: p 'cloneNode' addr CloneNode 0 0;
		call Method: p 'hasChildNodes' addr HasChildNodes 0 0;
		call Method: p 'contains' addr ContainsFn 1 0;
		call Method: p 'normalize' addr Normalize 0 0;
		call Method: p 'getRootNode' addr GetRootNode 0 0;
		call Method: p 'compareDocumentPosition' addr ComparePosition 1 0;
		call Method: p 'isSameNode' addr IsSameNode 1 0;
		call Js.Define: p 'ELEMENT_NODE' (JsV.Int: 1) JsObjs.E;
		call Js.Define: p 'ATTRIBUTE_NODE' (JsV.Int: 2) JsObjs.E;
		call Js.Define: p 'TEXT_NODE' (JsV.Int: 3) JsObjs.E;
		call Js.Define: p 'CDATA_SECTION_NODE' (JsV.Int: 4) JsObjs.E;
		call Js.Define: p 'COMMENT_NODE' (JsV.Int: 8) JsObjs.E;
		call Js.Define: p 'DOCUMENT_NODE' (JsV.Int: 9) JsObjs.E;
		call Js.Define: p 'DOCUMENT_TYPE_NODE' (JsV.Int: 10) JsObjs.E;
		call Js.Define: p 'DOCUMENT_FRAGMENT_NODE' (JsV.Int: 11) JsObjs.E;
		call Js.Define: p 'DOCUMENT_POSITION_DISCONNECTED' (JsV.Int: 1) JsObjs.E;
		call Js.Define: p 'DOCUMENT_POSITION_PRECEDING' (JsV.Int: 2) JsObjs.E;
		call Js.Define: p 'DOCUMENT_POSITION_FOLLOWING' (JsV.Int: 4) JsObjs.E;
		call Js.Define: p 'DOCUMENT_POSITION_CONTAINS' (JsV.Int: 8) JsObjs.E;
		call Js.Define: p 'DOCUMENT_POSITION_CONTAINED_BY' (JsV.Int: 16) JsObjs.E;
		ptr<JsObj> c: character_proto;
		call Getter: c 'data' addr ValueGet addr ValueSet 0;
		call Getter: c 'length' addr CharLength 0 0;
		call Method: c 'appendData' addr AppendData 1 0;
		call Method: c 'remove' addr RemoveSelf 0 0;
		call Getter: doctype_proto 'name' addr DoctypeProp 0 0;
		call Getter: doctype_proto 'publicId' addr DoctypeProp 0 1;
		call Getter: doctype_proto 'systemId' addr DoctypeProp 0 2;
		ptr<JsObj> f: fragment_proto;
		call ParentNodeMethods: f;
	[end]

	[NodeProp: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisNode: args);
		when self.magic
			is N_TYPE
				return (JsV.Int: n.type as int);
			;;
			is N_NAME
				return (NodeName: n);
			;;
			is N_PARENT
				return (Wrap: n.parent);
			;;
			is N_PARENT_EL
				if n.parent is not 0 and n.parent.type is DomType.ELEMENT
					return (Wrap: n.parent);
				;;
				return JsV.NULL;
			;;
			is N_CHILD_NODES
				return (NewCollection: n C_CHILD_NODES 0 nodelist_proto);
			;;
			is N_FIRST
				return (Wrap: n.first_child);
			;;
			is N_LAST
				return (Wrap: n.last_child);
			;;
			is N_PREV
				return (Wrap: n.prev);
			;;
			is N_NEXT
				return (Wrap: n.next);
			;;
			is N_DOC
				if n.type is DomType.DOCUMENT
					return JsV.NULL;
				;;
				return (Wrap: n.doc.root);
			;;
			is N_CONNECTED
				return (JsV.Bool: (Dom.Contains: n.doc.root n));
			;;
			is N_BASE_URI
				return (Js.NewStringZ: Page.current.url);
			;;
		;;
	[end: JsV.UNDEF]

	[NodeName: ptr<DomNode> n: 0;]
		when n.type
			is DomType.ELEMENT
				if n.ns is DomNs.HTML
					return (Upper: n.tag.text n.tag.len);
				;;
				return (Js.NewString: n.tag.text n.tag.len);
			;;
			is DomType.TEXT
				return (Js.NewStringZ: '#text');
			;;
			is DomType.CDATA
				return (Js.NewStringZ: '#cdata-section');
			;;
			is DomType.COMMENT
				return (Js.NewStringZ: '#comment');
			;;
			is DomType.DOCUMENT
				return (Js.NewStringZ: '#document');
			;;
			is DomType.FRAGMENT
				return (Js.NewStringZ: '#document-fragment');
			;;
			else
				return (Js.NewString: n.tag.text n.tag.len);
			;;
		;;
	[end: JsV.UNDEF]

	[Upper: ptr<u8> text: 0; u32 n: 0;]
		WlBuf b;
		while u32 i: 0; i < n; i++;
			call b.Add: (WlText.Upper: text:i) as u8;
		;;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
	[end: r]

	[HasText: ptr<DomNode> n: 0;]
	[end: n.type is DomType.TEXT or n.type is DomType.COMMENT or n.type is DomType.CDATA or n.type is DomType.PI]

	[ValueGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		if not (HasText: n)
			return JsV.NULL;
		;;
	[end: (Js.NewString: n.text n.text_len)]

	[ValueSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		if (HasText: n)
			WlBuf b;
			call StringArg: (Js.Arg: args argc 0) addr b;
			call Dom.SetText: n b.data b.len;
			call b.Free;
		;;
	[end: JsV.UNDEF]

	[CharLength: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<JsStr> s: (JsV.AsStr: (Js.NewString: n.text n.text_len));
	[end: (JsV.Uint: s.len)]

	[AppendData: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		WlBuf b;
		call Js.TextOf: (Js.Arg: args argc 0) addr b;
		call Dom.AddText: n b.data b.len;
		call b.Free;
	[end: JsV.UNDEF]

	[DoctypeProp: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisNode: args);
		when self.magic
			is 0
				return (Js.NewString: n.tag.text n.tag.len);
			;;
			is 1
				return (Js.NewString: n.text n.text_len);
			;;
		;;
	[end: (Js.NewString: n.text2 n.text2_len)]

	[TextContentGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		if n.type is DomType.DOCUMENT or n.type is DomType.DOCTYPE
			return JsV.NULL;
		;;
		WlBuf b;
		call Dom.TextContent: n b;
		u64 r: (Js.NewString: b.data b.len);
		call b.Free;
	[end: r]

	[TextContentSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		WlBuf b;
		call StringArg: (Js.Arg: args argc 0) addr b;
		if (HasText: n)
			call Dom.SetText: n b.data b.len;
		;;
		elif n.type is DomType.ELEMENT or n.type is DomType.FRAGMENT
			call RemoveAllChildren: n;
			if b.len > 0
				call Dom.Append: n (Dom.CreateText: n.doc b.data b.len);
			;;
		;;
		call b.Free;
	[end: JsV.UNDEF]

	[RemoveAllChildren: ptr<DomNode> n: 0;]
		while n.first_child is not 0
			call Dom.Remove: n.first_child;
		;;
	[end]

	# may this child go under this parent? Throws HierarchyRequestError if not, as the DOM says.
	[CheckInsert: ptr<DomNode> parent: 0; ptr<DomNode> child: 0;]
		if not (parent.type is DomType.ELEMENT or parent.type is DomType.FRAGMENT or parent.type is DomType.DOCUMENT)
			call DomError: 'HierarchyRequestError' 'This node type cannot have children';
		;;
		if child.type is DomType.DOCUMENT or (Dom.Contains: child parent)
			call DomError: 'HierarchyRequestError' 'The new child contains the parent';
		;;
		if child.type is DomType.DOCTYPE and parent.type is not DomType.DOCUMENT
			call DomError: 'HierarchyRequestError' 'A doctype can only go in a document';
		;;
		if (child.type is DomType.TEXT or child.type is DomType.CDATA) and parent.type is DomType.DOCUMENT
			call DomError: 'HierarchyRequestError' 'Text cannot go directly in a document';
		;;
	[end]

	# a fragment's children go in, in order, and it's left empty; anything else goes in itself
	[InsertNode: ptr<DomNode> parent: 0; ptr<DomNode> child: 0; ptr<DomNode> ref: 0;]
		call CheckInsert: parent child;
		if child.type is DomType.FRAGMENT
			while child.first_child is not 0
				call Dom.InsertBefore: parent child.first_child ref;
			;;
			call RunAdded: parent;
			return;
		;;
		call Dom.InsertBefore: parent child ref;
		call RunAdded: child;
	[end]

	# a <script> put in the document by a script runs now, once (and anything like it inside what was added)
	[RunAdded: ptr<DomNode> n: 0;]
		ptr<Page> p: Page.current;
		if not (Dom.Contains: p.doc.root n) return;
		ptr<WlAtom> script_tag: (WlAtoms.GetZ: 'script');
		ptr<DomNode> w: n;
		while w is not 0
			if w.type is DomType.ELEMENT and w.tag is script_tag and w.ns is DomNs.HTML
				if (w.flags & RAN_FLAG) is 0
					w.flags is w.flags | RAN_FLAG;
					call Page.Run: p w false;
				;;
			;;
			w is (Dom.Next: w n);
		;;
	[end]

	const u32 RAN_FLAG: 0x40;

	[AppendChild: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> c: (ArgNode: (Js.Arg: args argc 0));
		call InsertNode: n c 0;
	[end: args:0]

	[InsertBefore: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> c: (ArgNode: (Js.Arg: args argc 0));
		ptr<DomNode> ref: (NodeOf: (Js.Arg: args argc 1));
		if ref is not 0 and ref.parent is not n
			call DomError: 'NotFoundError' 'The node before which to insert is not a child of this node';
		;;
		call InsertNode: n c ref;
	[end: args:0]

	[RemoveChild: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> c: (ArgNode: (Js.Arg: args argc 0));
		if c.parent is not n
			call DomError: 'NotFoundError' 'The node to remove is not a child of this node';
		;;
		call Dom.Remove: c;
	[end: args:0]

	[ReplaceChild: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> fresh: (ArgNode: (Js.Arg: args argc 0));
		ptr<DomNode> old: (ArgNode: (Js.Arg: args argc 1));
		if old.parent is not n
			call DomError: 'NotFoundError' 'The node to replace is not a child of this node';
		;;
		ptr<DomNode> ref: old.next;
		if ref is fresh
			ref is fresh.next;
		;;
		call CheckInsert: n fresh;
		call Dom.Remove: old;
		call InsertNode: n fresh ref;
	[end: args:1]

	[CloneNode: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
	[end: (Wrap: (Clone: n (JsOps.ToBool: (Js.Arg: args argc 0))))]

	# a copy; with deep, of everything under it, by a walk and no recursion
	[Clone: ptr<DomNode> n: 0; bln deep: false;]
		ptr<DomNode> top: (CloneOne: n);
		if not deep or n.first_child is 0 return top;
		ptr<DomNode> from: n.first_child;
		ptr<DomNode> dest: top;
		while from is not 0
			ptr<DomNode> made: (CloneOne: from);
			call Dom.Append: dest made;
			if from.first_child is not 0
				dest is made;
				from is from.first_child;
			;;
			else
				while from is not n and from.next is 0
					from is from.parent;
					dest is dest.parent;
				;;
				if from is n
					from is 0;
				;;
				else
					from is from.next;
				;;
			;;
		;;
	[end: top]

	[CloneOne: ptr<DomNode> n: 0;]
		ptr<DomNode> c: 0;
		ptr<DomDocument> doc: n.doc;
		when n.type
			is DomType.ELEMENT
				c is (Dom.CreateElement: doc n.tag n.ns);
				ptr<DomAttr> a: n.attrs;
				while a is not 0
					ptr<DomAttr> na: (Dom.SetAttr: c a.name a.value a.value_len);
					na.prefix is a.prefix;
					a is a.next;
				;;
			;;
			is DomType.TEXT DomType.CDATA
				c is (Dom.CreateText: doc n.text n.text_len);
				c.type is n.type;
			;;
			is DomType.COMMENT DomType.PI
				c is (Dom.CreateComment: doc n.text n.text_len);
				c.type is n.type;
				c.tag is n.tag;
			;;
			is DomType.FRAGMENT
				c is (Dom.CreateFragment: doc);
			;;
			is DomType.DOCTYPE
				c is (Dom.CreateDoctype: doc n.tag n.text n.text_len n.text2 n.text2_len);
			;;
			else
				call DomError: 'NotSupportedError' 'A document cannot be cloned here';
			;;
		;;
	[end: c]

	[HasChildNodes: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
	[end: (JsV.Bool: n.first_child is not 0)]

	[ContainsFn: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		ptr<DomNode> o: (NodeOf: (Js.Arg: args argc 0));
		if o is 0
			return JsV.FALSE;
		;;
	[end: (JsV.Bool: (Dom.Contains: n o))]

	[Normalize: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> root: (ThisNode: args);
		ptr<DomNode> n: root;
		while n is not 0
			if n.type is DomType.TEXT
				while n.next is not 0 and n.next.type is DomType.TEXT
					ptr<DomNode> following: n.next;
					call Dom.AddText: n following.text following.text_len;
					call Dom.Remove: following;
				;;
				if n.text_len is 0 and n is not root
					ptr<DomNode> gone: n;
					n is (Dom.NextSkipping: n root);
					call Dom.Remove: gone;
					continue;
				;;
			;;
			n is (Dom.Next: n root);
		;;
	[end: JsV.UNDEF]

	[GetRootNode: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		while n.parent is not 0
			n is n.parent;
		;;
	[end: (Wrap: n)]

	[ComparePosition: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> a: (ThisNode: args);
		ptr<DomNode> b: (ArgNode: (Js.Arg: args argc 0));
		if a is b
			return (JsV.Int: 0);
		;;
		if (Dom.Contains: a b)
			return (JsV.Int: 20);
		;;
		if (Dom.Contains: b a)
			return (JsV.Int: 10);
		;;
		ptr<DomNode> top_a: a;
		while top_a.parent is not 0
			top_a is top_a.parent;
		;;
		ptr<DomNode> top_b: b;
		while top_b.parent is not 0
			top_b is top_b.parent;
		;;
		if top_a is not top_b
			return (JsV.Int: 33);
		;;
		ptr<DomNode> w: a;
		while w is not 0
			if w is b
				return (JsV.Int: 4);
			;;
			w is (Dom.Next: w top_a);
		;;
	[end: (JsV.Int: 2)]

	[IsSameNode: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> a: (ThisNode: args);
	[end: (JsV.Bool: a is (NodeOf: (Js.Arg: args argc 0)))]

	[RemoveSelf: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisNode: args);
		call Dom.Remove: n;
	[end: JsV.UNDEF]

	# ---- Element ----

	const u32 E_TAG: 0;
	const u32 E_LOCAL: 1;
	const u32 E_NS: 2;
	const u32 E_CHILDREN: 3;
	const u32 E_FIRST_EL: 4;
	const u32 E_LAST_EL: 5;
	const u32 E_NEXT_EL: 6;
	const u32 E_PREV_EL: 7;
	const u32 E_COUNT: 8;
	const u32 E_CLASSLIST: 9;
	const u32 E_STYLE: 10;
	const u32 E_DATASET: 11;
	const u32 E_ATTRS: 12;

	const u32 B_LEFT: 0;
	const u32 B_TOP: 1;
	const u32 B_WIDTH: 2;
	const u32 B_HEIGHT: 3;

	[InstallElement]
		ptr<JsObj> p: element_proto;
		call Getter: p 'tagName' addr ElementProp 0 E_TAG;
		call Getter: p 'localName' addr ElementProp 0 E_LOCAL;
		call Getter: p 'namespaceURI' addr ElementProp 0 E_NS;
		call Getter: p 'attributes' addr ElementProp 0 E_ATTRS;
		call Getter: p 'classList' addr ElementProp 0 E_CLASSLIST;
		call Getter: p 'id' addr ReflectGet addr ReflectSet (AtomMagic: 'id');
		call Getter: p 'className' addr ReflectGet addr ReflectSet (AtomMagic: 'class');
		call Getter: p 'slot' addr ReflectGet addr ReflectSet (AtomMagic: 'slot');
		call Getter: p 'innerHTML' addr InnerHtmlGet addr InnerHtmlSet 0;
		call Getter: p 'outerHTML' addr OuterHtmlGet addr OuterHtmlSet 0;
		call Method: p 'getAttribute' addr GetAttribute 1 0;
		call Method: p 'setAttribute' addr SetAttribute 2 0;
		call Method: p 'removeAttribute' addr RemoveAttribute 1 0;
		call Method: p 'hasAttribute' addr HasAttribute 1 0;
		call Method: p 'toggleAttribute' addr ToggleAttribute 1 0;
		call Method: p 'getAttributeNames' addr GetAttributeNames 0 0;
		call Method: p 'hasAttributes' addr HasAttributes 0 0;
		call Method: p 'getAttributeNS' addr NsGetAttribute 2 0;
		call Method: p 'setAttributeNS' addr NsSetAttribute 3 0;
		call Method: p 'removeAttributeNS' addr NsRemoveAttribute 2 0;
		call Method: p 'matches' addr MatchesFn 1 0;
		call Method: p 'webkitMatchesSelector' addr MatchesFn 1 0;
		call Method: p 'closest' addr ClosestFn 1 0;
		call Method: p 'insertAdjacentHTML' addr InsertAdjacentHtml 2 0;
		call Method: p 'insertAdjacentElement' addr InsertAdjacentNode 2 0;
		call Method: p 'insertAdjacentText' addr InsertAdjacentText 2 0;
		call Method: p 'getBoundingClientRect' addr BoundingRect 0 0;
		call Method: p 'getClientRects' addr ClientRects 0 0;
		call Method: p 'remove' addr RemoveSelf 0 0;
		call Method: p 'focus' addr Focus 0 1;
		call Method: p 'blur' addr Focus 0 0;
		call Method: p 'click' addr ClickFn 0 0;
		call Method: p 'scrollIntoView' addr Nothing 0 0;
		call Method: p 'scrollTo' addr Nothing 0 0;
		call Method: p 'scrollBy' addr Nothing 0 0;
		call Getter: p 'clientWidth' addr BoxGet 0 B_WIDTH;
		call Getter: p 'clientHeight' addr BoxGet 0 B_HEIGHT;
		call Getter: p 'clientLeft' addr Zero 0 0;
		call Getter: p 'clientTop' addr Zero 0 0;
		call Getter: p 'scrollWidth' addr BoxGet 0 B_WIDTH;
		call Getter: p 'scrollHeight' addr BoxGet 0 B_HEIGHT;
		call Getter: p 'scrollLeft' addr Zero addr Nothing 0;
		call Getter: p 'scrollTop' addr Zero addr Nothing 0;
		call ParentNodeMethods: p;
		call ChildNodeMethods: p;
		call ChildNodeMethods: character_proto;
		call Method: p 'getElementsByTagName' addr ByTag 1 0;
		call Method: p 'getElementsByClassName' addr ByClass 1 0;
		ptr<JsObj> h: html_proto;
		call Getter: h 'style' addr ElementProp 0 E_STYLE;
		call Getter: h 'dataset' addr ElementProp 0 E_DATASET;
		call Getter: svg_proto 'style' addr ElementProp 0 E_STYLE;
		call Getter: h 'offsetWidth' addr BoxGet 0 B_WIDTH;
		call Getter: h 'offsetHeight' addr BoxGet 0 B_HEIGHT;
		call Getter: h 'offsetLeft' addr BoxGet 0 B_LEFT;
		call Getter: h 'offsetTop' addr BoxGet 0 B_TOP;
		call Getter: h 'offsetParent' addr OffsetParent 0 0;
		call Getter: h 'innerText' addr TextContentGet addr TextContentSet 0;
		ptr<u8> names: 'title lang dir href src alt rel target type name placeholder action method enctype accept htmlFor=for media content charset download hreflang srcset sizes poster role tabIndex=tabindex cols rows maxLength=maxlength minLength=minlength min max step pattern list form autocomplete ';
		u32 i: 0;
		while names:i is not 0
			u32 start: i;
			u32 eq: 0;
			while names:i is not 32
				if names:i is '='
					eq is i;
				;;
				i++;
			;;
			if eq is 0
				ptr<JsStr> prop: (JsStrs.Intern: names + start i - start);
				call Getter: h prop.data addr ReflectGet addr ReflectSet (AtomMagicN: names + start i - start);
			;;
			else
				ptr<JsStr> prop2: (JsStrs.Intern: names + start eq - start);
				call Getter: h prop2.data addr ReflectGet addr ReflectSet (AtomMagicN: names + eq + 1 i - eq - 1);
			;;
			i++;
		;;
		ptr<u8> bools: 'hidden checked disabled readOnly=readonly required selected multiple autofocus defer async open controls loop muted noValidate=novalidate draggable ';
		i is 0;
		while bools:i is not 0
			u32 start2: i;
			u32 eq2: 0;
			while bools:i is not 32
				if bools:i is '='
					eq2 is i;
				;;
				i++;
			;;
			if eq2 is 0
				ptr<JsStr> bprop: (JsStrs.Intern: bools + start2 i - start2);
				call Getter: h bprop.data addr BoolGet addr BoolSet (AtomMagicN: bools + start2 i - start2);
			;;
			else
				ptr<JsStr> bprop2: (JsStrs.Intern: bools + start2 eq2 - start2);
				call Getter: h bprop2.data addr BoolGet addr BoolSet (AtomMagicN: bools + eq2 + 1 i - eq2 - 1);
			;;
			i++;
		;;
		# a form control's value is state of its own, kept under a key, that starts from the attribute
		call Getter: h 'value' addr ValueProp addr ValuePropSet 0;
		call Getter: h 'width' addr NumberAttr addr ReflectSet (AtomMagic: 'width');
		call Getter: h 'height' addr NumberAttr addr ReflectSet (AtomMagic: 'height');
		ptr<u8> events: 'onclick ondblclick onmousedown onmouseup onmouseover onmouseout onmousemove onkeydown onkeyup onkeypress onfocus onblur onchange oninput onsubmit onload onerror onresize onscroll ';
		call EventProps: h events;
		call EventProps: document_proto events;
		call EventProps: JsRt.r.global events;
	[end]

	# el.onclick and the like start as plain properties: Event dispatch looks them up by name, and they read as
	# null until they're given something. Null here, on the prototype, is what that takes.
	[EventProps: ptr<JsObj> proto: 0; ptr<u8> names: 0;]
		u32 i: 0;
		while names:i is not 0
			u32 start: i;
			while names:i is not 32
				i++;
			;;
			ptr<JsStr> key: (JsStrs.Intern: names + start i - start);
			if (JsObjs.Find: proto key as ptr<u8>) is 0
				call JsObjs.DefineValue: proto key as ptr<u8> JsV.NULL JsObjs.WEC;
			;;
			i++;
		;;
	[end]

	[Nothing: ptr<u64> args: 0; int argc: 0;]
	[end: JsV.UNDEF]

	[Zero: ptr<u64> args: 0; int argc: 0;]
	[end: JsV.INT_BASE]

	# A WlAtom in a native's u32 magic won't fit on 64-bit, so a small table holds them, and magic is its index.
	ptr<ptr<WlAtom>> atom_table: 0;
	u32 atom_count: 0;

	[AtomMagicN: ptr<u8> text: 0; u32 n: 0;]
		ptr<WlAtom> a: (WlAtoms.Get: text n);
		if atom_table is 0
			atom_table is new ptr<WlAtom>[256];
			if atom_table is 0
				throw 'out of memory';
			;;
		;;
		while u32 i: 0; i < atom_count; i++;
			if atom_table:i is a return i;
		;;
		if atom_count >= 256
			throw 'too many reflected attributes';
		;;
		atom_table:atom_count is a;
		atom_count++;
	[end: atom_count - 1]

	[AtomMagic: ptr<u8> text: 0;]
	[end: (AtomMagicN: text (WlText.LenZ: text))]

	[CalleeAtom: ptr<u64> args: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
	[end: atom_table:(self.magic)]

	[ElementProp: ptr<u64> args: 0; int argc: 0;]
		ptr<JsNativeFn> self: (Js.CalleeOf: args);
		ptr<DomNode> n: (ThisElement: args);
		when self.magic
			is E_TAG
				return (NodeName: n);
			;;
			is E_LOCAL
				return (Js.NewString: n.tag.text n.tag.len);
			;;
			is E_NS
				when n.ns
					is DomNs.SVG
						return (Js.NewStringZ: 'http://www.w3.org/2000/svg');
					;;
					is DomNs.MATHML
						return (Js.NewStringZ: 'http://www.w3.org/1998/Math/MathML');
					;;
					else
					;;
				;;
				return (Js.NewStringZ: 'http://www.w3.org/1999/xhtml');
			;;
			is E_ATTRS
				return (AttrList: n);
			;;
			is E_CLASSLIST
				return (Cached: n 'classList' token_class token_proto);
			;;
			is E_STYLE
				return (Cached: n 'style' style_class style_proto);
			;;
			is E_DATASET
				return (Cached: n 'dataset' dataset_class dataset_proto);
			;;
		;;
	[end: JsV.UNDEF]

	# el.style and the like are the same object each time, kept under a private key on the wrapper
	[Cached: ptr<DomNode> n: 0; ptr<u8> name: 0; ptr<JsClass> cl: 0; ptr<JsObj> proto: 0;]
		ptr<JsObj> w: (JsV.AsObj: (Wrap: n));
		ptr<JsStr> key: (JsStrs.InternZ: name);
		ptr<JsProp> found: (JsObjs.Find: w key as ptr<u8>);
		if found is not 0
			return found.value;
