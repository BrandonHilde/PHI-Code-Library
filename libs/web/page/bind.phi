		ptr<DomAttr> a: n.attrs;
		while a is not 0
			call JsObjs.ArrayPush: list (Js.NewString: a.name.text a.name.len);
			a is a.next;
		;;
	[end: (JsV.Obj: list)]

	[NsGetAttribute: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomAttr> a: (Dom.Attr: n (AtomOf: (Js.Arg: args argc 1)));
		if a is 0
			return JsV.NULL;
		;;
	[end: (Js.NewString: a.value a.value_len)]

	[NsSetAttribute: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
