		call Dom.RemoveAttr: n (AtomOf: (Js.Arg: args argc 1));
	[end: JsV.UNDEF]

	# el.id, el.href and all such: the attribute named by the getter's magic
	[ReflectGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomAttr> a: (Dom.Attr: n (CalleeAtom: args));
		if a is 0
			return (JsV.Str: JsRt.blank);
		;;
	[end: (Js.NewString: a.value a.value_len)]

	[ReflectSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		call SetAttrFrom: n (CalleeAtom: args) (Js.Arg: args argc 0);
	[end: JsV.UNDEF]

	[BoolGet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
	[end: (JsV.Bool: (Dom.Attr: n (CalleeAtom: args)) is not 0)]

	[BoolSet: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<WlAtom> name: (CalleeAtom: args);
		if (JsOps.ToBool: (Js.Arg: args argc 0))
			if (Dom.Attr: n name) is 0
				call Dom.SetAttr: n name 0 0;
			;;
		;;
		else
			call Dom.RemoveAttr: n name;
		;;
	[end: JsV.UNDEF]

	[NumberAttr: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomAttr> a: (Dom.Attr: n (CalleeAtom: args));
		if a is 0
			return JsV.INT_BASE;
		;;
		f64 x: (JsOps.ToNumber: (Js.NewString: a.value a.value_len));
		if x is not x
			return JsV.INT_BASE;
		;;
	[end: (JsV.Num: x)]

	[ValueProp: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<JsObj> w: (JsV.AsObj: (Wrap: n));
		ptr<JsProp> found: (JsObjs.Find: w (JsStrs.InternZ: '%value') as ptr<u8>);
		if found is not 0
			return found.value;
