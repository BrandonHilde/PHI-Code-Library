		ptr<JsObj> o: (JsObjs.NewHost: cl proto n as ptr<u8>);
		call JsObjs.DefineValue: w key as ptr<u8> (JsV.Obj: o) 0;
	[end: (JsV.Obj: o)]

	# a plain array of {name, value}: it isn't live, but it reads right
	[AttrList: ptr<DomNode> n: 0;]
		ptr<JsObj> list: (JsObjs.NewArray: 4);
		ptr<DomAttr> a: n.attrs;
		while a is not 0
			ptr<JsObj> one: (JsObjs.NewObject);
			u64 nm: (Js.NewString: a.name.text a.name.len);
			call Js.Define: one 'name' nm JsObjs.E;
			call Js.Define: one 'localName' nm JsObjs.E;
			call Js.Define: one 'value' (Js.NewString: a.value a.value_len) JsObjs.E | JsObjs.W;
			call JsObjs.ArrayPush: list (JsV.Obj: one);
			a is a.next;
		;;
	[end: (JsV.Obj: list)]

	# attribute names on HTML elements are lowercase, whatever a script writes
	[AttrAtom: ptr<DomNode> n: 0; u64 v: 0;]
		WlBuf b;
		call Js.TextOf: v addr b;
		ptr<WlAtom> a: 0;
		if n.ns is DomNs.HTML
			a is (WlAtoms.GetLower: b.data b.len);
		;;
		else
			a is (WlAtoms.Get: b.data b.len);
		;;
		call b.Free;
	[end: a]

	[GetAttribute: ptr<u64> args: 0; int argc: 0;]
		ptr<DomNode> n: (ThisElement: args);
		ptr<DomAttr> a: (Dom.Attr: n (AttrAtom: n (Js.Arg: args argc 0)));
		if a is 0
			return JsV.NULL;
		;;
	[end: (Js.NewString: a.value a.value_len)]

	[SetAttrFrom: ptr<DomNode> n: 0; ptr<WlAtom> name: 0; u64 value: 0;]
		WlBuf b;
		call Js.TextOf: value addr b;
		call Dom.SetAttr: n name b.data b.len;
		call b.Free;
	[end]

	[SetAttribute: ptr<u64> args: 0; int argc: 0;]
