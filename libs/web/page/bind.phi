		call Getter: p 'activeElement' addr DocProp 0 D_ACTIVE;
		call Getter: p 'currentScript' addr DocProp 0 D_CURRENT_SCRIPT;
		call Getter: p 'doctype' addr DocProp 0 D_DOCTYPE;
		call Getter: p 'defaultView' addr DocProp 0 D_VIEW;
		call Getter: p 'compatMode' addr DocProp 0 D_COMPAT;
		call Getter: p 'characterSet' addr DocProp 0 D_CHARSET;
		call Getter: p 'charset' addr DocProp 0 D_CHARSET;
		call Getter: p 'hidden' addr DocProp 0 D_HIDDEN;
		call Getter: p 'visibilityState' addr DocProp 0 D_VISIBILITY;
		call Getter: p 'forms' addr DocProp 0 D_FORMS;
