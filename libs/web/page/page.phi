# A document with its scripts and styles: what a browser's tab holds, and the whole of what it needs from this
# library. Everything from outside goes through PageHost, a struct of methods the browser fills in, so the
# library opens no files and no sockets.
#
#   PageHost host;
#   host.load is addr MyLoad;                    # fetch a URL, then call Page.Delivered
#   ptr<Page> page: (Page.New: addr host 1024.0 768.0);
#   call Page.Load: page html_bytes length 'https://example.com/';
#   while running
#       call Page.Tick: page now_ms;             # timers and promise jobs
#       call Page.UpdateStyle: page;             # node.style for every element that changed
#       # lay out and paint page.doc
#       call Page.Frame: page now_ms;            # requestAnimationFrame
#   ;;
#   call Page.Free: page;

use core.buf;
use core.text;
use dom.dom;
use html.parser;
use css.css;
use js.js;
use page.bind;
use page.events;
use page.window;
use page.observers;
use page.referrer;
use page.elements;
use page.platform;
use page.shadow;
use page.pmodules;
use page.canvas;
use page.anim;
use page.socket;
use page.realm;
use page.scroll;
use page.media;

# what's asked of PageHost.load
enum.PageLoad
{
	DOCUMENT
	SCRIPT
	STYLE
	FETCH
	IMAGE
	MEDIA                   # an <audio> or <video>'s file (PageMedia): all of it, answered once
}

struct.PageHost
{
	# Page, absolute URL, what it's for, the request's number. The answer is Page.Delivered with that number,
	# from inside this call or at any time after it (and Page.AnswerHeaders before it, for a fetch's). What a
	# fetch sends, if it isn't a plain GET, is in (Page.Find: page number): verb, headers and body, which
	# last until the answer.
	method<ptr<Page> ptr<u8> PageLoad u32> load;
	# console.logger and the like, and scripts' uncaught errors: text, length, level (0 log, 1 warning, 2 error)
	method<ptr<Page> ptr<u8> u32 int> logger;
	# something changed that may show: a good time to run the frame
	method<ptr<Page>> invalidate;
	# the page asked to go somewhere: location.href = ..., a link followed
	method<ptr<Page> ptr<u8>> navigate;
	# a form the page submitted by POST (form.submit(), requestSubmit()): where, its Content-Type,
	# and its body (bytes, how many). Without it, such a form goes nowhere.
	method<ptr<Page> ptr<u8> ptr<u8> ptr<u8> u32> post;
	# localStorage that outlasts the page, by origin ("https://example.com:8080"): what was kept
	# (into the buffer; false if nothing), and all of it to keep, whenever it changes. Its bytes are
	# records: a key's length (four bytes, the lowest first), the key (UTF-8), the value's length, the
	# value. Without them, localStorage lasts as long as the page.
	method<ptr<Page> ptr<u8> ptr<WlBuf>: bln> storage_load;
	# WebSockets: a connection opened (url, the protocols asked for, comma separated: an id, or 0 if
	# there's no room), a message sent on one (id, bytes, how many, binary: whether it went), and one
	# closed (id, code, reason). What happens on them the host tells Page.SocketEvent. Without them, a
	# page's WebSocket fails at once.
	method<ptr<Page> ptr<u8> ptr<u8>: int> ws_open;
	method<ptr<Page> int ptr<u8> u32 bln: bln> ws_send;
	# scrolling a page asks for (page/scroll.phi): the window (node 0) or a box that scrolls to
	# (x, y) (kind 0), or the node brought into view (kind 1). The host says where things went with
	# Page.Scrolled. Without it, what the page sets is kept as it is.
	method<ptr<Page> ptr<DomNode> f64 f64 int> scroll;
	method<ptr<Page> int int ptr<u8>> ws_close;
	method<ptr<Page> ptr<u8> ptr<u8> u32> storage_save;
	# where layout put a node: fills in x, y, width, height. Without it, layout queries answer 0.
	method<ptr<Page> ptr<DomNode> ptr<f64>> box;
	# what's drawn at (x, y) on the page (from its top left, not the window's), on top: the node, or
	# 0 for none (document.elementFromPoint). Without it, those answer null.
	method<ptr<Page> f64 f64: ptr<DomNode>> hit;
	# window.alert
	method<ptr<Page> ptr<u8>> alert;
	# document.cookie: the cookies for the page (into a buffer of the size given: their length), and one
	# the page sets ("name=value; Path=/..."). Without them, a page sees what it set, this session.
	method<ptr<Page> ptr<u8> int: int> cookies;
	method<ptr<Page> ptr<u8>> set_cookie;
	# for a <canvas>: a string's outlines in a CSS font (font, text, its length; into the path if it isn't
	# 0, at a baseline through the origin, with width, ascent and descent into the three numbers: false
	# if it can't); an <img>'s pixels (into the bitmap: false if it has none yet); and pixels as a PNG
	# file (pixels, width, height, into the buffer: false if it can't). Without them, text and pictures
	# don't draw, and toDataURL gives "data:,".
	method<ptr<Page> ptr<u8> ptr<u8> u32 ptr<VgPath> ptr<f64>: bln> canvas_text;
	method<ptr<Page> ptr<DomNode> ptr<PageBitmap>: bln> image_pixels;
	method<ptr<Page> ptr<u32> int int ptr<WlBuf>: bln> encode_png;
	# <audio> and <video>'s sound, mixed (page/media.phi): the rate the host plays at (0 or less if it
	# has none), a block of frames of left and right to play after what it has (how many it took), and
	# how many it has that haven't been heard yet. Without them, media play without sound.
	method<ptr<Page>: int> audio_rate;
	method<ptr<Page> ptr<i16> int: int> audio_write;
	method<ptr<Page>: int> audio_queued;
	# an <img>'s picture: 0 if none's been asked for, 1 if it's coming, 2 if it's here (its width
	# and height into the two ints), 3 if it can't be had. A host that has it answers an <img>'s
	# PageLoad.IMAGE only once its picture is in (or can't be), and the window's load waits for
	# those. Without it, a picture has come as soon as it's asked for, with no size.
	method<ptr<Page> ptr<DomNode> ptr<int>: int> picture;
	ptr<u8> user;           # the browser's own
}

struct.PageTimer
{
	int id;
	f64 due;
	f64 interval;           # 0 for one that fires once
	u64 fn;
	u64 args;               # a JS array, or undefined
	bln frame;              # requestAnimationFrame
}

struct.PageRequest
{
	u32 id;
	PageLoad kind;
	bln done;
	bln blocks;             # the parser waits for it (a script of the document's, not async or deferred)
	ptr<DomNode> node;      # the script or link it's for
	ptr<CssImport> import;  # a sheet's @import it's for (the kind is STYLE, and there's no node)
	u64 a;                  # resolve
	u64 b;                  # reject
	ptr<u8> url;
	int policy;             # its referrer policy (PageReferrer's numbers, 0 the default), fixed as it's made:
	                        # its element's referrerpolicy, fetch's referrerPolicy, or the document's then
	# what fetch and XMLHttpRequest send (the host reads them in PageHost.load, through Page.Find):
	ptr<u8> verb;           # 'POST' and the like, or 0 for a GET
	ptr<u8> headers;        # header lines, each "Name: value\r\n", or 0
	ptr<u8> body;           # what goes after them, or 0
	u32 body_len;
	# the answer's status line and header lines, if the host gives them (Page.AnswerHeaders)
	ptr<u8> answer_headers;
	# an answer that came while JS was running, which waits until it's finished
	bln waiting;
	int answer_status;
	ptr<u8> answer;
	u32 answer_len;
}

struct.PageSheet
{
	ptr<DomNode> node;      # the <style> or <link>
	ptr<CssSheet> sheet;
	u32 text_hash;
	u32 text_len;
	bln seen;
	# what a script made of a <style>'s sheet (insertRule, deleteRule: page/platform.js), which is
	# what styles the page instead of its text, until its text changes (own_base was its hash then)
	ptr<u8> own;
	u32 own_len;
	u32 own_base;
	bln owned;
	# a <link>'s sheet as it came, and where from: for a script that reads its rules (%linkText)
	ptr<u8> link_text;
	u32 link_len;
	ptr<u8> link_from;
}

struct.Page
{
	PageHost host;
	ptr<DomDocument> doc;
	ptr<HtmlParser> parser;
	ptr<CssEngine> css;
	ptr<JsRuntime> rt;
	ptr<u8> url;
	# what the page's relative addresses are against (BaseUrl): its first <base href>, or url
	ptr<u8> base;
	u32 base_version;
	ptr<u8> base_from;          # the url it was made against (pushState changes it)
	bln base_known;

	f64 width;
	f64 height;
	f64 now;
	f64 started_at;
	bln started_clock;

	PageTimer timers[atmost 2048];
	int next_timer;

	PageRequest requests[atmost 1024];
	ptr<DomNode> new_srcs[atmost 512];  # <img>s given a src, which ask for it once the script's done
	ptr<DomNode> new_metas[atmost 16];  # <meta>s given another name or content: taken before the next request (MetaPolicies)
	ptr<u8> referrer;       # document.referrer: the Referer the page's own request went with (SetReferrer; 0: none)
	int policy;             # the document's referrer policy (PageReferrer's numbers, 0 the default): its
	                        # Referrer-Policy header's (the host's), then each <meta name=referrer>'s as it comes
	int nav_policy;         # while host.navigate or host.post runs: the policy its request's Referer goes by
	u32 next_request;
	int blocking;           # requests the parser is waiting for
	int nest;               # how deep in running JS we are: microtasks and answers wait for 0
	bln submitted;          # the last Click's default action sent a form (the host needn't)
	bln is_frame;           # the host's: a page in another's <iframe> (its media aren't played)
	u64 realm[128];          # its JS classes and prototypes while another page is used (PageRealm; REALM_ROOM)
	ptr<JsObj> local_obj;
	# where it's scrolled to (page/scroll.phi): the window, and each box the host has said of
	f64 scroll_x;
	f64 scroll_y;
	bln scroll_window_news;         # a scroll event for the window waits for the next frame
	ptr<DomNode> scroll_nodes[atmost 256];
	f64 scroll_nx[256];
	f64 scroll_ny[256];
	bln scroll_news[256];   # its localStorage (changes to it are given to the host to keep)
	ptr<u8> anim_runs;      # its transitions and animations (PageAnim's, while another page has them)
	int anim_count;
	int anim_cap;
	bln parse_done;
	bln load_fired;

	ptr<DomNode> defer_list[atmost 256];
	ptr<DomNode> mod_nodes[atmost 256];   # module scripts, in the document's order (page/pmodules.phi)
	ptr<u8> mod_urls[atmost 256];         # their modules' addresses
	bln mod_async[atmost 256];
	u32 mod_next;                         # the first that hasn't run
	ptr<DomNode> current_script;
	ptr<DomNode> focused;
	# the mouse (Page.Pointer): the element it's over (:hover), the one a button was pressed on
	# while it's held (:active), and whether a canceled pointerdown keeps mouse events back
	ptr<DomNode> hovered;
	ptr<DomNode> pressed;
	bln no_compat;
	bln focus_quiet;            # what has the focus isn't :focus-visible (Chrome's rule, MoveFocus)
	bln mouse_focus;            # the last the user moved the focus, it was with the mouse
	ptr<DomNode> start_point;   # where the mouse was last pressed: where Tab goes on from (TabFocus)
	ptr<DomNode> edited;        # the field typed into since its last change event (Commit)
	ptr<DomNode> space_on;      # what a space went down on, to be pressed when it comes up (KeyUp)

	PageSheet sheets[atmost 4096];        # (each shadow tree's <style> is one)
	u32 sheets_version;
	bln sheets_scanned;

	# everything the page's objects need kept alive that isn't reachable some other way, in one JS array
	ptr<DomDocument> docs[atmost 256];    # documents a script made (document.implementation), freed with it
	# the import maps' entries (page/pmodules.phi): a scope ('' for the top level), a specifier or a
	# prefix of one, and the address it maps to, each on the heap
	ptr<CssSheet> made_sheets[atmost 4096];   # new CSSStyleSheet()'s, by their keys (page/platform.phi)
	ptr<u8> map_scope[atmost 1024];
	ptr<u8> map_key[atmost 1024];
	ptr<u8> map_url[atmost 1024];
	bln observing;          # a MutationObserver is watching (page/observers.phi)
	bln custom_elements;    # a custom element is defined (page/elements.phi)

	u64 keep;
	u64 window_location;
	u64 storage;
}

phi.Page:Library
{
	const int REALM_ROOM: 128;   # (Page.realm's size)

	# what Page.SocketEvent says of a WebSocket
	const int WS_OPEN: 1;       # it's open: data is the protocol the server chose
	const int WS_TEXT: 2;       # a text message (UTF-8)
	const int WS_BINARY: 3;     # a binary message
	const int WS_ERROR: 4;      # it failed (a close follows)
	const int WS_CLOSED: 5;     # it's closed: code, and data the reason

	# The host's news of scrolling: node (0 for the window) is scrolled to (x, y). The page's
	# scrollX, scrollTop ... say so at once; a scroll event goes in the next frame.
	[Scrolled: ptr<Page> p: 0; ptr<DomNode> n: 0; f64 x: 0.0; f64 y: 0.0;]
		call PageScroll.Scrolled: p n x y;
	[end]

	# The host's news of a WebSocket (ws_open's id): see WS_*. Turned into the socket's events.
	[SocketEvent: ptr<Page> p: 0; int id: 0; int kind: 0; ptr<u8> data: 0; u32 n: 0; int code: 0;]
		if p is 0 return;
		call PageSocket.Event: p id kind data n code;
	[end]

	ptr<Page> current: 0;

	# ---- starting and stopping ----

	[New: ptr<PageHost> host: 0; f64 width: 1024.0; f64 height: 768.0;]
		ptr<Page> p: new Page;
		if p is 0
			return 0 as ptr<Page>;
		;;
		if host is not 0
			p.host.load is host.load;
			p.host.logger is host.logger;
			p.host.invalidate is host.invalidate;
			p.host.navigate is host.navigate;
			p.host.post is host.post;
			p.host.storage_load is host.storage_load;
			p.host.storage_save is host.storage_save;
			p.host.ws_open is host.ws_open;
			p.host.ws_send is host.ws_send;
			p.host.ws_close is host.ws_close;
			p.host.scroll is host.scroll;
			p.host.box is host.box;
			p.host.hit is host.hit;
			p.host.alert is host.alert;
			p.host.cookies is host.cookies;
			p.host.set_cookie is host.set_cookie;
			p.host.canvas_text is host.canvas_text;
			p.host.audio_rate is host.audio_rate;
			p.host.audio_write is host.audio_write;
			p.host.audio_queued is host.audio_queued;
			p.host.image_pixels is host.image_pixels;
			p.host.encode_png is host.encode_png;
			p.host.picture is host.picture;
			p.host.user is host.user;
		;;
		p.width is width;
		p.height is height;
		p.next_timer is 1;
		p.next_request is 1;
		p.doc is (Dom.NewDocument);
		call HookMutations: p;
		p.parser is (HtmlParser.New: p.doc);
		p.parser.scripting is true;
		p.parser.host_data is p as ptr<u8>;
		p.parser.on_script is addr OnScript;
		p.css is (Css.NewEngine: p.doc);
		CssSel.on_state is addr CssState;
		p.css.on_import is addr OnImport;
		p.css.on_style is addr PageAnim.Style;
		call p.css.SetViewport: width height;
		if current is not 0
			# (what the page in use made is kept in it: this one makes its own)
			call PageRealm.Save: current;
		;;
		p.rt is (Js.New);
		p.keep is JsV.UNDEF;
		p.window_location is JsV.UNDEF;
		p.storage is JsV.UNDEF;
		current is p;
		call PageRealm.Clear;
		call PageBind.Install: p;
		call PageObservers.Install: p;
		call PageElements.Install: p;
		call PagePlatform.Install: p;
		call PageScroll.Install: p;
		call PageModules.Hooks;
		call Js.AddRootFn: addr MarkAll;
	[end: p]

	# The document tells Mutated of each change while a MutationObserver watches or a custom element is
	# defined, and nothing otherwise.
	# (always on: an <img> asks for its picture when it's given one, Pictures)
	[HookMutations: ptr<Page> p: 0;]
		p.doc.on_mutation is addr Mutated;
	[end]

	[Mutated: ptr<DomNode> target: 0; int kind: 0; ptr<DomNode> node: 0; ptr<WlAtom> name: 0; ptr<u8> old: 0; int old_length: 0;]
		ptr<Page> p: current;
		if p is 0 return;
		call Pictures: p target kind node name;
		call Metas: p target kind node name;
		PageElements.holding++;
		if p.custom_elements
			call PageElements.Mutated: target kind node name old old_length;
		;;
		if p.observing
			call PageObservers.Mutated: target kind node name old old_length;
		;;
		PageElements.holding--;
	[end]

	# An <img> of the page's document asks for its picture (a PageLoad.IMAGE request) when it's put in
	# with a src, or given another: its load or error event comes when the host answers. (The
	# browser draws pictures itself, from layout; this is what the page's scripts are told.)
	[Pictures: ptr<Page> p: 0; ptr<DomNode> target: 0; int kind: 0; ptr<DomNode> node: 0; ptr<WlAtom> name: 0;]
		if kind is Dom.ATTRIBUTE
			# (told before the new value's in place: it asks once what's running is done, RunJobs)
			if target.doc is p.doc and target.tag is (WlAtoms.GetZ: 'img') and target.ns is DomNs.HTML and (name is (WlAtoms.GetZ: 'src') or name is (WlAtoms.GetZ: 'srcset'))
				while u32 q: 0; q < p.new_srcs.len; q++;
					if p.new_srcs:q is target return;
				;;
				if p.new_srcs.len < p.new_srcs.max
					p.new_srcs++ target;
				;;
			;;
			return;
		;;
		if kind is not Dom.ADDED or node is 0 or node.doc is not p.doc return;
		# (what came in may hold pictures of its own)
		ptr<DomNode> n: node;
		while n is not 0
			if n.type is DomType.ELEMENT and (n.flags & Dom.PICTURE_ASKED) is 0 and n.tag is (WlAtoms.GetZ: 'img') and n.ns is DomNs.HTML
				call AskPicture: p n;
			;;
			n is (Dom.Next: n node);
		;;
	[end]

	[AskPicture: ptr<Page> p: 0; ptr<DomNode> img: 0;]
		# (the policy its picture goes by is fixed now, for the host: PicturePolicy)
		int policy: (ElementPolicy: p img false);
		img.flags is (img.flags & (Dom.PICTURE_POLICY ^ 0xFFFFFFFF)) | ((((policy + 1) as u32) << Dom.PICTURE_POLICY_SHIFT));
		ptr<DomAttr> src: (Dom.Attr: img (WlAtoms.GetZ: 'src'));
		if src is not 0 and src.value_len > 0
			img.flags is img.flags | Dom.PICTURE_ASKED;
			u32 id: (Request: p src.value src.value_len PageLoad.IMAGE img);
			return;
		;;
		# (none: srcset's first picture, the one its load event is about as far as a script can tell)
		ptr<DomAttr> set: (Dom.Attr: img (WlAtoms.GetZ: 'srcset'));
		if set is 0 or set.value_len is 0 return;
		u32 from: 0;
		while from < set.value_len and (set.value:from is 32 or set.value:from is 9 or set.value:from is 10 or set.value:from is ',')
			from++;
		;;
		u32 to: from;
		while to < set.value_len and set.value:to is not 32 and set.value:to is not 9 and set.value:to is not 10
			to++;
		;;
		# (a comma ending the address is the list's, not the address's)
		while to > from and set.value:(to - 1) is ','
			to--;
		;;
		if to is from return;
		img.flags is img.flags | Dom.PICTURE_ASKED;
		u32 id2: (Request: p set.value + from to - from PageLoad.IMAGE img);
	[end]

	# What CSS asks of the page (CssSel.on_state): whether a popover is showing, and what has the
	# focus (and so is inside :focus-within). Anything else, the attributes say.
	[CssState: ptr<DomNode> e: 0; u32 what: 0;]
		if what is CssSel.ST_POPOVER_OPEN
			if (e.flags & Dom.POPOVER_OPEN) is not 0 return 1;
			return 0;
		;;
		ptr<Page> p: current;
		if p is 0 return -1;
		if what is CssSel.ST_FOCUS
			if e is p.focused return 1;
			return 0;
		;;
		if what is CssSel.ST_FOCUS_VISIBLE
			if e is p.focused and not p.focus_quiet return 1;
			return 0;
		;;
		if what is CssSel.ST_HOVER
			if p.hovered is not 0 and (Holds: e p.hovered) return 1;
			return 0;
		;;
		if what is CssSel.ST_ACTIVE
			if p.pressed is not 0 and (Holds: e p.pressed) return 1;
			return 0;
		;;
		if what is CssSel.ST_FOCUS_WITHIN
			ptr<DomNode> n: p.focused;
			while n is not 0
				if n is e return 1;
				n is (Dom.FlatParent: n);
			;;
			return 0;
		;;
	[end: -1]

	[Use: ptr<Page> p: 0;]
		if current is not p
			if current is not 0
				call PageRealm.Save: current;
			;;
			current is p;
			call Js.Use: p.rt;
			call PageRealm.Load: p;
		;;
	[end]

	[Free: ptr<Page> p: 0;]
		call PageAnim.Forget: p;
		call PageElements.Forget;
		if PageMedia.owner is p
			call PageMedia.Forget;
		;;
		call PagePlatform.Forget: p;
		while u32 mu: 0; mu < p.mod_urls.len; mu++;
			free p.mod_urls:mu;
		;;
		call Use: p;
		call Js.Free: p.rt;
		current is 0;
		while each s in p.sheets
			if s.sheet is not 0
				call Css.FreeSheet: s.sheet;
			;;
			call Disown: s;
		;;
		call p.css.Free;
		call p.parser.Free;
		if p.base is not 0
			free p.base;
			p.base is 0;
		;;
		if p.referrer is not 0
			free p.referrer;
			p.referrer is 0;
		;;
		call Dom.FreeDocument: p.doc;
		while each d in p.docs
			call Dom.FreeDocument: d;
		;;
		while u32 mi: 0; mi < p.map_key.len; mi++;
			free p.map_scope:mi;
			free p.map_key:mi;
			free p.map_url:mi;
		;;
		while each r in p.requests
			call Release: addr r;
			if r.answer is not 0
				free r.answer;
			;;
		;;
		if p.url is not 0
			free p.url;
		;;
		free p;
	[end]

	# every JS value the page holds outside JS objects
	[MarkDocument: ptr<DomDocument> doc: 0;]
		ptr<DomNode> n: doc.all;
		while n is not 0
			if n.js_wrapper is not 0
				call Js.Mark: n.js_wrapper;
			;;
			n is n.all_next;
		;;
	[end]

	# a new document for a script, empty, kept until the page goes; 0 if it has made too many
	[NewDocument: ptr<Page> p: 0;]
		if p.docs.len >= p.docs.max return 0 as ptr<DomDocument>;
		ptr<DomDocument> d: (Dom.NewDocument);
		p.docs++ d;
	[end: d]

	[MarkAll]
		ptr<Page> p: current;
		call Js.Mark: p.keep;
		call Js.Mark: p.window_location;
		call Js.Mark: p.storage;
		call MarkDocument: p.doc;
		while each d in p.docs
			call MarkDocument: d;
		;;
		while each t in p.timers
			call Js.Mark: t.fn;
			call Js.Mark: t.args;
		;;
		while each r in p.requests
			if not r.done
				call Js.Mark: r.a;
				call Js.Mark: r.b;
			;;
		;;
	[end]

	# ---- loading ----

	# The document's bytes, all at once. Use Feed and Finish to give them as they arrive.
	[Load: ptr<Page> p: 0; ptr<u8> bytes: 0; u32 n: 0; ptr<u8> url: 0;]
		call Start: p url;
		call Feed: p bytes n;
		call Finish: p;
	[end]

	[Start: ptr<Page> p: 0; ptr<u8> url: 0;]
		call Use: p;
		if p.url is not 0
			free p.url;
		;;
		u32 len: (WlText.LenZ: url);
		p.url is (WlText.Dup: url len);
		p.doc.url is (WlText.Dup: url len);
		call PageWindow.LoadStorage: p;
	[end]

	[Feed: ptr<Page> p: 0; ptr<u8> bytes: 0; u32 n: 0;]
		call Use: p;
		call p.parser.Feed: bytes n;
		call Settle: p;
	[end]

	[Finish: ptr<Page> p: 0;]
		call Use: p;
		call p.parser.Finish;
		call Settle: p;
	[end]

	# the document's URL against the page's
	[Resolve: ptr<Page> p: 0; ptr<u8> rel: 0; u32 n: 0; ptr<WlBuf> dest: 0;]
		call CssUrl.Join: (BaseUrl: p) rel n dest;
	[end]

	# The page's base address: the first <base> with an href (looked for before <body>), made whole
	# against the page's own address; that address if there's none. Worked out again when the
	# document has changed.
	[BaseUrl: ptr<Page> p: 0; : ptr<u8>]
		if p.doc is 0 return p.url;
		if p.base_known and p.base_version is p.doc.version and p.base_from is p.url
			if p.base is not 0 return p.base;
			return p.url;
		;;
		p.base_known is true;
		p.base_version is p.doc.version;
		p.base_from is p.url;
		if p.base is not 0
			free p.base;
			p.base is 0;
		;;
		ptr<WlAtom> base_tag: (WlAtoms.GetZ: 'base');
		ptr<WlAtom> body_tag: (WlAtoms.GetZ: 'body');
		ptr<DomNode> root: p.doc.root;
		ptr<DomNode> n: root;
		int budget: 4000;
		while n is not 0 and budget > 0
			budget--;
			if n.type is DomType.ELEMENT and n.ns is DomNs.HTML
				if n.tag is body_tag break;
				if n.tag is base_tag
					ptr<DomAttr> href: (Dom.Attr: n (WlAtoms.GetZ: 'href'));
					if href is not 0
						WlBuf full;
						call CssUrl.Join: p.url href.value href.value_len addr full;
						call full.Add: 0;
						p.base is (full.Take);
						break;
					;;
				;;
			;;
			n is (Dom.Next: n root);
		;;
		if p.base is not 0 return p.base;
	[end: p.url]

	# A script and everything it calls, which reports what it throws and never lets it out
	[RunSource: ptr<Page> p: 0; ptr<u8> text: 0; u32 n: 0; ptr<u8> name: 0;]
		call Use: p;
		p.nest++;
		call Js.Eval: text n name;
		if Js.failed
			call ReportException: p;
		;;
		p.nest--;
		call RunJobs: p;
	[end]

	# Promise jobs, then answers that came while JS was running, when nothing's on the stack. JS code runs to
	# completion, so none of this happens in the middle of it: a host that answers at once looks like one that didn't.
	[RunJobs: ptr<Page> p: 0;]
		if p.nest > 0 return;
		p.nest++;
		call Js.RunJobs;
		if Js.failed
			call ReportException: p;
		;;
		p.nest--;
		# pictures given a new src
		while p.new_srcs.len > 0
			ptr<DomNode> img: p.new_srcs:0;
			while u32 q: 1; q < p.new_srcs.len; q++;
				p.new_srcs:(q - 1) is p.new_srcs:q;
			;;
			p.new_srcs.len--;
			call AskPicture: p img;
		;;
		while u32 i: 0; i < p.requests.len; i++;
			if p.requests:i.waiting
				p.requests:i.waiting is false;
				ptr<PageRequest> r: addr p.requests:i;
				ptr<u8> kept: r.answer;
				r.answer is 0;
				call DeliverNow: p r r.answer_status kept r.answer_len;
				if kept is not 0
					free kept;
				;;
			;;
		;;
	[end]

	# an event sent from here, with JS on the stack as far as RunJobs is concerned
	[Fire: ptr<Page> p: 0; u64 target: 0; ptr<u8> type: 0; bln bubbles: false;]
		p.nest++;
		call PageEvents.FireOn: target type bubbles;
		p.nest--;
	[end]

	[FireNode: ptr<Page> p: 0; ptr<DomNode> n: 0; ptr<u8> type: 0;]
		p.nest++;
		call PageEvents.FireSimple: n type;
		p.nest--;
	[end]

	[ReportException: ptr<Page> p: 0;]
		WlBuf b;
		call b.AddZ: 'Uncaught ';
		# an error's stack says what it is and where it came from
		u64 shown: Js.exception;
		if (JsV.IsObj: shown)
			ptr<JsProp> st: (JsObjs.Find: (JsV.AsObj: shown) JsRt.A.stack as ptr<u8>);
			if st is not 0 and (st.flags & JsObjs.ACC) is 0 and (JsV.IsStr: st.value)
				shown is st.value;
			;;
		;;
		JsTryState t;
		call Js.TryBegin: addr t;
		if call Js.TextOf: shown addr b throws err
			call Js.TryCatchAll: addr t err;
			call b.AddZ: '(an error that could not be shown)';
		;;
		call Log: p b.data b.len 2;
		call b.Free;
		Js.failed is false;
	[end]

	[Log: ptr<Page> p: 0; ptr<u8> text: 0; u32 n: 0; int level: 0;]
		# (an empty line, as console.trace() with nothing to say gives, comes as '' and never as
		# no text at all: hosts read it up to its 0)
		if text is 0
			text is '';
			n is 0;
		;;
		if p.host.logger is not 0
			call p.host.logger: p text n level;
		;;
	[end]

	[IsScriptType: ptr<DomNode> s: 0;]
		ptr<u8> t: (Dom.AttrValue: s 'type');
		if t is 0 or t:0 is 0 return true;
		if (Same: t 'text/javascript') or (Same: t 'application/javascript') return true;
	[end: (Same: t 'text/ecmascript') or (Same: t 'application/ecmascript')]

	[Same: ptr<u8> a: 0; ptr<u8> b: 0;]
	[end: (WlText.EqNoCaseZ: a (WlText.LenZ: a) b)]

	# the parser reached a </script>
	[OnScript: ptr<HtmlParser> parser: 0; ptr<DomNode> s: 0;]
		ptr<Page> p: parser.host_data as ptr<Page>;
		call Run: p s true;
	[end]

	[Run: ptr<Page> p: 0; ptr<DomNode> s: 0; bln from_parser: false;]
		# (it has started, as the HTML standard says: moved somewhere else later, it doesn't run again)
		s.flags is s.flags | Dom.SCRIPT_RAN;
		ptr<u8> t: (Dom.AttrValue: s 'type');
		if t is not 0 and (Same: t 'module')
			call ScanSheets: p;
			call PageModules.Script: p s;
			return;
		;;
		if t is not 0 and (Same: t 'importmap')
			call PageModules.ImportMap: p s;
			return;
		;;
		# a browser with modules leaves nomodule scripts (the fallback for one without) alone
		if (Dom.AttrValue: s 'nomodule') is not 0 return;
		if not (IsScriptType: s) return;
		# what it may ask of the styles should include the sheets found so far
		call ScanSheets: p;
		ptr<u8> src: (Dom.AttrValue: s 'src');
		if src is not 0
			if from_parser and (Dom.AttrValue: s 'defer') is not 0 and (Dom.AttrValue: s 'async') is 0
				if p.defer_list.len < p.defer_list.max
					p.defer_list++ s;
				;;
				return;
			;;
			u32 id: (Request: p src (WlText.LenZ: src) PageLoad.SCRIPT s JsV.UNDEF JsV.UNDEF);
			# if it hasn't come yet, parsing waits for it (an async one doesn't hold anything up)
			if from_parser and (Dom.AttrValue: s 'async') is 0 and not (RequestDone: p id)
				ptr<PageRequest> waited: (Find: p id);
				if waited is not 0
					waited.blocks is true;
					p.blocking++;
					call p.parser.Pause;
				;;
			;;
			return;
		;;
		WlBuf text;
		call Dom.TextContent: s text;
		if text.len > 0
			p.current_script is s;
			call RunSource: p text.data text.len 'inline script';
			p.current_script is 0;
		;;
		call text.Free;
	[end]

	# ---- requests ----

	# a request for the host to answer; a fetch's can say its verb (method), header lines and body (all copied)
	[Request: ptr<Page> p: 0; ptr<u8> url: 0; u32 n: 0; PageLoad kind: PageLoad.FETCH; ptr<DomNode> node: 0; u64 a: 0; u64 b: 0; ptr<CssImport> import: 0;
			ptr<u8> verb: 0; ptr<u8> headers: 0; ptr<u8> body: 0; u32 body_len: 0; int policy: 0;]
		if p.requests.len >= p.requests.max
			call Compact: p;
			if p.requests.len >= p.requests.max
				return 0;
			;;
		;;
		WlBuf full;
		call Resolve: p url n addr full;
		u32 id: p.next_request;
		p.next_request++;
		p.requests++;
		u32 at_: p.requests.len - 1;
		p.requests:at_.id is id;
		p.requests:at_.kind is kind;
		p.requests:at_.node is node;
		p.requests:at_.import is import;
		p.requests:at_.a is a;
		p.requests:at_.b is b;
		p.requests:at_.url is (full.Take);
		p.requests:at_.verb is 0;
		p.requests:at_.headers is 0;
		p.requests:at_.body is 0;
		p.requests:at_.body_len is 0;
		p.requests:at_.answer_headers is 0;
		p.requests:at_.blocks is false;
		if policy is PageReferrer.UNSET
			policy is (ElementPolicy: p node false);
		;;
		p.requests:at_.policy is policy;
		if verb is not 0 and verb:0 is not 0 and not (WlText.EqZ: verb (WlText.LenZ: verb) 'GET')
			p.requests:at_.verb is (DupZ: verb (WlText.LenZ: verb));
		;;
		if headers is not 0 and headers:0 is not 0
			p.requests:at_.headers is (DupZ: headers (WlText.LenZ: headers));
		;;
		if body is not 0
			p.requests:at_.body is (DupZ: body body_len);
			p.requests:at_.body_len is body_len;
		;;
		ptr<u8> asked: p.requests:at_.url;
		if p.host.load is 0
			call Delivered: p id 0 0 0;
			return id;
		;;
		call p.host.load: p asked kind id;
	[end: id]

	# drop the finished ones, which keeps the table from filling up
	[Compact: ptr<Page> p: 0;]
		u32 w: 0;
		while u32 r: 0; r < p.requests.len; r++;
			if p.requests:r.done
				call Release: addr p.requests:r;
			;;
			else
				if w is not r
					p.requests:w is p.requests:r;
				;;
				w++;
			;;
		;;
		p.requests.len is w;
	[end]

	# what a request holds besides its answer
	[Release: ptr<PageRequest> r: 0;]
		if r.url is not 0
			free r.url;
		;;
		if r.verb is not 0
			free r.verb;
		;;
		if r.headers is not 0
			free r.headers;
		;;
		if r.body is not 0
			free r.body;
		;;
		if r.answer_headers is not 0
			free r.answer_headers;
		;;
		r.url is 0;
		r.verb is 0;
		r.headers is 0;
		r.body is 0;
		r.answer_headers is 0;
	[end]

	# a request by its number (0 once it's answered and gone)
	[Find: ptr<Page> p: 0; u32 id: 0;]
		while u32 i: 0; i < p.requests.len; i++;
			if p.requests:i.id is id
				return addr p.requests:i;
			;;
		;;
	[end: 0 as ptr<PageRequest>]

	[RequestDone: ptr<Page> p: 0; u32 id: 0;]
		ptr<PageRequest> r: (Find: p id);
	[end: r is 0 or r.done]

	# The status line and header lines of a fetch's answer ("HTTP/1.1 200 OK\r\nContent-Type: ..."), which
	# its Response and XMLHttpRequest show: from the host, before Delivered.
	[AnswerHeaders: ptr<Page> p: 0; u32 id: 0; ptr<u8> text: 0; u32 n: 0;]
		ptr<PageRequest> r: (Find: p id);
		if r is 0 or r.done return;
		if r.answer_headers is not 0
			free r.answer_headers;
		;;
		r.answer_headers is (DupZ: text n);
	[end]

	# ---- the Referer

	# document.referrer, from the host: the Referer the page's own request went with (0 or '': none)
	[SetReferrer: ptr<Page> p: 0; ptr<u8> text: 0;]
		if p.referrer is not 0
			free p.referrer;
			p.referrer is 0;
		;;
		if text is not 0 and text:0 is not 0
			p.referrer is (DupZ: text (WlText.LenZ: text));
		;;
	[end]

	# the document's referrer policy from its Referrer-Policy header (the host's to read, with
	# netlib's WireReferrer.Header, which gives PageReferrer's numbers): a <meta> may change it after
	[SetPolicy: ptr<Page> p: 0; int policy: 0;]
		p.policy is policy;
		p.nav_policy is policy;
	[end]

	# The policy a request for n goes by: (a link followed: link) none for a link whose rel has
	# noreferrer, whatever else it says; its referrerpolicy if that names one; then the
	# document's, as it is now (a <meta> changed since taken first).
	[ElementPolicy: ptr<Page> p: 0; ptr<DomNode> n: 0; bln link: false; : int]
		call MetaPolicies: p;
		if n is not 0 and n.type is DomType.ELEMENT
			if link and (HasWord: (Dom.Attr: n (WlAtoms.GetZ: 'rel')) 'noreferrer')
				return PageReferrer.NO_REFERRER;
			;;
			ptr<DomAttr> a: (Dom.Attr: n (WlAtoms.GetZ: 'referrerpolicy'));
			if a is not 0
				int own: (PageReferrer.Parse: a.value a.value_len false);
				if own is not PageReferrer.UNSET return own;
			;;
		;;
	[end: p.policy]

	# The policy the picture of n (an <img>, or 0 for a background) goes by: what it was when the
	# <img> asked for it (its src given, or it put in), as Chrome fixes it then; else as it is now.
	[PicturePolicy: ptr<Page> p: 0; ptr<DomNode> n: 0; : int]
		if n is not 0
			u32 kept: (n.flags & Dom.PICTURE_POLICY) >> Dom.PICTURE_POLICY_SHIFT;
			if kept > 0 return (kept - 1) as int;
		;;
	[end: (ElementPolicy: p n false)]

	# whether an attribute's value has word among its space-separated words, in any case
	[HasWord: ptr<DomAttr> a: 0; ptr<u8> word: 0; : bln]
		if a is 0 return false;
		u32 wl: (WlText.LenZ: word);
		u32 i: 0;
		while i < a.value_len
			while i < a.value_len and (a.value:i is ' ' or a.value:i is 9 or a.value:i is 10 or a.value:i is 12 or a.value:i is 13)
				i++;
			;;
			u32 from: i;
			while i < a.value_len and not (a.value:i is ' ' or a.value:i is 9 or a.value:i is 10 or a.value:i is 12 or a.value:i is 13)
				i++;
			;;
			if i - from is wl and (WlText.EqNoCaseZ: a.value + from wl word)
				return true;
			;;
		;;
	[end: false]

	# A <meta name=referrer> put in the document sets its policy, when its content names one, and
	# so does one given another name or content (told before the new value's in place: taken
	# before the next request, MetaPolicies). Taking one out leaves the policy as it is, as in Chrome.
	[Metas: ptr<Page> p: 0; ptr<DomNode> target: 0; int kind: 0; ptr<DomNode> node: 0; ptr<WlAtom> name: 0;]
		ptr<WlAtom> meta_tag: (WlAtoms.GetZ: 'meta');
		if kind is Dom.ATTRIBUTE
			if target is 0 or target.doc is not p.doc or target.tag is not meta_tag or target.ns is not DomNs.HTML return;
			if name is not (WlAtoms.GetZ: 'content') and name is not (WlAtoms.GetZ: 'name') return;
			while u32 q: 0; q < p.new_metas.len; q++;
				if p.new_metas:q is target return;
			;;
			if p.new_metas.len < p.new_metas.max
				p.new_metas++ target;
			;;
			return;
		;;
		if kind is not Dom.ADDED or node is 0 or node.doc is not p.doc return;
		ptr<DomNode> n: node;
		while n is not 0
			if n.type is DomType.ELEMENT and n.tag is meta_tag and n.ns is DomNs.HTML
				call MetaPolicy: p n;
			;;
			n is (Dom.Next: n node);
		;;
	[end]

	# the <meta>s given another name or content since the last request, each as it is now
	[MetaPolicies: ptr<Page> p: 0;]
		if p.new_metas.len is 0 return;
		while u32 q: 0; q < p.new_metas.len; q++;
			call MetaPolicy: p p.new_metas:q;
		;;
		p.new_metas.len is 0;
	[end]

	[MetaPolicy: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		if not (Dom.IsConnected: n) return;
		ptr<DomAttr> name: (Dom.Attr: n (WlAtoms.GetZ: 'name'));
		if name is 0 or not (WlText.EqNoCaseZ: name.value name.value_len 'referrer') return;
		ptr<DomAttr> content: (Dom.Attr: n (WlAtoms.GetZ: 'content'));
		if content is 0 return;
		int named: (PageReferrer.Parse: content.value content.value_len true);
		if named is not PageReferrer.UNSET
			p.policy is named;
			p.nav_policy is named;
		;;
	[end]

	# a copy with a zero after it
	[DupZ: ptr<u8> text: 0; u32 n: 0;]
		ptr<u8> copy: (WlText.Dup: text n);
		copy:n is 0;
	[end: copy]

	# What the browser calls with an answer. status is HTTP's, or 0 if it couldn't be had.
	[Delivered: ptr<Page> p: 0; u32 id: 0; int status: 0; ptr<u8> bytes: 0; u32 n: 0;]
		call Use: p;
		ptr<PageRequest> r: (Find: p id);
		if r is 0 or r.done or r.waiting return;
		if p.nest > 0
			r.waiting is true;
			r.answer_status is status;
			r.answer_len is n;
			if n > 0
				r.answer is (WlText.Dup: bytes n);
			;;
			return;
		;;
		call DeliverNow: p r status bytes n;
		call RunJobs: p;
		call Settle: p;
		call Invalidate: p;
	[end]

	[DeliverNow: ptr<Page> p: 0; ptr<PageRequest> r: 0; int status: 0; ptr<u8> bytes: 0; u32 n: 0;]
		r.done is true;
		bln ok: status >= 200 and status < 300;
		when r.kind
			is PageLoad.SCRIPT
				ptr<DomNode> s: r.node;
				ptr<u8> name: r.url;
				if s is 0
					# a module's (page/pmodules.phi)
					call PageModules.Arrived: p r.url ok bytes n;
					return;
				;;
				if ok
					p.current_script is s;
					call RunSource: p bytes n name;
					p.current_script is 0;
					call FireNode: p s 'load';
				;;
				else
					call FireNode: p s 'error';
				;;
				# (only a script the parser waits for lets it go on: an async one, or one a script
				# made, coming first doesn't)
				if r.blocks and p.blocking > 0 and not p.parse_done
					r.blocks is false;
					p.blocking--;
					if p.blocking is 0
						call p.parser.Resume;
					;;
				;;
			;;
			is PageLoad.STYLE
				if r.import is not 0
					# a sheet another sheet asked for with @import: it goes to the import, if the
					# sheet that asked is still one of the page's
					if ok and (ImportLives: p r.import)
						bln took: (Css.ImportDone: p.css r.import bytes n);
						call Invalidate: p;
					;;
				;;
				elif ok
					call SheetArrived: p r.node bytes n r.url;
					call FireNode: p r.node 'load';
				;;
				else
					call FireNode: p r.node 'error';
				;;
			;;
			is PageLoad.FETCH
				p.nest++;
				call PageNet.Answer: p r status bytes n;
				p.nest--;
			;;
			is PageLoad.MEDIA
				call PageMedia.Arrived: p r.node r.id ok bytes n;
			;;
			else
				if r.node is not 0
					if ok
						call FireNode: p r.node 'load';
					;;
					else
						call FireNode: p r.node 'error';
					;;
				;;
			;;
		;;
	[end]

	[Invalidate: ptr<Page> p: 0;]
		if p.host.invalidate is not 0
			call p.host.invalidate: p;
		;;
	[end]

	# When the parser's finished and nothing it waits for is left: deferred scripts, then the events that say so.
	[Settle: ptr<Page> p: 0;]
		if p.parser.finished and not p.parse_done and p.blocking is 0
			p.parse_done is true;
			while u32 i: 0; i < p.defer_list.len; i++;
				call Run: p p.defer_list:i false;
			;;
			p.defer_list.len is 0;
			call ScanSheets: p;
			# module scripts run once the document is parsed, before DOMContentLoaded
			call PageModules.Pump: p;
			call Fire: p (PageBind.Wrap: p.doc.root) 'readystatechange' false;
			call Fire: p (PageBind.Wrap: p.doc.root) 'DOMContentLoaded' true;
			call RunJobs: p;
		;;
		if p.parse_done and not p.load_fired
			# (a request of the parser's, a stylesheet or a script, holds up load; and an <img>'s,
			# when the host answers those once they're in, unless it's loading="lazy")
			bln waiting: (PageModules.Waiting: p);
			while u32 r: 0; r < p.requests.len; r++;
				ptr<PageRequest> q: addr p.requests:r;
				if q.done or q.kind is PageLoad.FETCH
					continue;
				;;
				if q.kind is PageLoad.IMAGE and (p.host.picture is 0 or (Lazy: q.node))
					continue;
				;;
				waiting is true;
				break;
			;;
			if not waiting
				p.load_fired is true;
				call Fire: p (JsV.Obj: JsRt.r.global) 'load' false;
				call RunJobs: p;
			;;
		;;
	[end]

	# an <img loading="lazy">: what it's waiting for doesn't hold up the window's load
	[Lazy: ptr<DomNode> n: 0;]
		if n is 0 return false;
		ptr<DomAttr> a: (Dom.Attr: n (WlAtoms.GetZ: 'loading'));
		if a is 0 return false;
	[end: (WlText.EqNoCaseZ: a.value a.value_len 'lazy')]

	# ---- styles ----

	# Finds <style> and <link rel=stylesheet> elements that are new or changed, and what's gone away. It walks
	# the document, so only when the document has changed.
	[ScanSheets: ptr<Page> p: 0;]
		# (only when a <style> or <link> came, went or changed: it reads every <style>'s text)
		if p.sheets_scanned and p.sheets_version is p.doc.sheet_version return;
		p.sheets_version is p.doc.sheet_version;
		p.sheets_scanned is true;
		while each s in p.sheets
			s.seen is false;
		;;
		ptr<WlAtom> style_tag: (WlAtoms.GetZ: 'style');
		ptr<WlAtom> link_tag: (WlAtoms.GetZ: 'link');
		# (shadow trees' sheets too: each is for its own tree)
		ptr<DomNode> n: p.doc.root;
		while n is not 0
			if n.type is DomType.ELEMENT and n.ns is DomNs.HTML
				if n.tag is style_tag
					call SeeStyle: p n;
				;;
				elif n.tag is link_tag
					call SeeLink: p n;
				;;
			;;
			elif n.type is DomType.ELEMENT and n.ns is DomNs.SVG and n.tag is style_tag
				# (an <svg>'s own <style> is the page's as much as one in <head>)
				call SeeStyle: p n;
			;;
			n is (Dom.ShadowNext: n p.doc.root);
		;;
		# whatever wasn't found has left the document
		while u32 i: 0; i < p.sheets.len; i++;
			if not p.sheets:i.seen and p.sheets:i.sheet is not 0
				call p.css.RemoveSheet: p.sheets:i.sheet;
				call Css.FreeSheet: p.sheets:i.sheet;
				p.sheets:i.sheet is 0;
				p.sheets:i.node is 0;
				p.sheets:i.text_hash is 0;
				call Disown: addr p.sheets:i;
			;;
		;;
		p.sheets_version is p.doc.sheet_version;
	[end]

	[SheetFor: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		while u32 i: 0; i < p.sheets.len; i++;
			if p.sheets:i.node is n
				return addr p.sheets:i;
			;;
		;;
		if p.sheets.len >= p.sheets.max
			return 0 as ptr<PageSheet>;
		;;
		p.sheets++;
		ptr<PageSheet> s: addr p.sheets:(p.sheets.len - 1);
		s.node is n;
	[end: s]

	# Whether a <style> or <link>'s sheet is for this page as it is now: what its media attribute
	# says, if it has one (media="print" is for paper, media="(max-width: 600px)" for a narrow
	# window). Nothing written, or only spaces, is everything.
	[MediaHolds: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		ptr<u8> media: (Dom.AttrValue: n 'media');
		if media is 0 return true;
		u32 len: (WlText.LenZ: media);
		bln blank: true;
		while u32 i: 0; i < len; i++;
			if media:i > 32
				blank is false;
				break;
			;;
		;;
		if blank return true;
	[end: (Css.MatchMedia: p.css media len)]

	# a sheet whose media no longer holds is taken out; it's read again if it holds later
	[DropSheet: ptr<Page> p: 0; ptr<PageSheet> s: 0;]
		if s.sheet is not 0
			call p.css.RemoveSheet: s.sheet;
			call Css.FreeSheet: s.sheet;
			s.sheet is 0;
		;;
		s.text_hash is 0;
		s.text_len is 0;
		call ForgetLink: s;
	[end]

	# whether a rel attribute names a stylesheet to use: 'stylesheet' is one of its words, in
	# either case, and 'alternate' isn't (an alternate sheet is one the reader may choose instead)
	[IsSheetRel: ptr<u8> rel: 0;]
		bln sheet: false;
		u32 i: 0;
		while rel:i is not 0
			while rel:i is not 0 and rel:i <= 32
				i++;
			;;
			u32 from: i;
			while rel:i > 32
				i++;
			;;
			if (WlText.EqNoCaseZ: rel + from i - from 'stylesheet')
				sheet is true;
			;;
			elif (WlText.EqNoCaseZ: rel + from i - from 'alternate') return false;
		;;
	[end: sheet]

	[SeeStyle: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		ptr<PageSheet> s: (SheetFor: p n);
		if s is 0 return;
		s.seen is true;
		if not (MediaHolds: p n)
			call DropSheet: p s;
			return;
		;;
		WlBuf text;
		call Dom.TextContent: n text;
		u32 h: (WlText.Hash: text.data text.len);
		if s.owned
			if h is s.own_base
				# (a script's rules are what it says)
				call text.Clear;
				call text.AddN: s.own s.own_len;
				h is (WlText.Hash: text.data text.len) ^ 0x5A5A5A5A;
			;;
			else
				# (its text changed: that's what it says now)
				call Disown: s;
			;;
		;;
		ptr<DomNode> scope: (SheetScope: n);
		if s.sheet is not 0 and s.sheet.scope is not scope
			# moved into another tree: it's that tree's now
			s.text_hash is 0;
		;;
		if s.sheet is 0 or h is not s.text_hash or text.len is not s.text_len
			if s.sheet is not 0
				call p.css.RemoveSheet: s.sheet;
				call Css.FreeSheet: s.sheet;
			;;
			s.sheet is (Css.ParseSheet: text.data text.len p.url);
			s.text_hash is h;
			s.text_len is text.len;
			if s.sheet is not 0
				s.sheet.scope is scope;
				call p.css.AddSheet: s.sheet;
			;;
		;;
		call text.Free;
	[end]

	[Disown: ptr<PageSheet> s: 0;]
		if s.own is not 0
			free s.own;
		;;
		s.own is 0;
		s.own_len is 0;
		s.owned is false;
		call ForgetLink: s;
	[end]

	[ForgetLink: ptr<PageSheet> s: 0;]
		if s.link_text is not 0
			free s.link_text;
		;;
		if s.link_from is not 0
			free s.link_from;
		;;
		s.link_text is 0;
		s.link_len is 0;
		s.link_from is 0;
	[end]

	# the sheet a <link> brought, as it came (len into link_len), and where from; 0 if it hasn't
	# come (or n isn't one)
	ptr<u8> link_from: 0;
	u32 link_len: 0;

	[LinkText: ptr<Page> p: 0; ptr<DomNode> n: 0; : ptr<u8>]
		while u32 i: 0; i < p.sheets.len; i++;
			if p.sheets:i.node is n and p.sheets:i.link_text is not 0
				link_from is p.sheets:i.link_from;
				link_len is p.sheets:i.link_len;
				return p.sheets:i.link_text;
			;;
		;;
	[end: 0 as ptr<u8>]

	# A script's rules for a <style> (%styleText): text, or with no text its own text again
	[OwnStyle: ptr<Page> p: 0; ptr<DomNode> n: 0; ptr<u8> text: 0; u32 len: 0; bln clear: false;]
		ptr<PageSheet> s: (SheetFor: p n);
		if s is 0 return;
		call Disown: s;
		if not clear
			WlBuf now;
			call Dom.TextContent: n now;
			s.own_base is (WlText.Hash: now.data now.len);
			call now.Free;
			s.own is new u8[len + 1];
			if s.own is 0 return;
			call Mem.Copy: s.own text len;
			s.own:len is 0;
			s.own_len is len;
			s.owned is true;
		;;
		# (read again next time styles are worked out)
		s.text_hash is 0;
		s.text_len is 0xFFFFFFFF;
		p.sheets_scanned is false;
		p.doc.version++;
	[end]

	[SeeLink: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		ptr<u8> rel: (Dom.AttrValue: n 'rel');
		ptr<u8> href: (Dom.AttrValue: n 'href');
		if rel is 0 or href is 0 return;
		if not (IsSheetRel: rel) return;
		ptr<PageSheet> s: (SheetFor: p n);
		if s is 0 return;
		s.seen is true;
		# one that isn't for this page as it is (a sheet for print, say) isn't asked for
		if (Dom.AttrValue: n 'disabled') is not 0 or not (MediaHolds: p n)
			call DropSheet: p s;
			return;
		;;
		# asked for once; an empty record means it's on its way
		if s.text_hash is 0
			s.text_hash is 1;
			call Request: p href (WlText.LenZ: href) PageLoad.STYLE n JsV.UNDEF JsV.UNDEF;
		;;
	[end]

	[SheetArrived: ptr<Page> p: 0; ptr<DomNode> n: 0; ptr<u8> bytes: 0; u32 len: 0; ptr<u8> base_url: 0;]
		ptr<PageSheet> s: (SheetFor: p n);
		if s is 0 return;
		s.seen is true;
		if s.sheet is not 0
			call p.css.RemoveSheet: s.sheet;
			call Css.FreeSheet: s.sheet;
			s.sheet is 0;
		;;
		# (the window may have changed while it was on its way)
		if not (MediaHolds: p n)
			s.text_hash is 0;
			return;
		;;
		s.sheet is (Css.ParseSheet: bytes len base_url);
		if s.sheet is not 0
			s.sheet.scope is (SheetScope: n);
			call p.css.AddSheet: s.sheet;
		;;
		# (kept as it came, for a script that reads its rules)
		call ForgetLink: s;
		if n is not 0 and len < 0x4000000
			s.link_text is new u8[len + 1];
			if s.link_text is not 0
				call Mem.Copy: s.link_text bytes len;
				s.link_text:len is 0;
				s.link_len is len;
				if base_url is not 0
					u32 bl: (WlText.LenZ: base_url);
					s.link_from is new u8[bl + 1];
					if s.link_from is not 0
						call Mem.Copy: s.link_from base_url bl;
						s.link_from:bl is 0;
					;;
				;;
			;;
		;;
	[end]

	# the tree a <style> or <link>'s sheet is for: the shadow root it's in, or 0 for the document
	[SheetScope: ptr<DomNode> n: 0;]
		ptr<DomNode> top: (Dom.TreeRoot: n);
		if (Dom.IsShadowRoot: top) return top;
	[end: 0 as ptr<DomNode>]

	# The style engine found an @import that applies (as it worked the styles out): the sheet is
	# asked of the host like any other, and goes to the import when it comes (DeliverNow). The
	# styles are right again at the next UpdateStyle after that.
	[OnImport: ptr<CssEngine> e: 0; ptr<CssImport> im: 0;]
		ptr<Page> p: current;
		if p is 0 or p.css is not e or im is 0 or im.url is 0 return;
		u32 id: (Request: p im.url (WlText.LenZ: im.url) PageLoad.STYLE 0 as ptr<DomNode> JsV.UNDEF JsV.UNDEF im);
	[end]

	# whether an @import is still in one of the page's sheets (or in a sheet one of them imported)
	[ImportLives: ptr<Page> p: 0; ptr<CssImport> im: 0;]
		while u32 i: 0; i < p.sheets.len; i++;
			if p.sheets:i.sheet is not 0 and (ImportIn: p.sheets:i.sheet.first im 0) return true;
		;;
	[end: false]

	[ImportIn: ptr<CssRule> first: 0; ptr<CssImport> im: 0; u32 depth: 0;]
		if depth > 16 return false;
		ptr<CssRule> r: first;
		while r is not 0
			if r.import is not 0
				if r.import is im return true;
				if r.import.sheet is not 0 and (ImportIn: r.import.sheet.first im depth + 1) return true;
			;;
			if r.first_child is not 0 and (ImportIn: r.first_child im depth + 1) return true;
			r is r.next;
		;;
	[end: false]

	# Every element's node.style right for the document as it is now. False if that failed; Css.error says why.
	[UpdateStyle: ptr<Page> p: 0;]
		call Use: p;
		call ScanSheets: p;
		if (p.css.Update) return true;
		# (what stopped it, for the console)
		WlBuf b;
		call b.AddZ: 'styles could not be worked out: ';
		call b.AddZ: CssError.text;
		call Log: p b.data b.len 2;
		call b.Free;
	[end: false]

	[SetViewport: ptr<Page> p: 0; f64 width: 0.0; f64 height: 0.0;]
		call Use: p;
		p.width is width;
		p.height is height;
		call p.css.SetViewport: width height;
		p.sheets_scanned is false;              # a sheet's media may hold now, or no longer
		call PageBind.SyncWindow: p;
		call Fire: p (JsV.Obj: JsRt.r.global) 'resize' false;
		call RunJobs: p;
	[end]

	# ---- time ----

	# Whatever timers are due, oldest first, and promise jobs after each. Call this often.
	[Tick: ptr<Page> p: 0; f64 now: 0.0;]
		call Use: p;
		p.now is now;
		if not p.started_clock
			p.started_clock is true;
			p.started_at is now;
		;;
		# one pass, by id: a timer a timer sets runs on a later tick
		int limit: p.next_timer;
		bln fired: true;
		while fired
			fired is false;
			int best: -1;
			while int i: 0; i < p.timers.len as int; i++;
				if not p.timers:i.frame and p.timers:i.id < limit and p.timers:i.due <= now
					if best < 0 or p.timers:i.due < p.timers:best.due
						best is i;
					;;
				;;
			;;
			if best >= 0
				call FireTimer: p best now;
				fired is true;
			;;
		;;
		call RunJobs: p;
		call Settle: p;
	[end]

	# requestAnimationFrame's callbacks, once each
	[Frame: ptr<Page> p: 0; f64 now: 0.0;]
		call Use: p;
		p.now is now;
		# (scroll events, before the frame's callbacks, as browsers send them)
		call PageScroll.Fire: p;
		# (what's playing: its pictures, its sound and its clock)
		call PageMedia.Pump: p;
		call PageAnim.Frame: p;
		int limit: p.next_timer;
		int i: 0;
		while i < p.timers.len as int
			if p.timers:i.frame and p.timers:i.id < limit
				u64 fn: p.timers:i.fn;
				call RemoveTimerAt: p i;
				# (still safe from the collector: nothing's run since it was taken off)
				call Js.Push: (JsV.Num: now - p.started_at);
				p.nest++;
				call Js.Call: fn JsV.UNDEF 1;
				if Js.failed
					call ReportException: p;
				;;
				p.nest--;
				call RunJobs: p;
			;;
			else
				i++;
			;;
		;;
	[end]

	# whether any callbacks are waiting for a frame
	[WantsFrame: ptr<Page> p: 0;]
		while each t in p.timers
			if t.frame return true;
		;;
	[end: false]

	[FireTimer: ptr<Page> p: 0; int i: 0; f64 now: 0.0;]
		u64 fn: p.timers:i.fn;
		u64 args: p.timers:i.args;
		if p.timers:i.interval > 0.0
			p.timers:i.due is now + p.timers:i.interval;
		;;
		else
			call RemoveTimerAt: p i;
		;;
		int argc: 0;
		if (JsV.IsObj: args)
			ptr<JsObj> a: (JsV.AsObj: args);
			while u32 k: 0; k < a.length; k++;
				call Js.Push: a.elems:k;
				argc++;
			;;
		;;
		p.nest++;
		call Js.Call: fn (JsV.Obj: JsRt.r.global) argc;
		if Js.failed
			call ReportException: p;
		;;
		p.nest--;
		call RunJobs: p;
	[end]

	[RemoveTimerAt: ptr<Page> p: 0; int i: 0;]
		u32 last: p.timers.len - 1;
		while u32 j: i as u32; j < last; j++;
			p.timers:j is p.timers:(j + 1);
		;;
		p.timers.len--;
	[end]

	[AddTimer: ptr<Page> p: 0; u64 fn: 0; u64 args: 0; f64 delay: 0.0; bln repeat: false; bln frame: false;]
		if p.timers.len >= p.timers.max
			call JsErr.Range: 'Too many timers';
		;;
		p.timers++;
		u32 at_: p.timers.len - 1;
		int id: p.next_timer;
		p.next_timer++;
		if delay < 0.0 or delay is not delay
			delay is 0.0;
		;;
		p.timers:at_.id is id;
		p.timers:at_.due is p.now + delay;
		p.timers:at_.interval is 0.0;
		if repeat
			# (an interval of nothing would never let the page rest)
			if delay < 1.0
				delay is 1.0;
			;;
			p.timers:at_.interval is delay;
		;;
		p.timers:at_.fn is fn;
		p.timers:at_.args is args;
		p.timers:at_.frame is frame;
	[end: id]

	[ClearTimer: ptr<Page> p: 0; int id: 0;]
		while int i: 0; i < p.timers.len as int; i++;
			if p.timers:i.id is id
				call RemoveTimerAt: p i;
				return;
			;;
		;;
	[end]

	# ---- what happens to the page from outside ----

	# A click at node, as the browser sees it happen, at (x, y) in the window (ClickTarget says where
	# one goes): with the main button (0) a click, its count of clicks being detail, then for the
	# second of a double click a dblclick; with another button an auxclick. False if a handler
	# called preventDefault on the click. A link's default action is taken here, unless that happened.
	[Click: ptr<Page> p: 0; ptr<DomNode> node: 0; f64 x: 0.0; f64 y: 0.0; int detail: 1; int button: 0; : bln]
		call Use: p;
		ptr<u8> type: 'click';
		if button is not 0
			type is 'auxclick';
		;;
		# (a checkbox or radio button changes as it's clicked, before the click's heard, and is put
		# back if it's canceled; then input and change, as in Chrome)
		ptr<DomNode> box: 0;
		bln was_on: false;
		ptr<DomNode> was_radio: 0;
		int kind: 0;
		if button is 0
			kind is (CheckKind: node);
		;;
		if kind > 0
			box is node;
			was_on is ((Dom.AttrValue: node 'checked') is not 0);
			if kind is 1
				call SetChecked: node not was_on;
			;;
			elif not was_on
				was_radio is (CheckedRadio: p node);
				call SetChecked: node true;
				if was_radio is not 0
					call SetChecked: was_radio false;
				;;
			;;
		;;
		p.nest++;
		bln allowed: (SendPointer: p node type x y button 0 0 as ptr<DomNode> detail);
		p.nest--;
		call RunJobs: p;
		if box is not 0
			if not allowed
				call SetChecked: box was_on;
				if was_radio is not 0
					call SetChecked: was_radio true;
				;;
			;;
			elif kind is 1 or not was_on
				p.nest++;
				bln said: (PageEvents.Dispatch: (PageBind.Wrap: box) (PageEvents.NewTrusted: 'input' true false));
				bln changed: (PageEvents.Dispatch: (PageBind.Wrap: box) (PageEvents.NewTrusted: 'change' true false));
				p.nest--;
				call RunJobs: p;
			;;
		;;
		if allowed and button is 0
			call DefaultClick: p node;
		;;
		if button is 0 and detail is 2
			p.nest++;
			bln dbl: (SendPointer: p node 'dblclick' x y 0 0 0 as ptr<DomNode> 2);
			p.nest--;
			call RunJobs: p;
		;;
		call Invalidate: p;
	[end: allowed]

	# 1 for a checkbox, 2 for a radio button (an input of that type), 0 for the rest
	[CheckKind: ptr<DomNode> n: 0; : int]
		if n is 0 or not (Is: n HtmlTag.INPUT) or (Dom.AttrValue: n 'disabled') is not 0 return 0;
		ptr<u8> type: (Dom.AttrValue: n 'type');
		if type is 0 return 0;
		u32 tl: (WlText.LenZ: type);
		if (WlText.EqNoCaseZ: type tl 'checkbox') return 1;
		if (WlText.EqNoCaseZ: type tl 'radio') return 2;
	[end: 0]

	[SetChecked: ptr<DomNode> n: 0; bln on: false;]
		if on
			call Dom.SetAttrZ: n 'checked' '';
		;;
		elif (Dom.AttrValue: n 'checked') is not 0
			call Dom.RemoveAttr: n (WlAtoms.GetZ: 'checked');
		;;
	[end]

	# the radio button checked now in n's group (its name, in its form or with none), other than n
	[CheckedRadio: ptr<Page> p: 0; ptr<DomNode> n: 0; : ptr<DomNode>]
		ptr<u8> name: (Dom.AttrValue: n 'name');
		if name is 0 or name:0 is 0 return 0 as ptr<DomNode>;
		ptr<DomNode> form: (FormOf: n);
		ptr<DomNode> root: (Dom.DocumentElement: p.doc);
		ptr<DomNode> r: root;
		while r is not 0
			if r is not n and (CheckKind: r) is 2 and (Dom.AttrValue: r 'checked') is not 0 and (FormOf: r) is form
				ptr<u8> rn: (Dom.AttrValue: r 'name');
				if rn is not 0 and (WlText.EqZ: rn (WlText.LenZ: rn) name) and (WlText.LenZ: rn) is (WlText.LenZ: name)
					return r;
				;;
			;;
			r is (Dom.Next: r root);
		;;
	[end: 0 as ptr<DomNode>]

	# the form n is in (0: none)
	[FormOf: ptr<DomNode> n: 0; : ptr<DomNode>]
		ptr<DomNode> f: n.parent;
		while f is not 0 and not (Is: f HtmlTag.FORM)
			f is f.parent;
		;;
	[end: f]

	# where the click goes when a button's let go over node, having been pressed over pressed_on:
	# what holds them both (Chrome's), 0 for neither
	[ClickTarget: ptr<DomNode> pressed_on: 0; ptr<DomNode> node: 0; : ptr<DomNode>]
		if pressed_on is 0 or node is 0 return 0 as ptr<DomNode>;
		ptr<DomNode> a: pressed_on;
		while a is not 0
			if a.type is DomType.ELEMENT and (Holds: a node) return a;
			a is (Dom.FlatParent: a);
		;;
	[end: 0 as ptr<DomNode>]

	const int POINTER_MOVE: 0;
	const int POINTER_DOWN: 1;
	const int POINTER_UP: 2;

	# The mouse, as the browser sees it, at (x, y) in the window over node (0 for none): moved,
	# or a button pressed or let go (button: 0 the main one, 1 the middle, 2 the other; buttons:
	# those held now, as MouseEvent.buttons has them). What Chrome fires, in its order: when what
	# it's over changes, pointerout, pointerleave, pointerover and pointerenter, then the same of
	# mouse events; then pointermove and mousemove, pointerdown and mousedown, or pointerup and
	# mouseup. A canceled pointerdown keeps the mouse events back (all but those four) until the
	# button's let go. :hover and :active follow it. A mousedown that isn't canceled (and is sent)
	# moves the focus to what can have it that the mouse is over, or takes it away (any button);
	# then the other button's press is a contextmenu, as on the Mac (Windows and Linux have it at
	# the up). The click is the host's to send (Click), after the up. False if mousedown (or the
	# contextmenu) was canceled.
	[Pointer: ptr<Page> p: 0; ptr<DomNode> node: 0; int kind: 0; f64 x: 0.0; f64 y: 0.0; int button: 0; int buttons: 0; int clicks: 1; : bln]
		call Use: p;
		while node is not 0 and node.type is not DomType.ELEMENT
			node is (Dom.FlatParent: node);
		;;
		if node is not 0 and node.doc is not p.doc
			node is 0;
		;;
		p.nest++;
		if node is not p.hovered
			call Boundary: p node x y buttons;
		;;
		bln allowed: true;
		if node is not 0
			if kind is POINTER_MOVE
				bln moved: (SendPointer: p node 'pointermove' x y (-1) buttons 0 as ptr<DomNode>);
				if not p.no_compat
					bln mm: (SendPointer: p node 'mousemove' x y 0 buttons 0 as ptr<DomNode>);
				;;
			;;
			elif kind is POINTER_DOWN
				# (:active from the first, as handlers see it in Chrome)
				if button is 0
					call Pressed: p node;
				;;
				p.no_compat is not (SendPointer: p node 'pointerdown' x y button buttons 0 as ptr<DomNode>);
				if not p.no_compat
					allowed is (SendPointer: p node 'mousedown' x y button buttons 0 as ptr<DomNode> clicks);
					if allowed and (Holds: (Dom.DocumentElement: p.doc) node)
						call MoveFocus: p (FocusableFrom: node) true;
						p.start_point is node;
					;;
				;;
				if button is 2
					allowed is (SendPointer: p node 'contextmenu' x y button buttons 0 as ptr<DomNode> 0) and allowed;
				;;
			;;
			elif kind is POINTER_UP
				bln up: (SendPointer: p node 'pointerup' x y button buttons 0 as ptr<DomNode>);
				if not p.no_compat
					bln mu: (SendPointer: p node 'mouseup' x y button buttons 0 as ptr<DomNode> clicks);
				;;
			;;
		;;
		if kind is POINTER_UP
			p.no_compat is false;
			if button is 0
				call Pressed: p 0;
			;;
		;;
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: allowed]

	# the mouse's wheel turned over node (dx, dy in pixels, down and right being more): false if
	# a handler canceled it (then the host doesn't scroll)
	[Wheel: ptr<Page> p: 0; ptr<DomNode> node: 0; f64 x: 0.0; f64 y: 0.0; f64 dx: 0.0; f64 dy: 0.0; int buttons: 0; : bln]
		call Use: p;
		while node is not 0 and node.type is not DomType.ELEMENT
			node is (Dom.FlatParent: node);
		;;
		if node is 0 or node.doc is not p.doc
			node is (Dom.DocumentElement: p.doc);
		;;
		if node is 0 return true;
		u64 ev: (PageEvents.NewWheel: x y x + p.scroll_x y + p.scroll_y dx dy buttons);
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: node) ev);
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: allowed]

	# (detail: a mousedown's or mouseup's count of clicks, 1 or 2 for a double click; 0 for the rest)
	[SendPointer: ptr<Page> p: 0; ptr<DomNode> node: 0; ptr<u8> type: 0; f64 x: 0.0; f64 y: 0.0; int button: 0; int buttons: 0; ptr<DomNode> related: 0; int detail: 0; : bln]
		u64 rel: JsV.NULL;
		if related is not 0
			rel is (PageBind.Wrap: related);
		;;
		u64 ev: (PageEvents.NewPointer: type x y x + p.scroll_x y + p.scroll_y button buttons rel detail);
	[end: (PageEvents.Dispatch: (PageBind.Wrap: node) ev)]

	# whether e is n or one n is in (through shadow trees and slots, as :hover goes)
	[Holds: ptr<DomNode> e: 0; ptr<DomNode> n: 0; : bln]
		while n is not 0
			if n is e return true;
			n is (Dom.FlatParent: n);
		;;
	[end: false]

	# its style is to be worked out again (:hover or :active has changed), and what's under it
	# too unless only its own (deep false: then what's under it is only if its own style changes)
	[Restyle: ptr<DomNode> n: 0; bln deep: true;]
		if n is 0 or n.type is not DomType.ELEMENT return;
		if deep
			n.flags is n.flags | Dom.DIRTY_STYLE;
		;;
		else
			n.flags is n.flags | Dom.DIRTY_SELF;
		;;
		call Dom.MarkUp: n;
		n.doc.version++;
	[end]

	# The mouse has gone from what it was over to node: out and leave for what it's left (each
	# leave from the innermost out, up to what holds both), over and enter for what it's come into
	# (each enter from the outermost in); pointer events first, then mouse ones
	[Boundary: ptr<Page> p: 0; ptr<DomNode> node: 0; f64 x: 0.0; f64 y: 0.0; int buttons: 0;]
		ptr<DomNode> old: p.hovered;
		if old is not 0 and not (Holds: (Dom.DocumentElement: p.doc) old)
			# (taken out of the document since)
			old is 0;
		;;
		p.hovered is node;
		# what it's left, innermost first, and what it's come into, outermost first
		ptr<DomNode> left[256];
		int nl: 0;
		ptr<DomNode> a: old;
		while a is not 0 and nl < 256 and not (Holds: a node)
			if a.type is DomType.ELEMENT
				left:nl is a;
				nl++;
			;;
			a is (Dom.FlatParent: a);
		;;
		ptr<DomNode> came[256];
		int nc: 0;
		a is node;
		while a is not 0 and nc < 256 and not (Holds: a old)
			if a.type is DomType.ELEMENT
				came:nc is a;
				nc++;
			;;
			a is (Dom.FlatParent: a);
		;;
		# (:hover as it is now, for what the handlers ask)
		u32 was: p.doc.version;
		while int k: 0; k < nl; k++;
			call Restyle: left:k;
		;;
		while int m: 0; m < nc; m++;
			call Restyle: came:m;
		;;
		call StatesSettled: p was;
		while int round: 0; round < 2; round++;
			ptr<u8> out_: 'pointerout';
			ptr<u8> leave: 'pointerleave';
			ptr<u8> over: 'pointerover';
			ptr<u8> enter: 'pointerenter';
			if round is 1
				out_ is 'mouseout';
				leave is 'mouseleave';
				over is 'mouseover';
				enter is 'mouseenter';
			;;
			if old is not 0
				bln o: (SendPointer: p old out_ x y 0 buttons node);
			;;
			while int i: 0; i < nl; i++;
				bln l: (SendPointer: p left:i leave x y 0 buttons node);
			;;
			if node is not 0
				bln v: (SendPointer: p node over x y 0 buttons old);
			;;
			int j: nc - 1;
			while j >= 0
				bln en: (SendPointer: p came:j enter x y 0 buttons old);
				j--;
			;;
		;;
	[end]

	# the element a button's held down on (0: let go), for :active
	[Pressed: ptr<Page> p: 0; ptr<DomNode> node: 0;]
		u32 was: p.doc.version;
		call Restate: p.pressed;
		call Restate: node;
		p.pressed is node;
		call StatesSettled: p was;
	[end]

	# n's state has changed (:active, :focus): it's to be styled again, and what it's in (each of
	# those only its own style: the whole page over again at each press would be slow)
	[Restate: ptr<DomNode> n: 0;]
		call Restyle: n true;
		while n is not 0
			n is (Dom.FlatParent: n);
			call Restyle: n false;
		;;
	[end]

	# The focus goes to n (0: nowhere, so the body's the active element): blur and focusout at what
	# had it, then focus and focusin at n, each with the other as relatedTarget, :focus and
	# :focus-within moved first (as handlers see it in Chrome: during the blur it's nowhere). A
	# blur handler that moves the focus itself has the last word. :focus-visible, as Chrome has
	# it: always in a field one types into; else not when the mouse moved it (by_mouse), nor when
	# focus() does, if the last the user moved it was with the mouse (taking it away counts).
	[MoveFocus: ptr<Page> p: 0; ptr<DomNode> n: 0; bln by_mouse: false;]
		ptr<DomNode> old: (Focused: p);
		if old is n return;
		if by_mouse
			p.mouse_focus is true;
		;;
		p.focus_quiet is p.mouse_focus and not (TypedInto: n);
		u64 to: JsV.NULL;
		if n is not 0
			to is (PageBind.Wrap: n);
		;;
		u64 from: JsV.NULL;
		# (it's nowhere while what had it hears of it going: the body's the active element then)
		u32 was: p.doc.version;
		call Restate: p.focused;
		p.focused is 0;
		call StatesSettled: p was;
		if old is not 0
			# (a field typed into is told it's changed first: change, then blur, as in Chrome)
			call Commit: p old;
			from is (PageBind.Wrap: old);
			bln b: (PageEvents.Dispatch: from (PageEvents.NewFocus: 'blur' false to));
			# (a blur handler that's moved it: its focus and focusin have come, then this one's
			# focusout, with no relatedTarget, as in Chrome)
			u64 out_to: to;
			if p.focused is not 0
				out_to is JsV.NULL;
			;;
			bln fo: (PageEvents.Dispatch: from (PageEvents.NewFocus: 'focusout' true out_to));
		;;
		if n is 0 or p.focused is not 0 return;
		was is p.doc.version;
		call Restate: n;
		p.focused is n;
		call StatesSettled: p was;
		bln f: (PageEvents.Dispatch: to (PageEvents.NewFocus: 'focus' false from));
		bln fi: (PageEvents.Dispatch: to (PageEvents.NewFocus: 'focusin' true from));
	[end]

	# what has the focus (0: nothing, the body being the active element). Taken out of the document,
	# it's lost it, without a blur, as in Chrome.
	[Focused: ptr<Page> p: 0; : ptr<DomNode>]
		ptr<DomNode> n: p.focused;
		if n is not 0 and (n.doc is not p.doc or not (Holds: (Dom.DocumentElement: p.doc) n))
			p.focused is 0;
			n is 0;
		;;
	[end: n]

	const int NO_TABINDEX: -2147483647;

	# n's tabindex, or NO_TABINDEX when it has none (or one that isn't a number)
	[TabIndex: ptr<DomNode> n: 0; : int]
		ptr<u8> ti: (Dom.AttrValue: n 'tabindex');
		if ti is 0 return NO_TABINDEX;
		u32 i: 0;
		while ti:i is ' ' or ti:i is '\t' or ti:i is '\n'
			i++;
		;;
		bln minus: false;
		if ti:i is '-' or ti:i is '+'
			minus is (ti:i is '-');
			i++;
		;;
		if not (ti:i >= '0' and ti:i <= '9') return NO_TABINDEX;
		int v: 0;
		while ti:i >= '0' and ti:i <= '9' and v < 100000000
			v is v * 10 + (ti:i - '0') as int;
			i++;
		;;
		if minus
			v is 0 - v;
		;;
	[end: v]

	# what the mouse pressed on node gives the focus to: it or the nearest it's in that can have it
	# (0: none, so the focus goes)
	[FocusableFrom: ptr<DomNode> node: 0; : ptr<DomNode>]
		while node is not 0
			if (Focusable: node) return node;
			node is (Dom.FlatParent: node);
		;;
	[end: 0 as ptr<DomNode>]

	# whether n can have the focus, as Chrome has it: what has a tabindex, a link, a form control
	# that isn't disabled (nor a hidden input), a frame, a summary, what's editable. (Chrome also
	# asks that it be shown, display not none; not yet here.)
	[Focusable: ptr<DomNode> n: 0; : bln]
		if n is 0 or n.type is not DomType.ELEMENT return false;
		if (TabIndex: n) is not NO_TABINDEX return true;
		ptr<u8> ce: (Dom.AttrValue: n 'contenteditable');
		if ce is not 0 and not (WlText.EqNoCaseZ: ce (WlText.LenZ: ce) 'false') return true;
		if n.ns is not DomNs.HTML or n.tag is 0 return false;
		u32 t: n.tag.tag;
		if t is HtmlTag.A or t is HtmlTag.AREA
			return (Dom.AttrValue: n 'href') is not 0;
		;;
		if t is HtmlTag.BUTTON or t is HtmlTag.SELECT or t is HtmlTag.TEXTAREA
			return (Dom.AttrValue: n 'disabled') is 0;
		;;
		if t is HtmlTag.INPUT
			if (Dom.AttrValue: n 'disabled') is not 0 return false;
			ptr<u8> type: (Dom.AttrValue: n 'type');
			return type is 0 or not (WlText.EqNoCaseZ: type (WlText.LenZ: type) 'hidden');
		;;
		if t is HtmlTag.IFRAME return true;
		if t is HtmlTag.SUMMARY
			return n.parent is not 0 and (Is: n.parent HtmlTag.DETAILS);
		;;
	[end: false]

	# ---- the keyboard ----

	# A key pressed, as the browser sees it: keydown at what has the focus (the body when nothing
	# does), then for a key that types (char_code, its character's code; not with ctrl, alt or
	# meta) keypress, as Chrome sends them. False if either was canceled: then the key does nothing
	# more (no typing, no KeyDefault). key and code as DOM names them ('a', 'KeyA'; 'Enter',
	# 'Enter'), key_code the legacy keyCode (a letter's capital, 13 for Enter, 9 for Tab...). The
	# host sends KeyUp after, as it hears nothing of keys let go.
	[Key: ptr<Page> p: 0; ptr<u8> key: 0; ptr<u8> code: 0; int key_code: 0; int char_code: 0; bln ctrl: false; bln shift: false; bln alt: false; bln meta: false; : bln]
		call Use: p;
		p.space_on is 0;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: (KeyTarget: p)) (PageEvents.NewKeyboard: 'keydown' key code key_code 0 ctrl shift alt meta));
		# (Enter on a link: Chrome follows it as keydown's default, which stops the keypress)
		if allowed and char_code > 0 and not ctrl and not alt and not meta and not ((WlText.EqZ: key (WlText.LenZ: key) 'Enter') and (LinkFocused: p))
			allowed is (PageEvents.Dispatch: (PageBind.Wrap: (KeyTarget: p)) (PageEvents.NewKeyboard: 'keypress' key code char_code char_code ctrl shift alt meta));
		;;
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: allowed]

	# the key let go: keyup at what has the focus now (after a Tab, what it went to). A space let
	# go on the button it went down on presses it (KeyDefault), as in Chrome.
	[KeyUp: ptr<Page> p: 0; ptr<u8> key: 0; ptr<u8> code: 0; int key_code: 0; bln ctrl: false; bln shift: false; bln alt: false; bln meta: false; : bln]
		call Use: p;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: (KeyTarget: p)) (PageEvents.NewKeyboard: 'keyup' key code key_code 0 ctrl shift alt meta));
		p.nest--;
		call RunJobs: p;
		ptr<DomNode> armed: p.space_on;
		p.space_on is 0;
		if allowed and armed is not 0 and armed is (Focused: p)
			bln c: (Click: p armed 0.0 0.0 0 0);
		;;
		call Invalidate: p;
	[end: allowed]

	# whether a link (an a or area with an href) has the focus
	[LinkFocused: ptr<Page> p: 0; : bln]
		ptr<DomNode> f: (Focused: p);
		if f is 0 return false;
		if not (Is: f HtmlTag.A) and not (Is: f HtmlTag.AREA) return false;
	[end: (Dom.AttrValue: f 'href') is not 0]

	# where keys go: what has the focus, or the body (or the root, without one)
	[KeyTarget: ptr<Page> p: 0; : ptr<DomNode>]
		ptr<DomNode> n: (Focused: p);
		if n is 0
			n is (Dom.Body: p.doc);
		;;
		if n is 0
			n is (Dom.DocumentElement: p.doc);
		;;
	[end: n]

	# What a key does that the page let be (Key gave true), where it's the page's to do. Tab and
	# shift Tab move the focus along (TabFocus); Enter follows a link that has the focus, presses a
	# button, or sends the form of the field one types into (Chrome's implicit submission); a
	# space presses a button, a checkbox or a radio button when it comes up (KeyUp). True if it
	# did something: the host types or scrolls only if not. A Tab with nowhere to go is false (the
	# focus is then the host's to move, to its address bar say).
	[KeyDefault: ptr<Page> p: 0; ptr<u8> key: 0; bln shift: false; : bln]
		call Use: p;
		u32 kl: (WlText.LenZ: key);
		ptr<DomNode> f: (Focused: p);
		if (WlText.EqZ: key kl 'Tab')
			return (TabFocus: p shift);
		;;
		if f is 0 return false;
		if (WlText.EqZ: key kl 'Enter')
			if (LinkFocused: p)
				bln followed: (Click: p f 0.0 0.0 0 0);
				return true;
			;;
			if (Pressable: f false)
				bln pressed: (Click: p f 0.0 0.0 0 0);
				return true;
			;;
			if (Is: f HtmlTag.INPUT) and (TypedInto: f)
				call ImplicitSubmit: p f;
				return true;
			;;
			return false;
		;;
		if (WlText.EqZ: key kl ' ') and (Pressable: f true)
			p.space_on is f;
			return true;
		;;
	[end: false]

	# whether a key presses n (a click): a button, or an input that's one (submit, reset, button,
	# image); with a space (space) a checkbox or radio button too
	[Pressable: ptr<DomNode> n: 0; bln space: false; : bln]
		if (Is: n HtmlTag.BUTTON) return true;
		if not (Is: n HtmlTag.INPUT) return false;
		ptr<u8> type: (Dom.AttrValue: n 'type');
		if type is 0 return false;
		u32 tl: (WlText.LenZ: type);
		if (WlText.EqNoCaseZ: type tl 'submit') or (WlText.EqNoCaseZ: type tl 'reset') or (WlText.EqNoCaseZ: type tl 'button') or (WlText.EqNoCaseZ: type tl 'image') return true;
		if space and ((WlText.EqNoCaseZ: type tl 'checkbox') or (WlText.EqNoCaseZ: type tl 'radio')) return true;
	[end: false]

	# Enter in a field of a form: the field's change (if typed into), then its form's first submit
	# button clicked (if it's disabled, nothing); with none, the form sent, unless it has more than
	# one field one types into (the HTML standard's implicit submission)
	[ImplicitSubmit: ptr<Page> p: 0; ptr<DomNode> field: 0;]
		ptr<DomNode> form: field.parent;
		while form is not 0 and not (Is: form HtmlTag.FORM)
			form is form.parent;
		;;
		call Commit: p field;
		if form is 0 return;
		ptr<DomNode> button: 0;
		int fields: 0;
		ptr<DomNode> n: form;
		while n is not 0
			if button is 0 and (SubmitButton: n)
				button is n;
			;;
			if (Is: n HtmlTag.INPUT) and (TypedInto: n)
				fields++;
			;;
			n is (Dom.Next: n form);
		;;
		if button is not 0
			if (Dom.AttrValue: button 'disabled') is 0
				bln clicked: (Click: p button 0.0 0.0 0 0);
			;;
			return;
		;;
		if fields > 1 return;
		call RequestSubmit: p form 0 as ptr<DomNode>;
	[end]

	# form.requestSubmit(button) (button 0: with none), which fires submit and, if nothing stops it,
	# sends the form by its method (platform.js)
	[RequestSubmit: ptr<Page> p: 0; ptr<DomNode> form: 0; ptr<DomNode> button: 0;]
		u64 f: (PageBind.Wrap: form);
		u64 fn: (Js.GetProp: f 'requestSubmit');
		if not (JsV.IsObj: fn) return;
		int argc: 0;
		if button is not 0
			call Js.Push: (PageBind.Wrap: button);
			argc is 1;
		;;
		p.nest++;
		u64 ignored: (Js.Call: fn f argc);
		p.nest--;
		if Js.failed
			call ReportException: p;
		;;
		call RunJobs: p;
		p.submitted is true;
	[end]

	# Tab (back: shift Tab): the focus to the next that takes it in Chrome's tab order: what has a
	# tabindex above 0, least first, then the rest that can have the focus (but those with a
	# tabindex below 0), as the document has them. From what has the focus, else from where the
	# mouse was last pressed (the starting point), else from the start (the end, going back).
	# False with nothing more that way. (What isn't shown, display none, isn't left out yet.)
	[TabFocus: ptr<Page> p: 0; bln back: false; : bln]
		ptr<DomNode> root: (Dom.DocumentElement: p.doc);
		if root is 0 return false;
		ptr<DomNode> me: (Focused: p);
		if me is 0
			me is p.start_point;
		;;
		if me is not 0 and (me.doc is not p.doc or not (Holds: root me))
			me is 0;
		;;
		# where it's from, as the order sorts it: its tabindex (all those of 0 or none after), its place
		int my_key: 0;
		int my_pos: -1;
		int pos: 0;
		ptr<DomNode> n: root;
		if me is not 0
			while n is not 0
				if n is me
					my_pos is pos;
					my_key is (TabKey: n);
					break;
				;;
				pos++;
				n is (Dom.Next: n root);
			;;
		;;
		ptr<DomNode> best: 0;
		int best_key: 0;
		int best_pos: 0;
		pos is 0;
		n is root;
		while n is not 0
			if n is not me and (Focusable: n) and ((TabIndex: n) is NO_TABINDEX or (TabIndex: n) >= 0)
				int k: (TabKey: n);
				bln past: true;
				if my_pos >= 0
					if back
						past is k < my_key or (k is my_key and pos < my_pos);
					;;
					else
						past is k > my_key or (k is my_key and pos > my_pos);
					;;
				;;
				bln better: best is 0;
				if not better
					if back
						better is k > best_key or (k is best_key and pos > best_pos);
					;;
					else
						better is k < best_key or (k is best_key and pos < best_pos);
					;;
				;;
				if past and better
					best is n;
					best_key is k;
					best_pos is pos;
				;;
			;;
			pos++;
			n is (Dom.Next: n root);
		;;
		if best is 0 return false;
		p.mouse_focus is false;
		call MoveFocus: p best false;
		p.start_point is best;
	[end: true]

	# where n comes in the tab order: its tabindex if above 0, else after all those
	[TabKey: ptr<DomNode> n: 0; : int]
		int t: (TabIndex: n);
		if t > 0 return t;
	[end: 2147483647]

	# What the host types into the field n (an input or textarea, what has the focus): text put at
	# its end, or with none (0) the last character taken off, Backspace (the browser has no caret
	# yet). beforeinput first, which a handler can cancel (false: then it isn't changed), then the
	# value changed (its attribute and what scripts see), then input; its change event comes when
	# the focus leaves it (Commit).
	[TypeInto: ptr<Page> p: 0; ptr<DomNode> n: 0; ptr<u8> text: 0; : bln]
		call Use: p;
		ptr<u8> type: 'insertText';
		if text is 0
			type is 'deleteContentBackward';
		;;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: n) (PageEvents.NewInputEvent: 'beforeinput' type text true));
		p.nest--;
		call RunJobs: p;
		if not allowed return false;
		WlBuf b;
		if not (PageBind.LiveValue: n addr b)
			ptr<u8> now: (Dom.AttrValue: n 'value');
			if now is not 0
				call b.AddZ: now;
			;;
		;;
		if text is 0
			# (a whole character off, however many bytes UTF-8 gave it)
			if b.len > 0
				b.len--;
				while b.len > 0 and (b.data:(b.len) & 0xC0) is 0x80
					b.len--;
				;;
			;;
		;;
		else
			call b.AddZ: text;
		;;
		u32 vl: b.len;
		call b.Add: 0;
		call Dom.SetAttrZ: n 'value' b.data;
		call PageBind.SetLiveValue: n b.data vl;
		call b.Free;
		n.flags is n.flags | Dom.DIRTY_LAYOUT;
		call Dom.MarkUp: n;
		p.edited is n;
		p.nest++;
		bln said: (PageEvents.Dispatch: (PageBind.Wrap: n) (PageEvents.NewInputEvent: 'input' type text false));
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: true]

	# Enter in a field: beforeinput's insertLineBreak (false if canceled); a textarea then takes
	# the line (and input follows), an input doesn't (KeyDefault sends its form)
	[LineBreak: ptr<Page> p: 0; ptr<DomNode> n: 0; : bln]
		call Use: p;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: n) (PageEvents.NewInputEvent: 'beforeinput' 'insertLineBreak' 0 as ptr<u8> true));
		p.nest--;
		call RunJobs: p;
		if not allowed or not (Is: n HtmlTag.TEXTAREA) return allowed;
		# (beforeinput's been heard: the line put in as TypeInto puts text, but for its own input)
		WlBuf b;
		if not (PageBind.LiveValue: n addr b)
			ptr<u8> now: (Dom.AttrValue: n 'value');
			if now is not 0
				call b.AddZ: now;
			;;
		;;
		call b.Add: '\n';
		u32 vl: b.len;
		call b.Add: 0;
		call Dom.SetAttrZ: n 'value' b.data;
		call PageBind.SetLiveValue: n b.data vl;
		call b.Free;
		n.flags is n.flags | Dom.DIRTY_LAYOUT;
		call Dom.MarkUp: n;
		p.edited is n;
		p.nest++;
		bln said: (PageEvents.Dispatch: (PageBind.Wrap: n) (PageEvents.NewInputEvent: 'input' 'insertLineBreak' 0 as ptr<u8> false));
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: true]

	# change at n, if it's been typed into since it was last told (as the focus leaves it, or Enter
	# sends its form)
	[Commit: ptr<Page> p: 0; ptr<DomNode> n: 0;]
		if n is 0 or p.edited is not n return;
		p.edited is 0;
		bln c: (PageEvents.Dispatch: (PageBind.Wrap: n) (PageEvents.NewTrusted: 'change' true false));
	[end]

	# whether n is a field one types text into (a textarea, an input of a text kind), which the
	# mouse's focus leaves :focus-visible
	[TypedInto: ptr<DomNode> n: 0; : bln]
		if n is 0 return false;
		if (Is: n HtmlTag.TEXTAREA) return true;
		ptr<u8> ce: (Dom.AttrValue: n 'contenteditable');
		if ce is not 0 and not (WlText.EqNoCaseZ: ce (WlText.LenZ: ce) 'false') return true;
		if not (Is: n HtmlTag.INPUT) return false;
		ptr<u8> type: (Dom.AttrValue: n 'type');
		if type is 0 return true;
		u32 tl: (WlText.LenZ: type);
		if tl is 0 return true;
		bln not_text: (WlText.EqNoCaseZ: type tl 'button') or (WlText.EqNoCaseZ: type tl 'submit') or (WlText.EqNoCaseZ: type tl 'reset') or (WlText.EqNoCaseZ: type tl 'checkbox') or (WlText.EqNoCaseZ: type tl 'radio') or (WlText.EqNoCaseZ: type tl 'image') or (WlText.EqNoCaseZ: type tl 'file') or (WlText.EqNoCaseZ: type tl 'range') or (WlText.EqNoCaseZ: type tl 'color') or (WlText.EqNoCaseZ: type tl 'hidden');
	[end: not not_text]

	# :hover or :active has changed for what Restyle marked: their styles are worked out now, and
	# when none came out different (no rule cares) the document's version is put back as it was,
	# so the host needn't lay the page out again for nothing (each time the mouse crosses into
	# another element). Only when nothing else had changed since the styles were last worked out.
	[StatesSettled: ptr<Page> p: 0; u32 was: 0;]
		if p.doc.version is was return;
		bln clean: p.css.ran and p.css.seen_version is was;
		if not (UpdateStyle: p) return;
		if clean and p.css.changed is 0 and p.css.seen_version is p.doc.version
			p.doc.version is was;
			p.css.seen_version is was;
		;;
	[end]

	# following a link, or sending a form from its submit button
	[DefaultClick: ptr<Page> p: 0; ptr<DomNode> node: 0;]
		p.submitted is false;
		ptr<WlAtom> a_tag: (WlAtoms.GetZ: 'a');
		ptr<DomNode> n: node;
		while n is not 0
			if n.type is DomType.ELEMENT and n.tag is a_tag
				ptr<u8> href: (Dom.AttrValue: n 'href');
				if href is not 0 and p.host.navigate is not 0
					WlBuf full;
					call Resolve: p href (WlText.LenZ: href) addr full;
					p.nav_policy is (ElementPolicy: p n true);
					call p.host.navigate: p full.data;
					p.nav_policy is p.policy;
					call full.Free;
				;;
				return;
			;;
			n is n.parent;
		;;
		# a submit button (a <button> of type submit or none, an <input> of type submit or image) in
		# a form: the form's requestSubmit(button), which fires submit and, if nothing stops it, sends
		# the form by its method (platform.js)
		ptr<DomNode> button: node;
		while button is not 0 and not (SubmitButton: button)
			button is button.parent;
		;;
		if button is 0 return;
		ptr<DomNode> form: button.parent;
		while form is not 0 and not (Is: form HtmlTag.FORM)
			form is form.parent;
		;;
		if form is 0 return;
		call RequestSubmit: p form button;
	[end]

	[Is: ptr<DomNode> n: 0; u32 tag: 0; : bln]
		if n.type is not DomType.ELEMENT or n.ns is not DomNs.HTML or n.tag is 0 return false;
	[end: (n.tag.tag is tag)]

	[SubmitButton: ptr<DomNode> n: 0; : bln]
		if (Is: n HtmlTag.BUTTON)
			ptr<u8> t: (Dom.AttrValue: n 'type');
			if t is 0 return true;
			return (WlText.EqNoCaseZ: t (WlText.LenZ: t) 'submit');
		;;
		if (Is: n HtmlTag.INPUT)
			ptr<u8> t: (Dom.AttrValue: n 'type');
			if t is 0 return false;
			return (WlText.EqNoCaseZ: t (WlText.LenZ: t) 'submit') or (WlText.EqNoCaseZ: t (WlText.LenZ: t) 'image');
		;;
	[end: false]

	[MouseEvent: ptr<Page> p: 0; ptr<DomNode> node: 0; ptr<u8> type: 0; f64 x: 0.0; f64 y: 0.0; int button: 0;]
		call Use: p;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: node) (PageEvents.NewMouse: type x y button 1));
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: allowed]

	[KeyEvent: ptr<Page> p: 0; ptr<DomNode> node: 0; ptr<u8> type: 0; ptr<u8> key: 0; bln ctrl: false; bln shift: false; bln alt: false;]
		call Use: p;
		p.nest++;
		bln allowed: (PageEvents.Dispatch: (PageBind.Wrap: node) (PageEvents.NewKey: type key ctrl shift alt));
		p.nest--;
		call RunJobs: p;
		call Invalidate: p;
	[end: allowed]
}
