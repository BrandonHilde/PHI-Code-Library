# The document tree: what the HTML parser builds, CSS matches against, JS changes and a browser
# lays out. Nothing here recurses, so a tree can be as deep as a page makes it.
#
# Every node belongs to its document, which frees them all together (Dom.FreeDocument); taking a
# node out of the tree doesn't free it, since JS may still hold it. A browser drops the document
# when it leaves the page.
#
#   ptr<DomDocument> doc: (Dom.NewDocument);
#   ptr<DomNode> p: (Dom.CreateElement: doc (WlAtoms.GetZ: 'p'));
#   call Dom.SetAttrZ: p 'class' 'intro';
#   call Dom.Append: doc.root p;
#   call Dom.Append: p (Dom.CreateTextZ: doc 'hello');
#
#   ptr<DomNode> n: doc.root;                 # every node under root, in document order
#   while n is not 0
#       n is (Dom.Next: n doc.root);
#   ;;

use memory.mem;
use core.text;
use core.atoms;
use core.buf;

enum.DomType
{
	ELEMENT: 1
	TEXT: 3
	CDATA: 4
	PI: 7                   # a processing instruction: tag is its target, text its data
	COMMENT: 8
	DOCUMENT: 9
	DOCTYPE: 10
	FRAGMENT: 11
}

enum.DomNs
{
	HTML
	SVG
	MATHML
}

# what changed, for a document's on_change
enum.DomChange
{
	CHILDREN                # a child was added or taken out: the node is the parent
	ATTR                    # an attribute was set or removed: the node is the element
	TEXT                    # a text or comment node's text
}

struct.DomAttr
{
	ptr<WlAtom> name;       # the local name
	ptr<WlAtom> prefix;     # 'xlink' and the like, on foreign content; 0 otherwise
	ptr<u8> value;          # zero-terminated, UTF-8, on the heap
	u32 value_len;
	ptr<DomAttr> next;      # in the order they were set
}

struct.DomNode
{
	DomType type;
	DomNs ns;
	u32 flags;              # Dom.DIRTY_STYLE ... and the HTML parser's own

	ptr<DomDocument> doc;
	ptr<DomNode> parent;
	ptr<DomNode> first_child;
	ptr<DomNode> last_child;
	ptr<DomNode> prev;
	ptr<DomNode> next;
	ptr<DomNode> all_next;  # the document's list of every node it owns

	# an element's name, in the case HTML's rules gave it; a doctype's name
	ptr<WlAtom> tag;
	ptr<DomAttr> attrs;

	# a text or comment node's text; a doctype's public id
	ptr<u8> text;
	u32 text_len;
	u32 text_cap;
	# a doctype's system id
	ptr<u8> text2;
	u32 text2_len;

	# kept up to date by SetAttr and RemoveAttr, for matching selectors fast
	ptr<WlAtom> id_atom;
	ptr<ptr<WlAtom>> classes;
	u32 class_count;

	# <template>'s contents: a FRAGMENT of the document (whose own content is the template)
	ptr<DomNode> content;

	# A shadow host's shadow root, and a shadow root's host: each points at the other. A shadow root is
	# a FRAGMENT with Dom.SHADOW_ROOT, in no parent, so walks of the tree (Next, Contains) don't enter it;
	# ShadowNext does.
	ptr<DomNode> shadow;
	ptr<u8> sheets;         # a shadow root's stylesheets, as the page keeps them (the DOM never looks)

	# Places for what the other layers keep on a node. The DOM never looks inside them.
	u64 js_wrapper;         # the JS object for this node (a JsValue; 0 until JS asks), which
	                        # the JS engine marks: a node's wrapper lives as long as its document
	ptr<u8> listeners;      # event listeners (js/bindings)
	ptr<u8> style;          # the computed style (ptr<CssComputed>, css/)
	ptr<u8> inline_style;   # the parsed style attribute (css/)
	ptr<u8> layout;         # the browser's own: a layout box, say
	u32 box_w;              # the browser's: how wide its content box was laid out, plus 1 (0: not
	                        # laid out yet), which a container query about it is asked of
	u64 css_watch;          # CSS's: which of the compounds it watches this element matched when
	                        # last styled (css/cascade.phi, CssEngine.watch)
}

struct.DomDocument
{
	ptr<DomNode> root;      # the DOCUMENT node
	ptr<DomNode> all;       # every node it owns, newest first
	u32 node_count;
	bln quirks;             # no-quirks parsing unless the parser found otherwise
	bln limited_quirks;
	u32 version;            # goes up by one on every change, so a cache can see it's stale
	u32 sheet_version;      # goes up when a <style> or <link> comes, goes, or changes
	u32 css_reach;          # CSS's: Dom.REACH_ATTRS, REACH_ALL (see AttrChanged)
	method<ptr<DomNode> int> on_change;     # called after every change (see DomChange), if set
	# for MutationObserver: told of each change a script could see, with what it changed: the target,
	# the kind (Dom.ADDED, REMOVED, ATTRIBUTE, TEXT), the node added or taken out, the attribute's
	# name, and the value before (its length; -1 when there wasn't one). Attributes and text are told
	# before they change, children after. Set only while something observes.
	method<ptr<DomNode> int ptr<DomNode> ptr<WlAtom> ptr<u8> int> on_mutation;
	ptr<u8> url;            # the document's address, zero-terminated (the document's to free)
	ptr<u8> host_data;      # the browser's own: its tab, say
}

phi.Dom:Library
{
	# what on_mutation is told
	const int ADDED: 0;
	const int REMOVED: 1;
	const int ATTRIBUTE: 2;
	const int TEXT: 3;

	const u32 DIRTY_STYLE: 1;        # this element's style must be worked out again
	const u32 DIRTY_CHILD: 2;        # something under it (or it, or its shadow tree) changed: set on
	                                 # every ancestor by Changed and MarkUp, so CSS goes only down
	                                 # those paths
	const u32 DIRTY_LAYOUT: 4;       # for the browser: it needs laying out again
	const u32 DIRTY_TREE: 8;         # children were added or taken out (CSS looks at this for :first-child and the like)
	const u32 SHADOW_ROOT: 16;       # a FRAGMENT that is an element's shadow root
	const u32 SHADOW_CLOSED: 32;     # ... made with mode: 'closed'
	const u32 CE_DEFINED: 64;        # a custom element that has been made or upgraded (CSS's :defined)
	const u32 CE_SEEN: 128;          # the page's, for a moment, while it goes through what's changed
	const u32 FIRST_PARSER_FLAG: 0x100;   # flags from here to 0x8000 are the HTML parser's own
	const u32 SCRIPT_RAN: 0x10000;   # the page's: a <script> that has run, or been put in by a script
	const u32 SHADOW_DECLARATIVE: 0x20000;  # a shadow root the parser made from <template shadowrootmode>
	const u32 PICTURE_ASKED: 0x40000;       # the page's: an <img> that has asked for its picture
	const u32 POPOVER_OPEN: 0x80000;        # the page's: a popover that's showing (CSS's :popover-open)
	const u32 INERT: 0x100000;              # the page's: a copy of what's in a <template> (the standard's
	                                        # inert document, where nothing is upgraded), until it's put in
	const u32 DIRTY_SELF: 0x200000;         # CSS: this element's own style again, but what's under it
	                                        # only if that changes (a :has() or :first-child that may hold now)

	ptr<WlAtom> A_ID: 0;
	ptr<WlAtom> A_CLASS: 0;
	ptr<WlAtom> A_SLOT: 0;      # <slot>, and the slot attribute
	ptr<WlAtom> A_NAME: 0;
	ptr<WlAtom> A_STYLE: 0;
	ptr<WlAtom> A_LINK: 0;

	# How far an attribute's change can reach, as CSS says: on a WlAtom (css), the class, id or
	# attribute of that name is in a selector about other elements (an ancestor's .open, say); on
	# a document (css_reach), any attribute but class, id and style may be (REACH_ATTRS), or anything
	# may be (REACH_ALL). Otherwise a change restyles the element alone (DIRTY_SELF).
	const u32 REACH_CLASS: 1;
	const u32 REACH_ID: 2;
	const u32 REACH_ATTR: 4;
	const u32 REACH_ATTRS: 1;
	const u32 REACH_ALL: 2;

	[Start]
		if A_ID is not 0 return;
		A_ID is (WlAtoms.GetZ: 'id');
		A_CLASS is (WlAtoms.GetZ: 'class');
		A_SLOT is (WlAtoms.GetZ: 'slot');
		A_NAME is (WlAtoms.GetZ: 'name');
		A_STYLE is (WlAtoms.GetZ: 'style');
		A_LINK is (WlAtoms.GetZ: 'link');
	[end]

	# Says node has changed to whoever looks for changes from the top (CSS): DIRTY_CHILD on it and
	# every ancestor, through a shadow root to its host, up to one that has it already.
	[MarkUp: ptr<DomNode> node: 0;]
		ptr<DomNode> n: node;
		while n is not 0
			if (n.flags & DIRTY_CHILD) is not 0 return;
			n.flags is n.flags | DIRTY_CHILD;
			if n.parent is not 0
				n is n.parent;
			;;
			elif (n.flags & SHADOW_ROOT) is not 0
				n is n.shadow;
			;;
			else
				n is 0;
			;;
		;;
	[end]

	# whether there's a <style> or <link> at or under node (a stylesheet coming or going)
	[HoldsSheet: ptr<DomNode> node: 0;]
		call Start;
		ptr<DomNode> n: node;
		while n is not 0
			if n.type is DomType.ELEMENT and (n.tag is A_STYLE or n.tag is A_LINK) return true;
			n is (Next: n node);
		;;
	[end: false]

	[IsSheetNode: ptr<DomNode> n: 0;]
		call Start;
	[end: n is not 0 and n.type is DomType.ELEMENT and (n.tag is A_STYLE or n.tag is A_LINK)]

	# ---- making nodes

	[NewNode: ptr<DomDocument> doc: 0; DomType type: DomType.ELEMENT;]
		ptr<DomNode> n: new DomNode;
		if n is 0
			throw 'out of memory for a node';
		;;
		n.type is type;
		n.doc is doc;
		n.flags is DIRTY_STYLE;
		n.all_next is doc.all;
		doc.all is n;
		doc.node_count++;
	[end: n]

	[NewDocument]
		call Start;
		ptr<DomDocument> doc: new DomDocument;
		if doc is 0
			throw 'out of memory for a document';
		;;
		doc.root is (NewNode: doc DomType.DOCUMENT);
	[end: doc]

	[CreateElement: ptr<DomDocument> doc: 0; ptr<WlAtom> tag: 0; DomNs ns: DomNs.HTML;]
		ptr<DomNode> n: (NewNode: doc DomType.ELEMENT);
		n.tag is tag;
		n.ns is ns;
	[end: n]

	[CreateElementZ: ptr<DomDocument> doc: 0; ptr<u8> tag: 0;]
	[end: (CreateElement: doc (WlAtoms.GetZ: tag))]

	[CreateText: ptr<DomDocument> doc: 0; ptr<u8> text: 0; u32 n: 0;]
		ptr<DomNode> node: (NewNode: doc DomType.TEXT);
		call SetText: node text n;
	[end: node]

	[CreateTextZ: ptr<DomDocument> doc: 0; ptr<u8> text: 0;]
	[end: (CreateText: doc text (WlText.LenZ: text))]

	[CreateComment: ptr<DomDocument> doc: 0; ptr<u8> text: 0; u32 n: 0;]
		ptr<DomNode> node: (NewNode: doc DomType.COMMENT);
		call SetText: node text n;
	[end: node]

	[CreateDoctype: ptr<DomDocument> doc: 0; ptr<WlAtom> name: 0; ptr<u8> public_id: 0; u32 public_len: 0; ptr<u8> system_id: 0; u32 system_len: 0;]
		ptr<DomNode> node: (NewNode: doc DomType.DOCTYPE);
		node.tag is name;
		call SetText: node public_id public_len;
		node.text2 is (WlText.Dup: system_id system_len);
		node.text2_len is system_len;
	[end: node]

	[CreateFragment: ptr<DomDocument> doc: 0;]
	[end: (NewNode: doc DomType.FRAGMENT)]

	# ---- text

	[SetText: ptr<DomNode> node: 0; ptr<u8> text: 0; u32 n: 0;]
		if node.doc.on_mutation is not 0
			call node.doc.on_mutation: node TEXT 0 as ptr<DomNode> 0 as ptr<WlAtom> node.text node.text_len as int;
		;;
		if node.text is 0 or node.text_cap < n + 1
			u32 room: n + 1;
			if room < 16
				room is 16;
			;;
			ptr<u8> grown: new u8[room];
			if grown is 0
				throw 'out of memory for text';
			;;
			if node.text is not 0
				free node.text;
			;;
			node.text is grown;
			node.text_cap is room;
		;;
		if n > 0
			call Mem.Move: node.text text n;
		;;
		node.text:n is 0;
		node.text_len is n;
		call Changed: node DomChange.TEXT;
	[end]

	# more text at the end (grows by doubling, so the parser's many small pieces are cheap)
	[AddText: ptr<DomNode> node: 0; ptr<u8> text: 0; u32 n: 0;]
		u32 need: node.text_len + n + 1;
		if node.text is 0 or node.text_cap < need
			u32 room: node.text_cap * 2;
			if room < need
				room is need;
			;;
			if room < 16
				room is 16;
			;;
			ptr<u8> grown: new u8[room];
			if grown is 0
				throw 'out of memory for text';
			;;
			if node.text is not 0
				if node.text_len > 0
					call Mem.Copy: grown node.text node.text_len;
				;;
				free node.text;
			;;
			node.text is grown;
			node.text_cap is room;
		;;
		if n > 0
			call Mem.Copy: node.text + node.text_len text n;
		;;
		node.text_len is node.text_len + n;
		node.text:(node.text_len) is 0;
		call Changed: node DomChange.TEXT;
	[end]

	# ---- the tree

	# whether a is node or holds it
	[Contains: ptr<DomNode> a: 0; ptr<DomNode> node: 0;]
		while node is not 0
			if node is a return true;
			node is node.parent;
		;;
	[end: false]

	# take node out of wherever it is (not freed); nothing if it isn't in a tree
	[Remove: ptr<DomNode> node: 0;]
		ptr<DomNode> parent: node.parent;
		if parent is 0 return;
		if node.doc.on_mutation is not 0
			call node.doc.on_mutation: parent REMOVED node 0 as ptr<WlAtom> 0 as ptr<u8> (-1);
		;;
		if node.prev is not 0
			node.prev.next is node.next;
		;;
		else
			parent.first_child is node.next;
		;;
		if node.next is not 0
			node.next.prev is node.prev;
		;;
		else
			parent.last_child is node.prev;
		;;
		node.parent is 0;
		node.prev is 0;
		node.next is 0;
		if node.type is DomType.ELEMENT and (node.first_child is not 0 or (IsSheetNode: node))
			if (HoldsSheet: node)
				parent.doc.sheet_version++;
			;;
		;;
		call Changed: parent DomChange.CHILDREN;
	[end]

	# node put under parent, before ref (at the end if ref is 0), taken from where it was. A
	# node can't go inside itself: that's an error, which the bindings have checked first.
	[InsertBefore: ptr<DomNode> parent: 0; ptr<DomNode> node: 0; ptr<DomNode> ref: 0;]
		# a node with no children can hold nothing but itself, and asking first keeps building a
		# deep tree from the top down from walking every ancestor at every step
		if node is parent or (node.first_child is not 0 and (Contains: node parent))
			throw 'a node cannot go inside itself';
		;;
		if ref is node
			ref is node.next;
		;;
		call Remove: node;
		# (somewhere new, it may match other rules and inherits from another parent)
		node.flags is node.flags | DIRTY_STYLE;
		if node.type is DomType.ELEMENT and (node.first_child is not 0 or (IsSheetNode: node))
			if (HoldsSheet: node)
				parent.doc.sheet_version++;
			;;
		;;
		node.parent is parent;
		node.next is ref;
		if ref is 0
			node.prev is parent.last_child;
			if parent.last_child is not 0
				parent.last_child.next is node;
			;;
			else
				parent.first_child is node;
			;;
			parent.last_child is node;
		;;
		else
			node.prev is ref.prev;
			if ref.prev is not 0
				ref.prev.next is node;
			;;
			else
				parent.first_child is node;
			;;
			ref.prev is node;
		;;
		call Changed: parent DomChange.CHILDREN;
		if node.doc.on_mutation is not 0
			call node.doc.on_mutation: parent ADDED node 0 as ptr<WlAtom> 0 as ptr<u8> (-1);
		;;
	[end]

	[Append: ptr<DomNode> parent: 0; ptr<DomNode> node: 0;]
		call InsertBefore: parent node 0;
	[end]

	# ---- walking

	# the node after this one in document order, staying under root; 0 at the end
	[Next: ptr<DomNode> node: 0; ptr<DomNode> root: 0;]
		if node.first_child is not 0 return node.first_child;
	[end: (NextSkipping: node root)]

	# the same, skipping what's under node
	[NextSkipping: ptr<DomNode> node: 0; ptr<DomNode> root: 0;]
		while node is not 0 and node is not root
			if node.next is not 0 return node.next;
			node is node.parent;
		;;
	[end: 0 as ptr<DomNode>]

	# ---- shadow trees

	[IsShadowRoot: ptr<DomNode> node: 0;]
	[end: node.type is DomType.FRAGMENT and (node.flags & SHADOW_ROOT) is not 0]

	# the node at the top of node's tree: the document, a shadow root, or something not in either
	[TreeRoot: ptr<DomNode> node: 0;]
		while node.parent is not 0
			node is node.parent;
		;;
	[end: node]

	# whether node is in the document, its shadow trees included (the DOM's isConnected)
	[IsConnected: ptr<DomNode> node: 0;]
		while node is not 0
			ptr<DomNode> top: (TreeRoot: node);
			if top.type is DomType.DOCUMENT return true;
			if not (IsShadowRoot: top) return false;
			node is top.shadow;
		;;
	[end: false]

	# The parent in the tree that includes shadow trees: a shadow root's is its host.
	[ShadowParent: ptr<DomNode> node: 0;]
		if node.parent is 0 and (IsShadowRoot: node) return node.shadow;
	[end: node.parent]

	# The node after this one in shadow-including order (a host, its shadow tree, then its children),
	# staying under root; 0 at the end.
	[ShadowNext: ptr<DomNode> node: 0; ptr<DomNode> root: 0;]
		if node.type is DomType.ELEMENT and node.shadow is not 0 return node.shadow;
		if node.first_child is not 0 return node.first_child;
	[end: (ShadowNextSkipping: node root)]

	# the same, skipping what's under node (its shadow tree too)
	[ShadowNextSkipping: ptr<DomNode> node: 0; ptr<DomNode> root: 0;]
		while node is not 0 and node is not root
			if node.next is not 0 return node.next;
			if node.parent is 0 and (IsShadowRoot: node)
				ptr<DomNode> host: node.shadow;
				if host is root return host.first_child;
				if host.first_child is not 0 return host.first_child;
				node is host;
				continue;
			;;
			node is node.parent;
		;;
	[end: 0 as ptr<DomNode>]

	# ---- slots, and the flat tree: what's shown, where a shadow tree takes its host's children

	# The elements that can have a shadow tree: an HTML element with a custom element's name (a hyphen
	# in it), and these.
	[CanHostShadow: ptr<DomNode> n: 0;]
		if n.type is not DomType.ELEMENT or n.ns is not DomNs.HTML return false;
		ptr<WlAtom> t: n.tag;
		while u32 i: 0; i < t.len; i++;
			if t.text:i is '-' return true;
		;;
		ptr<u8> names: ' article aside blockquote body div footer h1 h2 h3 h4 h5 h6 header main nav p section span ';
		u32 at_: 1;
		while names:at_ is not 0
			u32 from: at_;
			while names:at_ is not 32
				at_++;
			;;
			if at_ - from is t.len and (Mem.Equal: names + from t.text t.len) return true;
			at_++;
		;;
	[end: false]

	# host's shadow root, new and empty (host can have one, and hasn't)
	[AttachShadow: ptr<DomNode> host: 0; bln closed: false;]
		ptr<DomNode> r: (CreateFragment: host.doc);
		r.flags is r.flags | SHADOW_ROOT;
		if closed
			r.flags is r.flags | SHADOW_CLOSED;
		;;
		call MakeShadowRoot: host r;
	[end: r]

	# fragment r becomes host's shadow root
	[MakeShadowRoot: ptr<DomNode> host: 0; ptr<DomNode> r: 0;]
		r.flags is r.flags | SHADOW_ROOT;
		r.shadow is host;
		host.shadow is r;
		# what's shown of it is its shadow tree's now
		host.flags is host.flags | DIRTY_STYLE | DIRTY_LAYOUT;
		call Changed: host DomChange.CHILDREN;
	[end]

	# whether node is a <slot> in a shadow tree
	[IsSlot: ptr<DomNode> node: 0;]
		if node.type is not DomType.ELEMENT or node.tag is not A_SLOT or node.ns is not DomNs.HTML return false;
	[end: (IsShadowRoot: (TreeRoot: node))]

	# what a slot takes and a node is put in by: a slot's name attribute, an element's slot attribute
	[SlotName: ptr<DomNode> node: 0; ptr<WlAtom> name: 0; ptr<u32> length: 0;]
		ptr<DomAttr> a: (Attr: node name);
		if a is 0
			length:0 is 0;
			return 0 as ptr<u8>;
		;;
		length:0 is a.value_len;
	[end: a.value]

	# The slot a shadow host's child is shown in (the first of its shadow tree whose name is the child's
	# slot attribute, or that has no name for text and an element without one), or 0 for none.
	[AssignedSlot: ptr<DomNode> node: 0;]
		ptr<DomNode> host: node.parent;
		if host is 0 or host.type is not DomType.ELEMENT or host.shadow is 0 return 0 as ptr<DomNode>;
		if node.type is not DomType.ELEMENT and node.type is not DomType.TEXT return 0 as ptr<DomNode>;
		u32 want_len: 0;
		ptr<u8> want: 0;
		if node.type is DomType.ELEMENT
			want is (SlotName: node A_SLOT addr want_len);
		;;
		ptr<DomNode> root: host.shadow;
		ptr<DomNode> s: root.first_child;
		while s is not 0
			if s.type is DomType.ELEMENT and s.tag is A_SLOT and s.ns is DomNs.HTML
				u32 have_len: 0;
				ptr<u8> have: (SlotName: s A_NAME addr have_len);
				if have_len is want_len and (have_len is 0 or (Mem.Equal: have want have_len))
					return s;
				;;
			;;
			s is (Next: s root);
		;;
	[end: 0 as ptr<DomNode>]

	# the host's children a slot takes, one after another: SlotNext with 0 gives the first
	[SlotNext: ptr<DomNode> slot: 0; ptr<DomNode> after: 0;]
		ptr<DomNode> root: (TreeRoot: slot);
		if not (IsShadowRoot: root) return 0 as ptr<DomNode>;
		ptr<DomNode> c: root.shadow.first_child;
		if after is not 0
			c is after.next;
		;;
		while c is not 0
			if (AssignedSlot: c) is slot return c;
			c is c.next;
		;;
	[end: 0 as ptr<DomNode>]

	# A node's first child in the flat tree: a shadow host's is its shadow tree's, and a slot's is the
	# first node it takes (or its own first child, if it takes none).
	[FlatFirst: ptr<DomNode> node: 0;]
		if node.type is DomType.ELEMENT
			if node.shadow is not 0 return node.shadow.first_child;
			if node.tag is A_SLOT and (IsSlot: node)
				ptr<DomNode> taken: (SlotNext: node 0);
				if taken is not 0 return taken;
			;;
		;;
	[end: node.first_child]

	# the flat tree's next child of parent after child (child came from FlatFirst or FlatNext of parent)
	[FlatNext: ptr<DomNode> child: 0; ptr<DomNode> parent: 0;]
		if child.parent is not parent and parent.type is DomType.ELEMENT and parent.tag is A_SLOT
			return (SlotNext: parent child);
		;;
	[end: child.next]

	# a node's parent in the flat tree: the slot it's shown in, a shadow tree's top's host
	[FlatParent: ptr<DomNode> node: 0;]
		ptr<DomNode> up: node.parent;
		if up is 0 return 0 as ptr<DomNode>;
		if up.type is DomType.ELEMENT and up.shadow is not 0
			return (AssignedSlot: node);
		;;
		if (IsShadowRoot: up) return up.shadow;
	[end: up]

	[FirstElementChild: ptr<DomNode> node: 0;]
		ptr<DomNode> c: node.first_child;
		while c is not 0
			if c.type is DomType.ELEMENT return c;
			c is c.next;
		;;
	[end: 0 as ptr<DomNode>]

	[NextElement: ptr<DomNode> node: 0;]
		ptr<DomNode> c: node.next;
		while c is not 0
			if c.type is DomType.ELEMENT return c;
			c is c.next;
		;;
	[end: 0 as ptr<DomNode>]

	[PrevElement: ptr<DomNode> node: 0;]
		ptr<DomNode> c: node.prev;
		while c is not 0
			if c.type is DomType.ELEMENT return c;
			c is c.prev;
		;;
	[end: 0 as ptr<DomNode>]

	# <html>, <head> and <body>, by their names: 0 if there isn't one
	[DocumentElement: ptr<DomDocument> doc: 0;]
	[end: (FirstElementChild: doc.root)]

	[ChildNamed: ptr<DomNode> parent: 0; ptr<u8> name: 0;]
		if parent is 0 return 0;
		ptr<WlAtom> atom: (WlAtoms.GetZ: name);
		ptr<DomNode> c: parent.first_child;
		while c is not 0
			if c.type is DomType.ELEMENT and c.tag is atom return c;
			c is c.next;
		;;
	[end: 0 as ptr<DomNode>]

	[Head: ptr<DomDocument> doc: 0;]
	[end: (ChildNamed: (DocumentElement: doc) 'head')]

	[Body: ptr<DomDocument> doc: 0;]
		ptr<DomNode> body: (ChildNamed: (DocumentElement: doc) 'body');
		if body is not 0 return body;
	[end: (ChildNamed: (DocumentElement: doc) 'frameset')]

	# the first element with this id under root (in the tree only), or 0
	[FindById: ptr<DomNode> root: 0; ptr<WlAtom> id: 0;]
		ptr<DomNode> n: root;
		while n is not 0
			if n.type is DomType.ELEMENT and n.id_atom is id return n;
			n is (Next: n root);
		;;
	[end: 0 as ptr<DomNode>]

	# all the text under node, added to output, as textContent reads it
	[TextContent: ptr<DomNode> node: 0; WlBuf output;]
		if node.type is DomType.TEXT or node.type is DomType.CDATA or node.type is DomType.COMMENT
			call output.AddN: node.text node.text_len;
			return;
		;;
		ptr<DomNode> n: node.first_child;
		while n is not 0
			if n.type is DomType.TEXT or n.type is DomType.CDATA
				call output.AddN: n.text n.text_len;
			;;
			n is (Next: n node);
		;;
	[end]

	# ---- attributes

	[Attr: ptr<DomNode> element: 0; ptr<WlAtom> name: 0;]
		ptr<DomAttr> a: element.attrs;
		while a is not 0
			if a.name is name return a;
			a is a.next;
		;;
	[end: 0 as ptr<DomAttr>]

	[AttrZ: ptr<DomNode> element: 0; ptr<u8> name: 0;]
	[end: (Attr: element (WlAtoms.GetZ: name))]

	# its value as zero-terminated text, or 0 if it isn't there
	[AttrValue: ptr<DomNode> element: 0; ptr<u8> name: 0;]
		ptr<DomAttr> a: (AttrZ: element name);
		if a is 0 return 0;
	[end: a.value]

	[SetAttr: ptr<DomNode> element: 0; ptr<WlAtom> name: 0; ptr<u8> value: 0; u32 n: 0;]
		ptr<DomAttr> a: (Attr: element name);
		if element.doc.on_mutation is not 0
			if a is 0
				call element.doc.on_mutation: element ATTRIBUTE 0 as ptr<DomNode> name 0 as ptr<u8> (-1);
			;;
			else
				call element.doc.on_mutation: element ATTRIBUTE 0 as ptr<DomNode> name a.value a.value_len as int;
			;;
			a is (Attr: element name);
		;;
		if a is 0
			a is new DomAttr;
			if a is 0
				throw 'out of memory for an attribute';
			;;
			a.name is name;
			if element.attrs is 0
				element.attrs is a;
			;;
			else
				ptr<DomAttr> last: element.attrs;
				while last.next is not 0
					last is last.next;
				;;
				last.next is a;
			;;
		;;
		ptr<u8> copy: (WlText.Dup: value n);
		if a.value is not 0
			free a.value;
		;;
		a.value is copy;
		a.value_len is n;
		call AttrChanged: element name;
	[end: a]

	[SetAttrZ: ptr<DomNode> element: 0; ptr<u8> name: 0; ptr<u8> value: 0;]
	[end: (SetAttr: element (WlAtoms.GetZ: name) value (WlText.LenZ: value))]

	[RemoveAttr: ptr<DomNode> element: 0; ptr<WlAtom> name: 0;]
		ptr<DomAttr> a: element.attrs;
		ptr<DomAttr> before: 0;
		while a is not 0
			if a.name is name
				if element.doc.on_mutation is not 0
					call element.doc.on_mutation: element ATTRIBUTE 0 as ptr<DomNode> name a.value a.value_len as int;
				;;
				if before is 0
					element.attrs is a.next;
				;;
				else
					before.next is a.next;
				;;
				free a.value;
				free a;
				call AttrChanged: element name;
				return true;
			;;
			before is a;
			a is a.next;
		;;
	[end: false]

	# whether an element has this class (an atom, so compare with WlAtoms.Get)
	[HasClass: ptr<DomNode> element: 0; ptr<WlAtom> name: 0;]
		while u32 i: 0; i < element.class_count; i++;
			if element.classes:i is name return true;
		;;
	[end: false]

	# ---- freeing

	[FreeDocument: ptr<DomDocument> doc: 0;]
		if doc is 0 return;
		ptr<DomNode> n: doc.all;
		while n is not 0
			ptr<DomNode> next_one: n.all_next;
			call FreeNode: n;
			n is next_one;
		;;
		if doc.url is not 0
			free doc.url;
		;;
		free doc;
	[end]

	# ---- inside

	[FreeNode: ptr<DomNode> n: 0;]
		ptr<DomAttr> a: n.attrs;
		while a is not 0
			ptr<DomAttr> next_one: a.next;
			free a.value;
			free a;
			a is next_one;
		;;
		if n.text is not 0
			free n.text;
		;;
		if n.text2 is not 0
			free n.text2;
		;;
		if n.classes is not 0
			free n.classes;
		;;
		free n;
	[end]

	[Changed: ptr<DomNode> node: 0; DomChange what: DomChange.CHILDREN;]
		ptr<DomDocument> doc: node.doc;
		doc.version++;
		if what is DomChange.CHILDREN
			node.flags is node.flags | DIRTY_TREE;
			call MarkUp: node;
			if (IsSheetNode: node)
				doc.sheet_version++;
			;;
		;;
		elif what is DomChange.TEXT and node.parent is not 0
			# :empty can see text come and go
			node.parent.flags is node.parent.flags | DIRTY_TREE;
			call MarkUp: node.parent;
			if (IsSheetNode: node.parent)
				doc.sheet_version++;
			;;
		;;
		else
			call MarkUp: node;
			if (IsSheetNode: node)
				doc.sheet_version++;
			;;
		;;
		if doc.on_change is not 0
			call doc.on_change: node what as int;
		;;
	[end]

	# What changed decides how much CSS does again: everything under the element if a selector about
	# other elements can see it (Dom.REACH_*), otherwise the element itself.
	[AttrChanged: ptr<DomNode> element: 0; ptr<WlAtom> name: 0;]
		ptr<DomDocument> doc: element.doc;
		bln reaches: (doc.css_reach & REACH_ALL) is not 0 or doc.quirks or (name.css & REACH_ATTR) is not 0;
		if name is A_ID
			if element.id_atom is not 0 and (element.id_atom.css & REACH_ID) is not 0
				reaches is true;
			;;
			call RefreshId: element;
			if element.id_atom is not 0 and (element.id_atom.css & REACH_ID) is not 0
				reaches is true;
			;;
		;;
		elif name is A_CLASS
			ptr<ptr<WlAtom>> old: element.classes;
			u32 old_n: element.class_count;
			element.classes is 0;
			call RefreshClasses: element;
			if (ClassesReach: old old_n element.classes element.class_count)
				reaches is true;
			;;
			if old is not 0
				free old;
			;;
		;;
		elif name is not A_STYLE and (doc.css_reach & REACH_ATTRS) is not 0
			reaches is true;
		;;
		if reaches
			element.flags is element.flags | DIRTY_STYLE;
		;;
		else
			element.flags is element.flags | DIRTY_SELF;
		;;
		call Changed: element DomChange.ATTR;
	[end]

	# whether a class that reaches further came or went
	[ClassesReach: ptr<ptr<WlAtom>> a: 0; u32 an: 0; ptr<ptr<WlAtom>> b: 0; u32 bn: 0;]
		while u32 i: 0; i < an; i++;
			if (a:i.css & REACH_CLASS) is not 0 and not (AtomIn: a:i b bn) return true;
		;;
		while u32 j: 0; j < bn; j++;
			if (b:j.css & REACH_CLASS) is not 0 and not (AtomIn: b:j a an) return true;
		;;
	[end: false]

	[AtomIn: ptr<WlAtom> x: 0; ptr<ptr<WlAtom>> list: 0; u32 n: 0;]
		while u32 i: 0; i < n; i++;
			if list:i is x return true;
		;;
	[end: false]

	[RefreshId: ptr<DomNode> element: 0;]
		ptr<DomAttr> a: (Attr: element A_ID);
		if a is 0 or a.value_len is 0
			element.id_atom is 0;
		;;
		else
			element.id_atom is (WlAtoms.Get: a.value a.value_len);
		;;
	[end]

	# the class attribute split at whitespace, as atoms
	[RefreshClasses: ptr<DomNode> element: 0;]
		if element.classes is not 0
			free element.classes;
		;;
		element.classes is 0;
		element.class_count is 0;
		ptr<DomAttr> a: (Attr: element A_CLASS);
		if a is 0 return;
		u32 words: 0;
		bln inside: false;
		while u32 i: 0; i < a.value_len; i++;
			bln space: (WlText.IsSpace: a.value:i);
			if space is false and inside is false
				words++;
			;;
			inside is (space is false);
		;;
		if words is 0 return;
		ptr<ptr<WlAtom>> list: new ptr<WlAtom>[words];
		if list is 0
			throw 'out of memory for classes';
		;;
		u32 pos: 0;
		u32 made: 0;
		while pos < a.value_len
			while pos < a.value_len and (WlText.IsSpace: a.value:pos)
				pos++;
			;;
			u32 start: pos;
			while pos < a.value_len and (WlText.IsSpace: a.value:pos) is false
				pos++;
			;;
			if pos > start
				list:made is (WlAtoms.Get: a.value + start pos - start);
				made++;
			;;
		;;
		element.classes is list;
		element.class_count is made;
	[end]
}
