# The whole library together: a page parsed, its scripts run against the DOM, its styles computed.
use weblib;

phi.TestPage:Program
{
	call Weblib.Start: 900000;
	log '--- normally\n';
	call Round: false;
	log '--- with a collection at every safepoint\n';
	call Round: true;
	log 'done\n';
	exit 0;

	[Round: bln stress: false;]
		PageHost host;
		host.load is addr Load;
		host.logger is addr Print;
		host.navigate is addr Navigate;

		ptr<u8> html: new u8[100];
		int size: (OS.FileSize: 'tests/page/page1.html');
		if size < 0
			log 'no test page\n';
			exit 1;
		;;
		free html;
		html is new u8[size + 1];
		int got: (OS.ReadFile: 'tests/page/page1.html' html size);

		ptr<Page> page: (Page.New: addr host 800.0 600.0);
		if page is 0
			log 'no page\n';
			exit 1;
		;;
		# (every safepoint collects: what bindings hold that the collector can't see is found at once)
		call Js.SetStress: stress;
		the_page is page;
		call Page.Load: page html got as u32 'http://test.example/dir/page.html';
		log 'readyState after load: ' page.load_fired '\n';

		# time passes
		call Page.Tick: page 5.0;
		call Page.Tick: page 100.0;
		call Page.Frame: page 116.0;
		call Page.Tick: page 200.0;

		# the browser clicks a button
		ptr<DomNode> button: (Css.Query: page.doc.root '#go' 3);
		if button is not 0
			log 'click result: ' (Page.Click: page button 10.0 20.0) '\n';
		;;
		ptr<DomNode> link: (Css.Query: page.doc.root 'a.out' 5);
		if link is not 0
			call Page.Click: page link 1.0 1.0;
		;;

		# styles, as a layout engine reads them
		call Page.UpdateStyle: page;
		ptr<DomNode> box: (Css.Query: page.doc.root '#box' 4);
		ptr<CssComputed> s: (Css.StyleOf: box);
		log 'box display ' ((s.Display) as int) ' block ' (s.Is: CssP.DISPLAY CssK.BLOCK) '\n';
		log 'box width ' (s.Width: 800.0 -1.0) ' color ' (s.TextColor) ' font ' (s.FontPx) '\n';
		ptr<DomNode> added: (Css.Query: page.doc.root '#added' 6);
		if added is 0
			log 'the script did not add its element\n';
		;;
		else
			ptr<CssComputed> a: (Css.StyleOf: added);
			log 'added color ' (a.TextColor) ' margin ' (a.MarginTop: 800.0) '\n';
		;;

		# the document as it ended up
		WlBuf out_text;
		call Html.SerializeOuter: page.doc.root out_text true;
		call Html.Serialize: page.doc.root out_text true;
		log 'serialized ' out_text.data '\n';
		call out_text.Free;

		call Page.Free: page;

	[end]

	ptr<Page> the_page: 0;

	[Print: ptr<Page> p: 0; ptr<u8> text: 0; u32 n: 0; int level: 0;]
		log 'console[' level ']: ' text '\n';
	[end]

	[Navigate: ptr<Page> p: 0; ptr<u8> url: 0;]
		log 'navigate to ' url '\n';
	[end]

	# a pretend network: answers at once
	[Load: ptr<Page> p: 0; ptr<u8> url: 0; PageLoad kind: PageLoad.DOCUMENT; u32 id: 0;]
		log 'load ' url ' kind ' (kind as int) '\n';
		if (Ends: url 'lib.js')
			ptr<u8> js: 'console.log("external script ran"); window.fromLib = 42;';
			call Page.Delivered: p id 200 js (WlText.LenZ: js);
			return;
		;;
		if (Ends: url 'site.css')
			ptr<u8> css: 'p.linked { color: rgb(1, 2, 3); }';
			call Page.Delivered: p id 200 css (WlText.LenZ: css);
			return;
		;;
		if (Ends: url 'data.json')
			ptr<u8> data: '{"answer": 7}';
			call Page.Delivered: p id 200 data (WlText.LenZ: data);
			return;
		;;
		call Page.Delivered: p id 404 0 0;
	[end]

	[Ends: ptr<u8> text: 0; ptr<u8> ending: 0;]
		u32 a: (WlText.LenZ: text);
		u32 b: (WlText.LenZ: ending);
		if b > a return false;
	[end: (WlText.EqZ: text + a - b b ending)]
}
