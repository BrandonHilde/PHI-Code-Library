# <color>: names, hex, rgb() hsl() hwb() lab() lch() oklab() oklch() color(), all kept as 8-bit
# sRGB with alpha (0xRRGGBBAA). Colors outside sRGB are clipped: a layout engine and a framebuffer
# have no use for more, but it does mean a wide-gamut color doesn't survive being read back.

use core.text;
use css.tables;
use css.lexer;
use css.values;
use css.calc;
use css.vp;

phi.CssColor:Library
{
	# what the last Part read: its value, and what it was
	f64 pv: 0.0;
	u32 pk: 0;
	const u32 P_NUM: 1;
	const u32 P_PCT: 2;
	const u32 P_ANGLE: 3;
	const u32 P_NONE: 4;

	u32 made: 0;

	# a <color> at the value parser's position
	[ParseValue]
		ptr<CssTok> tk: addr CssVp.t:(CssVp.pos);
		if tk.type is CssLex.IDENT
			u32 kw: (CssVp.Kw: tk);
			if kw is 0 return false;
			if kw is CssK.CURRENTCOLOR
				call CssV.SetKw: (CssVp.Emit) kw;
				call Advance;
				return true;
			;;
			u32 rgba: CssProps.color_of:kw;
			if rgba is 0 and kw is not CssK.TRANSPARENT return false;
			call CssV.SetColor: (CssVp.Emit) rgba;
			call Advance;
			return true;
		;;
		if tk.type is CssLex.HASH
			if (Hex: tk.text tk.len) is false return false;
			call CssV.SetColor: (CssVp.Emit) made;
			call Advance;
			return true;
		;;
		if tk.type is CssLex.FUNCTION
			u32 close: tk.match;
			u32 saved_stop: CssVp.stop;
			u32 fn: CssVp.pos;
			u32 kw: (CssVp.Kw: tk);
			if kw is 0 return false;
			CssVp.stop is close;
			CssVp.pos is fn + 1;
			call CssVp.Skip;
			bln ok: false;
			when kw
				is CssK.RGB CssK.RGBA
					ok is (Rgb);
				;;
				is CssK.HSL CssK.HSLA
					ok is (Hsl);
				;;
				is CssK.HWB
					ok is (Hwb);
				;;
				is CssK.LAB
					ok is (Lab: false);
				;;
				is CssK.OKLAB
					ok is (Lab: true);
				;;
				is CssK.LCH
					ok is (Lch: false);
				;;
				is CssK.OKLCH
					ok is (Lch: true);
				;;
				is CssK.COLOR
					ok is (ColorFn);
				;;
				is CssK.DEVICE_CMYK
					ok is (Cmyk);
				;;
				is CssK.COLOR_MIX
					ok is (Mix);
				;;
				is CssK.LIGHT_DARK
					ok is (LightDark);
				;;
			;;
			if ok and CssVp.pos is not close
				ok is false;
			;;
			CssVp.stop is saved_stop;
			if ok is false
				CssVp.pos is fn;
				return false;
			;;
			CssVp.pos is close + 1;
			if CssVp.pos > saved_stop
				CssVp.pos is saved_stop;
			;;
			call CssVp.Skip;
			call CssV.SetColor: (CssVp.Emit) made;
			return true;
		;;
	[end: false]

	[Advance]
		CssVp.pos++;
		call CssVp.Skip;
	[end]

	[Hex: ptr<u8> p: 0; u32 n: 0;]
		if n is not 3 and n is not 4 and n is not 6 and n is not 8 return false;
		u32 r: 0;
		u32 g: 0;
		u32 b: 0;
		u32 a: 255;
		while u32 i: 0; i < n; i++;
			if (WlText.IsHex: p:i) is false return false;
		;;
		if n <= 4
			r is (WlText.HexValue: p:0) as u32 * 17;
			g is (WlText.HexValue: p:1) as u32 * 17;
			b is (WlText.HexValue: p:2) as u32 * 17;
			if n is 4
				a is (WlText.HexValue: p:3) as u32 * 17;
			;;
		;;
		else
			r is (Pair: p);
			g is (Pair: p + 2);
			b is (Pair: p + 4);
			if n is 8
				a is (Pair: p + 6);
			;;
		;;
		made is (r << 24) | (g << 16) | (b << 8) | a;
	[end: true]

	[Pair: ptr<u8> p: 0;]
	[end: (WlText.HexValue: p:0) as u32 * 16 + (WlText.HexValue: p:1) as u32]

	# Reads one part: a number, percentage, angle (in degrees), or `none`, each of them possibly
	# calc(). allowed is a mask of 1 << P_*.
	[Part: u32 allowed: 0;]
		u32 pos: CssVp.pos;
		if pos >= CssVp.stop return false;
		ptr<CssTok> tk: addr CssVp.t:pos;
		u32 type: tk.type;
		if type is CssLex.NUMBER
			pk is P_NUM;
			pv is tk.num;
		;;
		elif type is CssLex.PERCENTAGE
			pk is P_PCT;
			pv is tk.num;
		;;
		elif type is CssLex.DIMENSION
			u32 unit: (CssProps.UnitOfKw: (CssVp.Kw: tk));
			if unit is 0 or (CssCalc.MaskOfUnit: unit) is not CssCalc.M_ANGLE return false;
			pk is P_ANGLE;
			pv is tk.num * (CssCalc.ToCanon: unit);
		;;
		elif type is CssLex.IDENT
			if (CssVp.Kw: tk) is not CssK.NONE return false;
			pk is P_NONE;
			pv is 0.0;
		;;
		elif type is CssLex.FUNCTION and (CssCalc.IsMathFunc: (CssVp.Kw: tk))
			u32 close: tk.match;
			u32 mask: 0;
			if (allowed & (1 << P_NUM)) is not 0
				mask is mask | CssCalc.M_NUM;
			;;
			if (allowed & (1 << P_PCT)) is not 0
				mask is mask | CssCalc.M_PCT;
			;;
			if (allowed & (1 << P_ANGLE)) is not 0
				mask is mask | CssCalc.M_ANGLE;
			;;
			if (CssCalc.Parse: CssVp.t pos mask) is false return false;
			u32 k: CssCalc.result.kind;
			if k is CssV.NUM
				pk is P_NUM;
				pv is (CssCalc.result.Num);
			;;
			elif k is CssV.PCT
				pk is P_PCT;
				pv is (CssCalc.result.Num);
			;;
			elif k is CssV.ANGLE
				pk is P_ANGLE;
				pv is (CssCalc.result.Num);
			;;
			else
				call CssV.Release: addr CssCalc.result;
				return false;
			;;
			if (allowed & (1 << pk)) is 0 return false;
			CssVp.pos is close;
			call Advance;
			return true;
		;;
		else
			return false;
		;;
		if (allowed & (1 << pk)) is 0 return false;
		call Advance;
	[end: true]

	# a comma, if there is one
	[Comma]
		if CssVp.pos < CssVp.stop and CssVp.t:(CssVp.pos).type is CssLex.COMMA
			call Advance;
			return true;
		;;
	[end: false]

	[Slash]
		if CssVp.pos < CssVp.stop and CssVp.t:(CssVp.pos).type is CssLex.DELIM and CssVp.t:(CssVp.pos).num is 47.0
			call Advance;
			return true;
		;;
	[end: false]

	# [ / alpha ], or for the old syntax , alpha. Leaves it from 0 to 1 in alpha.
	f64 alpha: 1.0;

	[AlphaAfter: bln legacy: false;]
		alpha is 1.0;
		if legacy
			if (Comma) is false return true;
		;;
		elif (Slash) is false
			return true;
		;;
		u32 allowed: (1 << P_NUM) | (1 << P_PCT);
		if legacy is false
			allowed is allowed | (1 << P_NONE);
		;;
		if (Part: allowed) is false return false;
		if pk is P_PCT
			alpha is pv / 100.0;
		;;
		elif pk is P_NONE
			alpha is 0.0;
		;;
		else
			alpha is pv;
		;;
		if alpha < 0.0
			alpha is 0.0;
		;;
		if alpha > 1.0
			alpha is 1.0;
		;;
	[end: true]

	[To8: f64 v: 0.0;]
		if v is not v
			return 0;
		;;
		if v <= 0.0 return 0;
		if v >= 255.0 return 255;
		# halves round up
		f64 r: v + 0.5;
	[end: r as int]

	[Make: f64 r: 0.0; f64 g: 0.0; f64 b: 0.0;]
		u32 a8: (To8: alpha * 255.0) as u32;
		made is ((To8: r) as u32 << 24) | ((To8: g) as u32 << 16) | ((To8: b) as u32 << 8) | a8;
	[end]

	[Rgb]
		u32 lead: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if (Part: lead) is false return false;
		u32 k0: pk;
		f64 c0: pv;
		bln legacy: (Comma);
		if legacy and k0 is P_NONE return false;
		u32 allowed: lead;
		if legacy
			# the old syntax's parts are all numbers or all percentages
			allowed is 1 << k0;
		;;
		if (Part: allowed) is false return false;
		f64 c1: pv;
		u32 k1: pk;
		if legacy and (Comma) is false return false;
		if (Part: allowed) is false return false;
		f64 c2: pv;
		u32 k2: pk;
		if (AlphaAfter: legacy) is false return false;
		call Make: (Chan: c0 k0) (Chan: c1 k1) (Chan: c2 k2);
	[end: true]

	[Chan: f64 v: 0.0; u32 kind: 0;]
		if kind is P_PCT return v * 255.0 / 100.0;
	[end: v]

	[Hue: f64 h: 0.0;]
		# to 0..360
		h is h % 360.0;
		if h < 0.0
			h is h + 360.0;
		;;
	[end: h]

	[Hsl]
		u32 hue_ok: (1 << P_NUM) | (1 << P_ANGLE) | (1 << P_NONE);
		if (Part: hue_ok) is false return false;
		f64 h: pv;
		u32 hk: pk;
		bln legacy: (Comma);
		if legacy and hk is P_NONE return false;
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if legacy
			allowed is 1 << P_PCT;
		;;
		if (Part: allowed) is false return false;
		f64 s: pv;
		if legacy and (Comma) is false return false;
		if (Part: allowed) is false return false;
		f64 l: pv;
		if (AlphaAfter: legacy) is false return false;
		call FromHsl: h s l;
	[end: true]

	# h in degrees, s and l in percent
	[FromHsl: f64 h: 0.0; f64 s: 0.0; f64 l: 0.0;]
		h is (Hue: h);
		if s < 0.0
			s is 0.0;
		;;
		if s > 100.0
			s is 100.0;
		;;
		if l < 0.0
			l is 0.0;
		;;
		if l > 100.0
			l is 100.0;
		;;
		s is s / 100.0;
		l is l / 100.0;
		f64 smaller: l;
		if 1.0 - l < smaller
			smaller is 1.0 - l;
		;;
		f64 a: s * smaller;
		call Make: (HslF: 0.0 h l a) * 255.0 (HslF: 8.0 h l a) * 255.0 (HslF: 4.0 h l a) * 255.0;
	[end]

	[HslF: f64 n: 0.0; f64 h: 0.0; f64 l: 0.0; f64 a: 0.0;]
		f64 k: (n + h / 30.0) % 12.0;
		f64 m: k - 3.0;
		if 9.0 - k < m
			m is 9.0 - k;
		;;
		if m > 1.0
			m is 1.0;
		;;
		if m < -1.0
			m is -1.0;
		;;
	[end: l - a * m]

	[Hwb]
		u32 hue_ok: (1 << P_NUM) | (1 << P_ANGLE) | (1 << P_NONE);
		if (Part: hue_ok) is false return false;
		f64 h: pv;
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if (Part: allowed) is false return false;
		f64 w: pv;
		if (Part: allowed) is false return false;
		f64 k: pv;
		if (AlphaAfter: false) is false return false;
		if w < 0.0
			w is 0.0;
		;;
		if k < 0.0
			k is 0.0;
		;;
		w is w / 100.0;
		k is k / 100.0;
		if w + k >= 1.0
			f64 gray: w / (w + k) * 255.0;
			call Make: gray gray gray;
			return true;
		;;
		h is (Hue: h);
		call MakeHwbPart: h w k;
	[end: true]

	[MakeHwbPart: f64 h: 0.0; f64 w: 0.0; f64 k: 0.0;]
		f64 scale: 1.0 - w - k;
		f64 r: (HslF: 0.0 h 0.5 0.5);
		f64 g: (HslF: 8.0 h 0.5 0.5);
		f64 b: (HslF: 4.0 h 0.5 0.5);
		call Make: (r * scale + w) * 255.0 (g * scale + w) * 255.0 (b * scale + w) * 255.0;
	[end]

	# lab(L a b / alpha), or with ok, oklab(): L 0..100 or 0..1, a and b scaled by 125 or 0.4
	[Lab: bln ok: false;]
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if (Part: allowed) is false return false;
		f64 l: (Scaled: 100.0 1.0 ok);
		if (Part: allowed) is false return false;
		f64 a: (Scaled: 125.0 0.4 ok);
		if (Part: allowed) is false return false;
		f64 b: (Scaled: 125.0 0.4 ok);
		if (AlphaAfter: false) is false return false;
		if ok
			call FromOklab: l a b;
		;;
		else
			call FromLab: l a b;
		;;
	[end: true]

	# the part just read, taking a percentage as a share of full (for lab) or okfull (for oklab)
	[Scaled: f64 full: 0.0; f64 okfull: 0.0; bln ok: false;]
		if pk is P_PCT
			if ok return pv / 100.0 * okfull;
			return pv / 100.0 * full;
		;;
	[end: pv]

	[Lch: bln ok: false;]
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if (Part: allowed) is false return false;
		f64 l: (Scaled: 100.0 1.0 ok);
		if (Part: allowed) is false return false;
		f64 c: (Scaled: 150.0 0.4 ok);
		if (Part: (1 << P_NUM) | (1 << P_ANGLE) | (1 << P_NONE)) is false return false;
		f64 h: pv;
		if (AlphaAfter: false) is false return false;
		if c < 0.0
			c is 0.0;
		;;
		f64 radians: h * 0.017453292519943295;
		f64 a: c * (Float.Cos: radians);
		f64 b: c * (Float.Sin: radians);
		if ok
			call FromOklab: l a b;
		;;
		else
			call FromLab: l a b;
		;;
	[end: true]

	[FromLab: f64 l: 0.0; f64 a: 0.0; f64 b: 0.0;]
		f64 fy: (l + 16.0) / 116.0;
		f64 fx: fy + a / 500.0;
		f64 fz: fy - b / 200.0;
		# to XYZ with a D50 white
		f64 x: (LabInv: fx) * 0.9642956764295677;
		f64 y: (LabInv: fy);
		f64 z: (LabInv: fz) * 0.8251046025104602;
		# Bradford to D65
		f64 x2: x * 0.9554734527042182 + y * -0.023098536874261423 + z * 0.0632593086610217;
		f64 y2: x * -0.028369706963208136 + y * 1.0099954580058226 + z * 0.021041398966943008;
		f64 z2: x * 0.012314001688319899 + y * -0.020507696433477912 + z * 1.3303659366080753;
		call FromXyz: x2 y2 z2;
	[end]

	[LabInv: f64 f: 0.0;]
		if f > 0.20689655172413793 return f * f * f;
	[end: (116.0 * f - 16.0) / 903.2962962962963]

	[FromXyz: f64 x: 0.0; f64 y: 0.0; f64 z: 0.0;]
		call FromLinear: x * 3.2409699419045226 + y * -1.537383177570094 + z * -0.4986107602930034
			x * -0.9692436362808796 + y * 1.8759675015077202 + z * 0.04155505740717559
			x * 0.05563007969699366 + y * -0.20397695888897652 + z * 1.0569715142428786;
	[end]

	[FromOklab: f64 l: 0.0; f64 a: 0.0; f64 b: 0.0;]
		f64 lm: l + a * 0.3963377773761749 + b * 0.2158037573099136;
		f64 mm: l + a * -0.1055613458156586 + b * -0.0638541728258133;
		f64 sm: l + a * -0.0894841775298119 + b * -1.2914855480194092;
		f64 lc: lm * lm * lm;
		f64 mc: mm * mm * mm;
		f64 sc: sm * sm * sm;
		call FromLinear: lc * 4.0767416621 + mc * -3.3077115913 + sc * 0.2309699292
			lc * -1.2684380046 + mc * 2.6097574011 + sc * -0.3413193965
			lc * -0.0041960863 + mc * -0.7034186147 + sc * 1.707614701;
	[end]

	[FromLinear: f64 r: 0.0; f64 g: 0.0; f64 b: 0.0;]
		call Make: (Gamma: r) * 255.0 (Gamma: g) * 255.0 (Gamma: b) * 255.0;
	[end]

	# linear light to sRGB's curve: x^(1/2.4) is the twelfth root of x^5
	[Gamma: f64 x: 0.0;]
		if x <= 0.0031308
			return x * 12.92;
		;;
		if x >= 1.0 return 1.0;
		f64 five: x * x * x * x * x;
		f64 root: (Float.Sqrt: (Float.Sqrt: (Cbrt: five)));
	[end: 1.055 * root - 0.055]

	[Cbrt: f64 x: 0.0;]
		if x <= 0.0 return 0.0;
		f64 g: x;
		if g < 1.0
			g is 1.0;
		;;
		while int i: 0; i < 60; i++;
			f64 next_g: (2.0 * g + x / (g * g)) / 3.0;
			f64 change: next_g - g;
			g is next_g;
			if change < 1e-14 and change > -1e-14 break;
		;;
	[end: g]

	# color(space a b c / alpha): sRGB-like spaces taken as they are, others converted roughly
	[ColorFn]
		if CssVp.pos >= CssVp.stop or CssVp.t:(CssVp.pos).type is not CssLex.IDENT return false;
		u32 space: (CssVp.Kw: addr CssVp.t:(CssVp.pos));
		bln known: space is CssK.SRGB or space is CssK.SRGB_LINEAR or space is CssK.DISPLAY_P3 or space is CssK.A98_RGB or space is CssK.PROPHOTO_RGB or space is CssK.REC2020 or space is CssK.XYZ or space is CssK.XYZ_D50 or space is CssK.XYZ_D65;
		if known is false return false;
		call Advance;
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		bln xyz: space is CssK.XYZ or space is CssK.XYZ_D50 or space is CssK.XYZ_D65;
		if (Part: allowed) is false return false;
		f64 c0: (Unit01);
		if (Part: allowed) is false return false;
		f64 c1: (Unit01);
		if (Part: allowed) is false return false;
		f64 c2: (Unit01);
		if (AlphaAfter: false) is false return false;
		if space is CssK.SRGB_LINEAR
			call FromLinear: c0 c1 c2;
		;;
		elif xyz
			call FromXyz: c0 c1 c2;
		;;
		else
			call Make: c0 * 255.0 c1 * 255.0 c2 * 255.0;
		;;
	[end: true]

	[Unit01]
		if pk is P_PCT return pv / 100.0;
	[end: pv]

	# light-dark(a, b): this library has no notion of a used color scheme yet, so it's the light one
	[LightDark]
		u32 mark: CssVp.vn;
		if (ParseValue) is false
			call CssVp.Cut: mark;
			return false;
		;;
		bln first_ok: CssVp.vals:mark.kind is CssV.COLOR as u8;
		u32 first: CssVp.vals:mark.bits;
		if (Comma) is false or (ParseValue) is false
			call CssVp.Cut: mark;
			return false;
		;;
		call CssVp.Cut: mark;
		if first_ok is false return false;
		made is first;
	[end: true]

	[Cmyk]
		u32 allowed: (1 << P_NUM) | (1 << P_PCT) | (1 << P_NONE);
		if (Part: allowed) is false return false;
		f64 c: (Unit01);
		u32 first_kind: pk;
		bln legacy: (Comma);
		if legacy
			# the old syntax is plain numbers, all of them
			if first_kind is not P_NUM return false;
			allowed is 1 << P_NUM;
		;;
		if (Part: allowed) is false return false;
		f64 m: (Unit01);
		if legacy and (Comma) is false return false;
		if (Part: allowed) is false return false;
		f64 y: (Unit01);
		if legacy and (Comma) is false return false;
		if (Part: allowed) is false return false;
		f64 k: (Unit01);
		if (AlphaAfter: legacy) is false return false;
		call Make: (1.0 - c) * (1.0 - k) * 255.0 (1.0 - m) * (1.0 - k) * 255.0 (1.0 - y) * (1.0 - k) * 255.0;
	[end: true]

	# color-mix(in space, a p%, b q%): mixed in sRGB whatever the space says
	[Mix]
		if CssVp.pos >= CssVp.stop or CssVp.t:(CssVp.pos).type is not CssLex.IDENT or (CssVp.Kw: addr CssVp.t:(CssVp.pos)) is not CssK.IN return false;
		call Advance;
		if CssVp.pos >= CssVp.stop or CssVp.t:(CssVp.pos).type is not CssLex.IDENT return false;
		call Advance;
		while CssVp.pos < CssVp.stop and CssVp.t:(CssVp.pos).type is CssLex.IDENT
			call Advance;
		;;
		if (Comma) is false return false;
		u32 mark: CssVp.vn;
		f64 p0: -1.0;
		f64 p1: -1.0;
		if (Part: 1 << P_PCT)
			p0 is pv;
		;;
		if (ParseValue) is false
			call CssVp.Cut: mark;
			return false;
		;;
		u32 first: CssVp.vals:mark.bits;
		bln first_is_color: CssVp.vals:mark.kind is CssV.COLOR as u8;
		if p0 < 0.0 and (Part: 1 << P_PCT)
			p0 is pv;
		;;
		if (Comma) is false
			call CssVp.Cut: mark;
			return false;
		;;
		if (Part: 1 << P_PCT)
			p1 is pv;
		;;
		if (ParseValue) is false
			call CssVp.Cut: mark;
			return false;
		;;
		u32 second: CssVp.vals:(mark + 1).bits;
		bln second_is_color: CssVp.vals:(mark + 1).kind is CssV.COLOR as u8;
		if p1 < 0.0 and (Part: 1 << P_PCT)
			p1 is pv;
		;;
		call CssVp.Cut: mark;
		if first_is_color is false or second_is_color is false return false;
		if p0 < 0.0 and p1 < 0.0
			p0 is 50.0;
			p1 is 50.0;
		;;
		elif p0 < 0.0
			p0 is 100.0 - p1;
		;;
		elif p1 < 0.0
			p1 is 100.0 - p0;
		;;
		f64 sum: p0 + p1;
		if sum <= 0.0 return false;
		f64 w0: p0 / sum;
		f64 w1: p1 / sum;
		alpha is (w0 * (first & 255) + w1 * (second & 255)) / 255.0;
		call Make: w0 * (first >> 24) + w1 * (second >> 24) w0 * ((first >> 16) & 255) + w1 * ((second >> 16) & 255) w0 * ((first >> 8) & 255) + w1 * ((second >> 8) & 255);
	[end: true]

	# ---- from text, for tests and browsers: true and the color in made, or false

	[FromText: ptr<u8> text: 0; u32 n: 0;]
		call CssProps.Start;
		ptr<CssToks> ts: (CssLex.Run: text n);
		ptr<CssTok> saved_t: CssVp.t;
		u32 saved_pos: CssVp.pos;
		u32 saved_stop: CssVp.stop;
		CssVp.t is ts.t;
		CssVp.pos is 0;
		CssVp.stop is ts.n;
		call CssVp.Skip;
		bln ok: false;
		u32 mark: CssVp.vn;
		if CssVp.pos < CssVp.stop
			if call ok is ParseValue throws err
				ok is false;
			;;
		;;
		if ok and CssVp.pos is not CssVp.stop
			ok is false;
		;;
		if ok
			if CssVp.vals:mark.kind is CssV.COLOR as u8
				made is CssVp.vals:mark.bits;
			;;
			else
				ok is false;
				if CssVp.vals:mark.code is CssK.CURRENTCOLOR as u16
					made is 0;
					current_color is true;
				;;
			;;
		;;
		call CssVp.Cut: mark;
		CssVp.t is saved_t;
		CssVp.pos is saved_pos;
		CssVp.stop is saved_stop;
		call CssLex.Free: ts;
	[end: ok]

	bln current_color: false;
}
