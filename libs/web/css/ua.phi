# The built-in stylesheet: the defaults from the HTML standard's Rendering section.

phi.CssUa:Library
{
	[Text]
		ptr<u8> text: 'html, address, blockquote, body, center, dialog, div, figure, figcaption, footer, form, header, hr,
legend, listing, main, p, plaintext, pre, search, xmp, article, aside, h1, h2, h3, h4, h5, h6, hgroup,
nav, section, details, summary, fieldset, dir, dd, dl, dt, menu, ol, ul, optgroup, option { display: block; }
area, base, basefont, datalist, head, link, meta, noembed, noframes, param, rp, script, style, template, title { display: none; }
[hidden], input[type=hidden i] { display: none; }
li { display: list-item; }
summary { display: list-item; }
slot { display: contents; }
ruby { display: ruby; }
rt { display: ruby-text; }
noscript { display: none; }
img, video, canvas, audio, iframe, embed, object, select, button, input, textarea, meter, progress { display: inline-block; }
html { color: canvastext; font-family: serif; font-size: 16px; }
body { margin: 8px; }
address, blockquote, center, dialog, div, figure, figcaption, footer, form, header, hr, legend, listing,
main, p, plaintext, pre, search, xmp { unicode-bidi: isolate; }
pre, listing, plaintext, xmp { font-family: monospace; white-space: pre; margin-top: 1em; margin-bottom: 1em; }
dialog:not([open]) { display: none; }
dialog { position: absolute; left: 0; right: 0; width: fit-content; height: fit-content; margin: auto; border: solid; padding: 1em; background-color: canvas; color: canvastext; }
slot { unicode-bidi: isolate; }
blockquote, figure { margin: 1em 40px; }
p, dl, multicol { margin-top: 1em; margin-bottom: 1em; }
dir, dd, dl, dt, menu, ol, ul { display: block; }
li { text-align: match-parent; }
dir, menu, ol, ul { margin-top: 1em; margin-bottom: 1em; padding-left: 40px; }
dir dir, dir menu, dir ol, dir ul, menu dir, menu menu, menu ol, menu ul, ol dir, ol menu, ol ol, ol ul, ul dir, ul menu, ul ol, ul ul { margin-top: 0; margin-bottom: 0; }
dd { margin-left: 40px; }
ol { list-style-type: decimal; }
ul, dir, menu { list-style-type: disc; }
dir ul, menu ul, ol ul, ul ul, dir dir, menu dir, ol dir, ul dir, dir menu, menu menu, ol menu, ul menu { list-style-type: circle; }
dir dir ul, dir menu ul, dir ol ul, dir ul ul, menu dir ul, menu menu ul, menu ol ul, menu ul ul, ol dir ul, ol menu ul, ol ol ul, ol ul ul, ul dir ul, ul menu ul, ul ol ul, ul ul ul { list-style-type: square; }
ol[type="1"], li[type="1"] { list-style-type: decimal; }
ol[type=a s], li[type=a s] { list-style-type: lower-alpha; }
ol[type=A s], li[type=A s] { list-style-type: upper-alpha; }
ol[type=i s], li[type=i s] { list-style-type: lower-roman; }
ol[type=I s], li[type=I s] { list-style-type: upper-roman; }
ul[type=none i], li[type=none i] { list-style-type: none; }
ul[type=disc i], li[type=disc i] { list-style-type: disc; }
ul[type=circle i], li[type=circle i] { list-style-type: circle; }
ul[type=square i], li[type=square i] { list-style-type: square; }
table { display: table; border-spacing: 2px; border-collapse: separate; text-indent: initial; box-sizing: border-box; border-color: gray; }
caption { display: table-caption; text-align: center; }
colgroup { display: table-column-group; }
col { display: table-column; }
thead { display: table-header-group; vertical-align: middle; border-color: inherit; }
tbody { display: table-row-group; vertical-align: middle; border-color: inherit; }
tfoot { display: table-footer-group; vertical-align: middle; border-color: inherit; }
tr { display: table-row; vertical-align: inherit; border-color: inherit; }
td, th { display: table-cell; vertical-align: inherit; padding: 1px; }
th { font-weight: bold; text-align: -webkit-center; }
table[border], table[rules] { border-style: outset; }
table[border] > tr > td, table[border] > tr > th, table[border] > tbody > tr > td, table[border] > tbody > tr > th, table[border] > thead > tr > td, table[border] > thead > tr > th, table[border] > tfoot > tr > td, table[border] > tfoot > tr > th { border-width: 1px; border-style: inset; }
table[frame=void i] { border-style: hidden; }
input, select, button, textarea { letter-spacing: initial; word-spacing: initial; line-height: initial; text-transform: initial; text-indent: initial; text-shadow: initial; appearance: auto; }
input, select, textarea { text-align: initial; }
input, button, select, textarea { font: 13.3333px sans-serif; color: fieldtext; }
input:is([type=radio i], [type=checkbox i], [type=reset i], [type=button i], [type=submit i], [type=color i], [type=search i]), select, button { box-sizing: border-box; }
textarea { white-space: pre-wrap; }
input, textarea { background-color: field; border: 2px inset gray; padding: 1px 2px; }
button, input:is([type=button i], [type=submit i], [type=reset i]) { text-align: center; background-color: buttonface; color: buttontext; border: 2px outset gray; padding: 1px 6px; cursor: default; }
select { background-color: field; border: 1px solid gray; }
marquee { display: inline-block; text-align: initial; overflow: hidden; }
meter { appearance: auto; }
progress { appearance: auto; }
hr { color: gray; border-style: inset; border-width: 1px; margin: 0.5em auto; overflow: hidden; }
fieldset { display: block; margin-left: 2px; margin-right: 2px; border: groove 2px threedface; padding: 0.35em 0.75em 0.625em; min-width: min-content; }
legend { padding-left: 2px; padding-right: 2px; }
h1 { margin-top: 0.67em; margin-bottom: 0.67em; font-size: 2em; font-weight: bold; }
h2 { margin-top: 0.83em; margin-bottom: 0.83em; font-size: 1.5em; font-weight: bold; }
h3 { margin-top: 1em; margin-bottom: 1em; font-size: 1.17em; font-weight: bold; }
h4 { margin-top: 1.33em; margin-bottom: 1.33em; font-size: 1em; font-weight: bold; }
h5 { margin-top: 1.67em; margin-bottom: 1.67em; font-size: 0.83em; font-weight: bold; }
h6 { margin-top: 2.33em; margin-bottom: 2.33em; font-size: 0.67em; font-weight: bold; }
:is(article, aside, nav, section) h1 { margin-top: 0.83em; margin-bottom: 0.83em; font-size: 1.5em; }
:is(article, aside, nav, section) :is(article, aside, nav, section) h1 { margin-top: 1em; margin-bottom: 1em; font-size: 1.17em; }
cite, dfn, em, i, var, address { font-style: italic; }
b, strong { font-weight: bolder; }
code, kbd, samp, tt { font-family: monospace; }
big { font-size: larger; }
small { font-size: smaller; }
sub { vertical-align: sub; font-size: smaller; }
sup { vertical-align: super; font-size: smaller; }
sub, sup { line-height: normal; }
u, ins { text-decoration: underline; }
s, strike, del { text-decoration: line-through; }
abbr[title], acronym[title] { text-decoration: dotted underline; }
nobr { white-space: nowrap; }
wbr { display: inline; }
center { text-align: center; }
mark { background-color: mark; color: marktext; }
q::before { content: open-quote; }
q::after { content: close-quote; }
rt { font-size: 50%; }
bdi, output { unicode-bidi: isolate; }
bdo, bdo[dir] { unicode-bidi: isolate-override; }
[dir=ltr i] { direction: ltr; }
[dir=rtl i] { direction: rtl; }
a:link { color: linktext; text-decoration: underline; cursor: pointer; }
a:visited { color: visitedtext; text-decoration: underline; cursor: pointer; }
a:any-link:active { color: activetext; }
:focus-visible { outline: auto; }
img { overflow: clip; }
video { object-fit: contain; }
iframe { border: 2px inset gray; }
details > summary:first-of-type { list-style-type: disclosure-closed; }
details[open] > summary:first-of-type { list-style-type: disclosure-open; }
@page { margin: 0.75in; }';
	[end: text]
}
