# The crash fuzzer for BMP, shared by test_bmp_fuzz (a short run, every day) and release_bmp_fuzz
# (the full run, for release). What it does, as its own comment had it:
# Reading damaged BMP files, in bulk: good files changed at random with a fixed seed, every value of
# every byte of the headers of several, numbers that cause trouble put in header fields, and bytes
# that are nothing at all. Every one must come back, as an image within the limit or a reason: a
# crash or a hang fails the test. (Whether imagelib is right about each is test_bmp's job: its fuzz
# cases are checked against the rules.)
# This is test code, which imagelib.phi doesn't use, so it's no part of the library.
use imagelib;
use memory.mem;

phi.ImgFuzzBmp:Library
{
	u32 seed: 0x2545F491;
	u32 read: 0;
	u32 refused: 0;
	u32 too_big: 0;
	u32 bases_count: 0;
	ptr<u8> base_data[512];
	u32 base_len[512];
	const u32 WORK_SIZE: 70000;
	# rounds random changes; files of every value of their header bytes, and of troublesome
	# numbers; noise rounds (or, for BMP, the longest noise); the starting files from cases_path
	[Run: u32 rounds: 0; u32 files: 0; u32 noise: 0; str cases_path;]

		# the starting points: BMP Suite files of each kind, and the good small files made for test_bmp
		str suite: 'g/pal1.bmp' 'q/pal2.bmp' 'g/pal4.bmp' 'g/pal4rle.bmp' 'g/pal8.bmp' 'g/pal8rle.bmp'
			'g/pal8os2.bmp' 'q/pal8os2v2-16.bmp' 'q/pal8os2v2.bmp' 'g/pal8v5.bmp' 'g/rgb16-565.bmp'
			'g/rgb24.bmp' 'g/rgb32bf.bmp' 'q/rgb32h52.bmp' 'q/rgba32h56.bmp' 'q/rgba32abf.bmp'
			'q/rgba16-4444.bmp' 'q/pal8rletrns.bmp' 'q/pal4rlecut.bmp' 'b/badrle4bis.bmp';
		while u32 s: 0; s < suite.len; s++;
			u32 size: 0;
			str path: ('tests/bmp/bmpsuite/' suite:s);
			base_data:bases_count is (Load: path addr size);
			base_len:bases_count is size;
			call Fits: path size;
			bases_count++;
		;;
		u32 cases_size: 0;
		ptr<u8> cases_bytes: (Load: cases_path addr cases_size);
		CoreReader r;
		call r.Start: cases_bytes cases_size;
		u32 count: (r.U32LE);
		while u32 i: 0; i < count; i++;
			u32 group: (r.U8);
			u32 kind: (r.U8);
			call r.Skip: (r.U8);
			u32 most: (r.U32LE);
			ptr<u8> bytes: 0;
			u32 length: 0;
			when kind
				is 0
					call r.Skip: (r.U8);
				;;
				is 1
					length is (r.U32LE);
					bytes is (r.Bytes: length);
				;;
				is 2
					call r.Skip: 8;
				;;
				else
					call r.Skip: 4;
					call r.Skip: (r.U16LE) * 5;
				;;
			;;
			bln ok: ((r.U8) is 1);
			if ok
				call r.Skip: 12;
			;;
			else
				call r.Skip: (r.U8);
			;;
			if group is 1 and kind is 1 and ok and most is 0 and length > 0 and length <= 2000 and bases_count < 512
				base_data:bases_count is bytes;
				base_len:bases_count is length;
				bases_count++;
			;;
		;;
		if r.failed
			log cases_path ' is damaged\n';
			exit 1;
		;;
		log 'files to change: ' bases_count '\n';

		ptr<u8> work: new u8[WORK_SIZE];

		# changed at random: a few bits, a byte, a header field, cut short, a byte put in or taken out
		while u32 n: 0; n < rounds; n++;
			u32 which: (Next) % bases_count;
			u32 len: base_len:which;
			call Mem.Copy: work base_data:which len;
			u32 how: (Next) % 6;
			if how is 0
				u32 flips: 1 + (Next) % 3;
				while u32 f: 0; f < flips; f++;
					u32 at_byte: (Next) % len;
					work:at_byte is (work:at_byte ^ (1 << ((Next) % 8))) as u8;
				;;
			;;
			elif how is 1
				work:((Next) % len) is ((Next) & 255) as u8;
			;;
			elif how is 2
				call Field: work len (Next) % 70;
			;;
			elif how is 3
				len is (Next) % len;
			;;
			elif how is 4
				u32 at_byte: (Next) % len;
				call Mem.Move: work + at_byte + 1 work + at_byte len - at_byte;
				work:at_byte is ((Next) & 255) as u8;
				len++;
			;;
			else
				u32 at_byte: (Next) % len;
				call Mem.Move: work + at_byte work + at_byte + 1 len - at_byte - 1;
				len--;
			;;
			# a quarter of them with a limit they may well reach
			Img.max_pixels is 0;
			if (n & 3) is 0
				Img.max_pixels is 500;
			;;
			call Try: work len;
		;;
		Img.max_pixels is 0;
		log 'changed at random: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

		# every value of every byte of the headers (and a little past), of files of each header size
		read is 0;
		refused is 0;
		too_big is 0;
		str starts: 'g/pal8os2.bmp' 'q/pal8os2v2-16.bmp' 'g/pal8.bmp' 'g/pal4rle.bmp' 'q/rgb32h52.bmp'
			'q/rgba32h56.bmp' 'q/pal8os2v2.bmp' 'g/pal8v4.bmp' 'g/pal8v5.bmp' 'g/rgb16-565.bmp';
		ptr<u8> start_data[10];
		u32 start_len[10];
		while u32 s: 0; s < starts.len and s < files; s++;
			str path: ('tests/bmp/bmpsuite/' starts:s);
			u32 size: 0;
			start_data:s is (Load: path addr size);
			start_len:s is size;
			call Fits: path size;
		;;
		while u32 s: 0; s < starts.len and s < files; s++;
			u32 len: start_len:s;
			ptr<u8> base: start_data:s;
			u32 top: 160;
			if top > len
				top is len;
			;;
			while u32 at_byte: 0; at_byte < top; at_byte++;
				while u32 v: 0; v < 256; v++;
					call Mem.Copy: work base len;
					work:at_byte is v as u8;
					call Try: work len;
				;;
			;;
		;;
		log 'every byte of the headers: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

		# numbers that cause trouble in every 32-bit field of a header
		read is 0;
		refused is 0;
		too_big is 0;
		u32 troubles: 0 1 2 3 4 0x7F 0x80 0xFF 0x100 0xFFFF 0x10000 0x7FFFFFFF 0x80000000 0x80000001
			0xFFFFFFFE 0xFFFFFFFF 14 40 54 124 1078;
		while u32 s: 0; s < starts.len and s < files; s++;
			u32 len: start_len:s;
			ptr<u8> base: start_data:s;
			while u32 at_byte: 2; at_byte + 4 <= 70 and at_byte + 4 <= len; at_byte++;
				while u32 t: 0; t < troubles.len; t++;
					call Mem.Copy: work base len;
					call Put: work at_byte troubles:t;
					call Try: work len;
				;;
			;;
		;;
		log 'troublesome numbers: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

		# nothing but noise, of every length up to 300, some of it after a header that passes
		read is 0;
		refused is 0;
		too_big is 0;
		u32 sizes: 12 16 40 52 56 64 108 124;
		u8 depths: 1 2 4 8 16 24 32;
		while u32 len: 0; len <= noise; len++;
			while u32 k: 0; k < 10; k++;
				while u32 j: 0; j < len; j++;
					work:j is ((Next) & 255) as u8;
				;;
				if len >= 2
					work:0 is 'B';
					work:1 is 'M';
				;;
				if k < 8 and len >= 18
					call Put: work 14 sizes:k;
				;;
				if k >= 2 and k < 6 and len >= 34
					# a small image of a depth there is, so the noise gets to the pixels
					u32 hs: sizes:k;
					call Put: work 10 14 + hs + (Next) % 64;
					call Put: work 18 1 + (Next) % 6;
					call Put: work 22 1 + (Next) % 6;
					work:28 is depths:((Next) % 7);
					work:29 is 0;
					if hs >= 20
						call Put: work 30 0;
						if k is 5
							call Put: work 30 (Next) % 4;
						;;
					;;
				;;
				call Try: work len;
			;;
		;;
		log 'noise: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';
		free work;
		log 'done\n';
		exit 0;
	[end]

	[Try: ptr<u8> data: 0; u32 len: 0;]
		ptr<ImgImage> image: (Img.Decode: data len);
		if image is not 0
			u32 most: Img.max_pixels;
			if most is 0
				most is Img.DEFAULT_MAX_PIXELS;
			;;
			if image.w <= 0 or image.h <= 0 or image.pixels is 0 or (image.w as u64) * (image.h as u64) > most
				log 'WRONG: an image of ' image.w ' by ' image.h ', past the limit or empty\n';
				exit 1;
			;;
			read++;
			call Img.Free: image;
			return;
		;;
		if Img.error.len is 0
			log 'WRONG: refused with no reason\n';
			exit 1;
		;;
		if Img.error has 'limit'
			too_big++;
		;;
		else
			refused++;
		;;
	[end]

	# a troublesome number in a header field
	[Field: ptr<u8> data: 0; u32 len: 0; u32 at_byte: 0;]
		u32 values: 0 1 0x7FFFFFFF 0x80000000 0xFFFFFFFF 0x10000 0xFFFF 40 124 0x7FFF;
		if at_byte + 4 > len return;
		call Put: data at_byte values:((Next) % 10);
	[end]

	# a u32 at a place in the data, little-endian
	[Put: ptr<u8> data: 0; u32 at_byte: 0; u32 v: 0;]
		data:at_byte is (v & 255) as u8;
		data:(at_byte + 1) is ((v >> 8) & 255) as u8;
		data:(at_byte + 2) is ((v >> 16) & 255) as u8;
		data:(at_byte + 3) is (v >> 24) as u8;
	[end]

	# the work space has room for each file, and one more byte
	[Fits: str path; u32 size: 0;]
		if size >= WORK_SIZE
			log path ' is bigger than the work space\n';
			exit 1;
		;;
	[end]

	# xorshift32
	[Next: : u32]
		seed is seed ^ (seed << 13);
		seed is seed ^ (seed >> 17);
		seed is seed ^ (seed << 5);
	[end: seed]

	[Load: str path; ptr<u32> size_out: 0; : ptr<u8>]
		int size: (OS.FileSize: path);
		if size < 0
			log 'cannot read ' path '\n';
			exit 1;
		;;
		ptr<u8> buffer: new u8[size as u32 + 1];
		if buffer is 0
			log 'out of memory reading ' path '\n';
			exit 1;
		;;
		if (OS.ReadFile: path buffer size) is not size
			log 'short read of ' path '\n';
			exit 1;
		;;
		size_out:0 is size as u32;
	[end: buffer]
}
