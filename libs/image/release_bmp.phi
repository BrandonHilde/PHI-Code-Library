# imagelib's BMP decoder against all the release cases, in tests/bmp/release.bin: the everyday
# ones at every size, and good files cut short at many lengths and fuzzed, for when the library is
# near release (build.ps1 -Test -Release). testcases.phi says how they're checked.
use imagelib;
use testcases;

phi.ReleaseBmp:Program
{
	call ImageLib.Start;
	call ImgTestCases.Run: 'tests/bmp/release.bin' Img.BMP 'suite';
}
