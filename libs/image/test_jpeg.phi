# imagelib's JPEG decoder against the everyday cases, in tests/jpeg/cases.bin: files written by libjpeg-turbo and the cases made by tools/image/make_jpeg_tests.py,
# one or a few of each feature and each kind of error. testcases.phi says how they're checked.
use imagelib;
use testcases;

phi.TestJpeg:Program
{
	call ImageLib.Start;
	call ImgTestCases.Run: 'tests/jpeg/cases.bin' Img.JPEG 'libjpeg';
}
