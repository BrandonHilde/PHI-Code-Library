# imagelib's PNG decoder against the everyday cases, in tests/png/cases.bin: PngSuite's files and the cases made by tools/image/make_png_tests.py,
# one or a few of each feature and each kind of error. testcases.phi says how they're checked.
use imagelib;
use testcases;

phi.TestPng:Program
{
	call ImageLib.Start;
	call ImgTestCases.Run: 'tests/png/cases.bin' Img.PNG 'suite';
}
