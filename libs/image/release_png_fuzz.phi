# imagelib's PNG decoder fuzzed for crashes and hangs: the full run, for release. fuzz_png.phi does it.
# takes up to 180 seconds: the full run is about a million files
use imagelib;
use fuzz_png;

phi.ReleasePngFuzz:Program
{
	call ImageLib.Start;
	call ImgFuzzPng.Run: 100000 99 30000 'tests/png/release.bin';
}
