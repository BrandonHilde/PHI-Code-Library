# Reading damaged JPEG files, in bulk: good files changed at random with a fixed seed, every value
# of each of the first 200 bytes (the tables and headers) of several, numbers that cause trouble put
# in every 16-bit field of the headers, and good headers followed by noise for the entropy-coded
# data, so that random coefficients reach the IDCT. Every one must come back, as an image within
# the limit or a reason: a crash or a hang fails the test. (Whether imagelib is right about each
# is test_jpeg's job: its fuzz cases are checked against the rules.)
# takes up to 120 seconds: about 15 alone, as 307,200 of its files are whole JPEGs with one byte changed
use imagelib;
use memory.mem;

phi.TestJpegFuzz:Program
{
	u32 seed: 0x2545F491;
	u32 read: 0;
	u32 refused: 0;
	u32 too_big: 0;
	u32 bases_count: 0;
	ptr<u8> base_data[512];
	u32 base_len[512];
	const u32 WORK_SIZE: 70000;

	call ImageLib.Start;
	# a limit of 2048 by 2048, so that no file is refused for memory: a 32-bit program's heap stops
	# at 128 MB, which a 4096 by 4096 image of three components nearly takes, so it would be
	# refused there and read in 64 bits
	const u32 MOST: 2048 * 2048;
	Img.max_pixels is MOST;

	# the starting points: the good files of test_jpeg's cases, of up to 6000 bytes
	u32 cases_size: 0;
	ptr<u8> cases_bytes: (Load: 'tests/jpeg/cases.bin' addr cases_size);
	CoreReader r;
	call r.Start: cases_bytes cases_size;
	u32 count: (r.U32LE);
	while u32 i: 0; i < count; i++;
		u32 group: (r.U8);
		u32 kind: (r.U8);
		call r.Skip: (r.U8);
		u32 most: (r.U32LE);
		ptr<u8> bytes: 0;
		u32 length: 0;
		when kind
			is 0
				call r.Skip: (r.U8);
			;;
			is 1
				length is (r.U32LE);
				bytes is (r.Bytes: length);
			;;
			is 2
				call r.Skip: 8;
			;;
			else
				call r.Skip: 4;
				call r.Skip: ((r.U16LE) * 5);
			;;
		;;
		bln ok: ((r.U8) is 1);
		if ok
			call r.Skip: 12;
		;;
		else
			call r.Skip: (r.U8);
		;;
		if group < 2 and kind is 1 and ok and most is 0 and length > 0 and length <= 6000 and bases_count < 512
			base_data:bases_count is bytes;
			base_len:bases_count is length;
			bases_count++;
		;;
	;;
	if r.failed or bases_count < 6
		log 'cases.bin is damaged\n';
		exit 1;
	;;
	log 'files to change: ' bases_count '\n';

	ptr<u8> work: new u8[WORK_SIZE];

	# changed at random: a few bits, a byte, a 16-bit field, cut short, a byte put in or taken out
	while u32 n: 0; n < 100000; n++;
		u32 which: (Next) % bases_count;
		u32 len: base_len:which;
		call Mem.Copy: work base_data:which len;
		u32 how: (Next) % 6;
		if how is 0
			u32 flips: 1 + (Next) % 3;
			while u32 f: 0; f < flips; f++;
				u32 at_byte: (Next) % len;
				work:at_byte is (work:at_byte ^ (1 << ((Next) % 8))) as u8;
			;;
		;;
		elif how is 1
			work:((Next) % len) is ((Next) & 255) as u8;
		;;
		elif how is 2
			call Field: work len ((Next) % 400);
		;;
		elif how is 3
			len is (Next) % len;
		;;
		elif how is 4
			u32 at_byte: (Next) % len;
			call Mem.Move: (work + at_byte + 1) (work + at_byte) (len - at_byte);
			work:at_byte is ((Next) & 255) as u8;
			len++;
		;;
		else
			u32 at_byte: (Next) % len;
			call Mem.Move: (work + at_byte) (work + at_byte + 1) (len - at_byte - 1);
			len--;
		;;
		# a quarter of them with a limit they may well reach
		Img.max_pixels is MOST;
		if (n & 3) is 1
			Img.max_pixels is 500;
		;;
		call Try: work len;
	;;
	Img.max_pixels is MOST;
	log 'changed at random: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

	# every value of each of the first 200 bytes of six files, of each kind
	read is 0;
	refused is 0;
	too_big is 0;
	while u32 s: 0; s < 6; s++;
		u32 which: (s * bases_count) / 6;
		u32 len: base_len:which;
		ptr<u8> base: base_data:which;
		u32 top: 200;
		if top > len
			top is len;
		;;
		while u32 at_byte: 0; at_byte < top; at_byte++;
			while u32 v: 0; v < 256; v++;
				call Mem.Copy: work base len;
				work:at_byte is v as u8;
				call Try: work len;
			;;
		;;
	;;
	log 'every value of the first 200 bytes: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

	# numbers that cause trouble in every 16-bit field of the first 400 bytes
	read is 0;
	refused is 0;
	too_big is 0;
	u32 troubles: 0 1 2 3 4 7 8 9 15 16 17 63 64 255 256 0x7FFF 0x8000 0xFFFE 0xFFFF;
	while u32 s: 0; s < 6; s++;
		u32 which: (s * bases_count) / 6 + 1;
		u32 len: base_len:which;
		ptr<u8> base: base_data:which;
		while u32 at_byte: 2; at_byte + 2 <= 400 and at_byte + 2 <= len; at_byte++;
			while u32 t: 0; t < troubles.len; t++;
				call Mem.Copy: work base len;
				work:at_byte is (troubles:t >> 8) as u8;
				work:(at_byte + 1) is (troubles:t & 255) as u8;
				call Try: work len;
			;;
		;;
	;;
	log 'troublesome numbers: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';

	# good headers, up to and including the first scan's, and then noise: so the noise is
	# decoded, and random coefficients reach the IDCT
	read is 0;
	refused is 0;
	too_big is 0;
	while u32 n: 0; n < 30000; n++;
		u32 which: (Next) % bases_count;
		u32 len: base_len:which;
		ptr<u8> base: base_data:which;
		u32 start: (ScanStart: base len);
		if start is 0
			continue;
		;;
		call Mem.Copy: work base start;
		u32 noise: (Next) % 3000;
		while u32 k: 0; k < noise; k++;
			u32 v: (Next) & 255;
			# mostly bytes that aren't markers, so the data runs on
			if v is 0xFF and (Next) % 4 is not 0
				v is 0;
			;;
			work:(start + k) is v as u8;
		;;
		work:(start + noise) is 0xFF;
		work:(start + noise + 1) is 0xD9;
		call Try: work (start + noise + 2);
	;;
	log 'noise for the image data: ' read ' read, ' refused ' refused, ' too_big ' over the limit\n';
	free work;
	log 'done\n';
	exit 0;

	[Try: ptr<u8> data: 0; u32 len: 0;]
		ptr<ImgImage> image: (Img.Decode: data len);
		if image is not 0
			u32 most: Img.max_pixels;
			if most is 0
				most is Img.DEFAULT_MAX_PIXELS;
			;;
			if image.w <= 0 or image.h <= 0 or image.pixels is 0 or (image.w as u64) * (image.h as u64) > most
				log 'WRONG: an image of ' image.w ' by ' image.h ', past the limit or empty\n';
				exit 1;
			;;
			read++;
			call Img.Free: image;
			return;
		;;
		if Img.error.len is 0
			log 'WRONG: refused with no reason\n';
			exit 1;
		;;
		if Img.error has 'limit'
			too_big++;
		;;
		else
			refused++;
		;;
	[end]

	# where the first scan's entropy-coded data starts, just after its SOS segment; 0 if there's none
	[ScanStart: ptr<u8> data: 0; u32 len: 0; : u32]
		u32 pos: 2;
		while pos + 4 <= len
			if data:pos is not 0xFF
				return 0;
			;;
			u32 m: data:(pos + 1);
			u32 size: ((data:(pos + 2) as u32) << 8) | data:(pos + 3);
			if m is 0xDA
				if pos + 2 + size > len
					return 0;
				;;
				return pos + 2 + size;
			;;
			pos++ 2 + size;
		;;
	[end: 0]

	# a troublesome 16-bit number at a place in the data
	[Field: ptr<u8> data: 0; u32 len: 0; u32 at_byte: 0;]
		u32 values: 0 1 2 0x7FFF 0x8000 0xFFFF 8 16 64 255;
		if at_byte + 2 > len return;
		u32 v: values:((Next) % 10);
		data:at_byte is (v >> 8) as u8;
		data:(at_byte + 1) is (v & 255) as u8;
	[end]

	# xorshift32
	[Next: : u32]
		seed is seed ^ (seed << 13);
		seed is seed ^ (seed >> 17);
		seed is seed ^ (seed << 5);
	[end: seed]

	[Load: str path; ptr<u32> size_out: 0; : ptr<u8>]
		int size: (OS.FileSize: path);
		if size < 0
			log 'cannot read ' path '\n';
			exit 1;
		;;
		ptr<u8> buffer: new u8[size as u32 + 1];
		if buffer is 0
			log 'out of memory reading ' path '\n';
			exit 1;
		;;
		if (OS.ReadFile: path buffer size) is not size
			log 'short read of ' path '\n';
			exit 1;
		;;
		size_out:0 is size as u32;
	[end: buffer]
}
