# imagelib's JPEG decoder fuzzed for crashes and hangs: the full run, for release. fuzz_jpeg.phi does it.
# takes up to 180 seconds: the full run is about a million files
use imagelib;
use fuzz_jpeg;

phi.ReleaseJpegFuzz:Program
{
	call ImageLib.Start;
	call ImgFuzzJpeg.Run: 100000 6 30000 'tests/jpeg/release.bin';
}
