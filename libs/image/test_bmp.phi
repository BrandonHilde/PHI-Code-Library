# imagelib's BMP decoder against the everyday cases, in tests/bmp/cases.bin: BMP Suite's files and the cases made by tools/image/make_bmp_tests.py,
# one or a few of each feature and each kind of error. testcases.phi says how they're checked.
use imagelib;
use testcases;

phi.TestBmp:Program
{
	call ImageLib.Start;
	call ImgTestCases.Run: 'tests/bmp/cases.bin' Img.BMP 'suite';
}
