# imagelib's GIF decoder against all the release cases, in tests/gif/release.bin: the everyday ones,
# and good files cut short at many lengths and fuzzed, for when the library is near release
# (build.ps1 -Test -Release). testcases.phi says how they're checked.
use imagelib;
use testcases;

phi.ReleaseGif:Program
{
	call ImageLib.Start;
	call ImgTestCases.Run: 'tests/gif/release.bin' Img.GIF 'written';
}
