# The image every decoder gives back, and what works on any of them.
#
#   ptr<ImgImage> image: (Img.Decode: bytes length);     # finds the format from the bytes
#   if image is 0
#       log 'bad image: ' Img.error '\n';
#       return;
#   ;;
#   call Draw.Blit: 10 10 image.w image.h image.pixels image.w;   # when it's opaque
#   call Img.Free: image;
#
# A file that's damaged, cut short or made to cause trouble gives 0 and a reason in Img.error,
# never a crash or a hang. Img.max_pixels is the most pixels an image may have (0, as it starts,
# means DEFAULT_MAX_PIXELS): a bigger one is refused before any memory is taken for it, so a
# small file can't claim gigabytes.

# An image: w by h pixels, each 0xAARRGGBB with straight alpha, a row at a time from the top.
struct.ImgImage
{
	int w;
	int h;
	ptr<u32> pixels;    # w * h of them, on the heap
}

# An animation, a frame at a time: from Img.OpenAnimation, which draws the first frame, and then
# Img.NextFrame for each of the rest. frame is the animation's own, drawn over for each frame, and
# freed with it by Img.CloseAnimation. The file's bytes must stay as they are until then.
#
#   ptr<ImgAnimation> a: (Img.OpenAnimation: bytes length);
#   if a is 0 ... Img.error says why ...
#   while true
#       ... show a.frame for a.delay milliseconds ...
#       if not (Img.NextFrame: a) break;
#   ;;
#   call Img.CloseAnimation: a;
#
# Any format opens as one: a still image is an animation of one frame.
struct.ImgAnimation
{
	int w;                  # the frames' size
	int h;
	int loops;              # how many more times to show it after the first: 0 forever; -1 if the file doesn't say (show it once)
	ptr<ImgImage> frame;    # the frame now
	u32 delay;              # how long the file says to show it, in milliseconds (browsers show 10 or less as 100)
	u32 index;              # which frame it is, from 0
	ptr<ImgGif> gif;        # what's reading it; 0 for a still image
}

phi.Img:Library
{
	const int UNKNOWN: 0;
	const int BMP: 1;
	const int PNG: 2;
	const int JPEG: 3;
	const int GIF: 4;

	# the limit when Img.max_pixels is 0: 4096 by 4096, 64 MB of pixels
	const u32 DEFAULT_MAX_PIXELS: 16 * 1024 * 1024;

	# the most an image's pixels may take, whatever max_pixels says: 2 GB
	const u32 MOST_PIXELS: 0x1FFFFFFF;

	str error: [383];   # why the last call failed
	u32 max_pixels;     # the most pixels an image may have; 0 means DEFAULT_MAX_PIXELS
	u32 orientation;    # the last image's EXIF orientation, 1 to 8 (1: as stored, or none)
	bln ignore_orientation;     # true: leave the pixels as stored, whatever the orientation says

	# which format the bytes are in, from their first few: Img.BMP, Img.PNG, Img.JPEG, Img.GIF, or
	# Img.UNKNOWN
	[Format: ptr<u8> data: 0; u32 length: 0; : int]
		if data is not 0 and length >= 2 and data:0 is 'B' and data:1 is 'M'
			return BMP;
		;;
		if data is not 0 and length >= 4 and data:0 is 0x89 and data:1 is 'P' and data:2 is 'N' and data:3 is 'G'
			return PNG;
		;;
		if data is not 0 and length >= 2 and data:0 is 0xFF and data:1 is 0xD8
			return JPEG;
		;;
		if data is not 0 and length >= 4 and data:0 is 'G' and data:1 is 'I' and data:2 is 'F' and data:3 is '8'
			return GIF;
		;;
	[end: UNKNOWN]

	# an image in any format imagelib reads; 0 if it can't be read, with the reason in error
	[Decode: ptr<u8> data: 0; u32 length: 0; : ptr<ImgImage>]
		when (Format: data length)
			is BMP
				return (DecodeBmp: data length);
			;;
			is PNG
				return (DecodePng: data length);
			;;
			is JPEG
				return (DecodeJpeg: data length);
			;;
			is GIF
				return (DecodeGif: data length);
			;;
		;;
		error is 'not an image format imagelib reads';
	[end: 0]

	# a BMP file; 0 if it can't be read, with the reason in error
	[DecodeBmp: ptr<u8> data: 0; u32 length: 0; : ptr<ImgImage>]
		error is '';
		orientation is 1;
		if data is 0 and length > 0
			error is 'no data was given';
			return 0;
		;;
		if length > 0x7FFFFFFF
			error is 'more than 2 GB of data';
			return 0;
		;;
		ptr<ImgBmp> d: new ImgBmp;
		if d is 0
			error is 'out of memory';
			return 0;
		;;
		if call d.Read: data length (Limit) throws err
			if err.kind is ErrorKind.THROWN
				error is err.text;
			;;
			else
				error is err.message;
			;;
			call Free: d.image;
			call Done: d;
			return 0;
		;;
		ptr<ImgImage> image: d.image;
		call Done: d;
	[end: image]

	# a PNG file; 0 if it can't be read, with the reason in error
	[DecodePng: ptr<u8> data: 0; u32 length: 0; : ptr<ImgImage>]
		error is '';
		orientation is 1;
		if data is 0 and length > 0
			error is 'no data was given';
			return 0;
		;;
		if length > 0x7FFFFFFF
			error is 'more than 2 GB of data';
			return 0;
		;;
		ptr<ImgPng> d: new ImgPng;
		if d is 0
			error is 'out of memory';
			return 0;
		;;
		if call d.Read: data length (Limit) throws err
			if err.kind is ErrorKind.THROWN
				error is err.text;
			;;
			else
				error is err.message;
			;;
			call Free: d.image;
			call DonePng: d;
			return 0;
		;;
		ptr<ImgImage> image: d.image;
		u32 turn: d.exif;
		call DonePng: d;
	[end: (Turned: image turn)]

	# a JPEG file; 0 if it can't be read, with the reason in error
	[DecodeJpeg: ptr<u8> data: 0; u32 length: 0; : ptr<ImgImage>]
		error is '';
		orientation is 1;
		if data is 0 and length > 0
			error is 'no data was given';
			return 0;
		;;
		if length > 0x7FFFFFFF
			error is 'more than 2 GB of data';
			return 0;
		;;
		ptr<ImgJpeg> d: new ImgJpeg;
		if d is 0
			error is 'out of memory';
			return 0;
		;;
		if call d.Read: data length (Limit) throws err
			if err.kind is ErrorKind.THROWN
				error is err.text;
			;;
			else
				error is err.message;
			;;
			call Free: d.image;
			call DoneJpeg: d;
			return 0;
		;;
		ptr<ImgImage> image: d.image;
		u32 turn: d.exif;
		call DoneJpeg: d;
	[end: (Turned: image turn)]

	# a GIF file's first frame (Img.OpenAnimation gives the rest); 0 if it can't be read, with the reason in error
	[DecodeGif: ptr<u8> data: 0; u32 length: 0; : ptr<ImgImage>]
		ptr<ImgGif> d: (OpenGif: data length);
		if d is 0
			return 0;
		;;
		ptr<ImgImage> image: d.image;
		d.image is 0;
		call DoneGif: d;
	[end: image]

	# a GIF read as far as its first frame; 0 if it can't be, with the reason in error
	[OpenGif: ptr<u8> data: 0; u32 length: 0; : ptr<ImgGif>]
		error is '';
		orientation is 1;
		if data is 0 and length > 0
			error is 'no data was given';
			return 0;
		;;
		if length > 0x7FFFFFFF
			error is 'more than 2 GB of data';
			return 0;
		;;
		ptr<ImgGif> d: new ImgGif;
		if d is 0
			error is 'out of memory';
			return 0;
		;;
		if call d.Open: data length (Limit) throws err
			call Failed: err.kind err.text err.message;
			call DoneGif: d;
			return 0;
		;;
		if call d.Next throws err
			call Failed: err.kind err.text err.message;
			call DoneGif: d;
			return 0;
		;;
	[end: d]

	[Failed: ErrorKind kind; str text; str message;]
		if kind is ErrorKind.THROWN
			error is text;
		;;
		else
			error is message;
		;;
	[end]

	# a GIF decoder's memory, the canvas too (unless it's been handed on), given back
	[DoneGif: ptr<ImgGif> d: 0;]
		call Free: d.image;
		if d.saved is not 0
			free d.saved;
		;;
		free d;
	[end]

	# An animation, with its first frame drawn; 0 if it can't be read, with the reason in error. Any
	# format opens: a still image is an animation of one frame. data must stay as it is until
	# CloseAnimation.
	[OpenAnimation: ptr<u8> data: 0; u32 length: 0; : ptr<ImgAnimation>]
		if (Format: data length) is GIF
			return (OpenGifAnimation: data length);
		;;
		ptr<ImgAnimation> a: new ImgAnimation;
		if a is 0
			error is 'out of memory';
			return 0;
		;;
		a.frame is (Decode: data length);
		if a.frame is 0
			free a;
			return 0;
		;;
		a.loops is -1;
		a.w is a.frame.w;
		a.h is a.frame.h;
	[end: a]

	# a GIF file as an animation, whatever its first bytes say; 0 if it can't be read, with the
	# reason in error
	[OpenGifAnimation: ptr<u8> data: 0; u32 length: 0; : ptr<ImgAnimation>]
		ptr<ImgAnimation> a: new ImgAnimation;
		if a is 0
			error is 'out of memory';
			return 0;
		;;
		ptr<ImgGif> d: (OpenGif: data length);
		if d is 0
			free a;
			return 0;
		;;
		a.gif is d;
		a.frame is d.image;
		a.loops is d.loops;
		a.delay is d.delay;
		a.w is a.frame.w;
		a.h is a.frame.h;
	[end: a]

	# The animation's next frame, drawn in a.frame: true, or false when there are no more (with the
	# reason in error, if it's damage that ends it, or '' at its end)
	[NextFrame: ptr<ImgAnimation> a: 0; : bln]
		error is '';
		if a is 0 or a.gif is 0
			return false;
		;;
		ptr<ImgGif> d: a.gif;
		if call d.Next throws err
			call Failed: err.kind err.text err.message;
			d.ended is true;
			return false;
		;;
		a.loops is d.loops;
		if not d.more
			return false;
		;;
		a.delay is d.delay;
		a.index++;
	[end: true]

	# gives back an animation's memory, its frame too (0 is allowed, and does nothing)
	[CloseAnimation: ptr<ImgAnimation> a: 0;]
		if a is 0 return;
		if a.gif is not 0
			call DoneGif: a.gif;
		;;
		else
			call Free: a.frame;
		;;
		free a;
	[end]

	# A decoded image turned to its EXIF orientation (0: none), unless ignore_orientation; and
	# orientation set. 0 if there isn't the memory to turn it, with the reason in error.
	[Turned: ptr<ImgImage> image: 0; u32 turn: 0; : ptr<ImgImage>]
		if turn is 0
			turn is 1;
		;;
		orientation is turn;
		if turn is 1 or ignore_orientation
			return image;
		;;
		if not (Orient: image turn)
			error is 'out of memory to turn the image to its orientation';
			call Free: image;
			return 0;
		;;
	[end: image]

	# The orientation in a TIFF block (EXIF's own): 1 to 8; 0 when the block isn't a TIFF header
	# Chrome takes. It reads it as Chrome does: the header must be II*\0 or MM\0*, and the
	# orientation is tag 0x0112 in the first IFD, of type SHORT and count 1, from 1 to 8; anything
	# else is 1.
	[ExifOrientation: u8 tiff[]; : u32]
		u32 n: tiff.len as u32;
		if n < 8
			return 0;
		;;
		bln big: false;
		if tiff:0 is 'I' and tiff:1 is 'I' and tiff:2 is 0x2A and tiff:3 is 0
			big is false;
		;;
		elif tiff:0 is 'M' and tiff:1 is 'M' and tiff:2 is 0 and tiff:3 is 0x2A
			big is true;
		;;
		else
			return 0;
		;;
		u32 ifd: (Tiff32: tiff 4 big);
		if ifd > n - 2
			return 1;
		;;
		u32 count: (Tiff16: tiff ifd big);
		while u32 k: 0; k < count; k++;
			u32 entry: ifd + 2 + 12 * k;
			if entry > n - 12
				return 1;
			;;
			if (Tiff16: tiff entry big) is 0x0112
				if (Tiff16: tiff (entry + 2) big) is 3 and (Tiff32: tiff (entry + 4) big) is 1
					u32 v: (Tiff16: tiff (entry + 8) big);
					if v >= 1 and v <= 8
						return v;
					;;
				;;
				return 1;
			;;
		;;
	[end: 1]

	[Tiff16: u8 tiff[]; u32 where: 0; bln big: false; : u32]
		if big
			return ((tiff:where as u32) << 8) | tiff:(where + 1);
		;;
	[end: tiff:where | ((tiff:(where + 1) as u32) << 8)]

	[Tiff32: u8 tiff[]; u32 where: 0; bln big: false; : u32]
		if big
			return ((Tiff16: tiff where big) << 16) | (Tiff16: tiff (where + 2) big);
		;;
	[end: (Tiff16: tiff where big) | ((Tiff16: tiff (where + 2) big) << 16)]

	# An image turned to orientation o, 2 to 8, as Pillow's exif_transpose turns it: 2 mirrored,
	# 3 turned a half, 4 flipped, 5 transposed, 6 turned a quarter clockwise, 7 transversed, 8 turned
	# a quarter counter-clockwise. Flips and the half turn are done where the pixels are; the rest
	# swap the width and height, into new pixels. False if there isn't the memory for them.
	[Orient: ptr<ImgImage> image: 0; u32 o: 0; : bln]
		u32 w: image.w as u32;
		u32 h: image.h as u32;
		u32 count: w * h;
		if o <= 4
			call Flip: (image.pixels as u32[count]) w h o;
			return true;
		;;
		ptr<u32> turned: new u32[count];
		if turned is 0
			return false;
		;;
		call Turn: (image.pixels as u32[count]) (turned as u32[count]) w h o;
		free image.pixels;
		image.pixels is turned;
		image.w is h as int;
		image.h is w as int;
	[end: true]

	# 2 mirrored, 3 turned a half, 4 flipped: pixel pairs swapped where they are
	[Flip: u32 px[]; u32 w: 0; u32 h: 0; u32 o: 0;]
		if o is 2 or o is 3
			while u32 y: 0; y < h; y++;
				u32 row: y * w;
				while u32 x: 0; x < w / 2; x++;
					u32 t: px:(row + x);
					px:(row + x) is px:(row + w - 1 - x);
					px:(row + w - 1 - x) is t;
				;;
			;;
		;;
		if o is 3 or o is 4
			while u32 y: 0; y < h / 2; y++;
				u32 top: y * w;
				u32 bottom: (h - 1 - y) * w;
				while u32 x: 0; x < w; x++;
					u32 t: px:(top + x);
					px:(top + x) is px:(bottom + x);
					px:(bottom + x) is t;
				;;
			;;
		;;
	[end]

	# 5 transposed, 6 turned a quarter clockwise, 7 transversed, 8 turned a quarter counter-clockwise:
	# into dst, which is h across and w down
	[Turn: u32 px[]; u32 dst[]; u32 w: 0; u32 h: 0; u32 o: 0;]
		while u32 y: 0; y < h; y++;
			while u32 x: 0; x < w; x++;
				u32 nx: y;
				u32 ny: x;
				if o is 6
					nx is h - 1 - y;
				;;
				elif o is 7
					nx is h - 1 - y;
					ny is w - 1 - x;
				;;
				elif o is 8
					ny is w - 1 - x;
				;;
				dst:(ny * h + nx) is px:(y * w + x);
			;;
		;;
	[end]

	# gives back an image's memory (0 is allowed, and does nothing)
	[Free: ptr<ImgImage> image: 0;]
		if image is 0 return;
		if image.pixels is not 0
			free image.pixels;
		;;
		free image;
	[end]

	# Draws count pixels of src over dest, which is taken as opaque: each of dest's colors
	# becomes (src * alpha + dest * (255 - alpha)) / 255, rounded, and dest's top byte stays as
	# it was. src is straight alpha, as decoders give it.
	[BlendRow: ptr<u32> dest: 0; ptr<u32> src: 0; u32 count: 0;]
		while u32 i: 0; i < count; i++;
			u32 s: src:i;
			u32 a: s >> 24;
			if a is 255
				dest:i is (dest:i & 0xFF000000) | (s & 0xFFFFFF);
			;;
			elif a is not 0
				u32 d: dest:i;
				u32 rest: 255 - a;
				u32 r: (((s >> 16) & 255) * a + ((d >> 16) & 255) * rest + 127) / 255;
				u32 g: (((s >> 8) & 255) * a + ((d >> 8) & 255) * rest + 127) / 255;
				u32 b: ((s & 255) * a + (d & 255) * rest + 127) / 255;
				dest:i is (d & 0xFF000000) | (r << 16) | (g << 8) | b;
			;;
		;;
	[end]

	# a BMP decoder's own memory, given back
	[Done: ptr<ImgBmp> d: 0;]
		if d.lut is not 0
			free d.lut;
		;;
		free d;
	[end]

	# a PNG decoder's own memory, given back
	[DonePng: ptr<ImgPng> d: 0;]
		if d.joined is not 0
			free d.joined;
		;;
		if d.raw is not 0
			free d.raw;
		;;
		free d;
	[end]

	# a JPEG decoder's own memory, given back
	[DoneJpeg: ptr<ImgJpeg> d: 0;]
		if d.scratch is not 0
			free d.scratch;
		;;
		if d.rows is not 0
			free d.rows;
		;;
		if d.plane0 is not 0
			free d.plane0;
		;;
		if d.plane1 is not 0
			free d.plane1;
		;;
		if d.plane2 is not 0
			free d.plane2;
		;;
		if d.coef0 is not 0
			free d.coef0;
		;;
		if d.coef1 is not 0
			free d.coef1;
		;;
		if d.coef2 is not 0
			free d.coef2;
		;;
		if d.padded is not 0
			free d.padded;
		;;
		free d;
	[end]

	# the limit on pixels a decoder works to
	[Limit: : u32]
		u32 most: max_pixels;
		if most is 0
			most is DEFAULT_MAX_PIXELS;
		;;
		if most > MOST_PIXELS
			most is MOST_PIXELS;
		;;
	[end: most]

	# A new image, for a decoder: all its pixels 0 (transparent). Throws if there's no memory.
	# The decoder has checked the size against the limit.
	[New: u32 width: 0; u32 height: 0; : ptr<ImgImage>]
		ptr<ImgImage> image: new ImgImage;
		if image is 0
			throw 'out of memory';
		;;
		image.w is width as int;
		image.h is height as int;
		image.pixels is new u32[width * height];
		if image.pixels is 0
			free image;
			throw 'out of memory for a ' width ' by ' height ' image';
		;;
	[end: image]
}
