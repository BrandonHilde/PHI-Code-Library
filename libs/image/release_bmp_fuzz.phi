# imagelib's BMP decoder fuzzed for crashes and hangs: the full run, for release. fuzz_bmp.phi does it.
# takes up to 180 seconds: the full run is about a million files
use imagelib;
use fuzz_bmp;

phi.ReleaseBmpFuzz:Program
{
	call ImageLib.Start;
	call ImgFuzzBmp.Run: 100000 99 300 'tests/bmp/release.bin';
}
