# Inflating damaged data, in bulk: the good streams of tests/inflate/cases.bin changed at random with a
# fixed seed, every single-byte change to the start of a few of them, and bytes that are nothing at
# all. Every one must come back, as a result or a failure: a crash or a hang fails the test. (Whether
# corelib is right about each is test_inflate's job: its fuzz cases are checked against zlib.)
use corelib;
use memory.mem;

phi.ReleaseInflateFuzz:Program
{
	u32 seed: 0x2545F491;
	u32 inflated: 0;
	u32 refused: 0;
	u32 too_big: 0;
	u32 limit: 1000000;
	u32 bases_count: 0;
	ptr<u8> base_data[256];
	u32 base_len[256];
	int base_format[256];

	call CoreLib.Start;
	u32 cases_size: 0;
	ptr<u8> cases_bytes: (Load: 'tests/inflate/cases.bin' addr cases_size);
	CoreReader r;
	call r.Start: cases_bytes cases_size;
	u32 count: (r.U32LE);
	while u32 i: 0; i < count; i++;
		u32 group: (r.U8);
		int format: (r.U8) as int;
		call r.Skip: (r.U8);
		call r.Skip: 4;
		u32 in_len: (r.U32LE);
		ptr<u8> input: (r.Bytes: in_len);
		call r.Skip: 17;
		if group is 0 and in_len > 0 and in_len <= 6000 and bases_count < 256
			base_data:bases_count is input;
			base_len:bases_count is in_len;
			base_format:bases_count is format;
			bases_count++;
		;;
	;;
	if r.failed
		log 'cases.bin is damaged\n';
		exit 1;
	;;
	log 'streams to change: ' bases_count '\n';

	ptr<u8> work: new u8[6100];

	# changed at random: a few bits, a byte, cut short, a byte put in or taken out
	while u32 n: 0; n < 100000; n++;
		u32 which: (Next) % bases_count;
		u32 len: base_len:which;
		call Mem.Copy: work base_data:which len;
		u32 how: (Next) % 5;
		if how is 0
			u32 flips: 1 + (Next) % 3;
			while u32 f: 0; f < flips; f++;
				u32 at_byte: (Next) % len;
				work:at_byte is (work:at_byte ^ (1 << ((Next) % 8))) as u8;
			;;
		;;
		elif how is 1
			work:((Next) % len) is ((Next) & 255) as u8;
		;;
		elif how is 2
			len is (Next) % len;
		;;
		elif how is 3
			u32 at_byte: (Next) % len;
			call Mem.Move: work + at_byte + 1 work + at_byte len - at_byte;
			work:at_byte is ((Next) & 255) as u8;
			len++;
		;;
		else
			u32 at_byte: (Next) % len;
			call Mem.Move: work + at_byte work + at_byte + 1 len - at_byte - 1;
			len--;
		;;
		# a quarter of them with a limit they may well reach
		limit is 1000000;
		if (n & 3) is 0
			limit is 3000;
		;;
		call Try: base_format:which work len;
	;;
	limit is 1000000;
	log 'changed at random: ' inflated ' inflated, ' refused ' refused, ' too_big ' over the limit\n';

	# every value of every one of the first 48 bytes, of the first stream of each format
	inflated is 0;
	refused is 0;
	too_big is 0;
	while int format: 0; format < 3; format++;
		u32 which: 0;
		while which < bases_count and base_format:which is not format
			which++;
		;;
		u32 len: base_len:which;
		u32 top: 48;
		if top > len
			top is len;
		;;
		while u32 at_byte: 0; at_byte < top; at_byte++;
			while u32 v: 0; v < 256; v++;
				call Mem.Copy: work base_data:which len;
				work:at_byte is v as u8;
				call Try: format work len;
			;;
		;;
	;;
	log 'every byte at the start: ' inflated ' inflated, ' refused ' refused, ' too_big ' over the limit\n';

	# nothing but noise, of every length up to 300, in each format
	inflated is 0;
	refused is 0;
	too_big is 0;
	while int format: 0; format < 3; format++;
		while u32 len: 0; len <= 300; len++;
			while u32 k: 0; k < 5; k++;
				while u32 j: 0; j < len; j++;
					work:j is ((Next) & 255) as u8;
				;;
				# a header that passes, now and then, so the noise gets past it
				if k is 0 and format is 1 and len >= 2
					work:0 is 0x78;
					work:1 is 0x9C;
				;;
				if k is 0 and format is 2 and len >= 10
					work:0 is 0x1F;
					work:1 is 0x8B;
					work:2 is 8;
					work:3 is 0;
				;;
				call Try: format work len;
			;;
		;;
	;;
	log 'noise: ' inflated ' inflated, ' refused ' refused, ' too_big ' over the limit\n';
	free work;
	log 'done\n';
	exit 0;

	[Try: int format: 0; ptr<u8> data: 0; u32 len: 0;]
		u32 size: 0;
		ptr<u8> got: 0;
		if format is 0
			got is (CoreInflate.Raw: data len limit addr size);
		;;
		elif format is 1
			got is (CoreInflate.Zlib: data len limit addr size);
		;;
		else
			got is (CoreInflate.Gzip: data len limit addr size);
		;;
		if got is not 0
			if size > limit
				log 'WRONG: ' size ' bytes, past the limit\n';
				exit 1;
			;;
			inflated++;
			free got;
			return;
		;;
		if CoreInflate.error has 'limit'
			too_big++;
		;;
		else
			refused++;
		;;
	[end]

	# xorshift32
	[Next: : u32]
		seed is seed ^ (seed << 13);
		seed is seed ^ (seed >> 17);
		seed is seed ^ (seed << 5);
	[end: seed]

	[Load: str path; ptr<u32> size_out: 0; : ptr<u8>]
		int size: (OS.FileSize: path);
		if size < 0
			log 'cannot read ' path '\n';
			exit 1;
		;;
		ptr<u8> buffer: new u8[size as u32 + 1];
		if buffer is 0
			log 'out of memory reading ' path '\n';
			exit 1;
		;;
		if (OS.ReadFile: path buffer size) is not size
			log 'short read of ' path '\n';
			exit 1;
		;;
		size_out:0 is size as u32;
	[end: buffer]
}
