# fontlib's WOFF2 reader, every day: each font in tests/woff2 (made by tools/font/make_woff2_tests.py,
# and read by macOS's CoreText exactly as the font it came from) must give every glyph's outline and
# advance exactly as that font does. And WOFF2 files cut short or changed must come back, read or
# refused, without a crash. Brotli's dictionary is given to corelib, as a program gives it.
use fontlib;
use memory.mem;

phi.TestWoff2:Program
{
	call FontLib.Start;
	ptr<u8> dict: (Load: '../core/brotli/dictionary.bin');
	log 'the dictionary: ' (CoreBrotli.Dictionary: dict loaded) '\n';
	call Same: 'tests/woff2/LiberationSans-transformed.woff2' 'tests/fonts/LiberationSans-Regular.ttf';
	call Same: 'tests/woff2/LiberationSans-plain.woff2' 'tests/fonts/LiberationSans-Regular.ttf';
	call Same: 'tests/woff2/SourceCodePro.woff2' 'tests/fonts/SourceCodePro-Regular.otf';

	# damage: cut short at many lengths, and bytes changed with a fixed seed
	ptr<u8> good: (Load: 'tests/woff2/LiberationSans-transformed.woff2');
	u32 good_len: loaded;
	ptr<u8> work: new u8[good_len];
	int read: 0;
	int tries: 0;
	u32 seed: 20261120;
	while int k: 0; k < 40; k++;
		u32 cut: (good_len * k as u32) / 40;
		call Mem.Copy: work good cut;
		ptr<FntFace> f: (Fnt.Load: work cut);
		tries++;
		if f is not 0
			read++;
			call Fnt.Free: f;
		;;
	;;
	while int k: 0; k < 60; k++;
		call Mem.Copy: work good good_len;
		while int c: 0; c < 3; c++;
			seed is seed * 1103515245 + 12345;
			u32 spot: (seed >> 8) % good_len;
			seed is seed * 1103515245 + 12345;
			work:spot is (seed >> 16) as u8;
		;;
		ptr<FntFace> f: (Fnt.Load: work good_len);
		tries++;
		if f is not 0
			read++;
			call Fnt.Free: f;
		;;
	;;
	log 'damaged: ' tries ' came back (' read ' read, ' tries - read ' refused)\n';
	exit 0;

	u32 loaded: 0;

	[Load: ptr<u8> path: 0; : ptr<u8>]
		int size: (OS.FileSize: path);
		if size <= 0
			log 'no ' path '\n';
			exit 1;
		;;
		ptr<u8> bytes: new u8[size];
		int got: (OS.ReadFile: path bytes size);
		loaded is got as u32;
	[end: bytes]

	# every glyph of the WOFF2 file and the font: outline and advance alike
	[Same: ptr<u8> woff2_path: 0; ptr<u8> font_path: 0;]
		ptr<u8> w: (Load: woff2_path);
		u32 wn: loaded;
		ptr<u8> o: (Load: font_path);
		u32 on: loaded;
		ptr<FntFace> wf: (Fnt.Load: w wn);
		if wf is 0
			log woff2_path ': refused: ' Fnt.error '\n';
			return;
		;;
		ptr<FntFace> of: (Fnt.Load: o on);
		ptr<FntOutline> a: (Fnt.NewOutline);
		ptr<FntOutline> b: (Fnt.NewOutline);
		u32 same: 0;
		u32 points: 0;
		while u32 g: 0; g < of.glyph_count; g++;
			bln wa: (Fnt.Outline: wf g a);
			bln ob: (Fnt.Outline: of g b);
			bln alike: wa is ob and a.points is b.points and a.contours is b.contours and (Fnt.Advance: wf g) is (Fnt.Advance: of g);
			if alike and a.points > 0
				alike is (Mem.Equal: a.x b.x a.points * 4) and (Mem.Equal: a.y b.y a.points * 4) and (Mem.Equal: a.on b.on a.points);
			;;
			if alike and a.contours > 0
				alike is (Mem.Equal: a.ends b.ends a.contours * 4);
			;;
			if alike
				same++;
				points++ a.points;
			;;
			elif same + 3 > g
				log '  glyph ' g ' differs\n';
			;;
		;;
		log woff2_path ': ' wf.glyph_count ' glyphs (the font has ' of.glyph_count '), ' same ' the same, ' points ' points\n';
		call Fnt.FreeOutline: a;
		call Fnt.FreeOutline: b;
		call Fnt.Free: wf;
		call Fnt.Free: of;
		free w;
		free o;
	[end]
}
