# A font, and what works on any of them.
#
#   ptr<FntFace> face: (Fnt.Load: bytes length);     # the bytes must stay as they are until Fnt.Free
#   if face is 0
#       log 'bad font: ' Fnt.error '\n';
#       return;
#   ;;
#   u32 g: (Fnt.GlyphOf: face 0x41);                  # 'A'
#   ptr<FntOutline> o: (Fnt.NewOutline);
#   if (Fnt.Outline: face g o) ... o.points, o.x, o.y, o.on, o.contours, o.ends, o.advance ...
#   call Fnt.FreeOutline: o;
#   call Fnt.Free: face;
#
# Everything is in font units, as the font has it (unscaled, unhinted). A font that's damaged, cut
# short or made to cause trouble gives 0 and a reason in Fnt.error, never a crash or a hang.

# A font: its numbers, in font units
struct.FntFace
{
	u32 glyph_count;
	int units_per_em;
	int ascender;           # above the baseline
	int descender;          # below it (negative)
	int height;             # from one line's baseline to the next's
	int max_advance;        # the widest advance
	ptr<FntTrueType> tt;    # what reads it
}

# A glyph's outline: points contours of closed curves, each point on the curve or a quadratic
# control point off it; the arrays grow as they need to, and are the outline's own
struct.FntOutline
{
	u32 points;
	u32 contours;
	int advance;            # FreeType's: the glyph's own, or a component's if it says so
	ptr<int> x;             # points of them
	ptr<int> y;
	ptr<u8> on;             # 1: on the curve; 0: a control point
	ptr<u32> ends;          # contours of them: each contour's last point
	u32 point_room;
	u32 contour_room;
}

# A font at a size, in pixels per em: its line in 64ths of a pixel (rounded to whole pixels as FreeType
# rounds them), and its glyphs' bitmaps, made the first time each is asked for and kept
struct.FntSize
{
	ptr<FntFace> face;
	u32 ppem;
	i64 scale;              # 16.16: font units to 64ths of a pixel
	i64 mult;               # HarfBuzz's: advances to 64ths of a pixel, over 65536
	int ascender;           # rounded up to a whole pixel
	int descender;          # rounded down
	int height;             # rounded
	int max_advance;        # rounded
	ptr<ptr<FntBitmap>> cache;      # each glyph's bitmap, once it's made
	ptr<FntOutline> outline;
	ptr<FntRaster> raster;
}

phi.Fnt:Library
{
	str error: [383];   # why the last call failed

	# FreeType's most points and contours in one outline (FT_OUTLINE_POINTS_MAX and CONTOURS_MAX)
	const u32 MOST_POINTS: 32767;
	const u32 MOST_CONTOURS: 32767;

	# the most pixels a glyph's bitmap may have: a damaged font's glyph can't ask for gigabytes
	const u32 MOST_BITMAP_PIXELS: 1024 * 1024;

	# a TrueType font; 0 if it can't be read, with the reason in error. data must stay as it is until
	# Free.
	[Load: ptr<u8> data: 0; u32 length: 0; : ptr<FntFace>]
		error is '';
		if data is 0 and length > 0
			error is 'no data was given';
			return 0;
		;;
		if length > 0x7FFFFFFF
			error is 'more than 2 GB of data';
			return 0;
		;;
		ptr<FntTrueType> tt: new FntTrueType;
		ptr<FntFace> face: new FntFace;
		if tt is 0 or face is 0
			error is 'out of memory';
			if tt is not 0
				free tt;
			;;
			if face is not 0
				free face;
			;;
			return 0;
		;;
		if call tt.Open: data length throws err
			call Failed: err.kind err.text err.message;
			call Done: tt;
			free face;
			return 0;
		;;
		face.tt is tt;
		face.glyph_count is tt.glyph_count;
		face.units_per_em is tt.units_per_em;
		face.ascender is tt.ascender;
		face.descender is tt.descender;
		face.height is tt.height;
		face.max_advance is tt.max_advance;
	[end: face]

	# gives back a font's memory (0 is allowed, and does nothing); not its bytes, which are the caller's
	[Free: ptr<FntFace> face: 0;]
		if face is 0 return;
		call Done: face.tt;
		free face;
	[end]

	# the glyph for a character (a Unicode code point), as HarfBuzz finds it; 0 if the font has none
	[GlyphOf: ptr<FntFace> face: 0; u32 code: 0; : u32]
		if face is 0
			return 0;
		;;
	[end: (face.tt.GlyphOf: code)]

	# glyph's advance and left side bearing from hmtx, in font units, as text is laid out with it
	[Advance: ptr<FntFace> face: 0; u32 glyph: 0; : int]
		if face is 0 or glyph >= face.glyph_count
			return 0;
		;;
		int lsb: 0;
		ptr<FntTrueType> tt: face.tt;
	[end: (tt.Metrics: (tt.data as u8[tt.length]) glyph addr lsb)]

	# A glyph's outline, into o, in font units: true, or false with the reason in error (a glyph the
	# font can't give, which leaves o empty)
	[Outline: ptr<FntFace> face: 0; u32 glyph: 0; ptr<FntOutline> o: 0; : bln]
		error is '';
		if face is 0 or o is 0
			error is 'no font or outline was given';
			return false;
		;;
		if call face.tt.Glyph: glyph o throws err
			call Failed: err.kind err.text err.message;
			o.points is 0;
			o.contours is 0;
			o.advance is 0;
			return false;
		;;
	[end: true]

	# A font at a size, in pixels per em (1 to 16,384); 0 if there isn't the memory, with the reason in
	# error. The face must stay until FreeSize.
	[AtSize: ptr<FntFace> face: 0; u32 ppem: 0; : ptr<FntSize>]
		error is '';
		if face is 0 or ppem is 0 or ppem > 16384
			error is 'no font, or a size that isn\'t 1 to 16384 pixels';
			return 0;
		;;
		ptr<FntSize> size: new FntSize;
		if size is 0
			error is 'out of memory';
			return 0;
		;;
		size.face is face;
		size.ppem is ppem;
		size.scale is (DivFix: ((ppem as i64) * 64) face.units_per_em);
		size.mult is (((ppem as i64) * 64) << 16) / (face.units_per_em as i64);
		i64 asc: (face.tt.MulFix: face.ascender size.scale);
		i64 desc: (face.tt.MulFix: face.descender size.scale);
		i64 height: (face.tt.MulFix: face.height size.scale);
		i64 adv: (face.tt.MulFix: face.max_advance size.scale);
		size.ascender is ((asc + 63) & ~63) as int;
		size.descender is (desc & ~63) as int;
		size.height is ((height + 32) & ~63) as int;
		size.max_advance is ((adv + 32) & ~63) as int;
		size.cache is new ptr<FntBitmap>[face.glyph_count + 1];
		size.outline is new FntOutline;
		size.raster is new FntRaster;
		if size.cache is 0 or size.outline is 0 or size.raster is 0
			call FreeSize: size;
			error is 'out of memory';
			return 0;
		;;
	[end: size]

	# FT_DivFix: a * 65536 / b, rounded
	[DivFix: i64 a: 0; int b: 0; : i64]
		i64 d: b;
		if d <= 0
			return 0;
		;;
	[end: ((a << 16) + (d >> 1)) / d]

	# gives back a size's memory and its glyphs' bitmaps (0 is allowed, and does nothing)
	[FreeSize: ptr<FntSize> size: 0;]
		if size is 0 return;
		if size.cache is not 0
			while u32 g: 0; g < size.face.glyph_count; g++;
				call FreeBitmap: size.cache:g;
			;;
			free size.cache;
		;;
		if size.outline is not 0
			call Release: size.outline;
			free size.outline;
		;;
		if size.raster is not 0
			if size.raster.cells is not 0
				free size.raster.cells;
			;;
			if size.raster.rows is not 0
				free size.raster.rows;
			;;
			free size.raster;
		;;
		free size;
	[end]

	[FreeBitmap: ptr<FntBitmap> bitmap: 0;]
		if bitmap is 0 return;
		if bitmap.pixels is not 0
			free bitmap.pixels;
		;;
		free bitmap;
	[end]

	# A glyph's bitmap at a size, as FreeType makes it (unhinted): the size's own, kept for next time, so
	# not to be freed; 0 if it can't be made, with the reason in error
	[Bitmap: ptr<FntSize> size: 0; u32 glyph: 0; : ptr<FntBitmap>]
		error is '';
		if size is 0 or glyph >= size.face.glyph_count
			error is 'no such glyph';
			return 0;
		;;
		if size.cache:glyph is not 0
			return size.cache:glyph;
		;;
		ptr<FntBitmap> bitmap: new FntBitmap;
		if bitmap is 0
			error is 'out of memory';
			return 0;
		;;
		if call Make: size glyph bitmap throws err
			call Failed: err.kind err.text err.message;
			call FreeBitmap: bitmap;
			return 0;
		;;
		size.cache:glyph is bitmap;
	[end: bitmap]

	[Make: ptr<FntSize> size: 0; u32 glyph: 0; ptr<FntBitmap> bitmap: 0;]
		ptr<FntTrueType> tt: size.face.tt;
		ptr<FntOutline> o: size.outline;
		call tt.Glyph: glyph o size.scale;
		bitmap.advance is ((tt.MulFix: (tt.pp1 + tt.advance) size.scale) - (tt.MulFix: tt.pp1 size.scale)) as int;
		if o.points is 0
			return;
		;;
		i64 min_x: o.x:0;
		i64 max_x: o.x:0;
		i64 min_y: o.y:0;
		i64 max_y: o.y:0;
		while u32 i: 1; i < o.points; i++;
			if o.x:i < min_x
				min_x is o.x:i;
			;;
			if o.x:i > max_x
				max_x is o.x:i;
			;;
			if o.y:i < min_y
				min_y is o.y:i;
			;;
			if o.y:i > max_y
				max_y is o.y:i;
			;;
		;;
		i64 left: min_x >> 6;
		i64 bottom: min_y >> 6;
		i64 right: (max_x + 63) >> 6;
		i64 top: (max_y + 63) >> 6;
		i64 w: right - left;
		i64 h: top - bottom;
		if w * h > MOST_BITMAP_PIXELS as i64
			throw 'a glyph bitmap of ' w ' by ' h ' pixels, more than ' MOST_BITMAP_PIXELS;
		;;
		bitmap.left is left as int;
		bitmap.top is top as int;
		bitmap.width is w as u32;
		bitmap.height is h as u32;
		if w * h is 0
			return;
		;;
		# a glyph marked as overlapping is drawn 4 times as fine, as FreeType draws it
		i64 k: 1;
		if tt.overlap
			if w * 4 > 0x7FFF
				throw 'a glyph too wide to draw 4 times as fine';
			;;
			k is 4;
		;;
		bitmap.pixels is new u8[(w * h) as u32];
		if bitmap.pixels is 0
			throw 'out of memory';
		;;
		ptr<u8> fine: bitmap.pixels;
		if k is 4
			fine is new u8[(w * h * 16) as u32];
			if fine is 0
				throw 'out of memory';
			;;
		;;
		ptr<FntRaster> r: size.raster;
		call r.Start: (w * k) as u32 (h * k) as u32;
		u32 first: 0;
		while u32 c: 0; c < o.contours; c++;
			call r.Contour: o first o.ends:c (0 - left * 64) (0 - bottom * 64) k;
			first is o.ends:c + 1;
		;;
		call r.Sweep: (fine as u8[(w * h * k * k) as u32]);
		if k is 4
			call Average: (fine as u8[(w * h * 16) as u32]) (bitmap.pixels as u8[(w * h) as u32]) w as u32 h as u32;
			free fine;
		;;
	[end]

	# each pixel the sum of its 16 subpixels' coverage in 16ths, rounded, at most 255, as FreeType's
	# ft_smooth_raster_overlap adds them up
	[Average: u8 fine[]; u8 px[]; u32 w: 0; u32 h: 0;]
		while u32 row: 0; row < h; row++;
			while u32 col: 0; col < w; col++;
				u32 total: 0;
				while u32 sy: 0; sy < 4; sy++;
					u32 base: (row * 4 + sy) * w * 4 + col * 4;
					while u32 sx: 0; sx < 4; sx++;
						total++ (fine:(base + sx) + 8) / 16;
					;;
				;;
				if total > 255
					total is 255;
				;;
				px:(row * w + col) is total as u8;
			;;
		;;
	[end]

	# How wide text is (length bytes of UTF-8) in the stack's fonts, in 64ths of a pixel: each character's
	# glyph from the first font that has one, its advance as HarfBuzz scales it
	[Measure: ptr<FntStack> stack: 0; ptr<u8> text: 0; u32 length: 0; : int]
		if stack is 0 or stack.count is 0 or (text is 0 and length > 0)
			return 0;
		;;
		FntText.pos is 0;
		int width: 0;
		while (FntText.Decode: (text as u8[length]))
			u32 which: 0;
			u32 g: (FntText.Pick: stack FntText.code addr which);
			width is width + (FntText.Advance: stack.sizes:which g);
		;;
	[end: width]

	# Draws text (length bytes of UTF-8) in the stack's fonts on canvas, width by height pixels of
	# 0xAARRGGBB, a row at a time from the top: the pen starts x 64ths of a pixel from the left, on the
	# baseline y pixels from the top, and each glyph's coverage, times color's alpha, blends color over
	# the canvas (its alpha kept). Gives where the pen ends, in 64ths of a pixel. What's off the canvas
	# isn't drawn, and a glyph that can't be made is left out (but its advance isn't).
	[Draw: ptr<FntStack> stack: 0; ptr<u8> text: 0; u32 length: 0; ptr<u32> canvas: 0; u32 width: 0; u32 height: 0; int x: 0; int y: 0; u32 color: 0; : int]
		if stack is 0 or stack.count is 0 or canvas is 0 or (text is 0 and length > 0)
			return x;
		;;
		FntText.pos is 0;
		int pen: x;
		while (FntText.Decode: (text as u8[length]))
			u32 which: 0;
			u32 g: (FntText.Pick: stack FntText.code addr which);
			ptr<FntSize> size: stack.sizes:which;
			ptr<FntBitmap> b: (Bitmap: size g);
			if b is not 0 and b.pixels is not 0
				call Blit: (canvas as u32[width * height]) width height b (((pen + 32) >> 6) + b.left) (y - b.top) color;
			;;
			pen is pen + (FntText.Advance: size g);
		;;
	[end: pen]

	[Blit: u32 canvas[]; u32 width: 0; u32 height: 0; ptr<FntBitmap> b: 0; int ox: 0; int oy: 0; u32 color: 0;]
		u32 ca: color >> 24;
		u32 n: b.width * b.height;
		call BlitRows: canvas width height (b.pixels as u8[n]) b.width b.height ox oy color ca;
	[end]

	[BlitRows: u32 canvas[]; u32 width: 0; u32 height: 0; u8 cov[]; u32 bw: 0; u32 bh: 0; int ox: 0; int oy: 0; u32 color: 0; u32 ca: 0;]
		while u32 row: 0; row < bh; row++;
			int cy: oy + row as int;
			if cy < 0 or cy >= height as int
				continue;
			;;
			while u32 col: 0; col < bw; col++;
				int cx: ox + col as int;
				if cx < 0 or cx >= width as int
					continue;
				;;
				u32 c: cov:(row * bw + col);
				if c is 0
					continue;
				;;
				u32 a: (c * ca + 127) / 255;
				if a is 0
					continue;
				;;
				u32 at_px: (cy as u32) * width + (cx as u32);
				u32 d: canvas:at_px;
				u32 rest: 255 - a;
				u32 r: (((color >> 16) & 255) * a + ((d >> 16) & 255) * rest + 127) / 255;
				u32 gr: (((color >> 8) & 255) * a + ((d >> 8) & 255) * rest + 127) / 255;
				u32 bl: ((color & 255) * a + (d & 255) * rest + 127) / 255;
				canvas:at_px is (d & 0xFF000000) | (r << 16) | (gr << 8) | bl;
			;;
		;;
	[end]

	# an outline to load glyphs into, again and again; 0 if there isn't the memory
	[NewOutline: : ptr<FntOutline>]
		ptr<FntOutline> o: new FntOutline;
	[end: o]

	# gives back an outline's memory (0 is allowed, and does nothing)
	[FreeOutline: ptr<FntOutline> o: 0;]
		if o is 0 return;
		call Release: o;
		free o;
	[end]

	# room in o for points points and contours contours; throws if there isn't the memory
	[Grow: ptr<FntOutline> o: 0; u32 points: 0; u32 contours: 0;]
		if points > o.point_room
			u32 room: o.point_room * 2;
			if room < 64
				room is 64;
			;;
			while room < points
				room is room * 2;
			;;
			ptr<int> x: new int[room];
			ptr<int> y: new int[room];
			ptr<u8> on: new u8[room];
			if x is 0 or y is 0 or on is 0
				if x is not 0
					free x;
				;;
				if y is not 0
					free y;
				;;
				if on is not 0
					free on;
				;;
				throw 'out of memory';
			;;
			while u32 i: 0; i < o.points; i++;
				x:i is o.x:i;
				y:i is o.y:i;
				on:i is o.on:i;
			;;
			call ReleasePoints: o;
			o.x is x;
			o.y is y;
			o.on is on;
			o.point_room is room;
		;;
		if contours > o.contour_room
			u32 room: o.contour_room * 2;
			if room < 16
				room is 16;
			;;
			while room < contours
				room is room * 2;
			;;
			ptr<u32> ends: new u32[room];
			if ends is 0
				throw 'out of memory';
			;;
			while u32 i: 0; i < o.contours; i++;
				ends:i is o.ends:i;
			;;
			if o.ends is not 0
				free o.ends;
			;;
			o.ends is ends;
			o.contour_room is room;
		;;
	[end]

	[ReleasePoints: ptr<FntOutline> o: 0;]
		if o.x is not 0
			free o.x;
		;;
		if o.y is not 0
			free o.y;
		;;
		if o.on is not 0
			free o.on;
		;;
	[end]

	[Release: ptr<FntOutline> o: 0;]
		call ReleasePoints: o;
		if o.ends is not 0
			free o.ends;
		;;
	[end]

	[Done: ptr<FntTrueType> tt: 0;]
		if tt.frames is not 0
			free tt.frames;
		;;
		if tt.on_path is not 0
			free tt.on_path;
		;;
		free tt;
	[end]

	[Failed: ErrorKind kind; str text; str message;]
		if kind is ErrorKind.THROWN
			error is text;
		;;
		else
			error is message;
		;;
	[end]
}
